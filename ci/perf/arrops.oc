architecture permissive

import ocara.IO
import ocara.Convert
import ocara.System
import ocara.Array

function main(): void {
    var n:int = Convert::strToInt(System::args()[1])
    var xs:array<int> = []
    for i in 0 until 1000 { xs.push(i) }
    var tot:int = 0
    for i in 0 until n {
        if Array::contains(xs, i % 1500) { tot += 1 }
        tot += Array::indexOf(xs, i % 1000)
        consumed part:array<int> = Array::slice(xs, i % 900, i % 900 + 50)
        tot += Array::reverse(part)[0]
        xs.push(i)
        tot += Array::pop(xs)
    }
    IO::writeln(`${tot}`)
}
