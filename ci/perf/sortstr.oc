architecture permissive

import ocara.IO
import ocara.Convert
import ocara.System
import ocara.Array

function main(): void {
    var n:int = Convert::strToInt(System::args()[1])
    var xs:array<string> = []
    for i in 0 until n { xs.push(`k${(i * 7919) % 100003}`) }
    var s:array<string> = Array::sort(xs)
    IO::writeln(`${s[0]} ${s[n - 1]}`)
}
