architecture permissive

import ocara.IO
import ocara.Convert
import ocara.System
import ocara.String
import ocara.Array
import ocara.Map
import ocara.JSON

function main(): void {
    var n:int = Convert::strToInt(System::args()[1])
    var words:array<string> = ["alpha", "beta", "gamma", "delta"]
    var hits:int = 0
    for i in 0 until n {
        for w in words { if w equal "gamma" { hits += 1 } }
    }
    IO::writeln(`${hits}`)
}
