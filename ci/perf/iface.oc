architecture permissive

import ocara.IO
import ocara.Convert
import ocara.System

interface Weight {
    method weight(n:int): int
}
class Double implements Weight {
    public method weight(n:int): int { return n * 2 }
}
class Triple implements Weight {
    public method weight(n:int): int { return n * 3 }
}
function total(w:Weight, n:int): int {
    var t:int = 0
    for i in 0 until n { t += w.weight(i) }
    return t
}
function main(): void {
    var n:int = Convert::strToInt(System::args()[1])
    IO::writeln(`${total(use Double(), n) + total(use Triple(), n)}`)
}
