architecture permissive

import ocara.IO
import ocara.Convert
import ocara.System
import ocara.String
import ocara.Array

async function sq(n:int): int { return n * n }
function main(): void {
    var n:int = Convert::strToInt(System::args()[1])
    var tot:int = 0
    for i in 0 until n { tot += resolve sq(i) }
    IO::writeln(`${tot}`)
}
