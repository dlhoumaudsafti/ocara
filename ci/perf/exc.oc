architecture permissive

import ocara.IO
import ocara.Convert
import ocara.System

function main(): void {
    var n:int = Convert::strToInt(System::args()[1])
    var c:int = 0
    for i in 0 until n {
        try {
            raise "x"
        } on e {
            c += 1
        }
    }
    IO::writeln(`${c}`)
}
