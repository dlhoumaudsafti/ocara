architecture permissive

import ocara.IO
import ocara.Convert
import ocara.System
import ocara.String
import ocara.Array

function main(): void {
    var n:int = Convert::strToInt(System::args()[1])
    var tot:int = 0
    var name:string = "ocara"
    for i in 0 until n {
        var s:string = `id=${i} name=${name} ok`
        tot += String::len(s)
    }
    IO::writeln(`${tot}`)
}
