architecture permissive

import ocara.IO
import ocara.Convert
import ocara.System
import ocara.String
import ocara.Array
import ocara.Map
import ocara.JSON

class Point {
    public property x:int
    public property y:int
    init(x:int, y:int) {
        self.x = x
        self.y = y
    }
    public method dist(o:Point): int { return (self.x - o.x) * (self.x - o.x) + (self.y - o.y) * (self.y - o.y) }
}
function main(): void {
    var n:int = Convert::strToInt(System::args()[1])
    var pts:array<Point> = []
    for i in 0 until n { pts.push(use Point(i, i * 2)) }
    var tot:int = 0
    for i in 1 until n { tot += pts[i].dist(pts[i - 1]) }
    IO::writeln(`${tot}`)
}
