architecture permissive

import ocara.IO
import ocara.Convert
import ocara.System

function main(): void {
    var m:map<string, int> = {"alpha": 1, "beta": 2, "gamma": 3, "delta": 4, "epsilon": 5, "zeta": 6, "eta": 7, "theta": 8}
    var n:int = Convert::strToInt(System::args()[1])
    var tot:int = 0
    for i in 0 until n {
        tot += m["alpha"] + m["delta"] + m["theta"]
        m["beta"] = i
        m["zeta"] += 1
    }
    IO::writeln(`${tot + m["beta"] + m["zeta"]}`)
}
