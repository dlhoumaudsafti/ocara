architecture permissive

import ocara.IO
import ocara.Convert
import ocara.System
import ocara.String
import ocara.Array
import ocara.Map
import ocara.JSON

function main(): void {
    var n:int = Convert::strToInt(System::args()[1])
    var xs:array<int> = []
    for i in 0 until n { xs.push((i * 7919) % 100003) }
    var s:array<int> = Array::sort(xs)
    IO::writeln(`${s[0]} ${s[n - 1]}`)
}
