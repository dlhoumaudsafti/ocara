architecture permissive

import ocara.IO
import ocara.Convert
import ocara.System
import ocara.DateTime

function main(): void {
    var n:int = Convert::strToInt(System::args()[1])
    var tot:int = 0
    for i in 0 until n {
        tot += DateTime::format(1700000000 + i * 37, "%d/%m/%Y %H:%M:%S").len()
    }
    IO::writeln(`${tot}`)
}
