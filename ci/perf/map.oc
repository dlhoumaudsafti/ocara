architecture permissive

import ocara.IO
import ocara.Convert
import ocara.System

function main(): void {
    var m:map<string, int> = {}
    var n:int = Convert::strToInt(System::args()[1])
    for i in 0 until n {
        m[`k${i}`] = i
    }
    var tot:int = 0
    for i in 0 until n {
        tot += m[`k${i}`]
    }
    IO::writeln(`${tot}`)
}
