architecture permissive

import ocara.IO
import ocara.Convert
import ocara.System
import ocara.String
import ocara.Array
import ocara.Map
import ocara.JSON

function main(): void {
    var n:int = Convert::strToInt(System::args()[1])
    var tot:int = 0
    for i in 0 until n {
        var m:map<string, mixed> = {"id": i, "name": "ocara", "ok": true, "tags": [1, 2, 3]}
        var text:string = JSON::encode(m)
        var back:map<string, mixed> = JSON::decode(text)
        tot += String::len(text) + back.size()
    }
    IO::writeln(`${tot}`)
}
