architecture permissive

import ocara.IO
import ocara.Convert
import ocara.System
import ocara.String
import ocara.Array
import ocara.Map
import ocara.JSON

function main(): void {
    var n:int = Convert::strToInt(System::args()[1])
    var tot:int = 0
    for i in 0 until n {
        var r:string = String::replace("hello world hello", "hello", "bye")
        tot += String::len(String::upper(r))
    }
    IO::writeln(`${tot}`)
}
