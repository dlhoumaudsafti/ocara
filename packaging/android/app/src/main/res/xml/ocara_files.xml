<?xml version="1.0" encoding="utf-8"?>
<!-- Dossiers partagés par le FileProvider (AndroidManifest.xml) : dossier du
     programme (`./`, Context.getFilesDir) et cache (fichiers choisis par
     ui.pickFile). -->
<paths>
    <files-path name="files" path="." />
    <cache-path name="cache" path="." />
</paths>
