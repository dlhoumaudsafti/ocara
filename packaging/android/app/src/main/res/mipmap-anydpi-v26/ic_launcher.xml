<?xml version="1.0" encoding="utf-8"?>
<!-- Icône réelle de l'app (voir mipmap-*/ic_launcher_foreground.webp) — PAS
     les drawables générés par défaut (ic_launcher_background/foreground.xml,
     le carré vert générique du template, supprimés) : sur Android 8+ (API
     26, la quasi-totalité des appareils réels), c'est CE fichier (icône
     adaptative) que le lanceur affiche, jamais directement les .webp
     ic_launcher/ic_launcher_round par densité (ceux-là ne servent plus que
     de repli légataire pour l'API 24/25, minSdk de ce projet).
     IMPORTANT : le foreground référence `ic_launcher_foreground`, PAS
     `ic_launcher` — `@mipmap/ic_launcher` se résoudrait EN CE MÊME FICHIER
     (gagnant pour toute densité sur API 26+), une référence circulaire que
     le système échoue à résoudre SILENCIEUSEMENT, retombant sur l'icône
     Android générique par défaut (confirmé par reproduction : c'est
     exactement ce qui s'est produit avec `@mipmap/ic_launcher` ici). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/black" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>