<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Requise même pour un socket en boucle locale (127.0.0.1) — comportement
         Android standard, pas spécifique à ce projet. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Builtins ocara.Android* : chaque permission ne sert qu'au builtin
         indiqué ; retirer celles que le programme n'utilise pas. Android ne
         demande rien tant que AndroidPermissions::request n'est pas appelé. -->
    <!-- ocara.AndroidCamera -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- ocara.AndroidMicrophone -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- ocara.AndroidNotifications (Android 13 et plus) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ocara.AndroidSensors, capteur step_counter (Android 10 et plus) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- ocara.AndroidUI::vibrate -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- ocara.AndroidFiles::saveToDownloads (Android 9 et moins) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.OcaraUIHybridDemo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="userPortrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
