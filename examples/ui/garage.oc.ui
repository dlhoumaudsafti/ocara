# Interface décrite en YAML (schéma : docs/oc-ui.md). Validée par
# `ocara examples/ui/garage.oc.ui` ; `--dump` affiche l'arbre JSON normalisé.
# Textes : variables `${…}` remplies par `use UI("garage.oc.ui", lang)`.
# Fenêtre ou écran large (≥ 840) : garage.md.oc.ui.
window:
  title: "${app_title}"
  width: 900
  height: 640
  theme: auto

styles:
  titre: { fontSize: 22, bold: true }

start: home
screens:
  home:
    layout:
      type: column
      spacing: 12
      padding: 16
      children:
        - { type: heading, value: "${cars_title}", style: titre }
        - type: row
          spacing: 8
          children:
            - { type: input, id: search, placeholder: "${search}", onSubmit: search, width: fill }
            - { type: iconButton, icon: search, label: "${search}", onClick: search }
        - type: list
          id: cars
          onSelect: open_car
          item:
            type: row
            spacing: 8
            children:
              - { type: text, bind: brand }
              - { type: text, bind: model }
        - { type: button, text: "${switch_lang}", variant: text, onClick: switch_lang }
        # Android seulement : bouton flottant, tiroir et panneau.
        - { type: android.fab, icon: info, label: "${about}", onClick: about }
        - type: android.drawer
          id: menu
          children:
            - { type: heading, value: "${app_title}", level: 3 }
            - { type: button, text: "${switch_lang}", variant: text, onClick: switch_lang }
        - type: android.bottomSheet
          id: about_sheet
          children:
            - { type: heading, value: "${about}", level: 3 }
            - { type: text, value: "${about_text}" }
  includes:
    - ui.d/details.oc.ui
