# Tous les composants d'`ocara.UI` (schéma : docs/oc-ui.md) : banc d'essai
# des moteurs de rendu. Aperçu desktop : `ocara examples/ui/components.oc.ui --preview`.
window:
  title: "Composants"
  width: 760
  height: 720
  theme: auto
  primary: "#00796b"

styles:
  section: { fontSize: 13, bold: true, color: "#00796b" }
  # États, ombre et transition (docs/oc-ui.md, « Styles d'état et effets »).
  action:
    shadow: { y: 2, blur: 6, color: "rgba(0, 0, 0, 0.3)" }
    transition: { duration: 150, properties: [background, opacity] }
    states:
      hover: { background: "#004d40" }
      active: { opacity: 0.8 }
  # Table `checked` : distincte de la propriété `checked` d'une case.
  case:
    states:
      checked: { bold: true }
  # Surcharge en thème sombre, par-dessus `section`.
  dark:
    section: { color: "#80cbc4" }

# Animations, sur le modèle des @keyframes CSS (docs/oc-ui.md, « Animations »).
animations:
  pulse:
    duration: 800
    iterations: infinite
    direction: alternate
    keyframes:
      0%: { opacity: 1, scale: 1 }
      100%: { opacity: 0.6, scale: 1.05 }

# Composant déclaré ici, développé à la compilation (docs/oc-ui.md, « Composants »).
components:
  chip:
    params:
      label: text
      tone: { type: color, default: "rgb(224, 242, 241)" }
    layout: { type: text, value: $label, background: $tone, padding: [4, 10], radius: 12 }

start: form
screens:
  form:
    title: "Formulaire"
    layout:
      type: column
      spacing: 12
      padding: 16
      scroll: true
      children:
        - { type: heading, level: 1, value: "Inscription" }
        - { type: text, value: "Champs, choix et boutons", style: section }
        - { type: input, id: name, placeholder: "Nom", required: true, onSubmit: save, onFocus: name_focus, onBlur: name_blur }
        - { type: input, id: password, kind: password, placeholder: "Mot de passe" }
        - { type: input, id: notes, kind: multiline, placeholder: "Notes" }
        - type: row
          spacing: 16
          children:
            - { type: checkbox, id: terms, label: "J'accepte les conditions", style: case, onChange: terms_changed }
            - { type: switch, id: news, label: "Lettre d'information", checked: true }
        - { type: radio, id: plan, value: free, options: [{ value: free, text: "Gratuit" }, { value: pro, text: "Pro" }] }
        - { type: select, id: country, value: fr, options: [{ value: fr, text: "France" }, { value: be, text: "Belgique" }, { value: ch, text: "Suisse" }] }
        - { type: slider, id: volume, min: 0, max: 10, step: 1, value: 3, onChange: volume_changed }
        - type: row
          spacing: 8
          children:
            - { type: date, id: birthday }
            - { type: time, id: alarm }
        - type: card
          id: zone
          onHover: zone_hover
          onLeave: zone_leave
          onDoubleClick: zone_double
          onLongPress: zone_long
          onSwipe: zone_swipe
          animation: pulse
          onAnimationEnd: zone_anim_end
          children:
            - { type: text, value: "Survol, double clic, appui long, balayage" }
        - { type: link, id: more, text: "En savoir plus", onClick: more }
        # Composants d'écran : rendus dans une couche au-dessus de l'écran.
        - { type: fab, id: add, icon: add, label: "Ajouter", position: bottomCenter, onClick: add_item }
        - type: drawer
          id: nav
          onDismiss: nav_closed
          children:
            - { type: text, value: "Menu" }
        - type: bottomSheet
          id: sheet
          onDismiss: sheet_closed
          children:
            - { type: text, value: "Panneau" }
        - type: floating
          id: badge
          anchor: topEnd
          x: 8
          y: 8
          z: 5
          children:
            - { type: text, value: "Bêta" }
        - type: row
          spacing: 12
          children:
            - { type: spinner, id: sp_circle }
            - { type: spinner, kind: dots, size: 24 }
            - { type: spinner, kind: bars, size: 24 }
            - { type: spinner, kind: pulse, size: 24 }
            - { type: spinner, kind: ring, size: 24 }
            - { type: spinner, kind: orbit, size: 24, color: "#c62828" }
        - { type: progress, id: upload, value: 0.4 }
        - { type: progress }
        - { type: divider }
        - type: row
          spacing: 8
          children:
            - { type: button, id: save, text: "Enregistrer", icon: check, style: action, onClick: save, submit: true, onInvalid: save_invalid }
            - { type: button, text: "Annuler", variant: secondary, onClick: cancel }
            - { type: button, text: "Désactivé", variant: text, enabled: false }
            - { type: spacer }
            - { type: iconButton, icon: refresh, label: "Recharger", onClick: reload, tooltip: "Recharger" }
            - { type: iconButton, icon: forward, label: "Liste", onClick: show_list }
  list:
    title: "Liste"
    layout:
      type: column
      spacing: 12
      padding: 16
      children:
        - type: card
          spacing: 4
          children:
            - type: row
              spacing: 8
              children:
                - { type: icon, name: info, color: "#00796b" }
                - { type: text, id: summary, value: "Aucun élément", bold: true }
            - { type: text, value: "Touchez un élément pour l'ouvrir.", color: "#757575", android: { fontSize: 14 } }
        - type: list
          id: people
          spacing: 4
          onSelect: open_person
          item:
            type: row
            spacing: 12
            children:
              - { type: icon, name: person }
              - type: column
                weight: 1
                children:
                  - { type: text, bind: name, bold: true }
                  - { type: text, bind: city }
              - { type: icon, name: forward }
        - type: grid
          columns: 3
          spacing: 8
          children:
            - { type: button, text: "Un", variant: secondary }
            - { type: button, text: "Deux", variant: secondary }
            - { type: button, text: "Trois", variant: secondary }
        - type: stack
          children:
            - { type: card, height: 60, background: "#e0f2f1", children: [] }
            - { type: text, value: "Superposé", align: center, padding: 18 }
        - type: webview
          id: page
          height: 140
          onMessage: page_message
          html: "<body style='font:15px sans-serif'><b>Vue web isolée</b><p><button onclick='ocara.post(\"clic\")'>Envoyer à Ocara</button></p></body>"
        # Grille de liste : 3 colonnes au plus, en serpentin (1 2 3 / 6 5 4).
        - type: list
          id: tiles
          display: grid
          itemWidth: 90
          maxColumns: 3
          direction: ltr-snake
          spacing: 4
          item: { type: text, bind: name }
        - type: row
          spacing: 6
          children:
            - { type: chip, id: chip_new, label: "Neuf" }
            - { type: chip, id: chip_sold, label: "Vendu", tone: "#ffcdd2" }
        - { type: button, text: "Retour", icon: back, variant: text, onClick: back }
