architecture permissive

import ocara.IO
import ocara.Convert

// ── 1. Enum simple (valeurs auto 0, 1, 2, ...) ──────────────────────────────
enum Direction {
    North,
    East,
    South,
    West
}

// ── 2. Enum avec valeurs explicites ─────────────────────────────────────────
enum HttpStatus {
    Ok      = 200,
    Created = 201,
    NotFound = 404,
    Error   = 500
}

// ── 3. Enum utilisé dans switch ──────────────────────────────────────────────
function directionName(d:int): string {
    switch d {
        0 { return "Nord" }
        1 { return "Est" }
        2 { return "Sud" }
        3 { return "Ouest" }
        default { return "Inconnu" }
    }
}

function httpLabel(code:int): string {
    switch code {
        200 { return "OK" }
        201 { return "Created" }
        404 { return "Not Found" }
        500 { return "Internal Server Error" }
        default { return "?" }
    }
}

// ── 4. Enum utilisé dans if ──────────────────────────────────────────────────
function isError(status:int): bool {
    return status equal HttpStatus::Error
}

function main(): void {
    IO::writeln("1. valeurs automatiques :")
    IO::writeln(Convert::intToStr(Direction::North))   // 0
    IO::writeln(Convert::intToStr(Direction::East))    // 1
    IO::writeln(Convert::intToStr(Direction::South))   // 2
    IO::writeln(Convert::intToStr(Direction::West))    // 3

    IO::writeln("2. valeurs explicites :")
    IO::writeln(Convert::intToStr(HttpStatus::Ok))       // 200
    IO::writeln(Convert::intToStr(HttpStatus::Created))  // 201
    IO::writeln(Convert::intToStr(HttpStatus::NotFound)) // 404
    IO::writeln(Convert::intToStr(HttpStatus::Error))    // 500

    IO::writeln("3. switch sur enum :")
    IO::writeln(directionName(Direction::North))  // Nord
    IO::writeln(directionName(Direction::South))  // Sud
    IO::writeln(httpLabel(HttpStatus::NotFound))  // Not Found

    IO::writeln("4. comparaison :")
    var s:int = HttpStatus::Error
    if isError(s) {
        IO::writeln("erreur detectee")
    }
    if s equal HttpStatus::Error {
        IO::writeln("statut = 500")
    }
}
