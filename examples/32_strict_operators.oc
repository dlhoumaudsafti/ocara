// Exemple : Comparaisons typées (equal / not equal / smaller / greater / ...)
// Ocara v0.2.0 — toute comparaison s'écrit en toutes lettres, sans aucun
// symbole (plus de ==, !=, <=, >=, <, >, ===, !==, <==, >==) :
//   equal              : égalité
//   not equal          : inégalité
//   smaller            : inférieur
//   greater            : supérieur
//   smaller or equal   : inférieur ou égal
//   greater or equal   : supérieur ou égal
//
// Les comparaisons sont toujours TYPÉES À LA COMPILATION (pas au runtime) :
// comparer deux types incompatibles est une erreur de compilation (E16), pas
// une valeur 'false' silencieuse découverte en production. int et float sont
// l'unique paire de types compatible malgré des types nominaux différents
// (widening numérique explicite lors de la compilation, pas un bitcast).

import ocara.IO

function main(): int {
    IO::writeln("=== Comparaisons typées ===")
    IO::writeln("")

    // 1. Égalité et inégalité (même type)
    IO::writeln("1. equal / not equal — même type")

    var x:int = 42
    var z:int = 42
    var y:int = 7

    if x equal z {
        IO::writeln("  x equal z : true (42 equal 42)")
    }
    if x not equal y {
        IO::writeln("  x not equal y : true (42 not equal 7)")
    }

    IO::writeln("")

    // 2. int et float : l'unique paire de types compatible
    IO::writeln("2. equal / not equal — int et float mélangés")

    var a:int = 10
    var b:float = 10.0
    var c:float = 2.5

    if a equal b {
        IO::writeln("  a equal b : true (10 equal 10.0, widening numerique)")
    }
    if a not equal c {
        IO::writeln("  a not equal c : true (10 not equal 2.5)")
    }

    IO::writeln("")

    // 3. equal compare le CONTENU des strings, pas leur adresse mémoire
    IO::writeln("3. equal sur des strings — comparaison de contenu")

    var name:string = "Alice"
    var otherName:string = "Alice"

    if name equal otherName {
        IO::writeln("  name equal otherName : true (meme contenu)")
    }

    IO::writeln("")

    // 4. Ordre : smaller / greater / smaller or equal / greater or equal
    IO::writeln("4. smaller / greater / smaller or equal / greater or equal")

    var num1:int = 100
    var num2:int = 200
    var num3:float = 100.0

    if num1 smaller num2 {
        IO::writeln("  num1 smaller num2 : true (100 smaller 200)")
    }
    if num2 greater num1 {
        IO::writeln("  num2 greater num1 : true (200 greater 100)")
    }
    if num1 smaller or equal num3 {
        IO::writeln("  num1 smaller or equal num3 : true (100 smaller or equal 100.0)")
    }
    if num2 greater or equal num1 {
        IO::writeln("  num2 greater or equal num1 : true (200 greater or equal 100)")
    }

    IO::writeln("")

    // 5. Comparaison entre types incompatibles : erreur de COMPILATION, pas
    //    une valeur 'false' silencieuse. Ce bloc ne compilerait pas :
    //
    //      var n:int = 5
    //      var s:string = "5"
    //      if n equal s { ... }
    //      // error: cannot compare 'int' and 'string' with 'equal' ...
    //
    //    Voir docs/diagnostics.md — E16.
    IO::writeln("5. equal/smaller/... entre types incompatibles = erreur a la compilation (E16)")
    IO::writeln("   (voir examples/21_errors.oc et docs/diagnostics.md)")

    IO::writeln("")

    // 6. Avec null
    IO::writeln("6. Comparaisons avec null")

    var nullable:string|null = null

    if nullable equal null {
        IO::writeln("  nullable equal null : true")
    }

    IO::writeln("")
    IO::writeln("=== Fin des exemples ===")

    return 0
}
