// ─────────────────────────────────────────────────────────────────────────────
// Exemple 01 — Variables et constantes
//
// Illustre :
//   - var      : variable mutable, portée du bloc
//   - scoped   : variable de BLOC — rend sa valeur (ferme sa ressource) à
//                la fermeture du bloc
//   - consumed : variable à USAGE UNIQUE — rend sa valeur (ferme sa
//                ressource) juste après sa première utilisation
//   - const    : constante globale (évaluée à la compilation)
//   - null     : absence de valeur pour les types référence
//
// NOTE : toute valeur tas (string, array, map, objet) est comptée : elle
// est libérée quand plus rien ne la référence, quel que soit le mot-clé.
// Une valeur partagée (`var y = x`, `return x`, champ, conteneur) reste
// vivante tant que ce partage existe. `scoped`/`consumed` ferment en plus
// automatiquement une ressource (Mutex/SQLite/MySQL/MariaDB), qui ne peut
// pas sortir de son bloc. Voir docs/variables.md.
// ─────────────────────────────────────────────────────────────────────────────

import ocara.IO
import ocara.Array

const PI:float = 3.14159
const APP_NAME:string = "Ocara"
const MAX_SCORE:int = 100


function main(): int {

    // var — variable MUTABLE, portée de la fonction
    // Elle peut être réassignée à tout moment
    var score:int = 0
    score = 42              // OK : var est réassignable
    IO::writeln(score)      // 42

    var compteur:int = 10
    compteur = compteur + 1
    IO::writeln(compteur)   // 11

    // scoped — variable de BLOC (block-scoped)
    // Portée : strictement limitée au bloc { } où elle est déclarée.
    // À la fermeture du bloc, chaque variable rend sa valeur : libérée si
    // plus rien d'autre ne la référence.
    if true {
        scoped message:string = "dans le bloc if"       // littéral : figé dans le binaire, jamais libéré
        IO::writeln(message) // dans le bloc if

        scoped built:string = "dans" + " le bloc if bis"   // concaténation : allouée, libérée à la fin du bloc
        IO::writeln(built)

        scoped data:array<int> = [1, 2, 3]
        IO::writeln(Array::len(data))   // 3
        // message, built et data existent ici...
    }
    // ...mais n'existent plus ici (built et data ont été libérées)

    var i:int = 0
    while i smaller 3 {
        scoped temp:int = i * 2    // temp est créé à chaque itération (int : se comporte comme var)
        IO::writeln(temp)
        i = i + 1
    }
    // temp n'existe plus ici

    // consumed — variable à USAGE UNIQUE
    // Rend sa valeur juste après l'instruction de sa toute première
    // utilisation (ici, un array — string/map/objet suivent la même règle).
    // Une deuxième utilisation serait une erreur de compilation :
    //   consumed once:array<int> = [7, 8, 9]
    //   IO::writeln(Array::len(once))   // 1ʳᵉ (et unique) utilisation → once rendu juste après
    //   IO::writeln(Array::len(once))   // ❌ erreur : 'once' déjà utilisée
    consumed once:array<int> = [7, 8, 9]
    IO::writeln(Array::len(once))   // 3

    // Constantes globales
    IO::writeln(PI)         // 3.14159
    IO::writeln(APP_NAME)   // Ocara
    IO::writeln(MAX_SCORE)  // 100

    // Types primitifs disponibles
    var count:int    = 10
    var rate:float   = 0.75
    var flag:bool    = true
    var label:string = "hello"
    var unknown:mixed  = 99

    IO::writeln(count)
    IO::writeln(rate)
    IO::writeln(flag)
    IO::writeln(label)
    IO::writeln(unknown)

    // null — absence de valeur pour les types référence (string, objet, tableau, map)
    // null est compatible avec string, classes, tableaux et maps — pas avec int/float/bool
    var nom:string  = null          // variable string initialisée à null
    var tags:mixed  = null          // mixed accepte null
    IO::writeln(nom)                // null
    IO::writeln(tags)               // null

    // Tester la nullité avec une comparaison
    if nom equal null {
        IO::writeln("nom est null")  // nom est null
    }

    // Réassigner depuis null vers une vraie valeur
    nom = "Ocara"
    IO::writeln(nom)                // Ocara

    return 0
}
