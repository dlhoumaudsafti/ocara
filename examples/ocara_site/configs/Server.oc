// examples/ocara_site/configs/Server.oc
// Configuration du serveur HTTP du mini site.
//
// Server extends HTTPServer : fixe le port (8080), le nombre de workers,
// le dossier racine des fichiers statiques (./public/), puis délègue
// l'enregistrement des routes aux classes de routes/ (General, Error,
// Infos, API).
namespace configs

import ocara.HTTPServer
import controllers.AboutController
import controllers.ContactController
import routes.General
import routes.Error
import routes.Infos

class Server {
    private property server:HTTPServer

    init() {
        self.server = use HTTPServer()
        self.server.port(3000)
        self.server.workers(4)
    }

    public method routes(): void {
        use General(self.server)
        use Error(self.server)
        use Infos(self.server)
    }

    public method run(): Exception|void {
        try {
            self.server.run()
        } on e {
            return e
        }
    }
}
