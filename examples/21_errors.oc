// 21_errors.oc — Démonstration des erreurs et warnings sémantiques d'Ocara
//
// Ce fichier est volontairement invalide.
// Il doit être analysé avec --check et ne doit PAS compiler.
//
// Usage :
//   ./target/release/ocara examples/21_errors.oc --check

import ocara.IO
import ocara.Math
import ocara.Mutex

function main(): int {
    // Warning 1 — variable déclarée mais jamais utilisée
    var inutile: string = "jamais lue"

    // Erreur 1 — symbole indéfini
    var a: int = foo

    // Erreur 2 — mauvais type : on attend int, on donne string
    var c: int = "bonjour"

    // Erreur 3 — condition non booléenne
    if 42 {
        IO::writeln("ne devrait pas compiler")
    }

    // Warning 2 — variable déclarée dans un bloc mais jamais lue
    if true {
        var temp: int = 99
    }

    // Erreur 4 — mauvais nombre d'arguments
    IO::writeln("trop", "d'", "arguments")

    // Erreur 5 — double déclaration dans le même scope
    var x: int = 1
    var x: int = 2

    // Erreur 6 — assignation à une constante
    Math::PI = 3

    // Erreur 7 — comparaison entre types incompatibles (E16)
    // int et float sont la seule paire compatible ; int et string ne le sont pas.
    var n: int = 5
    var s: string = "5"
    if n equal s {
        IO::writeln("ne devrait pas compiler")
    }

    // Erreur 8 — classe de filtre `on ... is` introuvable (E23)
    try {
        raise "boom"
    } on e is TypoException {
        IO::writeln("ne devrait jamais être atteint")
    }

    // Erreur 9 — handler catch-all pas en dernière position (E24)
    try {
        raise "boom"
    } on e {
        IO::writeln("générique")
    } on e is IOException {
        IO::writeln("jamais atteint : le catch-all précédent absorbe tout")
    }

    // Erreur 10 — ressource déjà finalisée manuellement (E25)
    scoped m: Mutex = use Mutex()
    m.destroy()
    m.destroy()

    // Erreur 11 — fuite d'un handle natif déclaré en `var` (E28) : jamais
    // échappé, jamais `.destroy()`é.
    var leaked: Mutex = use Mutex()
    leaked.lock()
    leaked.unlock()

    return 0
}

// Erreur 12 — champ de classe d'un type ressource (E29) : jamais fermé par
// `__free_LeakyCache`, quelle que soit la façon dont une instance est gérée.
class LeakyCache {
    private property lock: Mutex
    init() {
        self.lock = use Mutex()
    }
}
