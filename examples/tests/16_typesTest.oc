architecture permissive

import ocara.UnitTest
import ocara.IO
import ocara.Array

class Test16Types extends UnitTest {

    public method primitivesTest(): int {
        var i:int = 42
        var f:float = 3.14
        var s:string = "Ocara"
        var b:bool = true

        self::assertEquals(42, i)
        self::assertNotNull(f)
        self::assertEquals("Ocara", s)
        self::assertTrue(b)

        return 0
    }

    public method mixedTest(): int {
        var a:mixed = "text"
        self::assertNotNull(a)

        a = 100
        self::assertNotNull(a)

        a = false
        self::assertNotNull(a)

        return 0
    }

    public method arraysTest(): int {
        var ints:array<int> = [1, 2, 3]
        var strs:array<string> = ["a", "b", "c"]

        self::assertEquals(1, ints[0])
        self::assertEquals("b", strs[1])

        return 0
    }

    public method mainTest(): int {
        var i:int = 42
        var f:float = 3.14
        var s:string = "Ocara"
        var b:bool = true
        var a:mixed = "text"

        self::assertEquals(42, i)
        self::assertNotNull(f)
        self::assertEquals("Ocara", s)
        self::assertTrue(b)
        self::assertNotNull(a)

        a = 100
        a = false

        var ints:array<int> = [1, 2, 3]
        var strs:array<string> = ["a", "b", "c"]
        var bools:array<bool> = [true, false, true]
        var floats:array<float> = [1.5, 2.5, 3.5]
        var vals:array<mixed> = [1, "deux", 3.0, false]
        var matrix:array<array<int>> = [[1, 2], [3, 4]]

        self::assertEquals(1, ints[0])
        self::assertEquals("b", strs[1])
        self::assertTrue(bools[2])
        self::assertEquals(true, bools[2])
        self::assertEquals(2.5, floats[1])
        self::assertNotNull(vals[1])

        var config:map<string, mixed> = {
            "debug": true,
            "version": 1,
            "name": "app"
        }
        self::assertNotNull(config["debug"])
        self::assertNotNull(config["version"])

        var v:Vector2 = use Vector2(1.0, 2.5)
        self::assertNotNull(v.x)
        self::assertNotNull(v.y)

        return 0
    }
    public method displayTest(): int {
        var v:Vector2 = use Vector2(1.0, 2.5)
        v.display()
        self::assertEquals(1.0, v.x)
        self::assertEquals(2.5, v.y)
        v.x = -3.5
        v.display()
        self::assertEquals(-3.5, v.x)
        return 0
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 16_types.oc
// ─────────────────────────────────────────────────────────────────────────────


class Vector2 {
    public property x:float
    public property y:float
    init(x:float, y:float) {
        self.x = x
        self.y = y
    }
    public method display(): void {
        IO::writeln(`Vector2(${self.x}, ${self.y})`)
    }
}

