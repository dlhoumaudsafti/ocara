architecture permissive

import ocara.UnitTest

class Test29Async extends UnitTest {

    public method asyncIntTest(): int {
        var ti:Resolvable<int> = asyncInt(7)
        var ri:int = resolve ti
        self::assertEquals(49, ri)
        return 0
    }

    public method asyncBoolTest(): int {
        var tb:Resolvable<bool> = asyncBool(5)
        var rb:bool = resolve tb
        self::assertTrue(rb)

        var tb2:Resolvable<bool> = asyncBool(-5)
        var rb2:bool = resolve tb2
        self::assertFalse(rb2)

        return 0
    }

    public method asyncStringTest(): int {
        var ts:Resolvable<string> = asyncString("world")
        var rs:string = resolve ts
        self::assertEquals("hello world", rs)
        return 0
    }

    public method mainTest(): int {
        var ti:Resolvable<int> = asyncInt(7)
        var ri:int = resolve ti
        self::assertEquals(49, ri)

        var tb:Resolvable<bool> = asyncBool(5)
        var rb:bool = resolve tb
        self::assertTrue(rb)

        var ts:Resolvable<string> = asyncString("world")
        var rs:string = resolve ts
        self::assertEquals("hello world", rs)

        return 0
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 29_async.oc
// ─────────────────────────────────────────────────────────────────────────────


async function asyncInt(n:int): int {
    return n * n
}

async function asyncBool(n:int): bool {
    return n greater 0
}

async function asyncString(s:string): string {
    return "hello " + s
}

