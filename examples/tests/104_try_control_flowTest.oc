architecture permissive

import ocara.UnitTest
import ocara.Array

// `return`/`break`/`continue` dans un `try`/`on`, locales et captures d'un
// générateur après un `raise` rattrapé — voir
// docs/roadmap.d/langage-try-controle-de-flux.md.

class Test104TryControlFlow extends UnitTest {

    public method continueAndBreakInTryTest(): int {
        var s:string = ""
        for i in 0 until 5 {
            try {
                if i equal 1 { continue }
                if i equal 3 { break }
                s = s + `${i}`
            } on e { }
        }
        self::assertEquals("02", s)
        return 0
    }

    public method breakInWhileTryTest(): int {
        var n:int = 0
        while true {
            try {
                n = n + 1
                if n equal 3 { break }
            } on e { }
        }
        self::assertEquals(3, n)
        return 0
    }

    public method breakInHandlerTest(): int {
        var n:int = 0
        while true {
            n = n + 1
            try {
                if n equal 4 { raise "stop" }
            } on e {
                break
            }
        }
        self::assertEquals(4, n)
        return 0
    }

    public method nestedTryLoopControlTest(): int {
        var s:string = ""
        for i in 0 until 4 {
            try {
                try {
                    if i equal 1 { continue }
                    if i equal 3 { break }
                    s = s + `${i}`
                } on e { }
                s = s + "."
            } on e { }
        }
        self::assertEquals("0.2.", s)
        return 0
    }

    public method loopInsideTryTest(): int {
        var c:int = 0
        try {
            for i in 0 until 10 {
                if i equal 2 { continue }
                if i equal 5 { break }
                c = c + 1
            }
        } on e { }
        self::assertEquals(4, c)
        return 0
    }

    public method returnFromTryTest(): int {
        self::assertEquals("fromtry", fromTry())
        self::assertEquals(-1, minusOne())
        self::assertEquals(2.5, half())
        self::assertTrue(yes())
        self::assertEquals("profond", deep())
        self::assertEquals("t1-2", withLocals(1))
        self::assertEquals("fin", withLocals(2))
        return 0
    }

    public method returnFromHandlerTest(): int {
        self::assertEquals(-1, parse(""))
        self::assertEquals(1, parse("x"))
        return 0
    }

    public method voidReturnFromTryTest(): int {
        var log:array<string> = []
        stopEarly(log)
        self::assertEquals(1, log.len())
        return 0
    }

    public method returnInClosureTryTest(): int {
        var f:Function<int(int)> = nameless(x:int): int {
            for i in 0 until 10 {
                try {
                    if i equal x { return i * 10 }
                } on e { }
            }
            return -5
        }
        self::assertEquals(30, f(3))
        self::assertEquals(-5, f(20))
        return 0
    }

    public method generatorLocalsSurviveRaiseTest(): int {
        var total:int = 0
        for n in survivors() {
            total += n
        }
        self::assertEquals(6, total)
        return 0
    }

    public method generatorClosureCapturesParameterTest(): int {
        var got:int = 0
        for v in captureParam(9) {
            got = v
        }
        self::assertEquals(9, got)
        return 0
    }

    public method closureOutlivesGeneratorTest(): int {
        var fs:array<Function<string()>> = []
        for f in greeter("Ada") {
            fs.push(f)
        }
        var text:string = ""
        for f in fs {
            text = f()
        }
        self::assertEquals("Ada!2", text)
        return 0
    }
}

function fromTry(): string {
    try {
        return "fromtry"
    } on e {
        return "fromon"
    }
    return "after"
}

function minusOne(): int {
    try { return -1 } on e { }
    return 7
}

function half(): float {
    try { return 2.5 } on e { }
    return 0.0
}

function yes(): bool {
    try { return true } on e { }
    return false
}

function deep(): string {
    try {
        try {
            try {
                return "profond"
            } on e { }
        } on e { }
    } on e { }
    return "non"
}

function withLocals(n:int): string {
    var tmp:string = `t${n}`
    try {
        var inner:array<int> = [1, 2]
        if n equal 1 { return `${tmp}-${inner.len()}` }
    } on e { }
    return "fin"
}

function parse(text:string): int {
    try {
        if text equal "" { raise "vide" }
        return 1
    } on e {
        return -1
    }
    return 0
}

function stopEarly(log:array<string>): void {
    log.push("avant")
    try {
        return
    } on e { }
    log.push("après")
}

function survivors(): message<int> {
    var xs:array<int> = [7, 8, 9]
    var s:string = "abc"
    try {
        raise "boom"
    } on e { }
    emit xs.len()
    emit s.len()
}

function captureParam(n:int): message<int> {
    var f:Function<int()> = nameless(): int { return n }
    emit f()
}

function greeter(name:string): message<Function<string()>> {
    var suffix:string = "!"
    var xs:array<int> = [1, 2]
    emit nameless(): string { return `${name}${suffix}${xs.len()}` }
}
