architecture permissive

import ocara.UnitTest
import ocara.IO

class Test13Instantiation extends UnitTest {

    public method colorTest(): int {
        var red:Color = use Color(255, 0, 0)
        self::assertEquals(255, red.r)
        self::assertEquals(0, red.g)
        self::assertEquals(0, red.b)
        return 0
    }

    public method timerTest(): int {
        var timer:Timer = use Timer(10)
        self::assertEquals(10, timer.remaining())
        self::assertFalse(timer.isDone())

        timer.tick()
        self::assertEquals(9, timer.remaining())

        return 0
    }

    public method mainTest(): int {
        var red:Color = use Color(255, 0, 0)
        var green:Color = use Color(0, 255, 0)
        var blue:Color = use Color(0, 0, 255)

        self::assertEquals(255, red.r)
        self::assertEquals(255, green.g)
        self::assertEquals(255, blue.b)

        var timer:Timer = use Timer(5)
        self::assertEquals(5, timer.remaining())
        timer.tick()
        self::assertEquals(4, timer.remaining())

        return 0
    }
    public method displayTest(): int {
        var c:Color = use Color(10, 20, 30)
        c.display()
        self::assertEquals(10, c.r)
        self::assertEquals(20, c.g)
        self::assertEquals(30, c.b)

        var p1:Pair = use Pair("clé", 42)
        var p2:Pair = use Pair(true, 3.14)
        p1.display()
        p2.display()
        self::assertEquals("clé", p1.first)
        self::assertEquals(42, p1.second)
        self::assertEquals(true, p2.first)
        self::assertEquals(3.14, p2.second)
        return 0
    }

    public method tickTest(): int {
        var t:Timer = use Timer(2)
        t.tick()
        self::assertEquals(1, t.remaining())
        t.tick()
        self::assertEquals(0, t.remaining())
        // ne descend jamais sous zéro
        t.tick()
        self::assertEquals(0, t.remaining())
        return 0
    }

    public method remainingTest(): int {
        var t1:Timer = use Timer(3)
        var t2:Timer = use Timer(5)
        t1.tick()
        t1.tick()
        // instances indépendantes
        self::assertEquals(1, t1.remaining())
        self::assertEquals(5, t2.remaining())
        return 0
    }

    public method isDoneTest(): int {
        var t:Timer = use Timer(1)
        self::assertFalse(t.isDone())
        t.tick()
        self::assertTrue(t.isDone())
        var zero:Timer = use Timer(0)
        self::assertTrue(zero.isDone())
        return 0
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 13_instantiation.oc
// ─────────────────────────────────────────────────────────────────────────────


class Color {
    public property r:int
    public property g:int
    public property b:int

    init(r:int, g:int, b:int) {
        self.r = r
        self.g = g
        self.b = b
    }

    public method display(): void {
        IO::writeln(`rgb(${self.r}, ${self.g}, ${self.b})`)
    }
}

class Timer {
    private property seconds:int

    init(seconds:int) {
        self.seconds = seconds
    }

    public method tick(): void {
        if self.seconds greater 0 {
            self.seconds = self.seconds - 1
        }
    }

    public method remaining(): int {
        return self.seconds
    }

    public method isDone(): bool {
        return self.seconds equal 0
    }
}

class Pair {
    public property first:int|string|bool|float
    public property second:int|string|bool|float

    init(first:int|string|bool|float, second:int|string|bool|float) {
        self.first  = first
        self.second = second
    }

    public method display(): void {
        IO::writeln(`(${self.first}, ${self.second})`)
    }
}
