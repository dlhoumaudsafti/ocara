// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 26_modules.oc
// ─────────────────────────────────────────────────────────────────────────────
//
// Les résultats des méthodes issues d'un `module` (getAge, getId) sont passés
// directement en argument : leur type de retour était perdu au site d'appel
// (`0` → `null`, `float` → SIGSEGV), voir moduleReturnTypesTest.

architecture permissive

import ocara.UnitTest
import User from "../26_modules"

class Test26Modules extends UnitTest {

    public method basicTest(): int {
        var u:User = use User(10)
        self::assertEquals(10, u.getScore())
        return 0
    }

    // Module Timestamped : created_at initialisé à 0 par init → âge 100
    public method getAgeTest(): int {
        var u:User = use User(0)
        self::assertEquals(100, u.getAge())
        return 0
    }

    // Module Timestamped : markCreated() fixe created_at à 42 → âge 58
    public method markCreatedTest(): int {
        var u:User = use User(0)
        u.markCreated()
        self::assertEquals(58, u.getAge())
        return 0
    }

    // Module Identifiable : id initialisé à 0 par init
    public method getIdTest(): int {
        var u:User = use User(0)
        self::assertEquals(0, u.getId())
        return 0
    }

    public method setIdTest(): int {
        var u:User = use User(0)
        u.setId(1001)
        self::assertEquals(1001, u.getId())
        u.setId(7)
        self::assertEquals(7, u.getId())
        return 0
    }

    public method getScoreTest(): int {
        var u:User = use User(100)
        self::assertEquals(100, u.getScore())
        return 0
    }

    public method addPointsTest(): int {
        var u:User = use User(100)
        u.addPoints(50)
        self::assertEquals(150, u.getScore())
        u.addPoints(-30)
        self::assertEquals(120, u.getScore())
        return 0
    }

    // Reproduit le scénario de main() avec assertions
    public method mainTest(): int {
        var u:User = use User(100)
        self::assertEquals(100, u.getScore())
        u.addPoints(50)
        self::assertEquals(150, u.getScore())
        u.setId(1001)
        self::assertEquals(1001, u.getId())
        self::assertEquals(100, u.getAge())
        u.markCreated()
        self::assertEquals(58, u.getAge())
        // Les modules sont indépendants : l'état des uns n'affecte pas les autres
        self::assertEquals(1001, u.getId())
        self::assertEquals(150, u.getScore())
        return 0
    }

    // Types de retour des méthodes de module (int, bool, float, string)
    // passés directement en argument.
    public method moduleReturnTypesTest(): int {
        var m:Measured = use Measured()
        self::assertEquals(0, m.zero())
        self::assertTrue(m.yes())
        self::assertEquals(0.5, m.half())
        self::assertEquals("mod", m.label())
        return 0
    }
}

module Measures {
    public method zero(): int {
        return 0
    }

    public method yes(): bool {
        return true
    }

    public method half(): float {
        return 0.5
    }

    public method label(): string {
        return "mod"
    }
}

class Measured modules Measures {
}
