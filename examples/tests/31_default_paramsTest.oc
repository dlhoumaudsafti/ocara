architecture permissive

import ocara.UnitTest

class Test31DefaultParams extends UnitTest {

    public method multiplyTest(): int {
        var calc:Calculator = use Calculator()
        self::assertEquals(5, calc.multiply(5))
        self::assertEquals(15, calc.multiply(5, 3))
        return 0
    }

    public method powerTest(): int {
        var calc:Calculator = use Calculator()
        self::assertEquals(4, calc.power(2))
        self::assertEquals(8, calc.power(2, 3))
        return 0
    }

    public method defaultParamTest(): int {
        self::assertEquals("Hello, World!", greet())
        self::assertEquals("Hello, Ocara!", greet("Ocara"))
        return 0
    }

    public method multipleDefaultsTest(): int {
        self::assertEquals(5, add(5))
        self::assertEquals(8, add(5, 3))
        self::assertEquals(10, add(5, 3, 2))
        return 0
    }

    public method formatDefaultsTest(): int {
        self::assertEquals("[test]", format("test"))
        self::assertEquals("<test]", format("test", "<"))
        self::assertEquals("<test>", format("test", "<", ">"))
        return 0
    }

    public method mainTest(): int {
        self::assertEquals("Hello, World!", greet())
        self::assertEquals("Hello, Ocara!", greet("Ocara"))
        self::assertEquals(5, add(5))
        self::assertEquals(8, add(5, 3))
        self::assertEquals(10, add(5, 3, 2))
        self::assertEquals("[test]", format("test"))

        var calc:Calculator = use Calculator()
        self::assertEquals(5, calc.multiply(5))
        self::assertEquals(4, calc.power(2))

        return 0
    }

    // Méthode statique : un paramètre par défaut omis faisait échouer la
    // génération de code (« mismatched argument count »).
    public method staticDefaultParamTest(): int {
        self::assertEquals("Hello, World!", Greeter::greet())
        self::assertEquals("Hello, Ocara!", Greeter::greet("Ocara"))
        self::assertEquals("Bonjour, World!", Greeter::greetWith("Bonjour"))
        return 0
    }
}

class Greeter {
    public static method greet(name:string = "World"): string {
        return "Hello, " + name + "!"
    }

    public static method greetWith(greeting:string, name:string = "World"): string {
        return greeting + ", " + name + "!"
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 31_default_params.oc
// ─────────────────────────────────────────────────────────────────────────────


function greet(name:string = "World"): string {
    return "Hello, " + name + "!"
}

function add(a:int, b:int = 0, c:int = 0): int {
    return a + b + c
}

function format(text:string, prefix:string = "[", suffix:string = "]"): string {
    return prefix + text + suffix
}

class Calculator {
    public method multiply(a:int, b:int = 1): int {
        return a * b
    }

    public method power(base:int, exponent:int = 2): int {
        var result:int = 1
        var i:int = 0
        while i smaller exponent {
            result = result * base
            i = i + 1
        }
        return result
    }
}

