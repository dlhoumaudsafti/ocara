// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 15_operators.oc
// ─────────────────────────────────────────────────────────────────────────────

architecture permissive

import ocara.UnitTest

class Test15Operators extends UnitTest {

    public method arithmeticTest(): int {
        self::assertEquals(13, 10 + 3)
        self::assertEquals(7, 10 - 3)
        self::assertEquals(30, 10 * 3)
        self::assertEquals(3, 10 / 3)
        self::assertEquals(1, 10 % 3)
        return 0
    }

    public method precedenceTest(): int {
        self::assertEquals(14, 2 + 3 * 4)
        self::assertEquals(20, (2 + 3) * 4)
        self::assertEquals(5, 10 - 2 * 3 + 1)
        return 0
    }

    public method unaryTest(): int {
        var n:int = 5
        self::assertEquals(-5, -n)
        self::assertEquals(5, -(-n))
        return 0
    }

    public method comparisonTest(): int {
        self::assertTrue(5 equal 5)
        self::assertTrue(5 not equal 3)
        self::assertTrue(5 smaller 10)
        self::assertTrue(5 smaller or equal 5)
        self::assertTrue(10 greater 5)
        self::assertTrue(10 greater or equal 10)
        return 0
    }

    public method logicalTest(): int {
        self::assertTrue(true and true)
        self::assertFalse(true and false)
        self::assertTrue(false or true)
        self::assertFalse(false or false)
        self::assertTrue(not false)
        self::assertFalse(not true)
        return 0
    }

    public method mainTest(): int {
        // Reproduit le comportement de main()
        self::assertEquals(13, 10 + 3)
        self::assertEquals(7, 10 - 3)
        self::assertEquals(30, 10 * 3)
        self::assertEquals(3, 10 / 3)
        self::assertEquals(1, 10 % 3)

        self::assertEquals(14, 2 + 3 * 4)
        self::assertEquals(20, (2 + 3) * 4)
        self::assertEquals(5, 10 - 2 * 3 + 1)

        var n:int = 5
        self::assertEquals(-5, -n)
        self::assertEquals(5, -(-n))

        var flag:bool = false
        self::assertTrue(not flag)
        self::assertFalse(not true)
        self::assertTrue(not not true)

        self::assertTrue(5 equal 5)
        self::assertTrue(5 not equal 3)
        self::assertTrue(5 smaller 10)
        self::assertTrue(5 smaller or equal 5)
        self::assertTrue(10 greater 5)
        self::assertTrue(10 greater or equal 10)

        self::assertTrue(true and true)
        self::assertFalse(true and false)
        self::assertTrue(false or true)
        self::assertFalse(false or false)

        var a:int = 5
        var b:int = 0
        self::assertTrue(a greater 0 and b greater or equal 0)
        self::assertTrue(a greater 10 or b equal 0)

        var count:int = 0
        for i in 0 until 5 {
            count = count + 1
        }
        self::assertEquals(5, count)

        return 0
    }
}
