// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 15_operators.oc
// ─────────────────────────────────────────────────────────────────────────────

architecture permissive

import ocara.UnitTest
import ocara.IO
import ocara.MathException

class Test15Operators extends UnitTest {

    public method arithmeticTest(): int {
        self::assertEquals(13, 10 + 3)
        self::assertEquals(7, 10 - 3)
        self::assertEquals(30, 10 * 3)
        self::assertEquals(3, 10 / 3)
        self::assertEquals(1, 10 % 3)
        return 0
    }

    public method precedenceTest(): int {
        self::assertEquals(14, 2 + 3 * 4)
        self::assertEquals(20, (2 + 3) * 4)
        self::assertEquals(5, 10 - 2 * 3 + 1)
        return 0
    }

    public method unaryTest(): int {
        var n:int = 5
        self::assertEquals(-5, -n)
        self::assertEquals(5, -(-n))
        return 0
    }

    public method comparisonTest(): int {
        self::assertTrue(5 equal 5)
        self::assertTrue(5 not equal 3)
        self::assertTrue(5 smaller 10)
        self::assertTrue(5 smaller or equal 5)
        self::assertTrue(10 greater 5)
        self::assertTrue(10 greater or equal 10)
        return 0
    }

    public method logicalTest(): int {
        self::assertTrue(true and true)
        self::assertFalse(true and false)
        self::assertTrue(false or true)
        self::assertFalse(false or false)
        self::assertTrue(not false)
        self::assertFalse(not true)
        return 0
    }

    public method mainTest(): int {
        // Reproduit le comportement de main()
        self::assertEquals(13, 10 + 3)
        self::assertEquals(7, 10 - 3)
        self::assertEquals(30, 10 * 3)
        self::assertEquals(3, 10 / 3)
        self::assertEquals(1, 10 % 3)

        self::assertEquals(14, 2 + 3 * 4)
        self::assertEquals(20, (2 + 3) * 4)
        self::assertEquals(5, 10 - 2 * 3 + 1)

        var n:int = 5
        self::assertEquals(-5, -n)
        self::assertEquals(5, -(-n))

        var flag:bool = false
        self::assertTrue(not flag)
        self::assertFalse(not true)
        self::assertTrue(not not true)

        self::assertTrue(5 equal 5)
        self::assertTrue(5 not equal 3)
        self::assertTrue(5 smaller 10)
        self::assertTrue(5 smaller or equal 5)
        self::assertTrue(10 greater 5)
        self::assertTrue(10 greater or equal 10)

        self::assertTrue(true and true)
        self::assertFalse(true and false)
        self::assertTrue(false or true)
        self::assertFalse(false or false)

        var a:int = 5
        var b:int = 0
        self::assertTrue(a greater 0 and b greater or equal 0)
        self::assertTrue(a greater 10 or b equal 0)

        var count:int = 0
        for i in 0 until 5 {
            count = count + 1
        }
        self::assertEquals(5, count)

        return 0
    }

    // Division et modulo entiers par zéro : MathException (104) rattrapable —
    // le programme s'arrêtait (SIGILL/SIGFPE).
    public method integerDivisionByZeroTest(): int {
        var a:int = 7
        var zero:int = 0
        var code:int = 0
        try {
            IO::writeln(a / zero)
        } on e is MathException {
            code = e.code
        }
        self::assertEquals(104, code)
        code = 0
        try {
            IO::writeln(a % zero)
        } on e is MathException {
            code = e.code
        }
        self::assertEquals(104, code)
        return 0
    }

    // INT_MIN / -1 boucle comme tout dépassement entier ; INT_MIN % -1 vaut 0.
    public method integerDivisionOverflowTest(): int {
        var lowest:int = -9223372036854775807 - 1
        var minus_one:int = -1
        self::assertEquals(lowest, lowest / minus_one)
        self::assertEquals(0, lowest % minus_one)
        self::assertEquals(-3, -7 / 2)
        self::assertEquals(-1, -7 % 2)
        return 0
    }

    // `-x` et `%` sur des flottants : opérations flottantes, pas entières
    // sur les bits (`-2.5` valait `-1.75`, `5.5 % 2.0` une valeur absurde).
    public method floatNegationAndModuloTest(): int {
        var g:float = -2.5
        var a:float = 5.5
        var b:float = -5.5
        var c:float = 7.25
        self::assertEquals("-2.5", g.toStr())
        self::assertEquals("-5", (g * 2.0).toStr())
        self::assertEquals("5", (-(g * 2.0)).toStr())
        self::assertEquals("1.5", (a % 2.0).toStr())
        self::assertEquals("-1.5", (b % 2.0).toStr())
        self::assertEquals("0.25", (c % 0.5).toStr())
        self::assertEquals(-7, -(7))
        return 0
    }
}
