architecture permissive

import ocara.UnitTest
import ocara.IO
import Circle from "../11_interfaces"
import Rectangle from "../11_interfaces"

class Test11Interfaces extends UnitTest {

    private property circle:Circle = use Circle(5.0)
    private property rectangle:Rectangle = use Rectangle(4.0, 6.0)

    public method areaTest(): int {
        var area2:float = self.circle.area()
        self::assertEquals(area2, 78.53975)

        var rect_area:float = self.rectangle.area()
        self::assertEquals(rect_area, 24.0)
        return 0
    }

    public method perimeterTest(): int {
        var perimeter:float = self.circle.perimeter()
        self::assertEquals(perimeter, 31.4159)

        var rect_perimeter:float = self.rectangle.perimeter()
        self::assertEquals(rect_perimeter, 20.0)
        return 0
    }

    public method describeTest(): int {
        self.circle.describe()
        self.rectangle.describe()
        return 0
    }

    public method printInfoTest(): int {
        self.circle.printInfo()
        self.rectangle.printInfo()
        return 0
    }

    public method mainTest(): int {
        return 0
    }
}

