// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 09_maps.oc
// ─────────────────────────────────────────────────────────────────────────────

architecture permissive

import ocara.UnitTest
import ocara.IO
import ocara.Map
import ocara.Array

class Test09Maps extends UnitTest {

    public method mapLiteralTest(): int {
        var config:map<string, string> = {
            "lang": "fr",
            "theme": "dark"
        }

        self::assertEquals("fr", config["lang"])
        self::assertEquals("dark", config["theme"])
        return 0
    }

    public method mapUpdateTest(): int {
        var prices:map<string, int> = {
            "pomme": 2
        }
        self::assertEquals(2, prices["pomme"])

        prices["pomme"] = 3
        self::assertEquals(3, prices["pomme"])
        return 0
    }

    public method mapIterationTest(): int {
        var data:map<string, int> = {
            "a": 1,
            "b": 2
        }

        var sum:int = 0
        for k has v in data {
            sum = sum + v
        }
        self::assertEquals(3, sum)
        return 0
    }

    public method mainTest(): int {
        // Reproduit le comportement de main() - version simplifiée
        var ages:map<string, int> = {
            "Alice": 30,
            "Bob":   25,
            "Carol": 35
        }
        self::assertEquals(30, ages["Alice"])
        self::assertEquals(25, ages["Bob"])

        var age_count:int = 0
        for nom has age in ages {
            age_count = age_count + 1
        }
        self::assertEquals(3, age_count)

        var capitales:map<string, string> = {
            "France":    "Paris",
            "Allemagne": "Berlin",
            "Espagne":   "Madrid"
        }
        self::assertEquals("Paris", capitales["France"])
        self::assertEquals("Madrid", capitales["Espagne"])

        var codes:map<int, string> = {
            200: "OK",
            404: "Not Found",
            500: "Server Error"
        }
        self::assertEquals("OK", codes[200])
        self::assertEquals("Not Found", codes[404])

        return 0
    }
}
