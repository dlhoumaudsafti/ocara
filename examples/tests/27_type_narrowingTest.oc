architecture permissive

import ocara.UnitTest

class Test27TypeNarrowing extends UnitTest {

    public method isNullTest(): int {
        var val:int|string|null = null
        self::assertTrue(val is null)
        self::assertFalse(val is int)
        self::assertFalse(val is string)
        return 0
    }

    public method isIntTest(): int {
        var val:int|string|null = 42
        self::assertFalse(val is null)
        self::assertTrue(val is int)
        self::assertFalse(val is string)
        return 0
    }

    public method isStringTest(): int {
        var val:int|string|null = "test"
        self::assertFalse(val is null)
        self::assertFalse(val is int)
        self::assertTrue(val is string)
        return 0
    }

    public method formatValueTest(): int {
        self::assertEquals("(null)", formatValue(null))

        var i:int|string|null = 42
        self::assertEquals("entier", formatValue(i))

        var s:int|string|null = "hello"
        self::assertEquals("chaîne", formatValue(s))

        return 0
    }

    public method mainTest(): int {
        var val_null:int|string|null = null
        self::assertTrue(val_null is null)
        self::assertEquals("(null)", formatValue(val_null))

        var val_int:int|string|null = 42
        self::assertTrue(val_int is int)
        self::assertEquals("entier", formatValue(val_int))

        var val_str:int|string|null = "test"
        self::assertTrue(val_str is string)
        self::assertEquals("chaîne", formatValue(val_str))

        return 0
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 27_type_narrowing.oc
// ─────────────────────────────────────────────────────────────────────────────


function formatValue(val:int|string|null): string {
    if val is null {
        return "(null)"
    }
    if val is int {
        return "entier"
    }
    if val is string {
        return "chaîne"
    }
    return "inconnu"
}

