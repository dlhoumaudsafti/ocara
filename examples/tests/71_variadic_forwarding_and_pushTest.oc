architecture permissive

import ocara.UnitTest
import ocara.Array

// docs/roadmap.d/langage-variadic-element-kinds.md et
// docs/roadmap.d/memoire-array-push-large-int-boxed.md — valeurs choisies
// au-dessus de PTR_THRESHOLD (65536) : un scalaire boxé relu brut (ou
// l'inverse) y donnait une adresse au lieu de la valeur.
class Test71VariadicForwardingAndPush extends UnitTest {

    public method forwardVariadicTest(): int {
        self::assertEquals(30, forwardSum(10, 20))
        self::assertEquals(0, forwardSum())
        self::assertEquals(9000000001, forwardSum(9000000000, 1))
        return 0
    }

    public method variadicOfArraysTest(): int {
        var a:array<int> = [1, 2, 3]
        var b:array<int> = [4, 5]
        self::assertEquals(5, totalLen(a, b))
        return 0
    }

    public method variadicOfFunctionsTest(): int {
        self::assertEquals(30, applyAll(5, doubleIt, tripleIt))
        return 0
    }

    public method variadicInstanceMethodTest(): int {
        var c:Counter = use Counter()
        self::assertEquals(6, c.add(1, 2, 3))
        self::assertEquals(0, c.add())
        return 0
    }

    public method pushLargeIntTest(): int {
        var arr:array<int> = [1]
        Array::push(arr, 7777777)
        arr.push(6666666)
        Array::set(arr, 0, 9999999)
        self::assertEquals(9999999, arr[0])
        self::assertEquals(7777777, arr[1])
        self::assertEquals(6666666, arr[2])
        return 0
    }

    public method pushFloatBoolAndMapTest(): int {
        var floats:array<float> = [0.5]
        floats.push(2.25)
        self::assertEquals(2.75, floats[0] + floats[1])
        var flags:array<bool> = [true]
        flags.push(false)
        self::assertFalse(flags[1])
        var m:map<string, int> = {"a": 1}
        m.set("b", 8888888)
        self::assertEquals(8888888, m["b"])
        return 0
    }

    public method pushIntoMixedStillBoxedTest(): int {
        var mix:array<mixed> = [1]
        mix.push(7777777)
        mix.push(1.5)
        self::assertEquals(7777777, mix[1])
        self::assertEquals(1.5, mix[2])
        return 0
    }
}

class Counter {
    public method add(values:variadic<int>): int {
        var total:int = 0
        for v in values {
            total = total + v
        }
        return total
    }
}

function sumAll(nums:variadic<int>): int {
    var total:int = 0
    for n in nums {
        total = total + n
    }
    return total
}

// Transmission d'un variadic à un autre : `nums` est passé tel quel.
function forwardSum(nums:variadic<int>): int {
    return sumAll(nums)
}

function totalLen(arrays:variadic<array<int>>): int {
    var count:int = 0
    for arr in arrays {
        count = count + Array::len(arr)
    }
    return count
}

function applyAll(val:int, funcs:variadic<Function<int(int)>>): int {
    var result:int = val
    for f in funcs {
        result = f(result)
    }
    return result
}

function doubleIt(x:int): int { return x * 2 }
function tripleIt(x:int): int { return x * 3 }
