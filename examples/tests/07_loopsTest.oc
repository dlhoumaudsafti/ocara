// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 07_loops.oc
// ─────────────────────────────────────────────────────────────────────────────

architecture permissive

import ocara.UnitTest

class Test07Loops extends UnitTest {

    public method whileLoopTest(): int {
        var sum:int = 0
        var i:int = 1
        while i smaller or equal 5 {
            sum = sum + i
            i = i + 1
        }
        self::assertEquals(15, sum)  // 1+2+3+4+5 = 15
        return 0
    }

    public method forRangeTest(): int {
        var sum:int = 0
        for i in 1 to 5 {
            sum = sum + i
        }
        self::assertEquals(15, sum)  // 1+2+3+4+5 = 15
        return 0
    }

    public method forArrayTest(): int {
        var numbers:array<int> = [10, 20, 30]
        var sum:int = 0
        for n in numbers {
            sum = sum + n
        }
        self::assertEquals(60, sum)
        return 0
    }

    public method nestedLoopTest(): int {
        var count:int = 0
        var i:int = 0
        while i smaller 3 {
            var j:int = 0
            while j smaller 2 {
                count = count + 1
                j = j + 1
            }
            i = i + 1
        }
        self::assertEquals(6, count)  // 3 * 2 = 6
        return 0
    }

    public method mainTest(): int {
        // Reproduit le comportement de main()
        var i:int = 0
        var counter:int = 0
        while i smaller 5 {
            counter = counter + 1
            i = i + 1
        }
        self::assertEquals(5, counter)

        // Test for in range
        var count_range:int = 0
        for j in 1 to 5 {
            count_range = count_range + 1
        }
        self::assertEquals(5, count_range)

        // Test sum
        var sum:int = 0
        for k in 1 to 10 {
            sum = sum + k
        }
        self::assertEquals(55, sum)

        // Test array iteration
        var fruits:array<string> = ["pomme", "banane", "cerise"]
        var fruit_count:int = 0
        for fruit in fruits {
            fruit_count = fruit_count + 1
        }
        self::assertEquals(3, fruit_count)

        // Test map iteration
        var scores:map<string, int> = {
            "Alice": 95,
            "Bob":   82,
            "Carol": 78
        }
        var entry_count:int = 0
        for nom has points in scores {
            entry_count = entry_count + 1
        }
        self::assertEquals(3, entry_count)

        // Test countdown
        var countdown:int = 5
        while countdown greater 0 {
            countdown = countdown - 1
        }
        self::assertEquals(0, countdown)

        return 0
    }

    // `for i in a until b` / `a to b` : boucle compteur, sans tableau
    // intermédiaire (mémoire constante) — mêmes bornes qu'avant.
    public method rangeLoopBoundsTest(): int {
        var total:int = 0
        for i in 1 to 3 {
            total = total + i
        }
        self::assertEquals(6, total)
        total = 0
        for i in 1 until 3 {
            total = total + i
        }
        self::assertEquals(3, total)
        var turns:int = 0
        for i in 5 until 2 {
            turns = turns + 1
        }
        self::assertEquals(0, turns)
        total = 0
        for i in -2 to 1 {
            total = total + i
        }
        self::assertEquals(-2, total)
        return 0
    }

    public method rangeLoopBreakContinueTest(): int {
        var total:int = 0
        for i in 0 until 100 {
            if i equal 2 {
                continue
            }
            if i equal 5 {
                break
            }
            total = total + i
        }
        self::assertEquals(8, total)
        return 0
    }

    public method rangeLoopInGeneratorTest(): int {
        var total:int = 0
        for v in tens(4) {
            total = total + v
        }
        self::assertEquals(60, total)
        return 0
    }

    // Plage utilisée comme valeur : un tableau (elle était boxée comme un
    // entier — SIGSEGV).
    public method rangeAsValueTest(): int {
        var r:array<int> = 2 to 4
        self::assertEquals(3, r.len())
        self::assertEquals(2, r[0])
        self::assertEquals(4, r[2])
        return 0
    }
}

function tens(n:int): message<int> {
    for i in 0 until n {
        emit i * 10
    }
}
