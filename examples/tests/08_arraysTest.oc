// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 08_arrays.oc
// ─────────────────────────────────────────────────────────────────────────────

architecture permissive

import ocara.UnitTest
import ocara.Array

class Test08Arrays extends UnitTest {

    public method arrayAccessTest(): int {
        var numbers:array<int> = [10, 20, 30, 40, 50]
        self::assertEquals(10, numbers[0])
        self::assertEquals(30, numbers[2])
        self::assertEquals(50, numbers[4])
        return 0
    }

    public method arrayIterationTest(): int {
        var numbers:array<int> = [10, 20, 30]
        var sum:int = 0
        for n in numbers {
            sum = sum + n
        }
        self::assertEquals(60, sum)
        return 0
    }

    public method stringArrayTest(): int {
        var jours:array<string> = ["lundi", "mardi", "mercredi"]
        self::assertEquals("lundi", jours[0])
        self::assertEquals("mercredi", jours[2])
        return 0
    }

    public method mixedArrayTest(): int {
        var vals:array<mixed> = [42, "hello", true]
        self::assertNotNull(vals[0])
        self::assertNotNull(vals[1])
        self::assertNotNull(vals[2])
        return 0
    }

    public method array2DTest(): int {
        var matrix:array<array<int>> = [[1, 2], [3, 4], [5, 6]]
        self::assertEquals(1, matrix[0][0])
        self::assertEquals(4, matrix[1][1])
        self::assertEquals(6, matrix[2][1])
        return 0
    }

    public method mainTest(): int {
        // Reproduit le comportement de main()
        var numbers:array<int> = [10, 20, 30, 40, 50]
        self::assertEquals(10, numbers[0])
        self::assertEquals(30, numbers[2])
        self::assertEquals(50, numbers[4])

        var count:int = 0
        for n in numbers {
            count = count + 1
        }
        self::assertEquals(5, count)

        var jours:array<string> = ["lundi", "mardi", "mercredi", "jeudi", "vendredi"]
        self::assertEquals("lundi", jours[0])
        self::assertEquals("vendredi", jours[4])

        var jour_count:int = 0
        for j in jours {
            jour_count = jour_count + 1
        }
        self::assertEquals(5, jour_count)

        var vals:array<mixed> = [42, "hello", true, 3.14]
        self::assertNotNull(vals[0])
        self::assertNotNull(vals[1])
        self::assertNotNull(vals[2])
        self::assertNotNull(vals[3])

        var matrix:array<array<int>> = [
            [1, 2, 3],
            [4, 5, 6],
            [7, 8, 9]
        ]
        var line0:string = Array::join(matrix[0], ", ")
        var line1:string = Array::join(matrix[1], ", ")
        var line2:string = Array::join(matrix[2], ", ")
        self::assertNotNull(line0)
        self::assertNotNull(line1)
        self::assertNotNull(line2)

        var empty:array<int> = []
        var empty_str:string = Array::join(empty, ", ")
        self::assertNotNull(empty_str)

        return 0
    }
}
