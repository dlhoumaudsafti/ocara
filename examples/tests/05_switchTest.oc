architecture permissive

import ocara.UnitTest
import ocara.IO

class Test_05_switch {
    
    public method switchIntTest(): int {
        var day:int = 2
        var result:string = ""
        
        switch day {
            1 {
                result = "lundi"
            }
            2 {
                result = "mardi"
            }
            3 {
                result = "mercredi"
            }
            default {
                result = "autre"
            }
        }
        
        UnitTest::assertEquals("mardi", result)
        return 0
    }
    
    public method switchStringTest(): int {
        var fruit:string = "pomme"
        var color:string = ""
        
        switch fruit {
            "pomme" {
                color = "rouge"
            }
            "banane" {
                color = "jaune"
            }
            "orange" {
                color = "orange"
            }
            default {
                color = "inconnu"
            }
        }
        
        UnitTest::assertEquals("rouge", color)
        return 0
    }
    
    public method switchDefaultTest(): int {
        var n:int = 999
        var result:string = ""
        
        switch n {
            1 {
                result = "un"
            }
            2 {
                result = "deux"
            }
            default {
                result = "autre"
            }
        }
        
        UnitTest::assertEquals("autre", result)
        return 0
    }
    
    public method httpStatusTest(): int {
        // Appelle httpStatus pour assurer la couverture
        httpStatus(200)
        httpStatus(201)
        httpStatus(400)
        httpStatus(401)
        httpStatus(404)
        httpStatus(500)
        httpStatus(999)
        return 0
    }
    
    public method dayTypeTest(): int {
        // Appelle dayType pour assurer la couverture
        dayType("lundi")
        dayType("mardi")
        dayType("samedi")
        dayType("dimanche")
        return 0
    }
    
    public method mainTest(): int {
        // Reproduit le comportement de main()
        httpStatus(200)
        httpStatus(404)
        httpStatus(999)
        dayType("lundi")
        dayType("samedi")
        
        var niveau:int = 3
        var result:string = ""
        switch niveau {
            1 {
                result = "Débutant"
            }
            2 {
                result = "Intermédiaire"
            }
            3 {
                result = "Avancé"
            }
            default {
                result = "Niveau inconnu"
            }
        }
        UnitTest::assertEquals("Avancé", result)
        return 0
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 05_switch.oc
// ─────────────────────────────────────────────────────────────────────────────


function httpStatus(code:int): void {
    switch code {
        200 {
            IO::writeln("200 OK")
        }
        201 {
            IO::writeln("201 Created")
        }
        400 {
            IO::writeln("400 Bad Request")
        }
        401 {
            IO::writeln("401 Unauthorized")
        }
        404 {
            IO::writeln("404 Not Found")
        }
        500 {
            IO::writeln("500 Internal Server Error")
        }
        default {
            IO::writeln("Code HTTP inconnu")
        }
    }
}

function dayType(day:string): void {
    switch day {
        "samedi" {
            IO::writeln("Week-end")
        }
        "dimanche" {
            IO::writeln("Week-end")
        }
        default {
            IO::writeln("Jour de semaine")
        }
    }
}

