architecture permissive

import ocara.UnitTest
import ocara.IO

class Test18ClassConsts extends UnitTest {

    public method directionConstTest(): int {
        self::assertEquals("N", Direction::NORTH)
        self::assertEquals("S", Direction::SOUTH)
        self::assertEquals("E", Direction::EAST)
        self::assertEquals("W", Direction::WEST)
        return 0
    }

    public method directionOppositeTest(): int {
        self::assertEquals("S", Direction::opposite("N"))
        self::assertEquals("N", Direction::opposite("S"))
        self::assertEquals("W", Direction::opposite("E"))
        self::assertEquals("E", Direction::opposite("W"))
        return 0
    }

    public method configTest(): int {
        self::assertEquals("1.0.0", Config::VERSION)
        self::assertEquals("Ocara App", Config::APP_NAME)
        self::assertEquals(3, Config::MAX_RETRY)
        self::assertTrue(Config::retryLimitOk(0))
        self::assertTrue(Config::retryLimitOk(2))
        self::assertFalse(Config::retryLimitOk(3))
        return 0
    }

    public method colorTest(): int {
        self::assertEquals("#FF0000", Color::RED)
        self::assertEquals("#00FF00", Color::GREEN)
        self::assertEquals("#0000FF", Color::BLUE)
        return 0
    }

    public method mainTest(): int {
        self::assertEquals("N", Direction::NORTH)
        self::assertEquals("S", Direction::opposite("N"))
        self::assertEquals("1.0.0", Config::VERSION)
        self::assertTrue(Config::retryLimitOk(0))
        self::assertEquals("#FF0000", Color::RED)
        return 0
    }
    public method oppositeTest(): int {
        self::assertEquals(Direction::SOUTH, Direction::opposite(Direction::NORTH))
        self::assertEquals(Direction::NORTH, Direction::opposite(Direction::SOUTH))
        self::assertEquals(Direction::WEST, Direction::opposite(Direction::EAST))
        self::assertEquals(Direction::EAST, Direction::opposite(Direction::WEST))
        self::assertEquals("?", Direction::opposite("X"))
        self::assertEquals("?", Direction::opposite(""))
        // involution
        self::assertEquals("N", Direction::opposite(Direction::opposite("N")))
        return 0
    }

    public method bannerTest(): int {
        Config::banner()
        self::assertEquals("Ocara App v1.0.0", Config::APP_NAME + " v" + Config::VERSION)
        return 0
    }

    public method retryLimitOkTest(): int {
        self::assertTrue(Config::retryLimitOk(0))
        self::assertTrue(Config::retryLimitOk(2))
        self::assertFalse(Config::retryLimitOk(3))
        self::assertFalse(Config::retryLimitOk(10))
        // boucle de main : le nombre de tentatives vaut MAX_RETRY
        var attempt:int = 0
        while Config::retryLimitOk(attempt) {
            attempt = attempt + 1
        }
        self::assertEquals(Config::MAX_RETRY, attempt)
        return 0
    }

    public method primaryColorsTest(): int {
        Color::primaryColors()
        self::assertEquals("#FF0000", Color::RED)
        self::assertEquals("#00FF00", Color::GREEN)
        self::assertEquals("#0000FF", Color::BLUE)
        return 0
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 18_class_consts.oc
// ─────────────────────────────────────────────────────────────────────────────


class Direction {
    public const NORTH:string = "N"
    public const SOUTH:string = "S"
    public const EAST:string = "E"
    public const WEST:string = "W"

    public static method opposite(dir:string): string {
        return match dir {
            "N" => "S"
            "S" => "N"
            "E" => "W"
            "W" => "E"
            default => "?"
        }
    }
}

class Config {
    public const VERSION:string = "1.0.0"
    public const APP_NAME:string = "Ocara App"
    public const MAX_RETRY:int = 3
    public const TIMEOUT_SEC:int = 30
    protected const SECRET:string = "super-secret"

    public static method banner(): void {
        IO::writeln(Config::APP_NAME + " v" + Config::VERSION)
    }

    public static method retryLimitOk(attempt:int): bool {
        return attempt smaller Config::MAX_RETRY
    }
}

class Color {
    public const RED:string = "#FF0000"
    public const GREEN:string = "#00FF00"
    public const BLUE:string = "#0000FF"
    public const WHITE:string = "#FFFFFF"
    public const BLACK:string = "#000000"

    public static method primaryColors(): void {
        IO::writeln("Rouge : " + Color::RED)
        IO::writeln("Vert  : " + Color::GREEN)
        IO::writeln("Bleu  : " + Color::BLUE)
    }
}

