import ocara.UnitTest
import ocara.IO

class Test_04_conditions extends UnitTest {
    
    public method simpleIfTest(): int {
        var outcome:int = 0
        var x:int = 10
        if x greater 5 {
            outcome = 1
        }
        self::assertEquals(1, outcome)
        return 0
    }
    
    public method ifElseTest(): int {
        var outcome:int = 0
        var x:int = 3
        if x greater 5 {
            outcome = 1
        } else {
            outcome = 2
        }
        self::assertEquals(2, outcome)
        return 0
    }
    
    public method elseifTest(): int {
        var score:int = 75
        var grade:string = ""
        
        if score greater or equal 90 {
            grade = "A"
        } elseif score greater or equal 80 {
            grade = "B"
        } elseif score greater or equal 70 {
            grade = "C"
        } else {
            grade = "F"
        }
        
        self::assertEquals("C", grade)
        return 0
    }
    
    public method nestedIfTest(): int {
        var x:int = 10
        var y:int = 20
        var outcome:int = 0
        
        if x greater 5 {
            if y greater 15 {
                outcome = 3
            }
        }
        
        self::assertEquals(3, outcome)
        return 0
    }

    public method ifStrictEqualityTest(): void {
        // Depuis Ocara v0.2.0, une comparaison entre types incompatibles
        // (ex: int et string) est une erreur de COMPILATION (voir E16),
        // plus un simple 'false' au runtime — impossible à exercer ici.
        // int et float restent la seule paire de types compatible entre eux
        // (widening numérique explicite) : 5 (int) et 5.0 (float) sont égaux.
        var outcome:bool = false
        var a:int = 5
        var b:float = 5.0
        if a equal b {
            outcome = true
        }

        self::assertTrue(outcome)

        var c:int = 6
        outcome = false
        if a not equal c {
            outcome = true
        }

        self::assertTrue(outcome)
    }
    
    public method note_to_mentionTest(): int {
        self::assertEquals("Excellent", note_to_mention(95))
        self::assertEquals("Excellent", note_to_mention(90))
        self::assertEquals("Bien", note_to_mention(85))
        self::assertEquals("Bien", note_to_mention(75))
        self::assertEquals("Passable", note_to_mention(65))
        self::assertEquals("Passable", note_to_mention(60))
        self::assertEquals("Insuffisant", note_to_mention(45))
        self::assertEquals("Insuffisant", note_to_mention(0))
        return 0
    }
    
    public method is_adultTest(): int {
        self::assertTrue(is_adult(18))
        self::assertTrue(is_adult(20))
        self::assertTrue(is_adult(100))
        self::assertFalse(is_adult(17))
        self::assertFalse(is_adult(0))
        return 0
    }
    
    public method mainTest(): int {
        // Reproduit le comportement de main() avec des assertions
        var x:int = 10
        self::assertTrue(x greater 0)
        
        var temperature:int = 25
        self::assertTrue(temperature greater or equal 25)
        
        var a:int = 5
        var b:int = 10
        self::assertTrue(a greater 0 and b greater 0)
        self::assertTrue(a greater 100 or b greater 5)
        self::assertTrue(not false)
        
        self::assertEquals("Bien", note_to_mention(85))
        self::assertEquals("Insuffisant", note_to_mention(45))
        
        self::assertTrue(is_adult(20))
        self::assertFalse(is_adult(15))
        
        return 0
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 04_conditions.oc
// ─────────────────────────────────────────────────────────────────────────────


function note_to_mention(note:int): string {
    if note greater or equal 90 {
        return "Excellent"
    } elseif note greater or equal 75 {
        return "Bien"
    } elseif note greater or equal 60 {
        return "Passable"
    } else {
        return "Insuffisant"
    }
}

function is_adult(age:int): bool {
    return age greater or equal 18
}

