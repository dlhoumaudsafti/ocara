architecture permissive

import ocara.UnitTest
import ocara.Convert

// docs/roadmap.d/stdlib-convert-instance-methods.md — chaque forme
// d'instance doit produire EXACTEMENT la même valeur que la méthode statique
// `Convert` qu'elle remplace.
class Test69ConvertInstanceMethods extends UnitTest {

    public method stringConversionsTest(): int {
        var s:string = "12"
        self::assertEquals(Convert::strToInt(s), s.toInt())
        self::assertEquals(Convert::strToFloat("3.5"), "3.5".toFloat())
        self::assertEquals(Convert::strToBool("true"), "true".toBool())
        self::assertEquals(3, "a,b,c".toArray(",").len())
        self::assertEquals("v", "k=v".toMap(";", "=")["k"])
        return 0
    }

    public method scalarConversionsTest(): int {
        var i:int = 7
        var f:float = -1.5
        var b:bool = false
        self::assertEquals(Convert::intToStr(i), i.toStr())
        self::assertEquals(Convert::intToFloat(i), i.toFloat())
        self::assertEquals(Convert::intToBool(i), i.toBool())
        self::assertEquals(Convert::floatToStr(f), f.toStr())
        self::assertEquals(Convert::floatToInt(f), f.toInt())
        self::assertEquals(Convert::floatToBool(f), f.toBool())
        self::assertEquals(Convert::boolToStr(b), b.toStr())
        self::assertEquals(Convert::boolToInt(b), b.toInt())
        self::assertEquals(Convert::boolToFloat(b), b.toFloat())
        return 0
    }

    public method containerConversionsTest(): int {
        var arr:array<string> = ["a=1", "b=2"]
        var m:map<string, string> = "k=v;x=y".toMap(";", "=")
        self::assertEquals(Convert::arrayToStr(arr, ","), arr.toStr(","))
        self::assertEquals(2, arr.toMap("=").size())
        self::assertEquals(Convert::mapToStr(m, "&", ":"), m.toStr("&", ":"))
        return 0
    }

    public method chainingTest(): int {
        self::assertEquals("41", "41".toInt().toStr())
        self::assertEquals(2, Convert::strToArray("x,y", ",").len())
        self::assertEquals("1+2", [1, 2].toStr(sep: "+"))
        return 0
    }

    // Scénario de `main` de l'exemple reproduit avec assertions.
    public method mainTest(): int {
        var raw:string = "41"
        var n:int = raw.toInt() + 1
        self::assertEquals(42, n)
        self::assertEquals(3.5, "3.5".toFloat())
        self::assertTrue("true".toBool())
        var parts:array<string> = "a,b,c".toArray(",")
        self::assertEquals(3, parts.len())
        self::assertEquals("c", parts[2])
        var conf:map<string, string> = "host=localhost;port=8080".toMap(";", "=")
        self::assertEquals("8080", conf["port"])
        self::assertEquals("localhost", conf["host"])

        var count:int = 7
        self::assertEquals("7", count.toStr())
        self::assertEquals(7.0, count.toFloat())
        self::assertTrue(count.toBool())
        var price:float = 2.75
        self::assertEquals(Convert::floatToStr(price), price.toStr())
        self::assertEquals(2, price.toInt())
        self::assertTrue(price.toBool())
        var flag:bool = true
        self::assertEquals("true", flag.toStr())
        self::assertEquals(1, flag.toInt())
        self::assertEquals(1.0, flag.toFloat())

        var ids:array<int> = [1, 2, 3]
        self::assertEquals("1-2-3", ids.toStr("-"))
        self::assertEquals(2, ["a=1", "b=2"].toMap("=").size())
        self::assertEquals(Convert::mapToStr(conf, "&", ":"), conf.toStr("&", ":"))

        self::assertEquals("41", raw.toInt().toStr().toInt().toStr())
        self::assertEquals(2, "x,y".toArray(",").len())
        self::assertEquals("1+2+3", ids.toStr(sep: "+"))
        return 0
    }
}
