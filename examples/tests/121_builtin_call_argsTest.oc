architecture permissive

import ocara.UnitTest
import ocara.UI
import ocara.File

// Arguments des builtins au type déclaré de leur paramètre :
// - méthode d'INSTANCE (`ui.set(id, prop, valeur:mixed)`) : un booléen ou un
//   flottant est boxé (l'index du paramètre était décalé de 1 comme pour le
//   sucre `arr.push(v)` : `false` relu `null`, `2.5` relu en bits bruts) ;
// - littéral `[…]` passé à `array<int>` (`File::writeBytes`) : entiers
//   bruts, pas `mixed` boxés (un `0` y devenait « pas un octet »).
class BuiltinCallArgsTest extends UnitTest {

    public method instanceMixedArgsTest(): int {
        const ui:UI = use UI("ui/args.oc.ui")
        const empty:string = ""
        ui.set("probe", "a", false)
        ui.set("probe", "b", not empty.empty())
        ui.set("probe", "c", 2.5)
        ui.set("probe", "d", 7)
        self::assertEquals(false, ui.get("probe", "a"))
        self::assertEquals(false, ui.get("probe", "b"))
        self::assertEquals(2.5, ui.get("probe", "c"))
        self::assertEquals(7, ui.get("probe", "d"))
        return 0
    }

    public method arrayLiteralArgTest(): int {
        File::writeBytes("/tmp/ocara-121-bytes.bin", [1, 0, 255])
        const bytes:array<int> = File::readBytes("/tmp/ocara-121-bytes.bin")
        self::assertEquals(3, bytes.len())
        self::assertEquals(0, bytes[1])
        self::assertEquals(255, bytes[2])
        File::remove("/tmp/ocara-121-bytes.bin")
        return 0
    }
}
