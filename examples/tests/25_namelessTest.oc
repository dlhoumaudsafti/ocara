architecture permissive

import ocara.UnitTest
import Counter from "25_nameless"

class Test_25_nameless {
    
    public method simpleClosureTest(): int {
        var called:int = 0
        var greet:Function<void()> = nameless(): void {
            called = called + 1
        }
        greet()
        UnitTest::assertEquals(1, called)
        return 0
    }
    
    public method closureWithParamTest(): int {
        var double:Function<int(int)> = nameless(x:int): int {
            return x * 2
        }
        UnitTest::assertEquals(14, double(7))
        UnitTest::assertEquals(10, apply(double, 5))
        return 0
    }
    
    public method captureScopeTest(): int {
        var step:int = 3
        var add_step:Function<int(int)> = nameless(x:int): int {
            return x + step
        }
        UnitTest::assertEquals(13, add_step(10))
        return 0
    }
    
    public method makeIncrementerTest(): int {
        scoped c:Counter = use Counter(0)
        var inc:Function<void()> = c.makeIncrementer(5)
        UnitTest::assertEquals(0, c.value)
        inc()
        UnitTest::assertEquals(5, c.value)
        inc()
        inc()
        UnitTest::assertEquals(15, c.value)
        return 0
    }

    public method makeMultiplierTest(): int {
        scoped d:Counter = use Counter(1)
        var by2:Function<void()> = d.makeMultiplier(2)
        var by3:Function<void()> = d.makeMultiplier(3)
        by2()
        UnitTest::assertEquals(2, d.value)
        by3()
        UnitTest::assertEquals(6, d.value)
        by2()
        UnitTest::assertEquals(12, d.value)
        return 0
    }

    public method mainTest(): int {
        var greet:Function<void()> = nameless(): void {
            // Simple closure
        }
        greet()
        
        var double:Function<int(int)> = nameless(x:int): int {
            return x * 2
        }
        UnitTest::assertEquals(14, double(7))
        UnitTest::assertEquals(10, apply(double, 5))
        
        var step:int = 3
        var add_step:Function<int(int)> = nameless(x:int): int {
            return x + step
        }
        UnitTest::assertEquals(13, add_step(10))
        
        return 0
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 25_nameless.oc
// ─────────────────────────────────────────────────────────────────────────────


function apply(f:Function<int(int)>, n:int): int {
    return f(n)
}

