// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 70_when.oc
// ─────────────────────────────────────────────────────────────────────────────

architecture permissive

import ocara.UnitTest
import ocara.System
import separator from "70_when"
import Platform from "70_when"

class Test70When extends UnitTest {

    public method separatorTest(): int {
        when System::OS is 'windows'
        self::assertEquals("\\", separator())
        when default
        self::assertEquals("/", separator())
        return 0
    }

    public method familyTest(): int {
        var p:Platform = use Platform()
        when System::OS is 'linux' or System::OS is 'android'
        self::assertEquals("unix", p.family)
        when System::OS is 'macos'
        self::assertEquals("darwin", p.family)
        when default
        self::assertEquals("autre", p.family)
        return 0
    }

    public method levelTest(): int {
        var p:Platform = use Platform()
        when System::BUILD is 'debug'
        self::assertEquals("debug", p.level())
        when default
        self::assertEquals(3, p.level())
        return 0
    }
}
