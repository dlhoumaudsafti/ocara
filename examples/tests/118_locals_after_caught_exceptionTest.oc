architecture permissive

import ocara.UnitTest
import ocara.Array
import ocara.File

// Locales de la fonction englobante intactes après une exception attrapée
// (levée par le runtime ou par `raise`), y compris dans un générateur —
// sous Windows, `longjmp` les perdait (voir runtime/src/lib.rs, `setjmp`).

class Counter {
    public property total:int = 0

    public method add(n:int): void {
        self.total = self.total + n
    }
}

class Test118LocalsAfterCaughtException extends UnitTest {

    public method runtimeExceptionKeepsLocalsTest(): int {
        var s:string = "abcdef"
        var arr:array<int> = [1, 2, 3]
        var n:int = 42
        var f:float = 1.5
        var code:int = 0
        try {
            File::read("/ocara_absent/inexistant.txt")
        } on e {
            code = e.code
        }
        self::assertEquals(101, code)
        self::assertEquals(6, s.len())
        self::assertEquals(3, arr[2])
        self::assertEquals(42, n)
        self::assertEquals(1.5, f)
        return 0
    }

    public method receiverStaysValidTest(): int {
        var c:Counter = use Counter()
        c.add(1)
        for i in 0 until 3 {
            try {
                raise `boom ${i}`
            } on e {
                c.add(10)
            }
            c.add(1)
        }
        self::assertEquals(34, c.total)
        return 0
    }

    public method generatorKeepsLocalsTest(): int {
        var values:array<int> = Array::fromMessage(localsAcrossRaise())
        self::assertEquals(2, Array::len(values))
        self::assertEquals(101, Array::get(values, 0))
        self::assertEquals(7, Array::get(values, 1))
        return 0
    }
}

function localsAcrossRaise(): message<int> {
    var base:int = 4
    var arr:array<int> = [1, 2, 3]
    try {
        File::read("/ocara_absent/inexistant.txt")
    } on e {
        emit e.code
    }
    emit base + arr[2]
}
