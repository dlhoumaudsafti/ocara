architecture permissive

import ocara.UnitTest

class Test_14_static_access {
    
    public method mathStaticTest(): int {
        UnitTest::assertEquals(5, Math::abs(-5))
        UnitTest::assertEquals(5, Math::abs(5))
        UnitTest::assertEquals(3, Math::min(5, 3))
        UnitTest::assertEquals(5, Math::max(5, 3))
        return 0
    }
    
    public method httpStatusTest(): int {
        UnitTest::assertEquals(200, HttpStatus::OK)
        UnitTest::assertEquals(404, HttpStatus::NOT_FOUND)
        UnitTest::assertTrue(HttpStatus::is_success(200))
        UnitTest::assertFalse(HttpStatus::is_success(404))
        return 0
    }
    
    public method mainTest(): int {
        UnitTest::assertEquals(5, Math::abs(-5))
        UnitTest::assertEquals(3, Math::min(5, 3))
        UnitTest::assertEquals(5, Math::max(5, 3))
        
        UnitTest::assertTrue(HttpStatus::is_success(200))
        UnitTest::assertFalse(HttpStatus::is_success(404))
        
        return 0
    }
    public method absTest(): int {
        UnitTest::assertEquals(42, Math::abs(-42))
        UnitTest::assertEquals(7, Math::abs(7))
        UnitTest::assertEquals(0, Math::abs(0))
        return 0
    }

    public method minTest(): int {
        UnitTest::assertEquals(3, Math::min(3, 8))
        UnitTest::assertEquals(3, Math::min(8, 3))
        UnitTest::assertEquals(-2, Math::min(-2, 4))
        UnitTest::assertEquals(5, Math::min(5, 5))
        return 0
    }

    public method maxTest(): int {
        UnitTest::assertEquals(8, Math::max(3, 8))
        UnitTest::assertEquals(8, Math::max(8, 3))
        UnitTest::assertEquals(4, Math::max(-2, 4))
        UnitTest::assertEquals(5, Math::max(5, 5))
        return 0
    }

    public method clampTest(): int {
        UnitTest::assertEquals(100, Math::clamp(150, 0, 100))
        UnitTest::assertEquals(0, Math::clamp(-5, 0, 100))
        UnitTest::assertEquals(50, Math::clamp(50, 0, 100))
        UnitTest::assertEquals(0, Math::clamp(0, 0, 100))
        UnitTest::assertEquals(100, Math::clamp(100, 0, 100))
        return 0
    }

    public method isSuccessTest(): int {
        UnitTest::assertTrue(HttpStatus::isSuccess(HttpStatus::OK))
        UnitTest::assertTrue(HttpStatus::isSuccess(HttpStatus::CREATED))
        UnitTest::assertTrue(HttpStatus::isSuccess(299))
        UnitTest::assertFalse(HttpStatus::isSuccess(199))
        UnitTest::assertFalse(HttpStatus::isSuccess(300))
        UnitTest::assertFalse(HttpStatus::isSuccess(HttpStatus::NOT_FOUND))
        UnitTest::assertFalse(HttpStatus::isSuccess(HttpStatus::INTERNAL_ERROR))
        return 0
    }

    public method isEmptyTest(): int {
        UnitTest::assertEquals("", StringUtils::EMPTY)
        UnitTest::assertTrue(StringUtils::isEmpty(""))
        UnitTest::assertFalse(StringUtils::isEmpty("hi"))
        UnitTest::assertFalse(StringUtils::isEmpty(" "))
        return 0
    }

    public method repeatTest(): int {
        UnitTest::assertEquals("*****", StringUtils::repeat("*", 5))
        UnitTest::assertEquals("abab", StringUtils::repeat("ab", 2))
        UnitTest::assertEquals("", StringUtils::repeat("x", 0))
        UnitTest::assertTrue(StringUtils::isEmpty(StringUtils::repeat("x", 0)))
        return 0
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 14_static_access.oc
// ─────────────────────────────────────────────────────────────────────────────


class Math {
    public const PI:float = 3.14159
    public const E:float = 2.71828

    public static method abs(n:int): int {
        if n smaller 0 {
            return -n
        }
        return n
    }

    public static method min(a:int, b:int): int {
        if a smaller b {
            return a
        }
        return b
    }

    public static method max(a:int, b:int): int {
        if a greater b {
            return a
        }
        return b
    }

    public static method clamp(value:int, low:int, high:int): int {
        if value smaller low {
            return low
        }
        if value greater high {
            return high
        }
        return value
    }
}

class HttpStatus {
    public const OK:int = 200
    public const CREATED:int = 201
    public const NOT_FOUND:int = 404
    public const INTERNAL_ERROR:int = 500

    public static method is_success(code:int): bool {
        return code greater or equal 200 and code smaller 300
    }

    public static method isSuccess(code:int): bool {
        return code greater or equal 200 and code smaller 300
    }
}

class StringUtils {
    public const EMPTY:string = ""

    public static method isEmpty(s:string): bool {
        return s equal StringUtils::EMPTY
    }

    public static method repeat(c:string, n:int): string {
        var result:string = ""
        for i in 0 until n {
            result = result + c
        }
        return result
    }
}

