architecture permissive

import ocara.UnitTest

// `for k has v in m` : la valeur est lue au type de valeur déclaré de la map.
// Elle était toujours déclarée `int` : `${v}` d'une `map<string, string>`
// ou d'une `map<string, mixed>` affichait une adresse.
class Test75MapLoopValueType extends UnitTest {

    public method stringValuesTest(): int {
        var capitales:map<string, string> = {"France": "Paris"}
        var seen:string = ""
        for pays has capitale in capitales {
            seen = `${pays} → ${capitale}`
        }
        self::assertEquals("France → Paris", seen)
        return 0
    }

    public method scalarValuesTest(): int {
        var ages:map<string, int> = {"b": 70000}
        var prix:map<string, float> = {"x": 1.5}
        var flags:map<string, bool> = {"off": false}
        var total:int = 0
        var double:float = 0.0
        var any_on:bool = true
        for k has n in ages { total = n + 1 }
        for k has p in prix { double = p * 2.0 }
        for k has f in flags { any_on = f }
        self::assertEquals(70001, total)
        self::assertEquals(3.0, double)
        self::assertFalse(any_on)
        return 0
    }

    public method mixedValuesTest(): int {
        var profil:map<string, mixed> = {"nom": "David", "actif": true, "score": 9.8}
        var out:string = ""
        for k has v in profil {
            out = out + `${k}=${v};`
        }
        self::assertEquals("nom=David;actif=true;score=9.8;", out)
        return 0
    }
}
