architecture permissive

import ocara.UnitTest

// Constante globale calculée (docs/variables.md) : évaluée une seule fois en
// tête de `main`, puis relue par chaque fonction — elle était réévaluée à
// chaque entrée de fonction (récursion infinie si la fonction appelée lisait
// ses constantes), puis interdite (E61, retiré).
function tick(): int { return 7 }
function label(): string { return `n°${SEVEN}` }
function names(): array<string> { return ["a", "b", "c"] }

const SEVEN:int = tick()
const LABEL:string = label()
const NAMES:array<string> = names()
const DOUBLE:int = SEVEN * 2

class Test87GlobalConstComputed extends UnitTest {

    public method callValueTest(): int {
        self::assertEquals(7, SEVEN)
        self::assertEquals(14, DOUBLE)
        return 0
    }

    public method readFromCalledFunctionTest(): int {
        self::assertEquals("n°7", LABEL)
        self::assertEquals("n°7", label())
        return 0
    }

    public method arrayValueTest(): int {
        self::assertEquals(3, NAMES.len())
        self::assertEquals("b", NAMES[1])
        return 0
    }
}
