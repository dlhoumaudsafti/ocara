architecture permissive

import ocara.UnitTest
import ocara.IO

class Test24FunctionTypes extends UnitTest {

    public method binaryOpTest(): int {
        var op:Function<int(int, int)> = add
        self::assertEquals(15, compute(10, 5, op))
        return 0
    }

    public method transformerTest(): int {
        var tr:Function<int(int)> = double
        self::assertEquals(20, transform(10, tr))
        return 0
    }

    public method addTest(): int {
        self::assertEquals(15, add(10, 5))
        self::assertEquals(-3, add(2, -5))
        return 0
    }

    public method subtractTest(): int {
        self::assertEquals(5, subtract(10, 5))
        self::assertEquals(-5, subtract(5, 10))
        return 0
    }

    public method multiplyTest(): int {
        self::assertEquals(50, multiply(10, 5))
        self::assertEquals(0, multiply(7, 0))
        return 0
    }

    public method doubleTest(): int {
        self::assertEquals(14, double(7))
        self::assertEquals(0, double(0))
        return 0
    }

    public method tripleTest(): int {
        self::assertEquals(21, triple(7))
        self::assertEquals(-9, triple(-3))
        return 0
    }

    public method computeTest(): int {
        var op_add:Function<int(int, int)> = add
        var op_sub:Function<int(int, int)> = subtract
        var op_mul:Function<int(int, int)> = multiply
        self::assertEquals(15, compute(10, 5, op_add))
        self::assertEquals(5, compute(10, 5, op_sub))
        self::assertEquals(50, compute(10, 5, op_mul))
        return 0
    }

    public method transformTest(): int {
        var t1:Function<int(int)> = double
        var t2:Function<int(int)> = triple
        self::assertEquals(14, transform(7, t1))
        self::assertEquals(21, transform(7, t2))
        return 0
    }

    public method repeatTest(): int {
        var count:int = 0
        var action:Function<void()> = nameless(): void {
            count = count + 1
        }
        repeat(5, action)
        self::assertEquals(5, count)
        repeat(0, action)
        self::assertEquals(5, count)
        return 0
    }

    public method printStarTest(): int {
        var action:Function<void()> = printStar
        repeat(3, action)
        printStar()
        self::assertTrue(true)
        return 0
    }

    public method mainTest(): int {
        var op1:Function<int(int, int)> = add
        self::assertEquals(15, compute(10, 5, op1))
        var op2:Function<int(int, int)> = subtract
        self::assertEquals(5, compute(10, 5, op2))
        var op3:Function<int(int, int)> = multiply
        self::assertEquals(50, compute(10, 5, op3))

        var t1:Function<int(int)> = double
        self::assertEquals(14, transform(7, t1))
        var t2:Function<int(int)> = triple
        self::assertEquals(21, transform(7, t2))

        return 0
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 24_function_types.oc
// ─────────────────────────────────────────────────────────────────────────────


function add(x:int, y:int): int {
    return x + y
}

function subtract(x:int, y:int): int {
    return x - y
}

function multiply(x:int, y:int): int {
    return x * y
}

function double(n:int): int {
    return n * 2
}

function triple(n:int): int {
    return n * 3
}

function compute(a:int, b:int, operation:Function<int(int, int)>): int {
    return operation(a, b)
}

function transform(value:int, transformer:Function<int(int)>): int {
    return transformer(value)
}

function repeat(times:int, action:Function<void()>): void {
    var i:int = 0
    while i smaller times {
        action()
        i = i + 1
    }
}

function printStar(): void {
    IO::write("*")
}
