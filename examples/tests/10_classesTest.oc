architecture permissive

import ocara.UnitTest

class Test10Classes extends UnitTest {

    public method displayTest(): int {
        var p:Point = use Point(3, 4)
        p.display()
        self::assertTrue(true)
        return 0
    }

    public method distanceFromOriginTest(): int {
        var p:Point = use Point(3, 4)
        self::assertEquals(25, p.distanceFromOrigin())
        return 0
    }

    public method depositTest(): int {
        var account:BankAccount = use BankAccount("Alice", 1000.0)
        var before:float = account.getBalance()
        account.deposit(500.0)
        var after:float = account.getBalance()
        self::assertTrue(after greater before)
        return 0
    }

    public method withdrawTest(): int {
        var account:BankAccount = use BankAccount("Alice", 1000.0)
        var before:float = account.getBalance()
        account.withdraw(200.0)
        var after:float = account.getBalance()
        self::assertTrue(after smaller before)
        return 0
    }

    public method showBalanceTest(): int {
        var account:BankAccount = use BankAccount("Alice", 1000.0)
        account.showBalance()
        self::assertTrue(true)
        return 0
    }

    public method isNegativeTest(): int {
        var account:BankAccount = use BankAccount("Alice", -100.0)
        self::assertTrue(account.checkNegative())
        var positive:BankAccount = use BankAccount("Bob", 100.0)
        self::assertFalse(positive.checkNegative())
        return 0
    }

    public method pointTest(): int {
        var p:Point = use Point(3, 4)
        self::assertEquals(3, p.x)
        self::assertEquals(4, p.y)
        self::assertEquals(25, p.distanceFromOrigin())
        return 0
    }

    public method bankAccountTest(): int {
        var account:BankAccount = use BankAccount("Alice", 1000.0)
        account.deposit(500.0)
        account.withdraw(200.0)
        account.withdraw(2000.0)
        return 0
    }

    public method mainTest(): int {
        var p:Point = use Point(3, 4)
        p.display()
        self::assertEquals(25, p.distanceFromOrigin())

        var account:BankAccount = use BankAccount("Alice", 1000.0)
        account.showBalance()
        account.deposit(500.0)
        account.withdraw(200.0)
        account.withdraw(2000.0)

        return 0
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 10_classes.oc
// ─────────────────────────────────────────────────────────────────────────────


class Point {
    public property x:int
    public property y:int

    init(x:int, y:int) {
        self.x = x
        self.y = y
    }

    public method display(): void {
    }

    public method distanceFromOrigin(): int {
        return self.x * self.x + self.y * self.y
    }
}

class BankAccount {
    private property owner:string
    private property balance:float

    init(owner:string, initial:float) {
        self.owner   = owner
        self.balance = initial
    }

    public method deposit(amount:float): void {
        self.balance = self.balance + amount
    }

    public method withdraw(amount:float): void {
        if amount greater self.balance {
        } else {
            self.balance = self.balance - amount
        }
    }

    public method showBalance(): void {
    }

    public method checkNegative(): bool {
        return self.balance smaller 0.0
    }

    public method getBalance(): float {
        return self.balance
    }
}

