architecture permissive

import ocara.UnitTest
import ocara.JSON
import ocara.YAML

// Feuilles brutes d'un conteneur concret ressemblant à un pointeur aligné
// (70000 = 8 × 8750) : `JSON::encode`/`YAML::encode` les lisaient comme un
// tag (SIGSEGV). La forme `kind | depth << 8` (static_leaf_shape) les
// convertit sans lecture de tag.
class Test74EncodeRawLeafShape extends UnitTest {

    public method jsonEncodeLargeIntArrayTest(): int {
        var a:array<int> = [70000, 0, 1]
        self::assertEquals("[70000,0,1]", JSON::encode(a))
        self::assertEquals("[70000,0,1]", a.encode())
        return 0
    }

    public method jsonEncodeNestedLargeIntTest(): int {
        var grid:array<array<int>> = [[70000, 0], [1, 2]]
        var by_key:map<string, int> = {"big": 70000}
        self::assertEquals("[[70000,0],[1,2]]", JSON::encode(grid))
        self::assertEquals("{\"big\":70000}", JSON::encode(by_key))
        return 0
    }

    public method yamlEncodeLargeIntArrayTest(): int {
        var a:array<int> = [70000, 0]
        self::assertEquals("- 70000\n- 0\n", YAML::encode(a))
        return 0
    }
}
