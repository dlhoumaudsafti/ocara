architecture permissive

import ocara.UnitTest

class Test_30_variadic {
    
    public method variadicIntTest(): int {
        UnitTest::assertEquals(0, sumInt())
        UnitTest::assertEquals(5, sumInt(5))
        UnitTest::assertEquals(15, sumInt(5, 10))
        UnitTest::assertEquals(30, sumInt(5, 10, 15))
        return 0
    }
    
    public method variadicStringTest(): int {
        UnitTest::assertEquals("", concatString())
        UnitTest::assertEquals("hello", concatString("hello"))
        UnitTest::assertEquals("helloworld", concatString("hello", "world"))
        return 0
    }
    
    public method variadicBoolTest(): int {
        UnitTest::assertTrue(allTrue())
        UnitTest::assertTrue(allTrue(true))
        UnitTest::assertTrue(allTrue(true, true))
        UnitTest::assertFalse(allTrue(true, false))
        UnitTest::assertFalse(allTrue(false, true))
        return 0
    }
    
    public method mainTest(): int {
        UnitTest::assertEquals(30, sumInt(5, 10, 15))
        UnitTest::assertEquals("helloworld", concatString("hello", "world"))
        UnitTest::assertTrue(allTrue(true, true))
        UnitTest::assertFalse(allTrue(true, false))
        return 0
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 30_variadic.oc
// ─────────────────────────────────────────────────────────────────────────────


function sumInt(nums:variadic<int>): int {
    var total:int = 0
    for n in nums {
        total = total + n
    }
    return total
}

function concatString(parts:variadic<string>): string {
    var result:string = ""
    for p in parts {
        result = result + p
    }
    return result
}

function allTrue(flags:variadic<bool>): bool {
    for f in flags {
        if not f {
            return false
        }
    }
    return true
}

