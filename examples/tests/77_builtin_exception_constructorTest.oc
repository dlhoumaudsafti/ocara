architecture permissive

import ocara.UnitTest
import ocara.Exception
import ocara.FileException

// Constructeur des exceptions builtin `(message:string, code:int = 0)` :
// `use Exception(...)`, `raise use FileException(...)` et `parent::init(...)`
// d'une sous-classe remplissent `message`/`code` (valaient `null`/`0`).
class Test77BuiltinExceptionConstructor extends UnitTest {

    public method directConstructionTest(): int {
        var e:Exception = use Exception("boom", 3)
        self::assertEquals("boom", e.message)
        self::assertEquals(3, e.code)
        self::assertEquals("", e.source)
        var f:FileException = use FileException("absent")
        self::assertEquals("absent", f.message)
        self::assertEquals(0, f.code)
        return 0
    }

    public method raisedBuiltinExceptionTest(): int {
        var message:string = ""
        var code:int = 0
        try {
            raise use FileException("disque plein", 28)
        } on e is FileException {
            message = e.message
            code = e.code
        }
        self::assertEquals("disque plein", message)
        self::assertEquals(28, code)
        return 0
    }

    public method parentInitTest(): int {
        var message:string = ""
        var code:int = 0
        try {
            raise use ParentInitError("via parent", 7)
        } on e is ParentInitError {
            message = e.message
            code = e.code
        }
        self::assertEquals("via parent", message)
        self::assertEquals(7, code)
        return 0
    }
}

class ParentInitError extends Exception {
    init(message:string, code:int) {
        parent::init(message, code)
    }
}
