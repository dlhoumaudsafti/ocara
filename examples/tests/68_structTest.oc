architecture permissive

import ocara.UnitTest
import ocara.Array
import UserDTO from "../68_struct"
import AdminDTO from "../68_struct"
import TeamDTO from "../68_struct"
import findUser from "../68_struct"

// docs/roadmap.d/langage-struct-value-type.md — constructeur généré depuis
// les champs (défauts compris, arguments nommés), héritage entre structs,
// struct nullable/imbriqué. Chaque test vérifie les VALEURS réellement
// stockées dans les champs.
class Test68Struct extends UnitTest {

    public method positionalWithDefaultsTest(): int {
        var u:UserDTO = use UserDTO(1, "David")
        self::assertEquals(1, u.id)
        self::assertEquals("David", u.name)
        self::assertEquals("john.doe@example.com", u.email)
        return 0
    }

    public method namedMiddleFieldOmittedTest(): int {
        var u:UserDTO = use UserDTO(email: "eve@example.com", id: 3)
        self::assertEquals("John", u.name)
        self::assertEquals("eve@example.com", u.email)
        return 0
    }

    public method inheritedFieldsFirstTest(): int {
        var admin:AdminDTO = use AdminDTO(4, "Root", "root@example.com", 9)
        self::assertEquals(4, admin.id)
        self::assertEquals("Root", admin.name)
        self::assertEquals(9, admin.level)
        var named:AdminDTO = use AdminDTO(id: 5)
        self::assertEquals(1, named.level)
        return 0
    }

    public method mutableFieldAndConstTest(): int {
        var u:UserDTO = use UserDTO(id: 6)
        u.name = "Changed"
        self::assertEquals("Changed", u.name)
        self::assertEquals("user", UserDTO::KIND)
        return 0
    }

    public method nestedStructsTest(): int {
        var a:UserDTO = use UserDTO(id: 7)
        var team:TeamDTO = use TeamDTO(label: "core", members: [a])
        self::assertEquals("core", team.label)
        self::assertEquals(1, Array::len(team.members))
        self::assertTrue(team.lead is null)
        return 0
    }

    // `findUser` : null pour id 0, sinon un UserDTO avec les défauts.
    public method findUserTest(): int {
        var missing:UserDTO|null = findUser(0)
        self::assertTrue(missing is null)
        var found:UserDTO|null = findUser(5)
        self::assertFalse(found is null)
        if found is UserDTO {
            self::assertEquals(5, found.id)
            self::assertEquals("John", found.name)
            self::assertEquals("john.doe@example.com", found.email)
        }
        return 0
    }

    // Scénario de `main` reproduit avec assertions.
    public method mainTest(): int {
        var a:UserDTO = use UserDTO(1, "David")
        self::assertEquals("1 David john.doe@example.com", `${a.id} ${a.name} ${a.email}`)
        var b:UserDTO = use UserDTO(id: 2)
        self::assertEquals("2 John john.doe@example.com", `${b.id} ${b.name} ${b.email}`)
        var c:UserDTO = use UserDTO(email: "eve@example.com", id: 3)
        self::assertEquals("3 John eve@example.com", `${c.id} ${c.name} ${c.email}`)
        var admin:AdminDTO = use AdminDTO(name: "Root", id: 4, level: 9)
        self::assertEquals("4 Root 9", `${admin.id} ${admin.name} ${admin.level}`)
        admin.name = "Admin"
        self::assertEquals("Admin user", `${admin.name} ${UserDTO::KIND}`)
        var team:TeamDTO = use TeamDTO(label: "core", members: [a, b], lead: c)
        self::assertEquals("core 2", `${team.label} ${Array::len(team.members)}`)
        self::assertFalse(team.lead is null)
        var missing:UserDTO|null = findUser(0)
        self::assertTrue(missing is null)
        return 0
    }
}
