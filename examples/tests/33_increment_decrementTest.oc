// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 33_increment_decrement.oc
// ─────────────────────────────────────────────────────────────────────────────

architecture permissive

import ocara.UnitTest
import Counter from "33_increment_decrement"

class Test33IncrementDecrement extends UnitTest {

    public method intPostfixPrefixTest(): int {
        var i:int = 5
        self::assertEquals(5, i++)
        self::assertEquals(6, i)
        self::assertEquals(7, ++i)
        self::assertEquals(7, i--)
        self::assertEquals(5, --i)
        return 0
    }

    public method floatIncrementTest(): int {
        var f:float = 1.5
        f++
        self::assertEquals(2.5, f)
        return 0
    }

    public method expressionPositionTest(): int {
        var acc:int = 0
        var j:int = 0
        while j smaller 5 {
            acc = acc + j++
        }
        self::assertEquals(10, acc)
        self::assertEquals(5, j)
        return 0
    }

    public method arrayElementTest(): int {
        var arr:array<int> = [10, 20, 30]
        arr[0]++
        arr[2]--
        self::assertEquals(11, arr[0])
        self::assertEquals(29, arr[2])
        return 0
    }

    public method propertyTest(): int {
        var c:Counter = use Counter(100)
        c.value++
        ++c.value
        self::assertEquals(102, c.value)
        return 0
    }

    public method mapValueTest(): int {
        var scores:map<string, int> = {"alice": 10}
        scores["alice"]++
        self::assertEquals(11, scores["alice"])
        return 0
    }
}
