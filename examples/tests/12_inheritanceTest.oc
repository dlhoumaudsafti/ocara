architecture permissive

import ocara.UnitTest
import ocara.IO

class Test12Inheritance extends UnitTest {

    public method dogTest(): int {
        var dog:Dog = use Dog("Rex", "Labrador")
        self::assertEquals("Rex", dog.getName())
        self::assertEquals("Labrador", dog.getBreed())
        dog.log("test")
        return 0
    }

    public method catTest(): int {
        var cat:Cat = use Cat("Mimi", true)
        self::assertEquals("Mimi", cat.getName())
        self::assertTrue(cat.isIndoor())
        return 0
    }

    public method mainTest(): int {
        var dog:Dog = use Dog("Rex", "Labrador")
        self::assertEquals("Rex", dog.getName())

        var cat:Cat = use Cat("Mimi", true)
        self::assertEquals("Mimi", cat.getName())

        return 0
    }
    public method speakTest(): int {
        var dog:Dog = use Dog("Rex", "Labrador")
        var cat:Cat = use Cat("Mimi", true)
        // parent::init a bien fixé le cri propre à chaque sous-classe
        self::assertEquals("Woof", dog.getSound())
        self::assertEquals("Meow", cat.getSound())
        dog.speak()
        cat.speak()
        // speak() n'altère pas l'état
        self::assertEquals("Rex", dog.getName())
        self::assertEquals("Mimi", cat.getName())
        return 0
    }

    public method describeTest(): int {
        var animal:Animal = use Animal("Generic", "...")
        var dog:Dog = use Dog("Rex", "Labrador")
        var outdoor:Cat = use Cat("Tom", false)
        var indoor:Cat = use Cat("Mimi", true)
        animal.describe()
        dog.describe()
        outdoor.describe()
        indoor.describe()
        self::assertEquals("Generic", animal.getName())
        self::assertEquals("Labrador", dog.getBreed())
        self::assertFalse(outdoor.isIndoor())
        self::assertTrue(indoor.isIndoor())
        // dispatch via une variable typée par la classe parente
        var base:Animal = dog
        base.describe()
        self::assertEquals("Rex", base.getName())
        return 0
    }

    public method fetchTest(): int {
        var dog:Dog = use Dog("Rex", "Labrador")
        dog.fetch()
        self::assertEquals("Rex", dog.getName())
        self::assertEquals("Labrador", dog.getBreed())
        return 0
    }

    public method logTest(): int {
        var dog:Dog = use Dog("Rex", "Labrador")
        dog.log("promenade effectuée")
        // utilisable via l'interface Loggable
        var logger:Loggable = dog
        logger.log("via interface")
        self::assertEquals("Rex", dog.getName())
        return 0
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 12_inheritance.oc
// ─────────────────────────────────────────────────────────────────────────────


interface Loggable {
    method log(msg:string): void
}

class Animal {
    protected property name:string
    protected property sound:string

    init(name:string, sound:string) {
        self.name  = name
        self.sound = sound
    }

    public method getName(): string {
        return self.name
    }

    public method getSound(): string {
        return self.sound
    }

    public method speak(): void {
        IO::writeln(self.name + " dit : " + self.sound)
    }

    public method describe(): void {
        IO::writeln("Animal : " + self.name)
    }
}

class Dog extends Animal implements Loggable {
    private property breed:string

    init(name:string, breed:string) {
        parent::init(name, "Woof")
        self.breed = breed
    }

    public method getBreed(): string {
        return self.breed
    }

    public method describe(): void {
        IO::writeln("Chien : " + self.name + " (" + self.breed + ")")
    }

    public method fetch(): void {
        IO::writeln(self.name + " rapporte la balle !")
    }

    public method log(msg:string): void {
        IO::writeln("[Dog:" + self.name + "] " + msg)
    }
}

class Cat extends Animal {
    private property indoor:bool

    init(name:string, indoor:bool) {
        parent::init(name, "Meow")
        self.indoor = indoor
    }

    public method isIndoor(): bool {
        return self.indoor
    }

    public method describe(): void {
        scoped type:string = match self.indoor {
            true  => "d'intérieur"
            false => "d'extérieur"
            default => "inconnu"
        }
        IO::writeln("Chat " + type + " : " + self.name)
    }
}

