architecture permissive

import ocara.UnitTest

class Test28Enum extends UnitTest {

    public method enumAutoValuesTest(): int {
        self::assertEquals(0, Direction::North)
        self::assertEquals(1, Direction::East)
        self::assertEquals(2, Direction::South)
        self::assertEquals(3, Direction::West)
        return 0
    }

    public method enumExplicitValuesTest(): int {
        self::assertEquals(200, HttpStatus::Ok)
        self::assertEquals(201, HttpStatus::Created)
        self::assertEquals(404, HttpStatus::NotFound)
        self::assertEquals(500, HttpStatus::Error)
        return 0
    }

    public method enumSwitchTest(): int {
        self::assertEquals("Nord", directionName(Direction::North))
        self::assertEquals("Sud", directionName(Direction::South))
        return 0
    }

    public method enumComparisonTest(): int {
        var s:int = HttpStatus::Error
        self::assertTrue(isError(s))
        self::assertTrue(s equal HttpStatus::Error)
        return 0
    }

    public method directionNameTest(): int {
        self::assertEquals("Nord", directionName(Direction::North))
        self::assertEquals("Est", directionName(Direction::East))
        self::assertEquals("Sud", directionName(Direction::South))
        self::assertEquals("Ouest", directionName(Direction::West))
        self::assertEquals("Inconnu", directionName(42))
        return 0
    }

    public method httpLabelTest(): int {
        self::assertEquals("OK", httpLabel(HttpStatus::Ok))
        self::assertEquals("Created", httpLabel(HttpStatus::Created))
        self::assertEquals("Not Found", httpLabel(HttpStatus::NotFound))
        self::assertEquals("Internal Server Error", httpLabel(HttpStatus::Error))
        self::assertEquals("?", httpLabel(418))
        return 0
    }

    public method isErrorTest(): int {
        self::assertTrue(isError(HttpStatus::Error))
        self::assertTrue(isError(500))
        self::assertFalse(isError(HttpStatus::Ok))
        self::assertFalse(isError(HttpStatus::NotFound))
        return 0
    }

    public method mainTest(): int {
        self::assertEquals(0, Direction::North)
        self::assertEquals(200, HttpStatus::Ok)
        self::assertEquals("Nord", directionName(Direction::North))
        self::assertEquals("Sud", directionName(Direction::South))
        self::assertEquals("Not Found", httpLabel(HttpStatus::NotFound))
        self::assertTrue(isError(HttpStatus::Error))
        return 0
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 28_enum.oc
// ─────────────────────────────────────────────────────────────────────────────


enum Direction {
    North,
    East,
    South,
    West
}

enum HttpStatus {
    Ok = 200,
    Created = 201,
    NotFound = 404,
    Error = 500
}

function directionName(d:int): string {
    switch d {
        0 { return "Nord" }
        1 { return "Est" }
        2 { return "Sud" }
        3 { return "Ouest" }
        default { return "Inconnu" }
    }
}

function httpLabel(code:int): string {
    switch code {
        200 { return "OK" }
        201 { return "Created" }
        404 { return "Not Found" }
        500 { return "Internal Server Error" }
        default { return "?" }
    }
}

function isError(status:int): bool {
    return status equal HttpStatus::Error
}

