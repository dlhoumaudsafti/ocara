// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 22_union_types.oc
// ─────────────────────────────────────────────────────────────────────────────

architecture permissive

import ocara.UnitTest
import ocara.IO

class Test22UnionTypes extends UnitTest {

    public method unionIntOrStringTest(): int {
        var value:int|string = 42
        self::assertTrue(value is int)
        self::assertFalse(value is string)
        return 0
    }

    public method unionNullableTest(): int {
        var name:string|null = "Alice"
        self::assertFalse(name is null)
        self::assertTrue(name is string)
        return 0
    }

    public method unionNullTest(): int {
        var empty:string|null = null
        self::assertTrue(empty is null)
        return 0
    }

    public method unionMultipleTypesTest(): int {
        var val:int|string|bool = true
        self::assertNotNull(val)
        return 0
    }

    public method titleTest(): int {
        var adult:User = use User("Alice", 30)
        var t1:string|null = adult.title()
        self::assertNotNull(t1)

        var minor:User = use User("Bob", 15)
        var t2:string|null = minor.title()
        self::assertNull(t2)

        return 0
    }

    public method ageGroupTest(): int {
        var senior:User = use User("Senior", 65)
        var g1:string|null = senior.ageGroup()
        self::assertNotNull(g1)

        var adult:User = use User("Adult", 30)
        var g2:string|null = adult.ageGroup()
        self::assertNotNull(g2)

        var minor:User = use User("Minor", 10)
        var g3:string|null = minor.ageGroup()
        self::assertNotNull(g3)

        return 0
    }

    // Membre lu à travers un champ `T|null` non vérifié : type déclaré du
    // champ (un grand entier était lu comme un pointeur — SIGSEGV), méthode
    // de la bonne classe.
    public method unionFieldAccessTest(): int {
        var a:Link = use Link(1000005)
        a.next = use Link(1000005)
        self::assertTrue(a.next.value equal a.value)
        self::assertEquals(1000006, a.next.value + 1)
        self::assertEquals(2000010, a.next.twice())
        return 0
    }

    // Receveur `null` : exception rattrapable au lieu d'un SIGSEGV.
    public method nullReceiverTest(): int {
        var a:Link = use Link(1)
        var message:string = ""
        try {
            IO::writeln(a.next.value)
        } on e is Exception {
            message = e.message
        }
        self::assertEquals("Cannot access 'value' on null", message)
        return 0
    }
}

class User {
    public property name:string
    public property age:int

    init(name:string, age:int) {
        self.name = name
        self.age  = age
    }

    public method title(): string|null {
        if self.age greater or equal 18 {
            return "M."
        }
        return null
    }

    public method ageGroup(): string|null {
        if self.age greater or equal 60 {
            return "senior"
        }
        if self.age greater or equal 18 {
            return "adulte"
        }
        if self.age greater or equal 0 {
            return "mineur"
        }
        return null
    }
}

class Link {
    public property value:int
    public property next:Link|null = null

    init(value:int) {
        self.value = value
    }

    public method twice(): int {
        return self.value * 2
    }
}
