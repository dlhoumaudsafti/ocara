architecture permissive

import ocara.UnitTest
import ocara.Array

// Un appel à une méthode d'instance ou statique (`obj.method(...)`/
// `Class::method(...)`) ne boxait aucun argument F64/Bool/I64 vers un
// paramètre `mixed` (contrairement à un appel de fonction libre ou un
// constructeur, qui le faisaient déjà) — un `float`/`bool` restait alors
// indistinguable d'un entier au runtime, et un grand entier risquait le même
// SEGFAULT documenté dans docs/roadmap.d/memoire-fiabilite-runtime-bas-niveau.md.
// Découvert en creusant ce chantier (`b.show(3.5)` avec `show(v:mixed)`
// corrompait déjà silencieusement `v`).
//
// NOTE assertEquals : compare par égalité BRUTE de i64 (bug pré-existant,
// documenté ce même chantier) — on utilise `equal`/`assertTrue` pour toute
// valeur `mixed`, `assertEquals` seulement pour des petits entiers concrets.

class Test38MixedCallArgBoxing extends UnitTest {

    // Méthode D'INSTANCE — float
    public method instanceMethodFloatTest(): int {
        var b:Box = use Box(0)
        self::assertTrue(b.acceptFloat(3.5))
        return 0
    }

    // Méthode D'INSTANCE — bool
    public method instanceMethodBoolTest(): int {
        var b:Box = use Box(0)
        self::assertTrue(b.acceptBool(true))
        self::assertFalse(b.acceptBool(false))
        return 0
    }

    // Méthode D'INSTANCE — grand entier (le cas qui plantait potentiellement,
    // voir memoire-fiabilite-runtime-bas-niveau.md)
    public method instanceMethodLargeIntTest(): int {
        var b:Box = use Box(0)
        self::assertTrue(b.acceptInt(1000000))
        return 0
    }

    // Méthode STATIQUE (classe utilisateur) — float/bool/int
    public method staticMethodTest(): int {
        self::assertTrue(StaticBox::acceptFloat(2.5))
        self::assertTrue(StaticBox::acceptBool(true))
        self::assertTrue(StaticBox::acceptInt(2000000))
        return 0
    }

    // Constructeur — déjà correct avant ce chantier, revérifié après le
    // refactor qui factorise sa logique de boxing avec les méthodes.
    public method constructorTest(): int {
        var b:Box = use Box(7.5)
        self::assertTrue(b.storedFloatIsFloat())
        return 0
    }

    // Méthode STATIQUE builtin (Array::push, param `mixed`) — déjà vérifiée
    // manuellement pendant ce chantier, testée ici pour la régression.
    public method builtinStaticMethodTest(): int {
        var arr:array<mixed> = []
        Array::push(arr, 4.5)
        Array::push(arr, 3000000)
        var first:mixed = arr[0]
        var second:mixed = arr[1]
        self::assertTrue(first is float)
        self::assertTrue(second is int)
        self::assertTrue(second equal 3000000)
        return 0
    }

    // BUG CORRIGÉ (voir docs/roadmap.d/langage-array-get-display-bug.md) :
    // pour un appel EN SUCRE (`arr.get(idx)`) vers un builtin à double forme
    // (Array/Map/...), l'argument `idx` recevait le type du RÉCEPTEUR (`arr`,
    // toujours `mixed`/Ptr dans la table de signatures des builtins, qui
    // décrit la forme STATIQUE où le récepteur est un argument explicite) au
    // lieu de son propre type déclaré (`int`) — décalage d'index d'une
    // position, invisible tant que `box_int_if_needed` ne boxait jamais un
    // entier en dessous du seuil pointeur. `idx == 0` boxé à tort devenait un
    // pointeur arbitraire transmis à `__array_get`, hors-borne : `null`
    // silencieux ici (élément concret), SEGFAULT si le résultat est déréférencé
    // sans vérification (voir sugarGetIndexZeroOnObjectArrayTest ci-dessous,
    // reproduction exacte du crash confirmé sur
    // examples/tests/35_var_auto_freeTest.oc). Corrigé par
    // `param_type_for_sugar_call_arg` (src/lower/expr.d/helpers.rs).
    public method sugarGetIndexZeroNotCorruptedTest(): int {
        var arr:array<int> = [10, 20, 30]
        var first:int = arr.get(0)
        self::assertEquals(10, first)
        return 0
    }

    // Même bug, avec la conséquence réellement observée (SEGFAULT) : un objet
    // récupéré comme `null` par erreur puis son champ lu directement
    // (`GetField`, sans vérification de nullité).
    public method sugarGetIndexZeroOnObjectArrayTest(): int {
        var acc:array<Cell> = []
        var i:int = 0
        while i smaller 5 {
            var c:Cell = use Cell(i)
            acc.push(c)
            i = i + 1
        }
        var first:Cell = acc.get(0)
        self::assertEquals(0, first.n)
        var last:Cell = acc.get(4)
        self::assertEquals(4, last.n)
        return 0
    }

    // Même décalage d'index, sur un builtin à 2 arguments explicites
    // (`arr.slice(from, to)`) : `from == 0` (premier argument sucré) se
    // voyait attribuer le type du récepteur (position 0 de la signature
    // statique) au lieu de son propre type (`int`, position 1) — même risque
    // de corruption que pour `get`.
    public method sugarSliceFromZeroNotCorruptedTest(): int {
        var arr:array<int> = [10, 20, 30, 40]
        var sub:array<int> = arr.slice(0, 2)
        self::assertEquals(2, Array::len(sub))
        self::assertEquals(10, sub.get(0))
        self::assertEquals(20, sub.get(1))
        return 0
    }
}

class Box {
    public property stored:map<string, mixed>

    init(v:mixed) {
        self.stored = {"v": v}
    }

    public method acceptFloat(v:mixed): bool {
        return v is float
    }

    public method acceptBool(v:mixed): bool {
        return v equal true
    }

    public method acceptInt(v:mixed): bool {
        return v is int
    }

    public method storedFloatIsFloat(): bool {
        var v:mixed = self.stored["v"]
        return v is float
    }
}

class StaticBox {
    public static method acceptFloat(v:mixed): bool {
        return v is float
    }

    public static method acceptBool(v:mixed): bool {
        return v equal true
    }

    public static method acceptInt(v:mixed): bool {
        return v is int
    }
}

// Classe simple à propriété concrète (`int`, jamais `mixed`) — sert
// uniquement à observer le SEGFAULT (accès de champ sans vérification de
// nullité) provoqué par l'ancien décalage d'index sur `Array::get` sucré.
class Cell {
    public property n:int
    init(n:int) { self.n = n }
}
