import ocara.UnitTest
import ocara.Array

// Opérateurs d'incrémentation/décrémentation — voir
// docs/roadmap.d/langage-increment-decrement.md. Sémantique complète façon C :
// `i++`/`i--` (suffixe) valent l'ANCIENNE valeur, `++i`/`--i` (préfixe) valent
// la NOUVELLE — utilisables comme expressions (`x = i++`, `foo(i++)`...), pas
// seulement comme instructions.

class Test_45_increment_decrement {

    // Suffixe : la valeur retournée est l'ANCIENNE, la variable avance quand même.
    public method postIncReturnsOldValueTest(): int {
        var i:int = 5
        UnitTest::assertEquals(5, i++)
        UnitTest::assertEquals(6, i)
        return 0
    }

    public method postDecReturnsOldValueTest(): int {
        var i:int = 5
        UnitTest::assertEquals(5, i--)
        UnitTest::assertEquals(4, i)
        return 0
    }

    // Préfixe : la valeur retournée est la NOUVELLE.
    public method preIncReturnsNewValueTest(): int {
        var i:int = 5
        UnitTest::assertEquals(6, ++i)
        UnitTest::assertEquals(6, i)
        return 0
    }

    public method preDecReturnsNewValueTest(): int {
        var i:int = 5
        UnitTest::assertEquals(4, --i)
        UnitTest::assertEquals(4, i)
        return 0
    }

    // Sur un float — même sémantique, pas de résultat que sur int.
    public method floatIncDecTest(): int {
        var f:float = 1.5
        UnitTest::assertEquals(1.5, f++)
        UnitTest::assertEquals(2.5, f)
        UnitTest::assertEquals(1.5, --f)
        UnitTest::assertEquals(1.5, f)
        return 0
    }

    // Utilisable comme sous-expression (pas seulement comme instruction) :
    // affectation, argument, condition.
    public method usableAsExpressionTest(): int {
        var i:int = 0
        var x:int = i++
        UnitTest::assertEquals(0, x)
        UnitTest::assertEquals(1, i)

        var j:int = 0
        var acc:int = 0
        while j smaller 4 {
            acc = acc + j++
        }
        UnitTest::assertEquals(6, acc)  // 0+1+2+3
        return 0
    }

    // Cible = élément de tableau (`arr[i]++`).
    public method arrayIndexTargetTest(): int {
        var arr:array<int> = [10, 20, 30]
        UnitTest::assertEquals(10, arr[0]++)
        UnitTest::assertEquals(11, arr[0])
        UnitTest::assertEquals(31, ++arr[2])
        return 0
    }

    // Cible = valeur d'une map (`map[clé]++`).
    public method mapValueTargetTest(): int {
        var scores:map<string, int> = {"a": 1, "b": 2}
        UnitTest::assertEquals(1, scores["a"]++)
        UnitTest::assertEquals(2, scores["a"])
        return 0
    }

    // Cible = propriété d'un objet (`self.champ++`/`obj.champ++`).
    public method fieldTargetTest(): int {
        var c:Counter = use Counter(100)
        UnitTest::assertEquals(100, c.value++)
        UnitTest::assertEquals(101, c.value)
        UnitTest::assertEquals(102, ++c.value)
        return 0
    }

    // `object`/`index` ne doivent JAMAIS être évalués plus d'une fois —
    // `arr[bump()]++` n'appelle `bump()` qu'une seule fois (voir la fiche,
    // section Lowering : risque principal identifié pour cette fonctionnalité).
    public method singleEvaluationOfIndexTest(): int {
        var counter:Counter = use Counter(0)
        var arr:array<int> = [100, 200, 300]
        arr[counter.bump()]++
        UnitTest::assertEquals(1, counter.value)
        UnitTest::assertEquals(101, arr[0])
        return 0
    }

    // Une instruction préfixe (`++i`) placée juste après une autre instruction
    // qui se termine par une expression, SUR LA LIGNE SUIVANTE, ne doit
    // JAMAIS être avalée comme suffixe de l'instruction précédente — bug
    // réel rencontré pendant l'implémentation (`var c:Counter = use
    // Counter(100)` suivi de `++c.value` sur la ligne suivante était
    // auparavant parsé comme `(use Counter(100))++` puis `c.value` orphelin).
    // Voir `Parser::previous_line` (src/parsing/parser.d/primitives.rs).
    public method prefixOnNextLineNotSwallowedTest(): int {
        var c:Counter = use Counter(100)
        ++c.value
        UnitTest::assertEquals(101, c.value)
        return 0
    }

    // `- -x` (avec espace) reste une double négation, PAS une décrémentation —
    // non-régression explicite sur l'unaire `-` existant (voir la fiche,
    // section "risque de compatibilité vérifié").
    public method doubleNegationStillWorksTest(): int {
        var x:int = 5
        UnitTest::assertEquals(5, - -x)
        return 0
    }
}

class Counter {
    public property value:int
    init(v:int) { self.value = v }
    public method bump(): int {
        var c:int = self.value
        self.value = self.value + 1
        return c
    }
}
