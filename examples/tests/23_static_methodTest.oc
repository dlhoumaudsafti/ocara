architecture permissive

import ocara.UnitTest
import ocara.String

class Test23StaticMethod extends UnitTest {

    public method validatorTest(): int {
        self::assertTrue(Validator::isPositive(5))
        self::assertFalse(Validator::isPositive(-5))
        self::assertTrue(Validator::isInRange(50, 0, 100))
        self::assertFalse(Validator::isInRange(150, 0, 100))
        self::assertTrue(Validator::isValidAge(30))
        self::assertFalse(Validator::isValidAge(200))
        self::assertTrue(Validator::isValidScore(75))
        self::assertFalse(Validator::isValidScore(150))
        return 0
    }

    public method temperatureTest(): int {
        self::assertEquals(32, Temperature::toFahrenheit(0))
        self::assertEquals(212, Temperature::toFahrenheit(100))
        self::assertEquals(0, Temperature::toCelsius(32))
        self::assertTrue(Temperature::isValid(0))
        self::assertFalse(Temperature::isValid(-300))
        self::assertEquals(-273, Temperature::clamp(-300))
        self::assertEquals(25, Temperature::clamp(25))
        return 0
    }

    public method mainTest(): int {
        self::assertTrue(Validator::isValidAge(30))
        self::assertTrue(Validator::isValidScore(75))
        self::assertEquals(32, Temperature::toFahrenheit(0))
        self::assertTrue(Temperature::isValid(0))
        return 0
    }
    public method isPositiveTest(): int {
        self::assertTrue(Validator::isPositive(5))
        self::assertFalse(Validator::isPositive(-3))
        self::assertFalse(Validator::isPositive(0))
        return 0
    }

    public method isInRangeTest(): int {
        self::assertTrue(Validator::isInRange(50, 0, 100))
        self::assertTrue(Validator::isInRange(0, 0, 100))
        self::assertTrue(Validator::isInRange(100, 0, 100))
        self::assertFalse(Validator::isInRange(-1, 0, 100))
        self::assertFalse(Validator::isInRange(101, 0, 100))
        return 0
    }

    public method isValidAgeTest(): int {
        self::assertTrue(Validator::isValidAge(25))
        self::assertTrue(Validator::isValidAge(1))
        self::assertTrue(Validator::isValidAge(150))
        self::assertFalse(Validator::isValidAge(0))
        self::assertFalse(Validator::isValidAge(-5))
        self::assertFalse(Validator::isValidAge(200))
        return 0
    }

    public method isValidScoreTest(): int {
        self::assertTrue(Validator::isValidScore(85))
        self::assertTrue(Validator::isValidScore(0))
        self::assertTrue(Validator::isValidScore(100))
        self::assertFalse(Validator::isValidScore(101))
        self::assertFalse(Validator::isValidScore(-1))
        return 0
    }

    public method toFahrenheitTest(): int {
        self::assertEquals(212, Temperature::toFahrenheit(100))
        self::assertEquals(32, Temperature::toFahrenheit(0))
        self::assertEquals(-40, Temperature::toFahrenheit(-40))
        return 0
    }

    public method toCelsiusTest(): int {
        self::assertEquals(100, Temperature::toCelsius(212))
        self::assertEquals(0, Temperature::toCelsius(32))
        self::assertEquals(-40, Temperature::toCelsius(-40))
        // aller-retour exact (valeurs multiples de 5 : pas de troncature entière)
        self::assertEquals(100, Temperature::toCelsius(Temperature::toFahrenheit(100)))
        // division entière : 37 °C -> 98 °F -> 36 °C
        self::assertEquals(36, Temperature::toCelsius(Temperature::toFahrenheit(37)))
        return 0
    }

    public method isValidTest(): int {
        self::assertTrue(Temperature::isValid(-273))
        self::assertTrue(Temperature::isValid(20))
        self::assertFalse(Temperature::isValid(-274))
        self::assertFalse(Temperature::isValid(-300))
        return 0
    }

    public method clampTest(): int {
        self::assertEquals(-273, Temperature::clamp(-300))
        self::assertEquals(20, Temperature::clamp(20))
        self::assertEquals(Temperature::ABSOLUTE_ZERO, Temperature::clamp(-273))
        return 0
    }

    public method hasContentTest(): int {
        self::assertTrue(StringCheck::hasContent("hello"))
        self::assertTrue(StringCheck::hasContent(" "))
        self::assertFalse(StringCheck::hasContent(""))
        return 0
    }

    public method startsWithUpperTest(): int {
        self::assertTrue(StringCheck::startsWithUpper("Alice"))
        self::assertFalse(StringCheck::startsWithUpper("alice"))
        self::assertFalse(StringCheck::startsWithUpper(""))
        return 0
    }

    public method isValidNameTest(): int {
        self::assertTrue(StringCheck::isValidName("Alice"))
        self::assertFalse(StringCheck::isValidName("alice"))
        self::assertFalse(StringCheck::isValidName(""))
        return 0
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 23_static_method.oc
// ─────────────────────────────────────────────────────────────────────────────


class Validator {
    public static method isPositive(n:int): bool {
        return n greater 0
    }

    public static method isInRange(n:int, low:int, high:int): bool {
        return n greater or equal low and n smaller or equal high
    }

    public static method isValidAge(age:int): bool {
        return self::isPositive(age) and self::isInRange(age, 1, 150)
    }

    public static method isValidScore(score:int): bool {
        return self::isInRange(score, 0, 100)
    }
}

class Temperature {
    public const ABSOLUTE_ZERO:int = -273

    public static method toFahrenheit(c:int): int {
        return c * 9 / 5 + 32
    }

    public static method toCelsius(f:int): int {
        return (f - 32) * 5 / 9
    }

    public static method isValid(c:int): bool {
        return c greater or equal Temperature::ABSOLUTE_ZERO
    }

    public static method clamp(c:int): int {
        if self::isValid(c) {
            return c
        }
        return Temperature::ABSOLUTE_ZERO
    }
}

class StringCheck {
    public static method hasContent(s:string): bool {
        return s not equal ""
    }

    public static method startsWithUpper(s:string): bool {
        return s equal String::capitalize(s) and self::hasContent(s)
    }

    public static method isValidName(s:string): bool {
        return self::hasContent(s) and self::startsWithUpper(s)
    }
}
