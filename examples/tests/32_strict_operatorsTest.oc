// ─────────────────────────────────────────────────────────────────────────────
// Tests unitaires pour 32_strict_operators.oc
// ─────────────────────────────────────────────────────────────────────────────

architecture permissive

import ocara.UnitTest

class Test32StrictOperators extends UnitTest {

    public method equalityTest(): int {
        var x:int = 42
        var z:int = 42
        var y:int = 7

        self::assertTrue(x equal z)
        self::assertTrue(x not equal y)
        return 0
    }

    public method crossNumericEqualityTest(): int {
        // int et float sont l'unique paire de types compatible pour une
        // comparaison typée : widening numérique explicite, pas un bitcast.
        var a:int = 10
        var b:float = 10.0
        var c:float = 2.5

        self::assertTrue(a equal b)
        self::assertTrue(a not equal c)
        return 0
    }

    public method stringContentEqualityTest(): int {
        var name:string = "Alice"
        var other_name:string = "Alice"

        self::assertTrue(name equal other_name)
        return 0
    }

    public method orderingTest(): int {
        var num1:int = 100
        var num2:int = 200
        var num3:float = 100.0

        self::assertTrue(num1 smaller num2)
        self::assertTrue(num2 greater num1)
        self::assertTrue(num1 smaller or equal num3)
        self::assertTrue(num2 greater or equal num1)
        return 0
    }

    public method mainTest(): int {
        var x:int = 42
        var z:int = 42
        self::assertTrue(x equal z)

        var a:int = 10
        var b:float = 10.0
        self::assertTrue(a equal b)

        var num1:int = 100
        var num2:int = 200
        self::assertTrue(num1 smaller num2)
        self::assertTrue(num2 greater or equal num1)

        return 0
    }
}
