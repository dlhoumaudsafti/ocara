namespace configs.components
// examples/advanced/mini_projet/configs/components/StatBadge.oc

import ocara.HTMLComponent

class StatBadge extends HTMLComponent {
    init() {
        parent::init("stat-badge")
        self.register(nameless(attrs:map<string, string>): string {
            consumed label:string = attrs["label"]
            consumed value:string = attrs["value"]
            return `<div class="stat-badge">
                <span class="stat-value">${value}</span>
                <span class="stat-label">${label}</span>
            </div>`
        })
    }
}
