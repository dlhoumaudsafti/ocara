namespace configs.components
// examples/advanced/mini_projet/configs/components/Layout.oc
// Squelette de page commun à toutes les vues (voir examples/ocara_app pour
// le même patron). <nav-bar> est référencée dans le HTML retourné ici, donc
// résolue dans une passe de récursion ultérieure par HTML::render.

import ocara.HTMLComponent

class Layout extends HTMLComponent {
    init() {
        parent::init("layout")
        self.register(nameless(attrs:map<string, mixed>): string {
            scoped title:string   = attrs["title"]
            scoped active:string  = attrs["active"]
            scoped content:string = attrs["__slot__"]
            return `<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${title} — Garage Ocara</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav-bar active="${active}">
  <main class="container">${content}</main>
  <footer>Garage Ocara — gestion d'entretien de flotte, compilé nativement avec Ocara (SQLite + HTTPServer + Tauri)</footer>
</body>
</html>`
        })
    }
}
