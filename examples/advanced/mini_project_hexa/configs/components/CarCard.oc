namespace configs.components
// examples/advanced/mini_projet/configs/components/CarCard.oc
// Une voiture dans une grille (accueil ou résultats de recherche). Tous les
// prix arrivent déjà formatés (voir helpers/Format.oc) — ce composant ne
// fait que de la présentation, aucun calcul.

import ocara.HTMLComponent

class CarCard extends HTMLComponent {
    init() {
        parent::init("car-card")
        self.register(nameless(attrs:map<string, string>): string {
            consumed id:string              = attrs["id"]
            consumed reference:string       = attrs["reference"]
            consumed brand:string           = attrs["brand"]
            consumed model:string           = attrs["model"]
            consumed purchase_price:string   = attrs["purchase_price"]
            consumed estimated_price:string  = attrs["estimated_price"]
            consumed maintenance_total:string = attrs["maintenance_total"]
            return `<a class="car-card" href="/voitures/${id}">
      <div class="car-card-header">
        <span class="car-reference">${reference}</span>
        <span class="car-model">${brand} ${model}</span>
      </div>
      <div class="car-card-body">
        <div class="car-stat">
          <span class="car-stat-label">Achat</span>
          <span class="car-stat-value">${purchase_price}</span>
        </div>
        <div class="car-stat">
          <span class="car-stat-label">Vente estimée</span>
          <span class="car-stat-value highlight">${estimated_price}</span>
        </div>
        <div class="car-stat">
          <span class="car-stat-label">Entretiens</span>
          <span class="car-stat-value">${maintenance_total}</span>
        </div>
      </div>
    </a>`
        })
    }
}
