namespace configs.components
// examples/advanced/mini_projet/configs/components/SearchMaintenance.oc
// Une ligne d'entretien dans les résultats de recherche — comme
// <maintenance-row> mais cliquable vers la voiture correspondante, puisque
// la recherche traverse toutes les voitures à la fois.

import ocara.HTMLComponent

class SearchMaintenance extends HTMLComponent {
    init() {
        parent::init("search-maintenance")
        self.register(nameless(attrs:map<string, string>): string {
            consumed car_id:string       = attrs["car_id"]
            consumed car_reference:string = attrs["car_reference"]
            scoped type:string        = attrs["type"]
            consumed description:string = attrs["description"]
            consumed cost:string        = attrs["cost"]
            consumed badge_cls:string    = match type {
                "improvement" => "badge-improvement"
                default => "badge-maintenance"
            }
            consumed badge_label:string  = match type {
                "improvement" => "Amélioration"
                default => "Entretien"
            }
            return `<a class="maintenance-row search-result" href="/voitures/${car_id}">
      <span class="badge ${badge_cls}">${badge_label}</span>
      <span class="maintenance-desc">${description}</span>
      <span class="maintenance-car">${car_reference}</span>
      <span class="maintenance-cost">${cost}</span>
    </a>`
        })
    }
}
