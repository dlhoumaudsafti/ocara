namespace configs
// examples/advanced/mini_projet/configs/Database.oc
// Accès SQLite bas niveau : ouverture de connexion + migration du schéma.
//
// Comme dans examples/advanced/tauri_httpserver/configs/Database.oc : pas de propriété
// static en Ocara, donc chaque appel ouvre/ferme sa propre connexion vers le
// même fichier ("./app.db") plutôt que de garder un handle partagé en mémoire.
//
// Chemin RELATIF volontairement inconditionnel (pas de branche
// System::OS == "android") : sur Android, runtime_android_jni fait `chdir()`
// vers le répertoire de données de l'app (Context.getFilesDir()) AVANT de
// démarrer ce programme — "./app.db" y pointe alors déjà, exactement comme
// sur desktop où le répertoire de travail est celui depuis lequel on lance
// le programme. Voir docs/roadmap.d/packaging-android-webview-hybrid.md :
// un chemin absolu construit à la main ici avait fonctionné sur émulateur
// mais échouait sur un vrai appareil (SELinux/OEM plus strict que l'API
// Context.getFilesDir()) — la règle "un chemin relatif = même base que
// app.db" résout les deux à la fois, sans que ce fichier ait besoin de
// connaître la moindre spécificité Android.

import ocara.SQLite

class Database {

    public static method path(): string {
        return "./app.db"
    }

    public static method connect(): SQLite {
        return SQLite::open(self::path())
    }

    public static method migrate(): void {
        const db:SQLite = self::connect()
        db.execute(`CREATE TABLE IF NOT EXISTS cars (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            reference TEXT NOT NULL,
            brand TEXT NOT NULL,
            model TEXT NOT NULL,
            purchase_price REAL NOT NULL,
            estimated_sale_price REAL NOT NULL,
            created_at INTEGER NOT NULL
        )`)
        db.execute(`CREATE TABLE IF NOT EXISTS maintenances (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            car_id INTEGER NOT NULL,
            type TEXT NOT NULL,
            description TEXT NOT NULL,
            cost REAL NOT NULL,
            created_at INTEGER NOT NULL
        )`)
        db.close()
    }
}
