import ocara.UnitTest
import ocara.HTTPRequest
import ocara.HTTPResponse
import ocara.Thread
import configs.Server
import configs.routes.Search
import tests.support.fake.FakeDatabase

// Routes de configs/routes/Search.oc seules, sur un serveur dédié.
class SearchTest extends UnitTest {
    wiring tests.support.fake.FakeSearchRepository

    init() {
        FakeDatabase::reset()
        var server:Server = use Server()
        server.port(18112)
        use Search(server)
        var t:Thread = use Thread()
        t.run(nameless(): void { server.run() })
        t.detach()
        Thread::sleep(300)
    }

    public method initTest(): int {
        scoped res:HTTPResponse = HTTPRequest::get("http://localhost:18112/recherche?q=x")
        self::assertEquals(200, res.status())
        self::assertContains(res.body(), "<h1>Recherche</h1>")
        return 0
    }
}
