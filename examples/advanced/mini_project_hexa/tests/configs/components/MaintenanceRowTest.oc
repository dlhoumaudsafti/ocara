import ocara.UnitTest
import ocara.HTML
import configs.components.MaintenanceRow

class MaintenanceRowTest extends UnitTest {

    init() {
        use MaintenanceRow()
    }

    public method renderImprovementTest(): int {
        const html:string = HTML::render(`<maintenance-row type="improvement" description="Peinture"
            cost="500,00 €" date="24/09/2026">`)
        self::assertContains(html, `<span class="badge badge-improvement">Amélioration</span>`)
        self::assertContains(html, `<span class="maintenance-desc">Peinture</span>`)
        self::assertContains(html, `<span class="maintenance-date">24/09/2026</span>`)
        self::assertContains(html, `<span class="maintenance-cost">500,00 €</span>`)
        return 0
    }

    // Tout autre type est affiché comme un entretien.
    public method renderMaintenanceTest(): int {
        const html:string = HTML::render(`<maintenance-row type="maintenance" description="Vidange"
            cost="80,00 €" date="24/09/2026">`)
        self::assertContains(html, `<span class="badge badge-maintenance">Entretien</span>`)
        return 0
    }
}
