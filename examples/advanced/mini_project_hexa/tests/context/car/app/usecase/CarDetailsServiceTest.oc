import ocara.UnitTest
import context.car.app.dto.CarDetailsDTO
import context.car.app.usecase.CarDetailsService
import tests.support.fake.FakeDatabase

// Dépôts en mémoire : le cas d'usage est testé sans base de données.
class CarDetailsServiceTest extends UnitTest {
    wiring tests.support.fake.FakeCarRepository
    wiring tests.support.fake.FakeMaintenanceRepository

    public method buildTest(): int {
        FakeDatabase::reset()
        const car_id:int = FakeDatabase::car("DETAILS", "Peugeot", "308", 12000.0)
        FakeDatabase::maintenance(car_id, "maintenance", "Vidange", 80.0)
        FakeDatabase::maintenance(car_id, "improvement", "Peinture", 500.0)
        FakeDatabase::maintenance(car_id, "improvement", "Jantes", 200.0)
        const details:CarDetailsDTO|null = CarDetailsService::build(car_id)
        self::assertNotNull(details)
        self::assertEquals("TEST-OCUNIT-DETAILS", details.car.reference)
        self::assertEquals(3, details.maintenances.len())
        self::assertEquals(80.0, details.maintenance_total)
        self::assertEquals(700.0, details.improvement_total)
        FakeDatabase::cleanup()
        return 0
    }

    public method buildUnknownCarTest(): int {
        FakeDatabase::reset()
        self::assertNull(CarDetailsService::build(-1))
        return 0
    }
}
