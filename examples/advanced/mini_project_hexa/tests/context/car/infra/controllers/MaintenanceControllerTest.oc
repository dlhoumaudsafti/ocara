import ocara.UnitTest
import ocara.HTTPServer
import ocara.HTTPServerRequest
import ocara.HTTPRequest
import ocara.HTTPResponse
import ocara.Thread
import context.car.infra.controllers.CarController
import context.car.infra.controllers.MaintenanceController
import tests.support.fake.FakeDatabase

// Route de configs/routes/CarRoutes.oc ; la redirection mène à la fiche de
// la voiture (CarController::show), où s'affiche le message flash.
class MaintenanceControllerTest extends UnitTest {
    wiring tests.support.fake.FakeCarRepository
    wiring tests.support.fake.FakeMaintenanceRepository
    wiring tests.support.fake.FakeCarPhotoRepository

    init() {
        var server:HTTPServer = use HTTPServer()
        server.port(18102)
        server.route("/voitures/<id:int>", "GET", CarController::show)
        server.route("/voitures/<car_id:int>/entretiens", "POST", MaintenanceController::create)
        var t:Thread = use Thread()
        t.run(nameless(): void { server.run() })
        t.detach()
        Thread::sleep(300)
    }

    // Une amélioration est enregistrée et relève le prix de vente estimé.
    public method createTest(): int {
        FakeDatabase::reset()
        const id:int = FakeDatabase::car("MAINT", "Peugeot", "308", 10000.0)
        scoped res:HTTPResponse = self.post(
            id, "type=improvement&description=Peinture&cost=500&material_source=Garage&lifespan_days=180"
        )
        self::assertEquals(200, res.status())
        self::assertContains(res.body(), "Entretien ajouté — prix de vente estimé mis à jour.")
        self::assertEquals(1, FakeDatabase::maintenanceCount(id))
        const saved:map<string, mixed> = FakeDatabase::maintenances(id)[0]
        self::assertEquals("Garage", saved["material_source"])
        self::assertEquals(180, saved["lifespan_days"])
        self::assertEquals(10500.0, FakeDatabase::estimatedPrice(id))
        FakeDatabase::cleanup()
        return 0
    }

    // Une maintenance simple ne change pas le prix de vente estimé.
    public method createMaintenanceKeepsPriceTest(): int {
        FakeDatabase::reset()
        const id:int = FakeDatabase::car("MAINT2", "Peugeot", "308", 10000.0)
        self.post(
            id, "type=maintenance&description=Vidange&cost=80&material_source=&lifespan_days="
        )
        self::assertEquals(1, FakeDatabase::maintenanceCount(id))
        self::assertEquals(10000.0, FakeDatabase::estimatedPrice(id))
        FakeDatabase::cleanup()
        return 0
    }

    public method createInvalidTest(): int {
        FakeDatabase::reset()
        const id:int = FakeDatabase::car("MAINT3", "Peugeot", "308", 10000.0)
        consumed bad_cost:HTTPResponse = self.post(id,
            "type=maintenance&description=Vidange&cost=0&material_source=&lifespan_days="
        )
        consumed bad_type:HTTPResponse = self.post(id,
            "type=autre&description=Vidange&cost=80&material_source=&lifespan_days="
        )
        consumed bad_lifespan:HTTPResponse = self.post(id,
            "type=maintenance&description=Vidange&cost=80&material_source=&lifespan_days=0"
        )
        consumed no_desc:HTTPResponse = self.post(id,
            "type=maintenance&description=%20&cost=80&material_source=&lifespan_days="
        )
        self::assertContains(bad_cost.body(), "coût de l")
        self::assertContains(bad_type.body(), "coût de l")
        self::assertContains(bad_lifespan.body(), "coût de l")
        self::assertContains(no_desc.body(), "coût de l")
        self::assertEquals(0, FakeDatabase::maintenanceCount(id))
        FakeDatabase::cleanup()
        return 0
    }

    private method post(car_id:int, body:string): HTTPResponse {
        scoped req:HTTPRequest = HTTPRequest::new(`http://localhost:18102/voitures/${car_id}/entretiens`)
        req.setMethod("POST")
        req.setHeader("Content-Type", "application/x-www-form-urlencoded")
        req.setBody(body)
        return req.send()
    }
}
