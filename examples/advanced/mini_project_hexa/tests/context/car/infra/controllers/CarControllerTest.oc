import ocara.UnitTest
import ocara.HTTPServer
import ocara.HTTPServerRequest
import ocara.HTTPRequest
import ocara.HTTPResponse
import ocara.Thread
import ocara.File
import context.car.infra.controllers.CarController
import tests.support.fake.FakeDatabase

// Routes de configs/routes/CarRoutes.oc sur un serveur dédié ; la page
// d'accueil (autre contexte) est remplacée par un écho du code d'erreur.
// HTTPRequest suit les redirections : chaque test vérifie la page d'arrivée.
class CarControllerTest extends UnitTest {
    wiring tests.support.fake.FakeCarRepository
    wiring tests.support.fake.FakeMaintenanceRepository
    wiring tests.support.fake.FakeCarPhotoRepository

    init() {
        var server:HTTPServer = use HTTPServer()
        server.port(18101)
        server.route("/", "GET", nameless(req:HTTPServerRequest): int {
            req.respond(200, "accueil:" + req.query("error"))
            return 0
        })
        server.route("/voitures/<id:int>", "GET", CarController::show)
        server.route("/voitures/ajouter", "POST", CarController::create)
        server.route("/voitures/<id:int>/supprimer", "POST", CarController::delete)
        server.route("/voitures/<id:int>/photos", "POST", CarController::addPhoto)
        var t:Thread = use Thread()
        t.run(nameless(): void { server.run() })
        t.detach()
        Thread::sleep(300)
    }

    public method showTest(): int {
        FakeDatabase::reset()
        const id:int = FakeDatabase::car("SHOW", "Peugeot", "308", 12000.5)
        scoped res:HTTPResponse = HTTPRequest::get(`http://localhost:18101/voitures/${id}?success=car_added`)
        self::assertEquals(200, res.status())
        self::assertContains(res.body(), "TEST-OCUNIT-SHOW")
        self::assertContains(res.body(), "12000,50 €")
        self::assertContains(res.body(), "Voiture ajoutée avec succès.")
        FakeDatabase::cleanup()
        return 0
    }

    public method showUnknownCarTest(): int {
        FakeDatabase::reset()
        scoped res:HTTPResponse = HTTPRequest::get("http://localhost:18101/voitures/999999999")
        self::assertEquals(404, res.status())
        return 0
    }

    // Création puis redirection vers la fiche de la nouvelle voiture.
    public method createTest(): int {
        FakeDatabase::reset()
        scoped res:HTTPResponse = self.post(
            "/voitures/ajouter",
            "reference=TEST-OCUNIT-POST&brand=Renault&model=Clio&purchase_price=8000.25&"
            + "acquisition_date=2024-01-02&sale_date="
        )
        self::assertEquals(200, res.status())
        self::assertContains(res.body(), "TEST-OCUNIT-POST")
        self::assertContains(res.body(), "8000,25 €")
        self::assertContains(res.body(), "Voiture ajoutée avec succès.")
        FakeDatabase::cleanup()
        return 0
    }

    public method createMissingFieldsTest(): int {
        FakeDatabase::reset()
        scoped res:HTTPResponse = self.post(
            "/voitures/ajouter",
            "reference=TEST-OCUNIT-X&brand=&model=Clio&purchase_price=100"
        )
        self::assertEquals("accueil:missing_fields", res.body())
        return 0
    }

    public method createInvalidPriceTest(): int {
        FakeDatabase::reset()
        scoped res:HTTPResponse = self.post(
            "/voitures/ajouter",
            "reference=TEST-OCUNIT-X&brand=Fiat&model=500&purchase_price=0"
        )
        self::assertEquals("accueil:invalid_price", res.body())
        return 0
    }

    // Suppression puis redirection vers la fiche, désormais introuvable.
    public method deleteTest(): int {
        FakeDatabase::reset()
        const id:int = FakeDatabase::car("DELETE", "Fiat", "500", 5000.0)
        scoped req:HTTPRequest = HTTPRequest::new(`http://localhost:18101/voitures/${id}/supprimer`)
        req.setMethod("POST")
        scoped res:HTTPResponse = req.send()
        self::assertEquals(200, res.status())
        self::assertFalse(FakeDatabase::carExists(id))
        return 0
    }

    public method addPhotoTest(): int {
        FakeDatabase::reset()
        const id:int = FakeDatabase::car("PHOTO", "Peugeot", "308", 12000.0)
        scoped res:HTTPResponse = self.uploadPhoto(id, "photo.gif", "image/gif", "GIF89a")
        self::assertEquals(200, res.status())
        self::assertContains(res.body(), "Photo ajoutée à la galerie.")
        self::assertContains(res.body(), `<img src="/uploads/car-${id}-`)
        var photos:array<string> = FakeDatabase::photos(id)
        self::assertEquals(1, photos.len())
        File::remove("./public" + photos[0])
        FakeDatabase::cleanup()
        return 0
    }

    public method addPhotoUnknownCarTest(): int {
        scoped res:HTTPResponse = self.uploadPhoto(999999999, "photo.gif", "image/gif", "GIF89a")
        self::assertEquals(404, res.status())
        return 0
    }

    public method addPhotoMissingFileTest(): int {
        FakeDatabase::reset()
        const id:int = FakeDatabase::car("PHOTO-MISSING", "Peugeot", "308", 12000.0)
        const boundary:string = "OcaraPhotoEmptyBoundary"
        var body:string = "--" + boundary + "--\r\n"
        scoped req:HTTPRequest = HTTPRequest::new(`http://localhost:18101/voitures/${id}/photos`)
        req.setMethod("POST")
        req.setHeader("Content-Type", "multipart/form-data; boundary=" + boundary)
        req.setBody(body)
        scoped res:HTTPResponse = req.send()
        self::assertEquals(200, res.status())
        self::assertContains(res.body(), "Photo invalide")
        self::assertEquals(0, FakeDatabase::photos(id).len())

        var text_body:string = "--" + boundary + "\r\n"
        text_body += "Content-Disposition: form-data; name=\"photo\"\r\n\r\n"
        text_body += "not-a-file\r\n--" + boundary + "--\r\n"
        scoped text_req:HTTPRequest = HTTPRequest::new(`http://localhost:18101/voitures/${id}/photos`)
        text_req.setMethod("POST")
        text_req.setHeader("Content-Type", "multipart/form-data; boundary=" + boundary)
        text_req.setBody(text_body)
        scoped text_res:HTTPResponse = text_req.send()
        self::assertEquals(200, text_res.status())
        self::assertContains(text_res.body(), "Photo invalide")
        self::assertEquals(0, FakeDatabase::photos(id).len())
        FakeDatabase::cleanup()
        return 0
    }

    public method addPhotoUnsupportedTypeTest(): int {
        FakeDatabase::reset()
        const id:int = FakeDatabase::car("PHOTO-TYPE", "Peugeot", "308", 12000.0)
        scoped res:HTTPResponse = self.uploadPhoto(id, "photo.txt", "text/plain", "not-an-image")
        self::assertEquals(200, res.status())
        self::assertContains(res.body(), "Photo invalide")
        self::assertEquals(0, FakeDatabase::photos(id).len())
        FakeDatabase::cleanup()
        return 0
    }

    public method addPhotoInvalidSignatureTest(): int {
        FakeDatabase::reset()
        const id:int = FakeDatabase::car("PHOTO-SIGNATURE", "Peugeot", "308", 12000.0)
        scoped jpeg:HTTPResponse = self.uploadPhoto(id, "photo.jpg", "image/jpeg", "abc")
        scoped png:HTTPResponse = self.uploadPhoto(id, "photo.png", "image/png", "12345678")
        scoped gif:HTTPResponse = self.uploadPhoto(id, "photo.gif", "image/gif", "GIF")
        scoped webp:HTTPResponse = self.uploadPhoto(id, "photo.webp", "image/webp", "abcdefghijkl")
        self::assertContains(jpeg.body(), "Photo invalide")
        self::assertContains(png.body(), "Photo invalide")
        self::assertContains(gif.body(), "Photo invalide")
        self::assertContains(webp.body(), "Photo invalide")
        self::assertEquals(0, FakeDatabase::photos(id).len())
        FakeDatabase::cleanup()
        return 0
    }

    private method post(path:string, body:string): HTTPResponse {
        scoped req:HTTPRequest = HTTPRequest::new("http://localhost:18101" + path)
        req.setMethod("POST")
        req.setHeader("Content-Type", "application/x-www-form-urlencoded")
        req.setBody(body)
        return req.send()
    }

    private method uploadPhoto(id:int, filename:string, content_type:string, content:string): HTTPResponse {
        const boundary:string = "OcaraPhotoTestBoundary"
        var body:string = "--" + boundary + "\r\n"
        body += "Content-Disposition: form-data; name=\"photo\"; filename=\"" + filename + "\"\r\n"
        body += "Content-Type: " + content_type + "\r\n\r\n"
        body += content + "\r\n--" + boundary + "--\r\n"
        scoped req:HTTPRequest = HTTPRequest::new(`http://localhost:18101/voitures/${id}/photos`)
        req.setMethod("POST")
        req.setHeader("Content-Type", "multipart/form-data; boundary=" + boundary)
        req.setBody(body)
        return req.send()
    }
}
