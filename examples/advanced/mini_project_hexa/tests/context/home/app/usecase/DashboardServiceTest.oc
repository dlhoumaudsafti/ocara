import ocara.UnitTest
import context.home.app.dto.DashboardDto
import context.home.app.usecase.DashboardService
import tests.support.Fixture

// La base peut contenir d'autres voitures : on vérifie l'écart produit par
// les voitures de test, pas des totaux absolus.
class DashboardServiceTest extends UnitTest {

    public method buildTest(): int {
        Fixture::reset()
        const before:DashboardDto = DashboardService::build()
        Fixture::car("DASH1", "Peugeot", "308", 12000.0)
        const id:int = Fixture::car("DASH2", "Renault", "Clio", 8000.0)
        Fixture::maintenance(id, "maintenance", "Vidange", 80.0)
        const after:DashboardDto = DashboardService::build()

        self::assertEquals(before.cars.len() + 2, after.cars.len())
        self::assertEquals(20000.0, after.total_purchase_value - before.total_purchase_value)
        self::assertEquals(20000.0, after.total_estimated_value - before.total_estimated_value)
        Fixture::cleanup()
        return 0
    }
}
