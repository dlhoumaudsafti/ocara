// examples/advanced/mini_projet/controllers/HomeController.oc
// Page d'accueil : tableau de bord de la flotte + formulaire d'ajout de
// voiture + grille des voitures existantes.
//
// La liste des voitures est de longueur dynamique : le HTML de chaque
// <car-card> est construit ici par concaténation (une balise custom par
// voiture), puis interpolé une seule fois dans templates/home.html.
namespace context.home.infra.controllers

import ocara.HTML
import ocara.HTTPServer
import ocara.HTTPServerRequest
import ocara.Array
import ocara.Convert
import context.home.app.usecase.DashboardService
import context.home.app.dto.DashboardDto
import context.home.domain.entity.CarSummaryEntity
import context.home.app.usecase.helpers.Format
import context.home.app.usecase.helpers.Flash
import configs.Language

class HomeController {

    public static method index(req:HTTPServerRequest): int {
        const lang:map<string, string> = Language::get("home", req.param("lang"))
        const dashboard:DashboardDto = DashboardService::build()
        const cars:array<CarSummaryEntity> = dashboard.cars

        var cars_html:string = ""
        for car in cars {
            cars_html += `<car-card 
                id="${Convert::intToStr(car.id)}"
                reference="${car.reference}"
                brand="${car.brand}"
                model="${car.model}"
                purchase_price="${Format::price(car.purchasePrice)}"
                estimated_price="${Format::price(car.estimatedPrice)}"
                maintenance_total="${Format::price(car.maintenanceTotal)}"
            >`
        }

        if Array::len(cars) equal 0 {
            cars_html = `<p class="empty">Aucune voiture pour le moment — ajoutez la première ci-dessus.</p>`
        }

        scoped car_count:string    = Convert::intToStr(Array::len(cars))
        scoped purchase_text:string  = Format::price(dashboard.total_purchase_value)
        scoped estimated_text:string = Format::price(dashboard.total_estimated_value)
        scoped gain_text:string      = Format::price(dashboard.total_estimated_value - dashboard.total_purchase_value)

        scoped error_code:string   = req.query("error")
        scoped success_code:string = req.query("success")
        scoped error_text:string   = Flash::message(error_code)
        scoped success_text:string = Flash::message(success_code)

        scoped html:string = HTML::renderFile('templates/home/home.html')
        req.respond(200, html)
        return 0
    }
}
