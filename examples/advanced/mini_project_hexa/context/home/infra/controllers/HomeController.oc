// examples/advanced/mini_projet/controllers/HomeController.oc
// Page d'accueil : tableau de bord de la flotte + formulaire d'ajout de
// voiture + grille des voitures existantes.
//
// La liste des voitures est de longueur dynamique : le HTML de chaque
// <car-card> est construit ici par concaténation (une balise custom par
// voiture), puis interpolé une seule fois dans templates/home.html.
namespace context.home.infra.controllers

import ocara.HTML
import ocara.HTTPServer
import ocara.Array
import ocara.Convert
import context.home.app.usecase.DashboardService
import context.home.app.dto.DashboardDto
import context.home.domain.entity.CarSummaryEntity
import context.car.app.usecase.helpers.Format
import context.car.app.usecase.helpers.Flash

class HomeController {

    public static method index(req:int): int {
        const dashboard:DashboardDto = DashboardService::build()
        const cars:array<CarSummaryEntity> = dashboard.cars

        var carsHtml:string = ""
        for car in cars {
            carsHtml = carsHtml + `<car-card id="${Convert::intToStr(car.id)}" reference="${car.reference}" brand="${car.brand}" model="${car.model}" purchase_price="${Format::price(car.purchasePrice)}" estimated_price="${Format::price(car.estimatedPrice)}" maintenance_total="${Format::price(car.maintenanceTotal)}">`
        }

        if Array::len(cars) equal 0 {
            carsHtml = `<p class="empty">Aucune voiture pour le moment — ajoutez la première ci-dessus.</p>`
        }

        scoped carCount:string    = Convert::intToStr(Array::len(cars))
        scoped purchaseText:string  = Format::price(dashboard.totalPurchaseValue)
        scoped estimatedText:string = Format::price(dashboard.totalEstimatedValue)
        scoped gainText:string      = Format::price(dashboard.totalEstimatedValue - dashboard.totalPurchaseValue)

        scoped errorCode:string   = HTTPServer::query(req, "error")
        scoped successCode:string = HTTPServer::query(req, "success")
        scoped errorText:string   = Flash::message(errorCode)
        scoped successText:string = Flash::message(successCode)

        scoped html:string = HTML::renderFile('templates/home.html')
        HTTPServer::respond(req, 200, html)
        return 0
    }
}
