namespace context.home.infra.view

import ocara.HTML
import context.home.app.dto.DashboardDto
import context.home.app.port.HomeViewPort
import context.home.infra.view.HomeViewModel
import context.home.infra.view.helpers.Format
import context.home.infra.view.helpers.Flash

class HomeView implements HomeViewPort {
    public static method show(dashboard:DashboardDto, error_code:string, success_code:string): string {
        var cars_html:string = ""
        for car in dashboard.cars {
            cars_html += `<car-card
                id="${car.id.toStr()}"
                reference="${car.reference}"
                brand="${car.brand}"
                model="${car.model}"
                purchase_price="${Format::price(car.purchase_price)}"
                estimated_price="${Format::price(car.estimated_price)}"
                maintenance_total="${Format::price(car.maintenance_total)}"
            >`
        }
        if dashboard.cars.len() equal 0 {
            cars_html = `<p class="empty">Aucune voiture pour le moment — ajoutez la première ci-dessus.</p>`
        }
        const home:HomeViewModel = use HomeViewModel(
            car_count:dashboard.cars.len().toStr(),
            purchase_price:Format::price(dashboard.total_purchase_value),
            estimated_price:Format::price(dashboard.total_estimated_value),
            profit:Format::price(dashboard.total_estimated_value - dashboard.total_purchase_value),
            cars_html:cars_html,
            error_text:Flash::message(error_code),
            success_text:Flash::message(success_code)
        )
        return HTML::renderFile('templates/home/home.html')
    }
}
