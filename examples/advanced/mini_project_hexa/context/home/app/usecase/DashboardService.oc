namespace context.home.app.usecase

import context.home.app.dto.DashboardDto
import context.home.domain.entity.CarSummaryEntity
import context.home.domain.contract.CarSummaryContract

class DashboardService {
    public static method build(): DashboardDto {
        const cars:array<CarSummaryEntity> = CarSummaryContract::all()
        var total_purchase:float = 0.0
        var total_estimated:float = 0.0
        for car in cars {
            total_purchase = total_purchase + car.purchasePrice
            total_estimated = total_estimated + car.estimatedPrice
        }
        return use DashboardDto(
            cars,
            total_purchase,
            total_estimated
        )
    }
}
