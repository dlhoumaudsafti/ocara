namespace context.car.app.usecase

import context.car.app.dto.CarDetailsDTO
import context.car.domain.entity.CarEntity
import context.car.domain.entity.MaintenanceEntity
import context.car.domain.contract.CarContract
import context.car.domain.contract.MaintenanceContract

class CarDetailsService {

    public static method build(carId:int): CarDetailsDTO|null {
        const car:CarEntity|null = CarContract::find(carId)
        if car is null {
            return null
        }
        consumed maintenancesResolable:Resolvable<array<MaintenanceEntity>> = MaintenanceContract::forCar(carId)
        consumed maintenanceTotalResolable:Resolvable<float> = MaintenanceContract::maintenanceTotal(carId)
        consumed improvementTotalResolable:Resolvable<float> = MaintenanceContract::improvementTotal(carId)
        const maintenances:array<MaintenanceEntity> = resolve maintenancesResolable
        const maintenanceTotal:float = resolve maintenanceTotalResolable
        const improvementTotal:float = resolve improvementTotalResolable

        return use CarDetailsDTO(
            car,
            maintenances,
            maintenanceTotal,
            improvementTotal
        )
    }
}