namespace context.car.app.usecase

import context.car.app.dto.CarDetailsDTO
import context.car.domain.entity.CarEntity
import context.car.domain.entity.MaintenanceEntity
import context.car.domain.contract.CarContract
import context.car.domain.contract.MaintenanceContract

class CarDetailsService {

    public static method build(carId:int): CarDetailsDTO|null {
        const car:CarEntity|null = CarContract::find(carId)
        if car is null {
            return null
        }
        consumed maintenances_resolable:Resolvable<array<MaintenanceEntity>> = MaintenanceContract::forCar(carId)
        consumed maintenance_total_resolable:Resolvable<float> = MaintenanceContract::maintenanceTotal(carId)
        consumed improvement_total_resolable:Resolvable<float> = MaintenanceContract::improvementTotal(carId)
        const maintenances:array<MaintenanceEntity> = resolve maintenances_resolable
        const maintenance_total:float = resolve maintenance_total_resolable
        const improvement_total:float = resolve improvement_total_resolable

        return use CarDetailsDTO(
            car,
            maintenances,
            maintenance_total,
            improvement_total
        )
    }
}
