// examples/advanced/mini_projet/controllers/CarController.oc
// Fiche détail d'une voiture (historique d'entretiens + formulaire d'ajout
// d'entretien) et création d'une nouvelle voiture.
//
// La création passe par POST (voir configs/routes/CarRoutes.oc) : req.param()
// lit indifféremment la query string ET un corps application/x-www-form-urlencoded,
// plus besoin de forcer GET pour profiter du décodage automatique.
namespace context.car.infra.controllers

import ocara.HTML
import ocara.HTTPServer
import ocara.HTTPServerRequest
import ocara.Array
import ocara.Map
import ocara.Convert
import ocara.String
import context.car.domain.entity.CarEntity
import context.car.domain.contract.CarContract
import context.car.app.usecase.helpers.Format
import context.car.app.usecase.helpers.Flash
import context.car.app.usecase.CarDetailService
import context.car.app.dto.CarDetailsDTO

class CarController {

    public static method show(req:HTTPServerRequest): int {
        // `id` arrive comme paramètre de CHEMIN déjà typé (`<id:int>`, voir
        // configs/routes/CarRoutes.oc) — le routeur l'a déjà validé/parsé
        // avant même d'appeler ce handler, plus besoin de Convert::strToInt
        // ni de gérer une chaîne non numérique ici : un id invalide dans
        // l'URL (ex. /voitures/abc) ne matche simplement plus cette route du
        // tout (404 générique), au lieu d'être silencieusement traité comme
        // id=0 puis redirigé vers "not_found" comme avant ce changement.
        var id:int = req.param("id")
        const carDetails:CarDetailsDTO|null = CarDetailService::build(id)
        if carDetails is null {
            req.respondHeader("Location", "/?error=not_found")
            req.respond(302, "")
            return 0
        }

        var reference:string = carDetails.Car.reference
        var brand:string      = carDetails.Car.brand
        var model:string      = carDetails.Car.model
        var purchasePrice:float  = carDetails.Car.purchasePrice
        var estimatedPrice:float = carDetails.Car.estimatedPrice

        var rowsHtml:string = ""
        for m in carDetails.maintenances {
            rowsHtml = rowsHtml + `<maintenance-row type="${m.type}" description="${m.description}" cost="${Format::price(m.cost)}" date="${Format::date(m.createdAt)}">`
        }
        if carDetails.maintenances.len() equal 0 {
            rowsHtml = `<p class="empty">Aucun entretien enregistré pour cette voiture.</p>`
        }

        scoped idStr:string = Convert::intToStr(id)
        scoped purchasePriceText:string  = Format::price(purchasePrice)
        scoped estimatedPriceText:string = Format::price(estimatedPrice)
        scoped maintenanceTotalText:string = Format::price(carDetails.maintenanceTotal)
        scoped improvementTotalText:string = Format::price(carDetails.improvementTotal)

        scoped errorCode:string   = req.query("error")
        scoped successCode:string = req.query("success")
        scoped errorText:string   = Flash::message(errorCode)
        scoped successText:string = Flash::message(successCode)

        scoped html:string = HTML::renderFile('templates/car/car_detail.html')
        req.respond(200, html)
        return 0
    }

    public static method create(req:HTTPServerRequest): int {
        // `const` (pas `scoped`) : Car::create() les bind dans une map passée
        // à db.bind(), donc les retient au-delà de cet appel — une valeur
        // `scoped`/`consumed` ne peut pas être passée là où l'appelé la
        // retient (voir E26, docs/diagnostics.md).
        const reference:string = req.param("reference").trim()
        const brand:string     = req.param("brand").trim()
        const model:string     = req.param("model").trim()
        scoped priceStr:string  = req.param("purchase_price").trim()
        var price:float = Convert::strToFloat(priceStr)

        if reference.empty() or brand.empty() or model.empty() {
            req.respondHeader("Location", "/?error=missing_fields")
            req.respond(302, "")
            return 0
        }
        if price smaller or equal 0.0 {
            req.respondHeader("Location", "/?error=invalid_price")
            req.respond(302, "")
            return 0
        }

        CarContract::create(reference, brand, model, price)

        req.respondHeader("Location", "/?success=car_added")
        req.respond(302, "")
        return 0
    }
}
