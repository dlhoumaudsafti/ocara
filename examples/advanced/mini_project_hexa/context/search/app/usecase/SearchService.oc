namespace context.search.app.usecase

import context.search.domain.contract.SearchContract
import context.search.app.dto.SearchResultsDto

class SearchService {

    public static method run(term:string): SearchResultsDto {
        return use SearchResultsDto(
            cars: SearchContract::cars(term),
            maintenances: SearchContract::maintenances(term)
        )
    }
}
