// examples/advanced/mini_projet/controllers/SearchController.oc
// Recherche plein-texte simple (SQL LIKE, voir context.search.infra.db.SearchRepository)
// à travers les voitures ET les entretiens en une seule requête utilisateur.
namespace context.search.infra.controllers

import ocara.HTML
import ocara.HTTPServer
import ocara.HTTPServerRequest
import ocara.Array
import ocara.Convert
import ocara.String
import context.search.app.usecase.SearchService
import context.search.app.dto.SearchResultsDto
import context.search.domain.entity.CarSearchResultEntity
import context.search.domain.entity.MaintenanceSearchResultEntity
import context.search.app.usecase.helpers.Format

class SearchController {

    public static method handle(req:HTTPServerRequest): int {
        scoped term:string = String::trim(req.query("q"))

        var cars_html:string = ""
        var maintenances_html:string = ""

        if not String::empty(term) {
            const results:SearchResultsDto = SearchService::run(term)
            const cars:array<CarSearchResultEntity> = results.cars
            const maints:array<MaintenanceSearchResultEntity> = results.maintenances

            for car in cars {
                cars_html += `<car-card
                    id="${Convert::intToStr(car.id)}"
                    reference="${car.reference}"
                    brand="${car.brand}"
                    model="${car.model}"
                    purchase_price="${Format::price(car.purchase_price)}"
                    estimated_price="${Format::price(car.estimated_price)}"
                    maintenance_total="${Format::price(car.maintenance_total)}"
                >`
            }
            if Array::len(cars) equal 0 {
                cars_html = `<p class="empty">Aucune voiture ne correspond à « ${term} ».</p>`
            }

            for m in maints {
                maintenances_html += `<search-maintenance
                    car_id="${Convert::intToStr(m.car_id)}"
                    car_reference="${m.car_reference}"
                    type="${m.type}" description="${m.description}"
                    cost="${Format::price(m.cost)}"
                >`
            }
            if Array::len(maints) equal 0 {
                maintenances_html = `<p class="empty">Aucun entretien ne correspond à « ${term} ».</p>`
            }
        } else {
            cars_html = `<p class="empty">Saisissez un terme ci-dessus pour lancer une recherche.</p>`
        }

        scoped html:string = HTML::renderFile('templates/search/search.html')
        req.respond(200, html)
        return 0
    }
}
