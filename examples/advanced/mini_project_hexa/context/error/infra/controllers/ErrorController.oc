// examples/advanced/mini_projet/controllers/ErrorController.oc
//
// (architecture hexagonale : namespace conforme au chemin du fichier)
namespace context.error.infra.controllers

import ocara.HTML
import ocara.HTTPServer
import ocara.HTTPServerRequest

class ErrorController {
    public static method handle404(req:HTTPServerRequest): int {
        consumed path:string = req.path()
        var html:string = HTML::renderFile('templates/error/404.html')
        req.respond(404, html)
        return 0
    }
}
