namespace context.car.infra.db
// examples/advanced/mini_projet/models/Car.oc
//
// Toute valeur variable est bindée via des placeholders nominatifs `:nom`
// (voir docs/builtins/SQLite.md, "Requêtes paramétrées") — jamais concaténée
// dans la requête. Les écritures (create, updateEstimatedPrice) passent par
// le flux transactionnel `prepare()`/`bind()`/`commit()`, via
// `SQLite::withOpen` : la connexion est fermée automatiquement même si
// `commit()` lève (voir examples/tests/49_sqlite_with_open_raiseTest.oc).
//
// `find` retourne CarEntity|null (jamais une map brute) — voir
// context.car.domain.entity.CarEntity. Pas de `all()`/`search()` ici : home
// et search ont leur propre modèle de lecture ET leur propre requête SQL
// (context.home.infra.db / context.search.infra.db) — aucun contexte ne lit
// jamais via l'infra d'un autre contexte.

import ocara.SQLite
import ocara.DateTime
import context.shared.infra.db.Database
import context.car.domain.entity.CarEntity
import context.car.domain.contract.CarContract

class CarRepository implements CarContract {

    private static method fromRow(row:map<string, mixed>): CarEntity {
        var id:int = row["id"]
        var reference:string = row["reference"]
        var brand:string = row["brand"]
        var model:string = row["model"]
        var origin:string = row["origin"]
        var year:int = row["year"]
        var purchase_price:float = row["purchase_price"]
        var estimated_price:float = row["estimated_sale_price"]
        var acquisition_date:string = row["acquisition_date"]
        var sale_date:string = row["sale_date"]
        var mileage:int = row["mileage"]
        var inspection_date:string = row["inspection_date"]
        var last_inspection_date:string = row["last_inspection_date"]
        var collection:int = row["is_collection"]
        var distance_unit:string = row["distance_unit"]
        return use CarEntity(
            id, reference, brand, model, origin, year, purchase_price, estimated_price,
            acquisition_date, sale_date, mileage, inspection_date, last_inspection_date,
            collection equal 1, distance_unit
        )
    }

    public static method find(id:int): CarEntity|null {
        const db:SQLite = Database::connect()
        const row:map<string, mixed> = db.queryOne(
            `SELECT id, reference, brand, model, origin, year, purchase_price, estimated_sale_price,
                mileage, inspection_date, last_inspection_date, is_collection, distance_unit,
                COALESCE(acquisition_date, '') AS acquisition_date,
                COALESCE(sale_date, '') AS sale_date
            FROM cars WHERE id = :id`,
            {"id": id}
        )
        db.close()
        if row.size() equal 0 {
            return null
        }
        return self::fromRow(row)
    }

    public static method create(
        reference:string,
        brand:string,
        model:string,
        origin:string,
        year:int,
        purchase_price:float,
        acquisition_date:string,
        sale_date:string,
        mileage:int,
        inspection_date:string,
        last_inspection_date:string = "",
        is_collection:bool = false,
        distance_unit:string = "km"
    ): int {
        var id:int = 0
        SQLite::withOpen(Database::path(), nameless(db:SQLite): void {
            // Le prix de vente estimé démarre égal au prix d'achat : il n'est
            // ensuite fait évoluer que par les entretiens d'amélioration
            // (voir context.car.app.usecase.PricingService).
            db.prepare(`INSERT INTO cars 
                (reference, brand, model, origin, year, purchase_price, estimated_sale_price, created_at,
                 acquisition_date, sale_date, mileage, inspection_date, last_inspection_date, is_collection, distance_unit)
                VALUES (:reference, :brand, :model, :origin, :year, :price, :price, :createdAt,
                 :acquisitionDate, :saleDate, :mileage, :inspectionDate, :lastInspectionDate, :isCollection, :distanceUnit)
            `)
            db.bind({
                "reference": reference,
                "brand": brand,
                "model": model,
                "origin": origin,
                "year": year,
                "price": purchase_price,
                "createdAt": DateTime::now(),
                "acquisitionDate": acquisition_date,
                "saleDate": sale_date,
                "mileage": mileage,
                "inspectionDate": inspection_date,
                "lastInspectionDate": last_inspection_date,
                "isCollection": is_collection,
                "distanceUnit": distance_unit
            })
            db.commit()
            id = db.lastInsertId()
        })
        return id
    }

    // Fiche modifiée sur place (CarController::save).
    public static method update(car:CarEntity): void {
        SQLite::withOpen(Database::path(), nameless(db:SQLite): void {
            db.prepare(`UPDATE cars SET
                reference = :reference, brand = :brand, model = :model, origin = :origin, year = :year,
                purchase_price = :price, acquisition_date = :acquisitionDate, sale_date = :saleDate,
                mileage = :mileage, inspection_date = :inspectionDate,
                last_inspection_date = :lastInspectionDate, is_collection = :isCollection, distance_unit = :distanceUnit
                WHERE id = :id`)
            db.bind({
                "reference": car.reference,
                "brand": car.brand,
                "model": car.model,
                "origin": car.origin,
                "year": car.year,
                "price": car.purchase_price,
                "acquisitionDate": car.acquisition_date,
                "saleDate": car.sale_date,
                "mileage": car.mileage,
                "inspectionDate": car.inspection_date,
                "lastInspectionDate": car.last_inspection_date,
                "isCollection": car.is_collection,
                "distanceUnit": car.distance_unit,
                "id": car.id
            })
            db.commit()
        })
    }

    public static method updateMileage(id:int, mileage:int): void {
        SQLite::withOpen(Database::path(), nameless(db:SQLite): void {
            db.prepare("UPDATE cars SET mileage = :mileage WHERE id = :id")
            db.bind({"mileage": mileage, "id": id})
            db.commit()
        })
    }

    public static method updateLastInspectionDate(id:int, date:string): void {
        SQLite::withOpen(Database::path(), nameless(db:SQLite): void {
            db.prepare("UPDATE cars SET last_inspection_date = :date WHERE id = :id")
            db.bind({"date": date, "id": id})
            db.commit()
        })
    }

    public static method updateEstimatedPrice(id:int, newPrice:float): void {
        SQLite::withOpen(Database::path(), nameless(db:SQLite): void {
            db.prepare("UPDATE cars SET estimated_sale_price = :price WHERE id = :id")
            db.bind({"price": newPrice, "id": id})
            db.commit()
        })
    }

    // Les entretiens de la voiture partent avec elle, dans la même
    // transaction : le `ON DELETE CASCADE` du schéma n'est pas fiable (inactif
    // sans `PRAGMA foreign_keys`, absent d'une base créée avant lui).
    public static method delete(id:int): void {
        SQLite::withOpen(Database::path(), nameless(db:SQLite): void {
            db.begin()
            db.execute("DELETE FROM car_photos WHERE car_id = :id", {"id": id})
            db.execute(
                "DELETE FROM maintenance_attachments WHERE maintenance_id IN (SELECT id FROM maintenances WHERE car_id = :id)",
                {"id": id}
            )
            db.execute("DELETE FROM maintenances WHERE car_id = :id", {"id": id})
            db.execute("DELETE FROM cars WHERE id = :id", {"id": id})
            db.commit()
        })
    }
}
