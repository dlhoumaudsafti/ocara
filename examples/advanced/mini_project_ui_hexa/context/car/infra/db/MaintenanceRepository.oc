namespace context.car.infra.db
// examples/advanced/mini_projet/models/Maintenance.oc
//
// Le type est stocké tel quel ("maintenance" | "improvement") — c'est
// context.car.app.usecase.PricingService qui exploite cette distinction pour
// le recalcul du prix de vente estimé.
//
// `forCar` retourne des MaintenanceEntity (voir
// context.car.domain.entity.MaintenanceEntity). Pas de `search()` ici : voir
// context.search.infra.db (même raison que Car.oc).

import ocara.SQLite
import ocara.DateTime
import context.shared.infra.db.Database
import context.car.domain.entity.MaintenanceEntity
import context.car.domain.entity.MaintenanceAttachmentEntity
import context.car.domain.contract.MaintenanceContract

class MaintenanceRepository implements MaintenanceContract {

    private static method fromRow(row:map<string, mixed>): MaintenanceEntity {
        return self::fromRowWithAttachments(row, self::attachments(row["id"]))
    }

    private static method fromRowWithAttachments(
        row:map<string, mixed>,
        attachments:array<MaintenanceAttachmentEntity>
    ): MaintenanceEntity {
        var id:int = row["id"]
        var car_id:int = row["car_id"]
        var type:string = row["type"]
        var description:string = row["description"]
        var cost:float = row["cost"]
        var material_source:string = row["material_source"]
        var lifespan_days:int = row["lifespan_days"]
        var created_at:int = row["created_at"]
        var mileage:int = row["mileage"]
        var performed_on:string = row["performed_on"]
        var attachment:string = row["attachment"]
        var attachment_name:string = row["attachment_name"]
        var maintenance:MaintenanceEntity = use MaintenanceEntity(
            id, car_id, type, description, cost, material_source, lifespan_days, created_at,
            mileage, performed_on, attachment, attachment_name
        )
        maintenance.attachments = attachments
        if maintenance.attachments.len() equal 0 and not attachment.empty() {
            maintenance.attachments.push(use MaintenanceAttachmentEntity(0, id, attachment, attachment_name))
        }
        return maintenance
    }

    public static method attachments(maintenance_id:int): array<MaintenanceAttachmentEntity> {
        const db:SQLite = Database::connect()
        const rows:array<map<string, mixed>> = db.query(
            "SELECT id, maintenance_id, path, name FROM maintenance_attachments WHERE maintenance_id = :id ORDER BY id",
            {"id": maintenance_id}
        )
        db.close()
        var items:array<MaintenanceAttachmentEntity> = []
        for row in rows {
            var id:int = row["id"]
            var owner:int = row["maintenance_id"]
            var path:string = row["path"]
            var name:string = row["name"]
            items.push(use MaintenanceAttachmentEntity(id, owner, path, name))
        }
        return items
    }

    public static method find(id:int): MaintenanceEntity|null {
        const db:SQLite = Database::connect()
        const row:map<string, mixed> = db.queryOne(
            `SELECT id, car_id, type, description, cost, created_at, material_source,
                COALESCE(lifespan_days, 0) AS lifespan_days, mileage, performed_on, attachment, attachment_name
            FROM maintenances WHERE id = :id`,
            {"id": id}
        )
        db.close()
        if row.size() equal 0 {
            return null
        }
        return self::fromRow(row)
    }

    public static async method forCar(car_id:int): array<MaintenanceEntity> {
        const db:SQLite = Database::connect()
        consumed rows:array<map<string, mixed>> = db.query(
            `SELECT id, car_id, type, description, cost, created_at, material_source,
                COALESCE(lifespan_days, 0) AS lifespan_days, mileage, performed_on, attachment, attachment_name
            FROM maintenances
            WHERE car_id = :carId
            ORDER BY COALESCE(NULLIF(performed_on, ''), date(created_at, 'unixepoch')) DESC, id DESC`,
            {"carId": car_id}
        )
        consumed attachment_rows:array<map<string, mixed>> = db.query(
            `SELECT a.id, a.maintenance_id, a.path, a.name
            FROM maintenance_attachments a
            INNER JOIN maintenances m ON m.id = a.maintenance_id
            WHERE m.car_id = :carId
            ORDER BY a.maintenance_id, a.id`,
            {"carId": car_id}
        )
        db.close()
        var attachments_by_maintenance:map<string, array<MaintenanceAttachmentEntity>> = {}
        for row in attachment_rows {
            var id:int = row["maintenance_id"]
            const key:string = id.toStr()
            if not attachments_by_maintenance.has(key) {
                attachments_by_maintenance[key] = []
            }
            var attachments:array<MaintenanceAttachmentEntity> = attachments_by_maintenance[key]
            var attachment_id:int = row["id"]
            var path:string = row["path"]
            var name:string = row["name"]
            attachments.push(use MaintenanceAttachmentEntity(
                attachment_id, id, path, name
            ))
            attachments_by_maintenance[key] = attachments
        }
        var items:array<MaintenanceEntity> = []
        for row in rows {
            var id:int = row["id"]
            var attachments:array<MaintenanceAttachmentEntity> = []
            const key:string = id.toStr()
            if attachments_by_maintenance.has(key) {
                attachments = attachments_by_maintenance[key]
            }
            items.push(self::fromRowWithAttachments(row, attachments))
        }
        return items
    }

    public static method create(
        car_id:int,
        type:string,
        description:string,
        cost:float,
        material_source:string,
        lifespan_days:int,
        mileage:int,
        performed_on:string
    ): int {
        var id:int = 0
        SQLite::withOpen(Database::path(), nameless(db:SQLite): void {
            db.prepare(`INSERT INTO maintenances
                (car_id, type, description, cost, created_at, material_source, lifespan_days, mileage, performed_on)
                VALUES (:carId, :type, :description, :cost, :createdAt, :materialSource, :lifespanDays, :mileage, :performedOn)
            `)
            db.bind({
                "carId": car_id,
                "type": type,
                "description": description,
                "cost": cost,
                "createdAt": DateTime::now(),
                "materialSource": material_source,
                "lifespanDays": lifespan_days,
                "mileage": mileage,
                "performedOn": performed_on
            })
            db.commit()
            id = db.lastInsertId()
        })
        return id
    }

    // Entretien corrigé depuis l'historique de la fiche (sa date reste celle
    // de sa création).
    public static method update(
        id:int,
        type:string,
        description:string,
        cost:float,
        material_source:string,
        lifespan_days:int,
        mileage:int,
        performed_on:string
    ): void {
        SQLite::withOpen(Database::path(), nameless(db:SQLite): void {
            db.prepare(`UPDATE maintenances SET
                type = :type, description = :description, cost = :cost,
                material_source = :materialSource, lifespan_days = :lifespanDays,
                mileage = :mileage, performed_on = :performedOn
                WHERE id = :id`)
            db.bind({
                "type": type,
                "description": description,
                "cost": cost,
                "materialSource": material_source,
                "lifespanDays": lifespan_days,
                "mileage": mileage,
                "performedOn": performed_on,
                "id": id
            })
            db.commit()
        })
    }

    public static method setAttachment(id:int, path:string, name:string): void {
        SQLite::withOpen(Database::path(), nameless(db:SQLite): void {
            db.prepare("UPDATE maintenances SET attachment = :path, attachment_name = :name WHERE id = :id")
            db.bind({"path": path, "name": name, "id": id})
            db.commit()
        })
    }

    public static method addAttachment(maintenance_id:int, path:string, name:string): int {
        var id:int = 0
        SQLite::withOpen(Database::path(), nameless(db:SQLite): void {
            db.begin()
            db.execute(
                "INSERT INTO maintenance_attachments (maintenance_id, path, name) VALUES (:id, :path, :name)",
                {"id": maintenance_id, "path": path, "name": name}
            )
            id = db.lastInsertId()
            db.execute(
                "UPDATE maintenances SET attachment = :path, attachment_name = :name WHERE id = :id",
                {"path": path, "name": name, "id": maintenance_id}
            )
            db.commit()
        })
        return id
    }

    public static method deleteAttachment(maintenance_id:int, attachment_id:int): bool {
        var deleted:bool = false
        SQLite::withOpen(Database::path(), nameless(db:SQLite): void {
            const row:map<string, mixed> = db.queryOne(
                "SELECT id FROM maintenance_attachments WHERE id = :attachmentId AND maintenance_id = :maintenanceId",
                {"attachmentId": attachment_id, "maintenanceId": maintenance_id}
            )
            if row.size() equal 0 {
                return
            }
            db.begin()
            db.execute(
                "DELETE FROM maintenance_attachments WHERE id = :attachmentId AND maintenance_id = :maintenanceId",
                {"attachmentId": attachment_id, "maintenanceId": maintenance_id}
            )
            const latest:map<string, mixed> = db.queryOne(
                "SELECT path, name FROM maintenance_attachments WHERE maintenance_id = :id ORDER BY id DESC LIMIT 1",
                {"id": maintenance_id}
            )
            var path:string = ""
            var name:string = ""
            if latest.size() greater 0 {
                path = latest["path"]
                name = latest["name"]
            }
            db.execute(
                "UPDATE maintenances SET attachment = :path, attachment_name = :name WHERE id = :id",
                {"path": path, "name": name, "id": maintenance_id}
            )
            db.commit()
            deleted = true
        })
        return deleted
    }

    public static method clearAttachments(maintenance_id:int): void {
        SQLite::withOpen(Database::path(), nameless(db:SQLite): void {
            db.begin()
            db.execute("DELETE FROM maintenance_attachments WHERE maintenance_id = :id", {"id": maintenance_id})
            db.execute(
                "UPDATE maintenances SET attachment = '', attachment_name = '' WHERE id = :id",
                {"id": maintenance_id}
            )
            db.commit()
        })
    }

    public static method delete(id:int): void {
        SQLite::withOpen(Database::path(), nameless(db:SQLite): void {
            db.begin()
            db.execute("DELETE FROM maintenance_attachments WHERE maintenance_id = :id", {"id": id})
            db.execute("DELETE FROM maintenances WHERE id = :id", {"id": id})
            db.commit()
        })
    }

    // Dernier relevé du compteur : jour de l'entretien (`performed_on`, sinon
    // celui de son enregistrement) le plus récent, puis le dernier enregistré.
    public static method latestReading(car_id:int): MaintenanceEntity|null {
        const db:SQLite = Database::connect()
        const row:map<string, mixed> = db.queryOne(
            `SELECT id, car_id, type, description, cost, created_at, material_source,
                COALESCE(lifespan_days, 0) AS lifespan_days, mileage, performed_on, attachment, attachment_name
            FROM maintenances
            WHERE car_id = :carId AND mileage > 0
            ORDER BY COALESCE(NULLIF(performed_on, ''), date(created_at, 'unixepoch')) DESC, id DESC
            LIMIT 1`,
            {"carId": car_id}
        )
        db.close()
        if row.size() equal 0 {
            return null
        }
        return self::fromRow(row)
    }

    public static method latestInspection(car_id:int): MaintenanceEntity|null {
        const db:SQLite = Database::connect()
        const row:map<string, mixed> = db.queryOne(
            `SELECT id, car_id, type, description, cost, created_at, material_source,
                COALESCE(lifespan_days, 0) AS lifespan_days, mileage, performed_on, attachment, attachment_name
            FROM maintenances
            WHERE car_id = :carId AND type = 'technical_inspection'
            ORDER BY COALESCE(NULLIF(performed_on, ''), date(created_at, 'unixepoch')) DESC, id DESC
            LIMIT 1`,
            {"carId": car_id}
        )
        db.close()
        if row.size() equal 0 {
            return null
        }
        return self::fromRow(row)
    }

    // Somme des entretiens d'amélioration d'une voiture — base du recalcul
    // du prix de vente estimé (context.car.app.usecase.PricingService).
    public static async method improvementTotal(car_id:int): float {
        const db:SQLite = Database::connect()
        consumed row:map<string, mixed> = db.queryOne(
            `SELECT COALESCE(SUM(cost), 0) as total
            FROM maintenances
            WHERE car_id = :carId AND type = 'improvement'`,
            {"carId": car_id}
        )
        db.close()
        var total:float = row["total"]
        return total
    }

    // Somme des entretiens de maintenance (hors amélioration) — coût suivi
    // à titre informatif, sans impact sur le prix de vente estimé.
    public static async method maintenanceTotal(car_id:int): float {
        const db:SQLite = Database::connect()
        consumed row:map<string, mixed> = db.queryOne(
            `SELECT COALESCE(SUM(cost), 0) as total
            FROM maintenances
            WHERE car_id = :carId AND type = 'maintenance'`,
            {"carId": car_id}
        )
        db.close()
        var total:float = row["total"]
        return total
    }
}
