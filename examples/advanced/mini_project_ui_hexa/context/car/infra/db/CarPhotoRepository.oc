namespace context.car.infra.db

import ocara.SQLite
import ocara.File
import context.shared.infra.db.Database
import context.car.domain.entity.CarPhotoEntity
import context.car.domain.contract.CarPhotoContract

class CarPhotoRepository implements CarPhotoContract {

    public static method reserve(car_id:int): int {
        var id:int = 0
        SQLite::withOpen(Database::path(), nameless(db:SQLite): void {
            db.prepare("INSERT INTO car_photos (car_id) VALUES (:carId)")
            db.bind({"carId": car_id})
            db.commit()
            id = db.lastInsertId()
        })
        return id
    }

    public static method setPath(id:int, path:string): void {
        SQLite::withOpen(Database::path(), nameless(db:SQLite): void {
            db.prepare("UPDATE car_photos SET path = :path WHERE id = :id")
            db.bind({"path": path, "id": id})
            db.commit()
        })
    }

    public static method forCar(car_id:int): array<CarPhotoEntity> {
        const db:SQLite = Database::connect()
        const rows:array<map<string, mixed>> = db.query(
            "SELECT id, path, main FROM car_photos WHERE car_id = :carId AND path != '' ORDER BY main DESC, id",
            {"carId": car_id}
        )
        db.close()
        var photos:array<CarPhotoEntity> = []
        for row in rows {
            var id:int = row["id"]
            var path:string = row["path"]
            var main:int = row["main"]
            photos.push(use CarPhotoEntity(id, path, main equal 1))
        }
        return photos
    }

    public static method setMain(car_id:int, photo_id:int): bool {
        const db:SQLite = Database::connect()
        const row:map<string, mixed> = db.queryOne(
            "SELECT id FROM car_photos WHERE id = :id AND car_id = :carId AND path != ''",
            {"id": photo_id, "carId": car_id}
        )
        db.close()
        if row.size() equal 0 {
            return false
        }
        SQLite::withOpen(Database::path(), nameless(db:SQLite): void {
            db.begin()
            db.execute("UPDATE car_photos SET main = 0 WHERE car_id = :carId", {"carId": car_id})
            db.execute("UPDATE car_photos SET main = 1 WHERE id = :id", {"id": photo_id})
            db.commit()
        })
        return true
    }

    public static method deleteForCar(car_id:int): void {
        for photo in self::forCar(car_id) {
            var absolute_path:string = "./" + photo.path
            if File::exists(absolute_path) {
                File::remove(absolute_path)
            }
        }
        SQLite::withOpen(Database::path(), nameless(db:SQLite): void {
            db.execute("DELETE FROM car_photos WHERE car_id = :carId", {"carId": car_id})
        })
    }
}
