namespace context.car.infra.view.form
// Formulaire d'une voiture, lié à l'interface (`ui.bind`) : racine `new_car`
// (ajout, panneau de l'accueil) ou `car` (fiche modifiée sur place), voir
// ui/ui.d/components.oc.ui `carFields`. Les champs sont le texte saisi —
// nombres compris : CarController les contrôle et les convertit. Le compteur
// est dans l'unité sélectionnée pour ce véhicule (km ou mi).

import context.car.domain.entity.CarEntity
import context.shared.infra.i18n.Format
import ocara.ConvertException

class CarForm {
    public property reference:string = ""
    public property brand:string = ""
    public property model:string = ""
    public property origin:string = ""
    public property year:string = ""
    public property purchase_price:string = ""
    public property acquisition_date:string = ""
    public property sale_date:string = ""
    public property mileage:string = ""
    public property distance_unit:string = "km"
    public property last_inspection_date:string = ""
    public property is_collection:bool = false
    public property inspection_date:string = ""
    public property original_mileage:int = 0
    public property original_display_mileage:string = ""
    public property display_unit:string = "km"

    // Voiture lue en base : ses champs affichés.
    public method load(car:CarEntity): void {
        self.reference = car.reference
        self.brand = car.brand
        self.model = car.model
        self.origin = car.origin
        self.year = ""
        if car.year greater 0 {
            self.year = car.year.toStr()
        }
        self.purchase_price = car.purchase_price.toStr()
        self.acquisition_date = car.acquisition_date
        self.sale_date = car.sale_date
        self.mileage = ""
        self.original_mileage = car.mileage
        if car.mileage greater 0 {
            self.mileage = Format::toUnit(car.mileage, car.distance_unit).toStr()
        }
        self.distance_unit = car.distance_unit
        self.display_unit = car.distance_unit
        self.original_display_mileage = self.mileage
        self.last_inspection_date = car.last_inspection_date
        self.is_collection = car.is_collection
        self.inspection_date = car.inspection_date
    }

    public method changeUnit(unit:string): void {
        if self.mileage equal self.original_display_mileage {
            self.mileage = ""
            if self.original_mileage greater 0 {
                self.mileage = Format::toUnit(self.original_mileage, unit).toStr()
            }
        } else {
            if not self.mileage.empty() {
                try {
                    const km:int = Format::toKilometers(self.mileage.toInt(), self.display_unit)
                    self.mileage = Format::toUnit(km, unit).toStr()
                } on e is ConvertException {
                    // La validation du formulaire signalera la saisie invalide.
                }
            }
        }
        self.distance_unit = unit
        self.display_unit = unit
        self.original_display_mileage = ""
        if self.original_mileage greater 0 {
            self.original_display_mileage = Format::toUnit(self.original_mileage, unit).toStr()
        }
    }

    public method clear(): void {
        self.reference = ""
        self.brand = ""
        self.model = ""
        self.origin = ""
        self.year = ""
        self.purchase_price = ""
        self.acquisition_date = ""
        self.sale_date = ""
        self.mileage = ""
        self.original_mileage = 0
        self.original_display_mileage = ""
        self.distance_unit = "km"
        self.display_unit = "km"
        self.last_inspection_date = ""
        self.is_collection = false
        self.inspection_date = ""
    }
}
