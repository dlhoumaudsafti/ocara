namespace context.car.infra.view.form
// Formulaire d'entretien de la fiche, lié à l'interface (racine
// `maintenance`, ui/ui.d/components.oc.ui `maintenanceForm`) : ajout
// (`id` 0), ou modification d'un entretien de l'historique. `adding` et
// `editing` montrent les titres et boutons de chaque cas. `mileage` : relevé
// du compteur dans l'unité du véhicule ; `performed_on` vide : aujourd'hui.

import context.car.domain.entity.MaintenanceEntity
import context.shared.infra.i18n.Format

class MaintenanceForm {
    public property id:int = 0
    public property type:string = "maintenance"
    public property description:string = ""
    public property cost:string = ""
    public property material_source:string = ""
    public property lifespan_days:string = ""
    public property mileage:string = ""
    public property performed_on:string = ""
    public property adding:bool = true
    public property editing:bool = false
    // Selon le type : coût, durée de vie et source pour un entretien ou une
    // amélioration ; relevé obligatoire pour un relevé du compteur.
    public property needs_cost:bool = true
    public property is_reading:bool = false
    public property is_inspection:bool = false
    public property distance_unit:string = "km"
    public property original_mileage:int = 0
    public property original_display_mileage:string = ""

    // Entretien de l'historique à corriger.
    public method load(m:MaintenanceEntity, unit:string = "km"): void {
        self.id = 0
        if m.id is int {
            self.id = m.id
        }
        self.type = m.type
        self.description = m.description
        self.cost = m.cost.toStr()
        self.material_source = m.material_source
        self.lifespan_days = ""
        if m.lifespan_days greater 0 {
            self.lifespan_days = m.lifespan_days.toStr()
        }
        self.mileage = ""
        self.original_mileage = m.mileage
        if m.mileage greater 0 {
            self.mileage = Format::toUnit(m.mileage, unit).toStr()
        }
        self.distance_unit = unit
        self.original_display_mileage = self.mileage
        self.performed_on = m.performed_on
        self.adding = false
        self.editing = true
        self.applyType()
    }

    // Type choisi : champs montrés et obligatoires.
    public method applyType(): void {
        self.is_reading = self.type equal "reading"
        self.is_inspection = self.type equal "technical_inspection"
        self.needs_cost = not self.is_reading and not self.is_inspection
    }

    // Formulaire vide, prêt pour un ajout.
    public method reset(): void {
        self.id = 0
        self.type = "maintenance"
        self.description = ""
        self.cost = ""
        self.material_source = ""
        self.lifespan_days = ""
        self.mileage = ""
        self.original_mileage = 0
        self.original_display_mileage = ""
        self.distance_unit = "km"
        self.performed_on = ""
        self.adding = true
        self.editing = false
        self.applyType()
    }
}
