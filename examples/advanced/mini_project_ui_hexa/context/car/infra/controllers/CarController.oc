namespace context.car.infra.controllers
// Fiche d'une voiture (modifiée sur place), création, suppression et galerie
// photo — actions de l'interface (configs/actions/CarActions.oc). La voiture
// affichée est dans le nœud caché `car_id` de l'écran `car` ; un élément de
// liste (accueil, recherche) porte l'`id` de la sienne. Les formulaires
// (CarForm) sont liés à l'interface : leurs champs suivent la saisie.

import ocara.UI
import ocara.UIEvent
import ocara.File
import ocara.Directory
import ocara.DateTime
import ocara.ConvertException
import context.car.domain.entity.CarEntity
import context.car.domain.contract.CarContract
import context.car.domain.contract.CarPhotoContract
import context.car.app.port.CarViewPort
import context.car.app.usecase.CarDetailsService
import context.car.app.usecase.PricingService
import context.car.app.dto.CarDetailsDTO
import context.car.infra.view.form.CarForm
import context.car.infra.view.helpers.Flash
import context.shared.infra.ui.Screen
import context.shared.infra.i18n.Format

class CarController {

    // Carte choisie (accueil, recherche) : ouvre sa fiche.
    public static method open(ui:UI, event:UIEvent): void {
        var row:map<string, mixed> = event.value()
        var id:int = row["id"]
        self::openId(ui, id)
    }

    // Proposition de la recherche (barre de titre) : sa valeur est l'`id`
    // de la voiture.
    public static method openSuggestion(ui:UI, event:UIEvent): void {
        var id:int = event.value()
        ui.set("top_search", "value", "")
        self::openId(ui, id)
    }

    public static method openId(ui:UI, id:int): void {
        ui.set("car_id", "value", id.toStr())
        ui.navigate("car")
    }

    // Écran `car` affiché (onShow) : la fiche de la voiture courante.
    // Voiture disparue : retour à l'accueil.
    public static method show(ui:UI, event:UIEvent, form:CarForm): void {
        if not self::display(ui, self::current(ui), form) {
            ui.toast(Flash::message("not_found"))
            ui.navigate("home")
        }
    }

    // Fiche complète : formulaire rempli depuis la base, chiffres, galerie,
    // historique.
    public static method display(ui:UI, id:int, form:CarForm): bool {
        const car:CarEntity|null = CarContract::find(id)
        if car is null or not self::refresh(ui, id) {
            return false
        }
        form.load(car)
        ui.set("car_saved", "visible", false)
        return true
    }

    // Chiffres, galerie et historique (après un enregistrement).
    public static method refresh(ui:UI, id:int): bool {
        const details:CarDetailsDTO|null = CarDetailsService::build(id)
        if details is null {
            return false
        }
        Screen::apply(ui, CarViewPort::present(details))
        return true
    }

    public static method current(ui:UI): int {
        var id:string = Screen::text(ui, "car_id")
        if id.empty() {
            return 0
        }
        return id.toInt()
    }

    // Bouton flottant de l'accueil : panneau d'ajout, formulaire vide.
    public static method openNew(ui:UI, event:UIEvent, form:CarForm): void {
        form.clear()
        Screen::error(ui, "home_error", "")
        ui.set("new_car_sheet", "open", true)
    }

    public static method closeNew(ui:UI, event:UIEvent): void {
        ui.set("new_car_sheet", "open", false)
    }

    // « Ajouter la voiture » (champs obligatoires déjà remplis : `submit`).
    public static method add(ui:UI, event:UIEvent, form:CarForm): void {
        Screen::error(ui, "home_error", Flash::message(self::create(ui, form)))
    }

    // Crée la voiture du formulaire et ouvre sa fiche ; rend le code
    // d'erreur, "" si créée.
    public static method create(ui:UI, form:CarForm): string {
        const error:string = self::check(form)
        if not error.empty() {
            return error
        }
        const id:int = CarContract::create(
            form.reference.trim(), form.brand.trim(), form.model.trim(), form.origin,
            self::year(form.year), self::number(form.purchase_price),
            form.acquisition_date.trim(), form.sale_date.trim(),
            Format::toKilometers(self::count(form.mileage)), form.inspection_date.trim()
        )
        form.clear()
        ui.set("new_car_sheet", "open", false)
        ui.toast(Flash::message("car_added"))
        self::openId(ui, id)
        return ""
    }

    // Champ de la fiche quitté, ou choix fait : la voiture est enregistrée
    // si elle a changé (prix de vente estimé recalculé si le prix d'achat
    // change). Erreur : message sur la fiche, rien d'enregistré.
    public static method save(ui:UI, event:UIEvent, form:CarForm): void {
        self::commit(ui, form)
    }

    public static method commit(ui:UI, form:CarForm): void {
        const id:int = self::current(ui)
        const error:string = self::update(id, form)
        Screen::error(ui, "car_error", Flash::message(error))
        if error.empty() {
            self::refresh(ui, id)
            ui.set("car_saved", "visible", true)
        }
    }

    // Rend le code d'erreur ; "" si enregistrée ou inchangée.
    public static method update(id:int, form:CarForm): string {
        const before:CarEntity|null = CarContract::find(id)
        if before is null {
            return "not_found"
        }
        const error:string = self::check(form)
        if not error.empty() {
            return error
        }
        // Compteur inchangé à l'écran : la valeur en kilomètres reste exacte
        // (pas d'aller-retour arrondi par les miles).
        var mileage:int = before.mileage
        if self::count(form.mileage) not equal self::shownMileage(before.mileage) {
            mileage = Format::toKilometers(self::count(form.mileage))
        }
        const after:CarEntity = use CarEntity(
            id, form.reference.trim(), form.brand.trim(), form.model.trim(), form.origin,
            self::year(form.year), self::number(form.purchase_price), before.estimated_price,
            form.acquisition_date.trim(), form.sale_date.trim(), mileage, form.inspection_date.trim()
        )
        if self::same(before, after) {
            return ""
        }
        CarContract::update(after)
        if after.purchase_price not equal before.purchase_price {
            PricingService::recalculateEstimatedPrice(id)
        }
        return ""
    }

    // Contrôles du site : champs texte remplis, prix positif ; plus ici
    // l'année (vide, ou de 1886 à l'an prochain) et le pays proposé.
    public static method check(form:CarForm): string {
        if form.reference.trim().empty() or form.brand.trim().empty() or form.model.trim().empty() {
            return "missing_fields"
        }
        if self::number(form.purchase_price) smaller or equal 0.0 {
            return "invalid_price"
        }
        const year:int = self::year(form.year)
        if year smaller 0 or not CarEntity::validYear(year, DateTime::year(DateTime::now())) {
            return "invalid_year"
        }
        if not form.origin.empty() and not CarEntity::origins().contains(form.origin) {
            return "invalid_origin"
        }
        if self::count(form.mileage) smaller 0 {
            return "invalid_mileage"
        }
        const inspection:string = form.inspection_date.trim()
        if not inspection.empty() and Format::parseDay(inspection) is null {
            return "invalid_date"
        }
        return ""
    }

    // Compteur affiché (unité des paramètres) ; 0 sans compteur.
    private static method shownMileage(km:int): int {
        if km smaller or equal 0 {
            return 0
        }
        return Format::toUnit(km)
    }

    // Nombre entier saisi (compteur, relevé) : 0 si vide, -1 si ce n'est pas
    // un entier positif ou nul (espaces de groupement acceptés : « 12 500 »).
    public static method count(text:string): int {
        const t:string = text.replace(" ", "").trim()
        if t.empty() {
            return 0
        }
        try {
            const n:int = t.toInt()
            if n smaller 0 {
                return -1
            }
            return n
        } on e is ConvertException {
            return -1
        }
    }

    private static method same(a:CarEntity, b:CarEntity): bool {
        return a.reference equal b.reference and a.brand equal b.brand and a.model equal b.model
            and a.origin equal b.origin and a.year equal b.year and a.purchase_price equal b.purchase_price
            and a.acquisition_date equal b.acquisition_date and a.sale_date equal b.sale_date
            and a.mileage equal b.mileage and a.inspection_date equal b.inspection_date
    }

    // Nombre saisi ; 0.0 si le texte n'en est pas un (refusé ensuite comme
    // le site refusait un prix invalide).
    public static method number(text:string): float {
        try {
            return text.trim().replace(",", ".").toFloat()
        } on e is ConvertException {
            return 0.0
        }
    }

    // Année saisie : 0 si vide, -1 si ce n'est pas un entier.
    public static method year(text:string): int {
        const t:string = text.trim()
        if t.empty() {
            return 0
        }
        try {
            return t.toInt()
        } on e is ConvertException {
            return -1
        }
    }

    // Champs obligatoires vides au moment d'envoyer un formulaire (`onInvalid`).
    public static method incomplete(ui:UI, event:UIEvent): void {
        ui.toast(Flash::message("missing_fields"))
    }

    // Corbeille d'une carte (accueil, recherche).
    public static method delete(ui:UI, event:UIEvent): void {
        var row:map<string, mixed> = event.value()
        var id:int = row["id"]
        self::confirmDelete(ui, id)
    }

    // Bouton « Supprimer la voiture » de la fiche.
    public static method deleteCurrent(ui:UI, event:UIEvent): void {
        self::confirmDelete(ui, self::current(ui))
    }

    // Confirmation native, puis retour à l'accueil.
    private static method confirmDelete(ui:UI, id:int): void {
        if not ui.confirm("${confirm_title}", "${confirm_delete_car}") {
            return
        }
        self::remove(id)
        ui.toast(Flash::message("car_deleted"))
        ui.navigate("home")
    }

    public static method remove(id:int): void {
        CarPhotoContract::deleteForCar(id)
        CarContract::delete(id)
    }

    // « Ajouter une photo » : sélecteur natif.
    public static method addPhoto(ui:UI, event:UIEvent): void {
        const source:string = ui.pickFile(["jpg", "jpeg", "png", "webp", "gif"])
        if source.empty() {
            return
        }
        const id:int = self::current(ui)
        if not self::storePhoto(id, source) {
            Screen::error(ui, "car_error", Flash::message("invalid_photo"))
            return
        }
        ui.toast(Flash::message("photo_added"))
        self::refresh(ui, id)
    }

    // Copie la photo `source` dans ./uploads après les contrôles du site :
    // format reconnu à sa signature, 1 octet à 10 Mo. Faux si refusée.
    public static method storePhoto(id:int, source:string): bool {
        const car:CarEntity|null = CarContract::find(id)
        if car is null or not File::exists(source) {
            return false
        }
        var extension:string = match File::extension(source).lower() {
            "jpg" => "jpg"
            "jpeg" => "jpg"
            "png" => "png"
            "webp" => "webp"
            "gif" => "gif"
            default => ""
        }
        var content:array<int> = File::readBytes(source)
        if extension.empty() or not self::validSignature(extension, content)
            or content.len() greater 10485760 or content.len() smaller 1 {
            return false
        }
        Directory::createRecursive("./uploads")
        var photo_id:int = CarPhotoContract::reserve(id)
        var path:string = "uploads/car-" + id.toStr() + "-" + photo_id.toStr() + "." + extension
        File::writeBytes("./" + path, content)
        CarPhotoContract::setPath(photo_id, path)
        return true
    }

    private static method validSignature(extension:string, content:array<int>): bool {
        if extension equal "jpg" and content.len() greater or equal 3 {
            return content[0] equal 255 and content[1] equal 216 and content[2] equal 255
        }
        if extension equal "png" and content.len() greater or equal 8 {
            return content[0] equal 137 and content[1] equal 80
                and content[2] equal 78 and content[3] equal 71
                and content[4] equal 13 and content[5] equal 10
                and content[6] equal 26 and content[7] equal 10
        }
        if extension equal "gif" and content.len() greater or equal 6 {
            return content[0] equal 71 and content[1] equal 73
                and content[2] equal 70 and content[3] equal 56
        }
        if extension equal "webp" and content.len() greater or equal 12 {
            return content[0] equal 82 and content[1] equal 73
                and content[2] equal 70 and content[3] equal 70
                and content[8] equal 87 and content[9] equal 69
                and content[10] equal 66 and content[11] equal 80
        }
        return false
    }

    // Photo de la galerie : en grand.
    public static method openPhoto(ui:UI, event:UIEvent): void {
        var row:map<string, mixed> = event.value()
        ui.set("photo_full", "src", row["path"])
        ui.navigate("photo")
    }
}
