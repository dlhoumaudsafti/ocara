namespace context.car.infra.controllers
// Entretiens de la fiche : ajout et modification par le formulaire lié
// (MaintenanceForm, `id` 0 pour un ajout), suppression depuis l'historique.
// Chaque changement recalcule le prix de vente estimé (PricingService) ; le
// dernier relevé du compteur met à jour celui de la voiture (MileageService).

import ocara.UI
import ocara.UIEvent
import context.car.domain.entity.MaintenanceEntity
import context.car.domain.entity.CarEntity
import context.car.domain.contract.MaintenanceContract
import context.car.domain.contract.CarContract
import context.car.app.usecase.PricingService
import context.car.infra.controllers.CarController
import context.car.infra.view.form.MaintenanceForm
import context.car.infra.view.helpers.Flash
import context.shared.infra.ui.Screen
import context.shared.infra.i18n.Format
import context.car.app.usecase.MileageService
import context.car.infra.files.Upload

const ATTACHMENT_TYPES:array<string> = ["pdf", "jpg", "jpeg", "png", "webp"]
import ocara.DateTime

class MaintenanceController {

    // « Ajouter l'entretien » ou « Mettre à jour » (champs obligatoires déjà
    // remplis : `submit`).
    public static method save(ui:UI, event:UIEvent, form:MaintenanceForm): void {
        self::submit(ui, form)
    }

    public static method submit(ui:UI, form:MaintenanceForm): void {
        const car_id:int = CarController::current(ui)
        const updating:bool = form.id greater 0
        const error:string = self::store(car_id, form)
        Screen::error(ui, "car_error", Flash::message(error))
        if not error.empty() {
            return
        }
        form.reset()
        var message:string = "maintenance_added"
        if updating {
            message = "maintenance_updated"
        }
        ui.toast(Flash::message(message))
        CarController::refresh(ui, car_id)
    }

    // Enregistre l'entretien du formulaire (ajout, ou modification s'il a un
    // `id`) ; rend le code d'erreur, "" si enregistré.
    public static method store(car_id:int, form:MaintenanceForm): string {
        var desc:string = form.description.trim()
        const car:CarEntity|null = CarContract::find(car_id)
        if car is null {
            return "not_found"
        }
        var cost:float = CarController::number(form.cost)
        const lifespan_str:string = form.lifespan_days.trim()
        var lifespan_days:int = 0
        var invalid_lifespan:bool = false
        if not lifespan_str.empty() {
            lifespan_days = CarController::number(lifespan_str).toInt()
            if lifespan_days smaller or equal 0 {
                invalid_lifespan = true
            }
        }
        if not MaintenanceEntity::types().contains(form.type) {
            return "invalid_cost"
        }
        const is_reading:bool = form.type equal "reading"
        const is_inspection:bool = form.type equal "technical_inspection"
        const reading:int = CarController::count(form.mileage)
        if reading smaller 0 {
            return "invalid_mileage"
        }
        // Relevé du compteur : le relevé seul, sans coût ni durée de vie.
        if is_reading and reading equal 0 {
            return "invalid_reading"
        }
        if not is_reading and not is_inspection and (desc.empty() or cost smaller or equal 0.0 or invalid_lifespan) {
            return "invalid_cost"
        }
        if is_reading or is_inspection {
            cost = 0.0
            lifespan_days = 0
        }
        var performed_on:string = form.performed_on.trim()
        if performed_on.empty() {
            performed_on = Format::today(DateTime::now())
        }
        if Format::parseDay(performed_on) is null {
            return "invalid_date"
        }
        const mileage:int = Format::toKilometers(reading, car.distance_unit)
        var old_inspection:bool = false
        if form.id greater 0 {
            const existing:MaintenanceEntity|null = MaintenanceContract::find(form.id)
            if existing is null or existing.car_id not equal car_id {
                return "not_found"
            }
            old_inspection = existing.isInspection()
            // Relevé inchangé à l'écran : la valeur en kilomètres reste exacte.
            var kept:int = mileage
            if form.mileage equal form.original_display_mileage {
                kept = existing.mileage
            }
            MaintenanceContract::update(form.id, form.type, desc, cost, self::source(form), lifespan_days, kept, performed_on)
            // Devenu relevé : plus de justificatif.
            if is_reading {
                for attachment in existing.attachments {
                    Upload::remove(attachment.path)
                }
                if existing.attachments.len() equal 0 and not existing.attachment.empty() {
                    Upload::remove(existing.attachment)
                }
                MaintenanceContract::clearAttachments(form.id)
            }
            MileageService::applyLatestReading(car_id, form.id)
        } else {
            const id:int = MaintenanceContract::create(car_id, form.type, desc, cost, self::source(form), lifespan_days, mileage, performed_on)
            MileageService::applyLatestReading(car_id, id)
        }
        if old_inspection or is_inspection {
            self::syncInspectionDate(car_id)
        }
        // Recalcul complet (pas un simple +=) : voir PricingService.
        PricingService::recalculateEstimatedPrice(car_id)
        return ""
    }

    private static method source(form:MaintenanceForm): string {
        if form.type equal "reading" {
            return ""
        }
        return form.material_source.trim()
    }

    // Type choisi dans le formulaire : champs montrés et obligatoires.
    public static method typeChanged(ui:UI, event:UIEvent, form:MaintenanceForm): void {
        form.applyType()
    }

    // Trombone d'une ligne de l'historique : ajoute une pièce justificative
    // (PDF ou image) sans remplacer les fichiers déjà associés.
    public static method attach(ui:UI, event:UIEvent): void {
        var row:map<string, mixed> = event.value()
        var id:int = row["id"]
        const source:string = ui.pickFile(ATTACHMENT_TYPES)
        if source.empty() {
            return
        }
        const car_id:int = CarController::current(ui)
        const error:string = self::storeAttachment(car_id, id, source)
        Screen::error(ui, "car_error", Flash::message(error))
        if error.empty() {
            ui.toast(Flash::message("attachment_added"))
            CarController::refresh(ui, car_id)
        }
    }

    // Rend le code d'erreur ; "" si le fichier est joint.
    public static method storeAttachment(car_id:int, id:int, source:string): string {
        const m:MaintenanceEntity|null = MaintenanceContract::find(id)
        if m is null or m.car_id not equal car_id or m.isReading() {
            return "not_found"
        }
        const extension:string = Upload::check(source, ATTACHMENT_TYPES)
        if extension.empty() {
            return "invalid_attachment"
        }
        const path:string = Upload::storeUnique(source, extension, "maintenance-" + id.toStr())
        MaintenanceContract::addAttachment(id, path, Upload::fileName(source))
        return ""
    }

    // Croix à côté d'une pièce : elle seule est retirée.
    public static method detach(ui:UI, event:UIEvent): void {
        var row:map<string, mixed> = event.value()
        var maintenance_id:int = row["maintenance_id"]
        var attachment_id:int = row["id"]
        const car_id:int = CarController::current(ui)
        if self::removeOneAttachment(car_id, maintenance_id, attachment_id) {
            CarController::refresh(ui, car_id)
        }
    }

    public static method removeOneAttachment(car_id:int, maintenance_id:int, attachment_id:int): bool {
        const m:MaintenanceEntity|null = MaintenanceContract::find(maintenance_id)
        if m is null or m.car_id not equal car_id {
            return false
        }
        for attachment in m.attachments {
            if attachment.id equal attachment_id {
                Upload::remove(attachment.path)
                return MaintenanceContract::deleteAttachment(maintenance_id, attachment_id)
            }
        }
        if attachment_id equal 0 and not m.attachment.empty() {
            Upload::remove(m.attachment)
            MaintenanceContract::setAttachment(maintenance_id, "", "")
            return true
        }
        return false
    }

    // Retire tous les justificatifs d'une intervention.
    public static method removeAttachment(car_id:int, id:int): bool {
        const m:MaintenanceEntity|null = MaintenanceContract::find(id)
        if m is null or m.car_id not equal car_id {
            return false
        }
        var removed:bool = false
        for attachment in m.attachments {
            Upload::remove(attachment.path)
            removed = true
        }
        if m.attachments.len() equal 0 and not m.attachment.empty() {
            Upload::remove(m.attachment)
            removed = true
        }
        if not removed {
            return false
        }
        MaintenanceContract::clearAttachments(id)
        return true
    }

    // Crayon d'une ligne de l'historique : l'entretien dans le formulaire.
    public static method edit(ui:UI, event:UIEvent, form:MaintenanceForm): void {
        var row:map<string, mixed> = event.value()
        var id:int = row["id"]
        const m:MaintenanceEntity|null = MaintenanceContract::find(id)
        if m is null {
            ui.toast(Flash::message("not_found"))
            return
        }
        const car:CarEntity|null = CarContract::find(m.car_id)
        var unit:string = "km"
        if car is CarEntity {
            unit = car.distance_unit
        }
        form.load(m, unit)
        ui.set("maintenance_form", "focus", true)
    }

    public static method cancel(ui:UI, event:UIEvent, form:MaintenanceForm): void {
        form.reset()
    }

    // Corbeille d'une ligne de l'historique, après confirmation.
    public static method delete(ui:UI, event:UIEvent, form:MaintenanceForm): void {
        var row:map<string, mixed> = event.value()
        var id:int = row["id"]
        if not ui.confirm("${confirm_title}", "${confirm_delete_maintenance}") {
            return
        }
        const car_id:int = CarController::current(ui)
        if not self::remove(car_id, id) {
            ui.toast(Flash::message("not_found"))
            return
        }
        if form.id equal id {
            form.reset()
        }
        ui.toast(Flash::message("maintenance_deleted"))
        CarController::refresh(ui, car_id)
    }

    // Supprime l'entretien `id` de la voiture `car_id` et recalcule son prix
    // de vente estimé ; faux s'il n'est pas à elle.
    public static method remove(car_id:int, id:int): bool {
        const m:MaintenanceEntity|null = MaintenanceContract::find(id)
        if m is null or m.car_id not equal car_id {
            return false
        }
        for attachment in m.attachments {
            Upload::remove(attachment.path)
        }
        if m.attachments.len() equal 0 and not m.attachment.empty() {
            Upload::remove(m.attachment)
        }
        MaintenanceContract::delete(id)
        if m.isInspection() {
            self::syncInspectionDate(car_id)
        }
        PricingService::recalculateEstimatedPrice(car_id)
        return true
    }

    private static method syncInspectionDate(car_id:int): void {
        const latest:MaintenanceEntity|null = MaintenanceContract::latestInspection(car_id)
        var date:string = ""
        if latest is MaintenanceEntity {
            date = latest.performed_on
        }
        CarContract::updateLastInspectionDate(car_id, date)
    }
}
