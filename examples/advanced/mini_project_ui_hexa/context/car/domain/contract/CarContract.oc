namespace context.car.domain.contract

import context.car.domain.entity.CarEntity

interface CarContract {
    wiring context.car.infra.db.CarRepository
    private static method fromRow(row:map<string, mixed>): CarEntity
    public static method find(id:int): CarEntity|null
    public static method create(
        reference       :string,
        brand           :string,
        model           :string,
        origin          :string,
        year            :int,
        purchase_price  :float,
        acquisition_date:string,
        sale_date       :string,
        mileage         :int,
        inspection_date :string
    ): int
    // Champs modifiables de la fiche (pas le prix de vente estimé, recalculé
    // par PricingService).
    public static method update(car:CarEntity): void
    // Compteur mis à jour par le dernier relevé d'un entretien (MileageService).
    public static method updateMileage(id:int, mileage:int): void
    public static method updateEstimatedPrice(id:int, new_price:float): void
    public static method delete(id:int): void
}
