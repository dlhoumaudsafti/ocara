namespace context.car.domain.entity

// Modèle de lecture/écriture propre à ce contexte (fiche détail, création,
// modification). home et search ont leurs propres modèles de lecture
// (context.home.domain.entity, context.search.domain.entity) — jamais
// celui-ci, pour ne pas dépendre du domaine d'un autre contexte.
// `origin` : code ISO du pays d'origine ("" : non renseigné) ; `year` :
// année du modèle (0 : non renseignée) ; `mileage` : compteur en kilomètres ;
// `mileage` est stocké en kilomètres ; l'unité d'affichage est propre au
// véhicule. `inspection_date` conserve l'échéance historique des anciennes
// bases ; la nouvelle échéance est calculée depuis `last_inspection_date`.

class CarEntity {
    public property id:int|null
    public property reference:string
    public property brand:string
    public property model:string
    public property origin:string
    public property year:int
    public property purchase_price:float
    public property estimated_price:float
    public property acquisition_date:string
    public property sale_date:string
    public property mileage:int
    public property inspection_date:string
    public property last_inspection_date:string
    public property is_collection:bool
    public property distance_unit:string

    init(
        id:int|null,
        reference:string,
        brand:string,
        model:string,
        origin:string,
        year:int,
        purchase_price:float,
        estimated_price:float,
        acquisition_date:string,
        sale_date:string,
        mileage:int = 0,
        inspection_date:string = "",
        last_inspection_date:string = "",
        is_collection:bool = false,
        distance_unit:string = "km"
    ) {
        self.id = id
        self.reference = reference
        self.brand = brand
        self.model = model
        self.origin = origin
        self.year = year
        self.purchase_price = purchase_price
        self.estimated_price = estimated_price
        self.acquisition_date = acquisition_date
        self.sale_date = sale_date
        self.mileage = mileage
        self.inspection_date = inspection_date
        self.last_inspection_date = last_inspection_date
        self.is_collection = is_collection
        self.distance_unit = distance_unit
    }

    // Pays d'origine proposés (codes ISO).
    public static method origins(): array<string> {
        return ["FR", "DE", "IT", "GB", "ES", "SE", "CZ", "US", "JP", "KR", "CN"]
    }

    public static method distanceUnits(): array<string> {
        return ["km", "mi"]
    }

    // Première voiture de série : 1886 ; au plus l'an prochain (millésime).
    public static method validYear(year:int, current:int): bool {
        return year equal 0 or (year greater or equal 1886 and year smaller or equal current + 1)
    }
}
