namespace context.car.domain.entity

// `mileage` : relevé du compteur à l'intervention, en kilomètres (0 : aucun) ;
// `performed_on` : date de l'intervention (AAAA-MM-JJ, "" : celle de
// l'enregistrement, `created_at`) ; `attachment` et `attachment_name` gardent
// la dernière pièce jointe pour compatibilité. `attachments` contient tous les
// justificatifs. `type` : `maintenance`, `improvement`, `reading` ou
// `technical_inspection`.

class MaintenanceEntity {
    public property id:int|null
    public property car_id:int
    public property type:string
    public property description:string
    public property cost:float
    public property material_source:string
    public property lifespan_days:int
    public property created_at:int
    public property mileage:int
    public property performed_on:string
    public property attachment:string
    public property attachment_name:string
    public property attachments:array<MaintenanceAttachmentEntity>

    init(
        id:int|null,
        car_id:int,
        type:string,
        description:string,
        cost:float,
        material_source:string,
        lifespan_days:int,
        created_at:int,
        mileage:int = 0,
        performed_on:string = "",
        attachment:string = "",
        attachment_name:string = "",
        attachments:array<MaintenanceAttachmentEntity> = []
    ) {
        self.id = id
        self.car_id = car_id
        self.type = type
        self.description = description
        self.cost = cost
        self.material_source = material_source
        self.lifespan_days = lifespan_days
        self.created_at = created_at
        self.mileage = mileage
        self.performed_on = performed_on
        self.attachment = attachment
        self.attachment_name = attachment_name
        self.attachments = attachments
    }

    public static method types(): array<string> {
        return ["maintenance", "improvement", "reading", "technical_inspection"]
    }

    // Un relevé n'a ni coût ni facture.
    public method isReading(): bool {
        return self.type equal "reading"
    }

    public method isInspection(): bool {
        return self.type equal "technical_inspection"
    }
}
