namespace context.shared.infra.ui
// Menu de l'application (tiroir de chaque écran, ui/ui.d/components.oc.ui
// `navMenu`) : Accueil, Paramètres, Recherche, À propos.

import ocara.UI
import ocara.UIEvent

class NavController {
    public static method home(ui:UI, event:UIEvent): void {
        self::go(ui, "home")
    }

    public static method settings(ui:UI, event:UIEvent): void {
        self::go(ui, "settings")
    }

    // Écran des résultats ; le champ de la barre de titre prend le focus.
    public static method search(ui:UI, event:UIEvent): void {
        self::go(ui, "search")
        ui.set("top_search", "focus", true)
    }

    public static method about(ui:UI, event:UIEvent): void {
        self::go(ui, "about")
    }

    // Ferme le tiroir (sans effet s'il est toujours affiché) et ouvre l'écran.
    private static method go(ui:UI, screen:string): void {
        for menu in self::menus() {
            ui.set(menu, "open", false)
        }
        ui.navigate(screen)
    }

    // `id` des tiroirs : instances de `navMenu`, une par écran.
    public static method menus(): array<string> {
        return ["home_menu", "car_menu", "search_menu", "settings_menu", "about_menu"]
    }
}
