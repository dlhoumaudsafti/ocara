namespace context.shared.infra.db
// examples/advanced/mini_project_ui_hexa/context/shared/infra/db/Database.oc
// Accès SQLite bas niveau : ouverture de connexion + migration du schéma.
//
// Comme dans examples/advanced/tauri_httpserver/configs/Database.oc : pas de propriété
// static en Ocara, donc chaque appel ouvre/ferme sa propre connexion vers le
// même fichier ("./app.db") plutôt que de garder un handle partagé en mémoire.
//
// Chemin RELATIF volontairement inconditionnel (pas de branche
// System::OS == "android") : sur Android, runtime_android_jni fait `chdir()`
// vers le répertoire de données de l'app (Context.getFilesDir()) AVANT de
// démarrer ce programme — "./app.db" y pointe alors déjà, exactement comme
// sur desktop où le répertoire de travail est celui depuis lequel on lance
// le programme. Voir docs/roadmap.d/packaging-android-webview-hybrid.md :
// un chemin absolu construit à la main ici avait fonctionné sur émulateur
// mais échouait sur un vrai appareil (SELinux/OEM plus strict que l'API
// Context.getFilesDir()) — la règle "un chemin relatif = même base que
// app.db" résout les deux à la fois, sans que ce fichier ait besoin de
// connaître la moindre spécificité Android.

import ocara.SQLite

class Database {

    public static method path(): string {
        return "./app.db"
    }

    public static method connect(): SQLite {
        return SQLite::open(self::path())
    }

    public static method migrate(): void {
        const db:SQLite = self::connect()
        self::migrateSchema(db)
        db.close()
    }

    public static method migrateSchema(db:SQLite): void {
        db.execute(`CREATE TABLE IF NOT EXISTS cars (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            reference TEXT NOT NULL,
            brand TEXT NOT NULL,
            model TEXT NOT NULL,
            purchase_price REAL NOT NULL,
            estimated_sale_price REAL NOT NULL,
            created_at INTEGER NOT NULL
        )`)
        var has_acquisition_date:bool = false
        var has_sale_date:bool = false
        for row in db.query("PRAGMA table_info(cars)") {
            var column:string = row["name"]
            if column equal "acquisition_date" {
                has_acquisition_date = true
            }
            if column equal "sale_date" {
                has_sale_date = true
            }
        }
        if not has_acquisition_date {
            db.execute("ALTER TABLE cars ADD COLUMN acquisition_date TEXT NOT NULL DEFAULT ''")
        }
        if not has_sale_date {
            db.execute("ALTER TABLE cars ADD COLUMN sale_date TEXT NOT NULL DEFAULT ''")
        }
        // Pays d'origine (code ISO, "" : non renseigné) et année du modèle (0 : non renseignée).
        if not self::hasColumn(db, "cars", "origin") {
            db.execute("ALTER TABLE cars ADD COLUMN origin TEXT NOT NULL DEFAULT ''")
        }
        if not self::hasColumn(db, "cars", "year") {
            db.execute("ALTER TABLE cars ADD COLUMN year INTEGER NOT NULL DEFAULT 0")
        }
        // Compteur (en kilomètres, affiché dans l'unité des paramètres) et
        // date du contrôle technique ("" : non renseignée).
        if not self::hasColumn(db, "cars", "mileage") {
            db.execute("ALTER TABLE cars ADD COLUMN mileage INTEGER NOT NULL DEFAULT 0")
        }
        if not self::hasColumn(db, "cars", "inspection_date") {
            db.execute("ALTER TABLE cars ADD COLUMN inspection_date TEXT NOT NULL DEFAULT ''")
        }
        db.execute(`CREATE TABLE IF NOT EXISTS maintenances (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            car_id INTEGER NOT NULL,
            type char(20) NOT NULL,
            description TEXT NOT NULL,
            cost REAL NOT NULL,
            created_at INTEGER NOT NULL,
            FOREIGN KEY(car_id) REFERENCES cars(id) ON DELETE CASCADE
        )`)
        var has_material_source:bool = false
        var has_lifespan_days:bool = false
        for row in db.query("PRAGMA table_info(maintenances)") {
            var column:string = row["name"]
            if column equal "material_source" {
                has_material_source = true
            }
            if column equal "lifespan_days" {
                has_lifespan_days = true
            }
        }
        if not has_material_source {
            db.execute("ALTER TABLE maintenances ADD COLUMN material_source TEXT NOT NULL DEFAULT ''")
        }
        if not has_lifespan_days {
            db.execute("ALTER TABLE maintenances ADD COLUMN lifespan_days INTEGER NOT NULL DEFAULT 0")
        }
        // Relevé du compteur à l'intervention (km, 0 : aucun) et date de
        // l'intervention (AAAA-MM-JJ, "" : celle de l'enregistrement).
        if not self::hasColumn(db, "maintenances", "mileage") {
            db.execute("ALTER TABLE maintenances ADD COLUMN mileage INTEGER NOT NULL DEFAULT 0")
        }
        if not self::hasColumn(db, "maintenances", "performed_on") {
            db.execute("ALTER TABLE maintenances ADD COLUMN performed_on TEXT NOT NULL DEFAULT ''")
        }
        // Fichier joint (facture) : chemin dans ./uploads et nom d'origine.
        if not self::hasColumn(db, "maintenances", "attachment") {
            db.execute("ALTER TABLE maintenances ADD COLUMN attachment TEXT NOT NULL DEFAULT ''")
        }
        if not self::hasColumn(db, "maintenances", "attachment_name") {
            db.execute("ALTER TABLE maintenances ADD COLUMN attachment_name TEXT NOT NULL DEFAULT ''")
        }
        db.execute(`CREATE TABLE IF NOT EXISTS car_photos (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            car_id INTEGER NOT NULL,
            path TEXT NOT NULL DEFAULT '',
            FOREIGN KEY(car_id) REFERENCES cars(id) ON DELETE CASCADE
        )`)
        // Photo principale de la voiture (une au plus ; aucune : la première).
        if not self::hasColumn(db, "car_photos", "main") {
            db.execute("ALTER TABLE car_photos ADD COLUMN main INTEGER NOT NULL DEFAULT 0")
        }
        // Préférences (contexte settings) : langue, devise, fuseau horaire.
        db.execute(`CREATE TABLE IF NOT EXISTS settings (
            key TEXT PRIMARY KEY,
            value TEXT NOT NULL
        )`)
    }

    private static method hasColumn(db:SQLite, table:string, column:string): bool {
        for row in db.query("SELECT name FROM pragma_table_info(:table)", {"table": table}) {
            var name:string = row["name"]
            if name equal column {
                return true
            }
        }
        return false
    }

}
