namespace context.home.infra.db
// Lecture directe des tables "cars"/"maintenances" — jamais via
// context.car.infra.db.Car : ce contexte n'a que ses propres besoins
// d'affichage. Le total d'entretiens "maintenance" est déjà agrégé en SQL
// (même règle que context.car.infra.db.Maintenance::maintenanceTotal :
// n'inclut PAS les entretiens de type "improvement").

import ocara.SQLite
import context.shared.infra.db.Database
import context.home.domain.entity.CarSummaryEntity
import context.home.domain.contract.CarSummaryContract

class CarSummaryRepository implements CarSummaryContract {

    private static method fromRow(row:map<string, mixed>): CarSummaryEntity {
        var id:int = row["id"]
        var reference:string = row["reference"]
        var brand:string = row["brand"]
        var model:string = row["model"]
        var purchase_price:float = row["purchase_price"]
        var estimated_price:float = row["estimated_sale_price"]
        var maintenance_total:float = row["maintenance_total"]
        var photo:string = row["photo"]
        return use CarSummaryEntity(
            id,
            reference,
            brand,
            model,
            purchase_price,
            estimated_price,
            maintenance_total,
            photo
        )
    }

    public static method all(withPhotos:bool = false): array<CarSummaryEntity> {
        // Première photo : la sous-requête n'est évaluée que si `:withPhotos`
        // vaut 1 (l'interface affichée la montre).
        var with_photos:int = 0
        if withPhotos {
            with_photos = 1
        }
        const db:SQLite = Database::connect()
        const rows:array<map<string, mixed>> = db.query(`
            SELECT 
                cars.*,
                CASE WHEN :withPhotos = 1 THEN
                    COALESCE((
                        SELECT path FROM car_photos
                        WHERE car_photos.car_id = cars.id AND path != ''
                        ORDER BY car_photos.id LIMIT 1
                    ), '')
                ELSE '' END as photo,
                COALESCE(
                    SUM(
                        CASE WHEN maintenances.type = 'maintenance' THEN
                            maintenances.cost 
                        ELSE 0 END
                    ),
                0) as maintenance_total
            FROM cars LEFT JOIN maintenances ON maintenances.car_id = cars.id
            GROUP BY cars.id ORDER BY cars.created_at DESC
        `, {"withPhotos": with_photos})
        db.close()
        var items:array<CarSummaryEntity> = []
        for row in rows {
            items.push(self::fromRow(row))
        }
        return items
    }
}
