namespace context.home.domain.entity

// Modèle de lecture propre à ce contexte (tableau de bord) — n'est PAS
// context.car.domain.entity.CarEntity : ce contexte n'a besoin que d'un
// résumé déjà agrégé (total d'entretiens inclus) pour l'affichage de chaque
// carte, jamais d'écrire quoi que ce soit. `photo` : chemin de la première
// photo, "" sans photo ou quand l'interface ne l'affiche pas. `origin` : code
// ISO du pays d'origine ("" : non renseigné) ; `year` : année (0 : non renseignée).

class CarSummaryEntity {
    public property id:int
    public property reference:string
    public property brand:string
    public property model:string
    public property purchase_price:float
    public property estimated_price:float
    public property maintenance_total:float
    public property photo:string
    public property origin:string
    public property year:int
    // Compteur, en kilomètres (0 : non renseigné).
    public property mileage:int

    init(
        id:int,
        reference:string,
        brand:string,
        model:string,
        purchase_price:float,
        estimated_price:float,
        maintenance_total:float,
        photo:string = "",
        origin:string = "",
        year:int = 0,
        mileage:int = 0
    ) {
        self.id = id
        self.reference = reference
        self.brand = brand
        self.model = model
        self.purchase_price = purchase_price
        self.estimated_price = estimated_price
        self.maintenance_total = maintenance_total
        self.photo = photo
        self.origin = origin
        self.year = year
        self.mileage = mileage
    }
}
