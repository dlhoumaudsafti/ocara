namespace context.settings.infra.controllers
// Écran `settings` : langue, devise, fuseau horaire, unité de distance et
// thème, enregistrés dès qu'un choix change. Les préférences passent dans
// context.shared.infra.settings.Preferences (formats des autres écrans) ; la
// langue et l'unité remplacent les textes de l'interface (`ui.setVars`), le
// thème est appliqué à chaud (`ui.setTheme`).

import ocara.UI
import ocara.UIEvent
import ocara.DateTime
import ocara.ConvertException
import context.settings.domain.entity.SettingsEntity
import context.settings.app.usecase.SettingsService
import context.settings.app.port.SettingsViewPort
import context.settings.infra.view.SettingsForm
import context.shared.infra.settings.Preferences
import context.shared.infra.i18n.Language
import context.shared.infra.ui.Screen

class SettingsController {

    // Démarrage : préférences enregistrées appliquées.
    public static method boot(): void {
        const settings:SettingsEntity = SettingsService::load()
        Preferences::apply(
            settings.language, settings.currency, settings.timezone, settings.distance_unit, settings.theme,
            settings.inspection_mode, settings.inspection_country, settings.ordinary_inspection_years,
            settings.collection_inspection_years
        )
    }

    // Textes de l'interface dans la langue choisie, unité de distance comprise.
    public static method vars(): map<string, mixed> {
        const vars:map<string, mixed> = Language::vars(Preferences::language())
        for key has value in Preferences::vars() {
            vars[key] = value
        }
        return vars
    }

    public static method show(ui:UI, event:UIEvent, form:SettingsForm): void {
        const settings:SettingsEntity = SettingsService::load()
        form.load(settings)
        Screen::apply(ui, SettingsViewPort::present(settings, DateTime::now()))
    }

    // Un choix a changé : enregistré et appliqué.
    public static method save(ui:UI, event:UIEvent, form:SettingsForm): void {
        self::apply(ui, form)
    }

    // Rend vrai si les préférences du formulaire sont enregistrées.
    public static method apply(ui:UI, form:SettingsForm): bool {
        form.applyMode()
        const language:string = Preferences::language()
        const unit:string = Preferences::distanceUnit()
        const theme:string = Preferences::theme()
        const settings:SettingsEntity|null = SettingsService::update(
            form.language, form.currency, form.timezone, form.distance_unit, form.theme, form.inspection_mode,
            form.inspection_country, self::years(form.ordinary_inspection_years), self::years(form.collection_inspection_years)
        )
        if settings is null {
            ui.toast("${flash_invalid_settings}")
            return false
        }
        Preferences::apply(
            settings.language, settings.currency, settings.timezone, settings.distance_unit, settings.theme,
            settings.inspection_mode, settings.inspection_country, settings.ordinary_inspection_years,
            settings.collection_inspection_years
        )
        if settings.language not equal language or settings.distance_unit not equal unit {
            ui.setVars(self::vars())
        }
        if settings.theme not equal theme {
            ui.setTheme(settings.theme)
        }
        Screen::apply(ui, SettingsViewPort::present(settings, DateTime::now()))
        ui.toast("${flash_settings_saved}")
        return true
    }

    private static method years(value:string): int {
        try {
            return value.trim().toInt()
        } on e is ConvertException {
            return 0
        }
    }
}
