namespace context.settings.infra.db
// Table `settings` (clé → valeur, context.shared.infra.db.Database).

import ocara.SQLite
import context.shared.infra.db.Database
import context.settings.domain.entity.SettingsEntity
import context.settings.domain.contract.SettingsContract

class SettingsRepository implements SettingsContract {

    public static method load(): SettingsEntity {
        const settings:SettingsEntity = SettingsEntity::defaults()
        const db:SQLite = Database::connect()
        const rows:array<map<string, mixed>> = db.query("SELECT key, value FROM settings")
        db.close()
        for row in rows {
            var key:string = row["key"]
            var value:string = row["value"]
            if key equal "language" {
                settings.language = value
            }
            if key equal "currency" {
                settings.currency = value
            }
            if key equal "timezone" {
                settings.timezone = value
            }
            if key equal "distance_unit" {
                settings.distance_unit = value
            }
            if key equal "theme" {
                settings.theme = value
            }
            if key equal "inspection_mode" {
                settings.inspection_mode = value
            }
            if key equal "inspection_country" {
                settings.inspection_country = value
            }
            if key equal "ordinary_inspection_years" {
                settings.ordinary_inspection_years = value.toInt()
            }
            if key equal "collection_inspection_years" {
                settings.collection_inspection_years = value.toInt()
            }
        }
        return settings
    }

    public static method save(settings:SettingsEntity): void {
        SQLite::withOpen(Database::path(), nameless(db:SQLite): void {
            db.begin()
            const values:map<string, string> = {
                "language": settings.language, "currency": settings.currency, "timezone": settings.timezone,
                "distance_unit": settings.distance_unit, "theme": settings.theme,
                "inspection_mode": settings.inspection_mode, "inspection_country": settings.inspection_country,
                "ordinary_inspection_years": settings.ordinary_inspection_years.toStr(),
                "collection_inspection_years": settings.collection_inspection_years.toStr()
            }
            for key has value in values {
                db.execute(
                    "INSERT INTO settings (key, value) VALUES (:key, :value) ON CONFLICT(key) DO UPDATE SET value = :value",
                    {"key": key, "value": value}
                )
            }
            db.commit()
        })
    }
}
