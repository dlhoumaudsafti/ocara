namespace context.search.infra.view
// Écran `search` (ui/ui.d/search.oc.ui) : voitures et entretiens trouvés —
// l'équivalent de templates/search/search.html et des composants car-card et
// search-maintenance de mini_project_hexa. Un résultat porte l'`id` de sa
// voiture : l'action `open_car` ouvre la fiche, sans que ce contexte dépende
// de celui des voitures.

import context.search.app.dto.SearchResultsDto
import context.search.app.port.SearchViewPort
import context.search.app.usecase.helpers.Format

class SearchView implements SearchViewPort {
    public static method present(term:string, results:SearchResultsDto|null): map<string, map<string, mixed>> {
        var cars:array<map<string, mixed>> = []
        var maintenances:array<map<string, mixed>> = []
        if results is null {
            return {
                "search_hint": {"visible": true},
                "search_cars": {"items": cars},
                "search_maintenances": {"items": maintenances},
                "search_cars_empty": {"visible": false},
                "search_maintenances_empty": {"visible": false},
            }
        }
        for car in results.cars {
            cars.push({
                "id": car.id,
                "reference": car.reference,
                "model_line": `${car.brand} ${car.model}`,
                "purchase": Format::price(car.purchase_price),
                "estimated": Format::price(car.estimated_price),
                "maintenance": Format::price(car.maintenance_total),
            })
        }
        for m in results.maintenances {
            maintenances.push({
                "id": m.car_id,
                "car_reference": m.car_reference,
                "badge": match m.type { "improvement" => "${badge_improvement}" default => "${badge_maintenance}" },
                "badge_color": match m.type { "improvement" => "#6a1b9a" default => "#1565c0" },
                "description": m.description,
                "cost": Format::price(m.cost),
            })
        }
        return {
            "search_hint": {"visible": false},
            "search_cars": {"items": cars},
            "search_maintenances": {"items": maintenances},
            "search_cars_empty": {"visible": cars.len() equal 0, "value": "${search_no_cars} « " + term + " »."},
            "search_maintenances_empty": {
                "visible": maintenances.len() equal 0,
                "value": "${search_no_maintenances} « " + term + " »."
            },
        }
    }
}
