namespace context.search.infra.controllers
// Recherche — le champ `top_search` de la barre de titre (tous les écrans) :
// propositions pendant la saisie (menu sous le champ), Entrée ouvre l'écran
// `search` avec les résultats, rafraîchis à chaque affichage (onShow).

import ocara.UI
import ocara.UIEvent
import context.search.app.usecase.SearchService
import context.search.app.dto.SearchResultsDto
import context.search.app.port.SearchViewPort
import context.shared.infra.ui.Screen

class SearchController {

    // Saisie dans le champ : propositions à partir de deux caractères.
    public static method suggest(ui:UI, event:UIEvent): void {
        ui.set("top_search", "suggestions", self::suggestions(Screen::text(ui, "top_search")))
    }

    public static method suggestions(term:string): array<map<string, mixed>> {
        const q:string = term.trim()
        if q.len() smaller 2 {
            return []
        }
        return SearchViewPort::suggestions(SearchService::run(q))
    }

    // Entrée dans le champ : écran des résultats (onShow lance la recherche).
    public static method submit(ui:UI, event:UIEvent): void {
        ui.set("top_search", "suggestions", [])
        ui.navigate("search")
    }

    public static method show(ui:UI, event:UIEvent): void {
        self::search(ui, Screen::text(ui, "top_search"))
    }

    public static method search(ui:UI, term:string): void {
        const q:string = term.trim()
        var results:SearchResultsDto|null = null
        if not q.empty() {
            results = SearchService::run(q)
        }
        Screen::apply(ui, SearchViewPort::present(q, results))
    }
}
