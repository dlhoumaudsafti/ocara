namespace context.search.app.port

import context.search.app.dto.SearchResultsDto

// État de l'écran `search` (ui/ui.d/search.oc.ui) pour un terme et ses
// résultats (`null` : aucun terme saisi).
interface SearchViewPort {
    wiring context.search.infra.view.SearchView
    public static method present(term:string, results:SearchResultsDto|null): map<string, map<string, mixed>>
    // Propositions du champ de recherche (`{ value, text }`).
    public static method suggestions(results:SearchResultsDto): array<map<string, mixed>>
}
