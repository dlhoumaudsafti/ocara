# Carfolio — interface native (ocara.UI) : fenêtre Tauri sur desktop,
# Compose sur Android. Écrans :
#   home      tableau de bord, flotte, ajout d'une voiture (panneau inférieur)
#   car       fiche modifiable sur place, galerie, entretiens
#   search    résultats de la recherche de la barre de titre
#   settings  langue, devise, fuseau horaire
#   about     à propos
#   photo     photo en grand
# Téléphone et fenêtre étroite ; à partir de 840 px/dp : carfolio.md.oc.ui,
# 1200 px/dp : carfolio.lg.oc.ui. Textes : variables `${…}` (languages/<langue>/ui.yaml).
window:
  title: "Carfolio"
  width: 1200
  height: 800
  minWidth: 380
  minHeight: 520
  theme: auto
  # Fond des boutons et du bouton flottant ; texte posé dessus, par thème.
  primary: "#FFD700"
  onPrimary: { light: "#000000", dark: "#ffffff" }
  radius: 6
  android: { systemBars: dark }

# Barre de titre de tous les écrans : recherche, propositions dans un menu
# sous le champ pendant la saisie (SearchController::suggest).
bar:
  type: row
  children:
    - type: input
      id: top_search
      placeholder: "${search_placeholder}"
      width: fill
      onChange: suggest_search
      onSubmit: search_submit
      onSuggestion: open_suggestion

# Composants partagés (menu, formulaires, cartes) et leurs styles.
components:
  includes:
    - ui.d/components.oc.ui

start: home
screens:
  includes:
    - ui.d/home.oc.ui
    - ui.d/car.oc.ui
    - ui.d/search.oc.ui
    - ui.d/settings.oc.ui
    - ui.d/about.oc.ui
    - ui.d/photo.oc.ui
