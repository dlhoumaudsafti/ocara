# Résultats des écrans larges : voitures et entretiens côte à côte. Mêmes id
# et actions que ui.d/search.oc.ui.
screens:
  search:
    title: "${search_title}"
    onShow: show_search
    layout:
      type: column
      spacing: 14
      padding: 20
      children:
        - { type: text, id: search_hint, value: "${search_hint}", style: muted }
        - { type: heading, level: 2, id: search_summary, style: section_title, visible: false }
        - type: row
          spacing: 20
          align: start
          height: fill
          children:
            - type: column
              spacing: 8
              weight: 1
              height: fill
              scroll: true
              children:
                - { type: heading, level: 3, value: "${search_cars}" }
                - { type: text, id: search_cars_empty, style: muted, visible: false }
                - type: list
                  id: search_cars
                  spacing: 8
                  onSelect: open_car
                  item: { type: carCard }
            - type: column
              spacing: 8
              weight: 1
              height: fill
              scroll: true
              children:
                - { type: heading, level: 3, value: "${search_maintenances}" }
                - { type: text, id: search_maintenances_empty, style: muted, visible: false }
                - type: list
                  id: search_maintenances
                  spacing: 6
                  onSelect: open_car
                  item:
                    type: card
                    spacing: 4
                    children:
                      - type: row
                        spacing: 8
                        children:
                          - { type: text, bind: badge, bold: true, binds: { color: badge_color } }
                          - { type: text, bind: car_reference, style: muted, width: fill }
                          - { type: text, bind: cost, bold: true }
                      - { type: text, bind: description }
        - { type: navMenu, id: search_menu }
