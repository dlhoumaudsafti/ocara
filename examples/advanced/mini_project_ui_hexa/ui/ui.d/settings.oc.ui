# Paramètres (toutes les tailles) — SettingsController : choix liés à la
# racine `settings`, enregistrés dès qu'ils changent (save_settings) ;
# l'exemple montre un montant et une date dans les formats choisis.
screens:
  settings:
    title: "${settings_title}"
    onShow: show_settings
    layout:
      type: column
      spacing: 14
      padding: 16
      scroll: true
      children:
        - type: card
          spacing: 10
          width: fill
          children:
            - { type: heading, level: 3, value: "${settings_display}" }
            - { type: label, text: "${field_language}" }
            - type: select
              bind: settings.language
              onChange: save_settings
              options:
                - { value: fr, text: "Français" }
                - { value: en, text: "English" }
            - { type: label, text: "${field_currency}" }
            - type: select
              bind: settings.currency
              onChange: save_settings
              options:
                - { value: EUR, text: "${currency_EUR}" }
                - { value: USD, text: "${currency_USD}" }
                - { value: GBP, text: "${currency_GBP}" }
                - { value: CHF, text: "${currency_CHF}" }
                - { value: CAD, text: "${currency_CAD}" }
                - { value: JPY, text: "${currency_JPY}" }
            - { type: label, text: "${field_timezone}" }
            - type: select
              bind: settings.timezone
              onChange: save_settings
              options:
                - { value: UTC, text: "UTC" }
                - { value: Europe/London, text: "Europe/London (UTC+0)" }
                - { value: Europe/Lisbon, text: "Europe/Lisbon (UTC+0)" }
                - { value: Europe/Paris, text: "Europe/Paris (UTC+1)" }
                - { value: Europe/Berlin, text: "Europe/Berlin (UTC+1)" }
                - { value: Europe/Athens, text: "Europe/Athens (UTC+2)" }
                - { value: America/New_York, text: "America/New_York (UTC−5)" }
                - { value: America/Chicago, text: "America/Chicago (UTC−6)" }
                - { value: America/Los_Angeles, text: "America/Los_Angeles (UTC−8)" }
                - { value: Asia/Dubai, text: "Asia/Dubai (UTC+4)" }
                - { value: Asia/Tokyo, text: "Asia/Tokyo (UTC+9)" }
            - { type: text, value: "${timezone_dst_hint}", style: muted }
            - { type: label, text: "${field_default_distance_unit}" }
            - type: select
              bind: settings.distance_unit
              onChange: save_settings
              options:
                - { value: km, text: "${unit_km}" }
                - { value: mi, text: "${unit_mi}" }
            - { type: label, text: "${field_theme}" }
            - type: select
              bind: settings.theme
              onChange: save_settings
              options:
                - { value: auto, text: "${theme_auto}" }
                - { value: light, text: "${theme_light}" }
                - { value: dark, text: "${theme_dark}" }
        - type: card
          spacing: 10
          width: fill
          children:
            - { type: heading, level: 3, value: "${settings_inspection}" }
            - { type: text, id: settings_inspection_mode, style: highlight }
            - { type: label, text: "${field_inspection_mode}" }
            - type: select
              bind: settings.inspection_mode
              onChange: save_settings
              options:
                - { value: manual, text: "${inspection_mode_manual}" }
                - { value: country, text: "${inspection_mode_country}" }
            - type: column
              spacing: 8
              binds: { visible: settings.manual_mode }
              children:
                - { type: label, text: "${ordinary_vehicle}" }
                - { type: input, bind: settings.ordinary_inspection_years, kind: number, onBlur: save_settings }
                - { type: label, text: "${collection_period_years}" }
                - { type: input, bind: settings.collection_inspection_years, kind: number, onBlur: save_settings }
            - type: column
              spacing: 8
              binds: { visible: settings.country_mode }
              children:
                - { type: label, text: "${field_inspection_country}" }
                - type: select
                  bind: settings.inspection_country
                  onChange: save_settings
                  options:
                    - { value: "", text: "${origin_unknown}" }
                    - { value: FR, text: "${country_FR}" }
                    - { value: DE, text: "${country_DE}" }
                    - { value: IT, text: "${country_IT}" }
                    - { value: GB, text: "${country_GB}" }
                    - { value: ES, text: "${country_ES}" }
                    - { value: SE, text: "${country_SE}" }
                    - { value: CZ, text: "${country_CZ}" }
                    - { value: US, text: "${country_US}" }
                    - { value: JP, text: "${country_JP}" }
                    - { value: KR, text: "${country_KR}" }
                    - { value: CN, text: "${country_CN}" }
            - { type: text, id: settings_inspection_rules_status, style: muted }
            - { type: text, id: settings_inspection_periods, style: muted }
        - type: card
          spacing: 6
          width: fill
          children:
            - { type: heading, level: 3, value: "${settings_preview}" }
            - { type: text, id: settings_price_example, style: stat_value }
            - { type: text, id: settings_date_example, style: muted }
        - { type: navMenu, id: settings_menu }
