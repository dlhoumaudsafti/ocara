# Fiche d'une voiture (téléphone, fenêtre étroite) — CarController::show à
# chaque affichage (onShow). Les champs, liés à la racine `car`, sont
# enregistrés à la volée (save_car, en quittant un champ ou en choisissant) ;
# entretiens ajoutés, modifiés et supprimés depuis la fiche.
screens:
  car:
    title: "${car_screen_title}"
    onShow: show_car
    layout:
      type: column
      spacing: 14
      padding: 16
      scroll: true
      children:
        - { type: text, id: car_id, visible: false }
        - { type: text, id: car_error, style: error, visible: false }
        - { type: carInfo }
        - { type: maintenanceForm }
        - { type: historyCard }
        - { type: photosCard }
        - { type: navMenu, id: car_menu }
