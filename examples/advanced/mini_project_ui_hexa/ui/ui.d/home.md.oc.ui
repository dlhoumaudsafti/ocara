# Tableau de bord des écrans larges : statistiques à gauche, flotte à droite.
# Mêmes id et actions que ui.d/home.oc.ui.

screens:
  home:
    title: "${home_title}"
    onShow: show_home
    layout:
      type: row
      spacing: 20
      padding: 20
      align: start
      children:
        - type: column
          spacing: 10
          width: 320
          children:
            - { type: statCard, id: stat_count, label: "${stat_cars}", value: "0" }
            - { type: statCard, id: stat_purchase, label: "${stat_purchase}" }
            - { type: statCard, id: stat_estimated, label: "${stat_estimated}" }
            - { type: statCard, id: stat_profit, label: "${stat_profit}" }
            - { type: button, text: "${add_car_title}", icon: add, onClick: open_new_car }
        - type: column
          spacing: 10
          weight: 1
          height: fill
          scroll: true
          children:
            - { type: heading, level: 2, value: "${cars_title}", style: section_title }
            - { type: text, id: cars_empty, value: "${cars_empty}", style: muted, visible: false }
            - type: list
              id: cars
              spacing: 8
              onSelect: open_car
              item: { type: carCard }
        - { type: newCarSheet }
        - { type: navMenu, id: home_menu }
