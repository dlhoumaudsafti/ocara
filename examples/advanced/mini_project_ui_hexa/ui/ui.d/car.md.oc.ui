# Fiche des écrans larges : voiture et galerie à gauche, entretiens à
# droite. Mêmes id et actions que ui.d/car.oc.ui.
screens:
  car:
    title: "${car_screen_title}"
    onShow: show_car
    layout:
      type: column
      spacing: 14
      padding: 20
      children:
        - { type: text, id: car_id, visible: false }
        - { type: text, id: car_error, style: error, visible: false }
        - type: row
          spacing: 20
          align: start
          height: fill
          children:
            - type: column
              spacing: 14
              weight: 1
              height: fill
              scroll: true
              children:
                - { type: carInfo }
                - { type: photosCard }
            - type: column
              spacing: 14
              weight: 1
              height: fill
              scroll: true
              children:
                - { type: maintenanceForm }
                - { type: historyCard }
        - { type: navMenu, id: car_menu }
