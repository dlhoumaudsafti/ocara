# Tableau de bord (téléphone, fenêtre étroite) — HomeController::show à chaque
# affichage (onShow) ; ajout d'une voiture : panneau inférieur (newCarSheet),
# ouvert par le bouton flottant, CarController::add.

screens:
  home:
    title: "${home_title}"
    onShow: show_home
    layout:
      type: column
      spacing: 14
      padding: 16
      scroll: true
      children:
        - type: grid
          columns: 2
          spacing: 10
          children:
            - { type: statCard, id: stat_count, label: "${stat_cars}", value: "0" }
            - { type: statCard, id: stat_purchase, label: "${stat_purchase}" }
            - { type: statCard, id: stat_estimated, label: "${stat_estimated}" }
            - { type: statCard, id: stat_profit, label: "${stat_profit}" }
        - { type: heading, level: 2, value: "${cars_title}", style: section_title }
        - { type: text, id: cars_empty, value: "${cars_empty}", style: muted, visible: false }
        - type: list
          id: cars
          spacing: 8
          onSelect: open_car
          item: { type: carCard }
        - { type: fab, icon: add, label: "${add_car_title}", text: "${add_car_short}", onClick: open_new_car }
        - { type: newCarSheet }
        - { type: navMenu, id: home_menu }
