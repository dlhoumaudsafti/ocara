# Résultats de la recherche (téléphone, fenêtre étroite) — le champ est dans
# la barre de titre (`bar` de carfolio.oc.ui) : Entrée lance
# SearchController::submit ; une voiture ou un entretien ouvre la fiche.
screens:
  search:
    title: "${search_title}"
    onShow: show_search
    layout:
      type: column
      spacing: 14
      padding: 16
      scroll: true
      children:
        - { type: text, id: search_hint, value: "${search_hint}", style: muted }
        - { type: heading, level: 2, id: search_summary, style: section_title, visible: false }
        - { type: heading, level: 3, value: "${search_cars}" }
        - { type: text, id: search_cars_empty, style: muted, visible: false }
        - type: list
          id: search_cars
          spacing: 8
          onSelect: open_car
          item: { type: carCard }
        - { type: heading, level: 3, value: "${search_maintenances}" }
        - { type: text, id: search_maintenances_empty, style: muted, visible: false }
        - type: list
          id: search_maintenances
          spacing: 6
          onSelect: open_car
          item:
            type: row
            spacing: 8
            children:
              - { type: text, bind: badge, bold: true, binds: { color: badge_color } }
              - { type: text, bind: description, width: fill }
              - { type: text, bind: car_reference, style: muted }
              - { type: text, bind: cost, bold: true }
        - { type: navMenu, id: search_menu }
