# Tableau de bord des très grands écrans : statistiques en ligne, flotte en
# grille avec la première photo de chaque voiture (chargée seulement ici :
# HomeController regarde `ui.has("car_photo")`). Menu toujours affiché.
# Mêmes id et actions que ui.d/home.oc.ui.

screens:
  home:
    title: "${home_title}"
    onShow: show_home
    layout:
      type: column
      spacing: 16
      padding: 20
      children:
        - type: row
          spacing: 12
          align: center
          children:
            - { type: statCard, id: stat_count, label: "${stat_cars}", value: "0", weight: 1 }
            - { type: statCard, id: stat_purchase, label: "${stat_purchase}", weight: 1 }
            - { type: statCard, id: stat_estimated, label: "${stat_estimated}", weight: 1 }
            - { type: statCard, id: stat_profit, label: "${stat_profit}", weight: 1 }
            - { type: button, text: "${add_car_title}", icon: add, onClick: open_new_car }
        - { type: heading, level: 2, value: "${cars_title}", style: section_title }
        - { type: text, id: cars_empty, value: "${cars_empty}", style: muted, visible: false }
        - type: list
          id: cars
          display: grid
          itemWidth: 320
          spacing: 10
          height: fill
          onSelect: open_car
          item:
            type: card
            spacing: 6
            children:
              - type: row
                spacing: 8
                children:
                  - { type: text, bind: reference, style: card_ref }
                  - { type: text, bind: model_line, width: fill }
                  - { type: iconButton, icon: delete, label: "${delete_label}", tooltip: "${delete_label}", onClick: delete_car, color: "#c62828" }
              - { type: image, id: car_photo, bind: photo, label: "${photo_label}", width: fill, height: 160, fit: cover, radius: 4, binds: { visible: has_photo } }
              - { type: text, bind: origin_line, style: muted, binds: { visible: has_origin_line } }
              - type: row
                spacing: 20
                children:
                  - { type: cardFact, label: "${card_purchase}", value: { bind: purchase } }
                  - { type: cardFact, label: "${card_estimated}", value: { bind: estimated }, tone: highlight }
                  - { type: cardFact, label: "${card_maintenance}", value: { bind: maintenance } }
        - { type: newCarSheet }
        - { type: navMenu, id: home_menu }
