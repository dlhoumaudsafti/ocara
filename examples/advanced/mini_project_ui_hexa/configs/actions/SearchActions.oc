namespace configs.actions
// Recherche de la barre de titre : propositions, écran des résultats.

import ocara.UI
import context.search.infra.controllers.SearchController

class SearchActions {
    init(ui:UI) {
        ui.on("suggest_search", SearchController::suggest)
        ui.on("search_submit", SearchController::submit)
        ui.on("show_search", SearchController::show)
    }
}
