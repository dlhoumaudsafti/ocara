namespace configs.actions
// Menu de l'application (tiroir) : Accueil, Paramètres, Recherche, À propos.

import ocara.UI
import context.shared.infra.ui.NavController

class NavActions {
    init(ui:UI) {
        ui.on("go_home", NavController::home)
        ui.on("go_settings", NavController::settings)
        ui.on("go_search", NavController::search)
        ui.on("go_about", NavController::about)
    }
}
