namespace configs
// L'interface native de Carfolio : l'interface (ui/carfolio.oc.ui, lue et
// validée à la compilation) et ses actions (configs/actions/). Langue des
// textes, unité de distance et thème : ceux des paramètres enregistrés
// (SettingsController::boot).

import ocara.UI
import ocara.IO
import configs.actions.NavActions
import configs.actions.HomeActions
import configs.actions.CarActions
import configs.actions.SearchActions
import configs.actions.SettingsActions
import configs.actions.AboutActions
import context.shared.infra.settings.Preferences
import context.settings.infra.controllers.SettingsController

class App {
    private property ui:UI

    init() {
        IO::writeln("Configuration de l'interface...")
        SettingsController::boot()
        self.ui = use UI("../ui/carfolio.oc.ui", SettingsController::vars())
        self.ui.setTheme(Preferences::theme())
    }

    public method actions(): void {
        IO::writeln("Configuration des actions...")
        use NavActions(self.ui)
        use HomeActions(self.ui)
        use CarActions(self.ui)
        use SearchActions(self.ui)
        use SettingsActions(self.ui)
        use AboutActions(self.ui)
    }

    // Affiche l'interface et rend la main à sa fermeture.
    public method run(): void {
        IO::writeln("Ouverture de l'interface...")
        self.ui.run()
    }
}
