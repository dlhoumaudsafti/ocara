// Base en mémoire des faux dépôts (tests/support/fake/Fake*Repository) :
// lignes `cars` et `maintenances` au format des tables SQLite, partagées par
// les contextes car, home et search comme la vraie base. Un test la remplit
// avec la même API que tests.support.Fixture, sans toucher à `./app.db` ;
// il déclare les faux dépôts dans sa classe (`wiring tests.support.fake.…`).

import ocara.DateTime

const FAKE_CARS:array<map<string, mixed>> = []
const FAKE_MAINTENANCES:array<map<string, mixed>> = []
const FAKE_MAINTENANCE_ATTACHMENTS:array<map<string, mixed>> = []
const FAKE_CAR_PHOTOS:array<map<string, mixed>> = []
const FAKE_SETTINGS:map<string, string> = {}
const FAKE_SEQUENCE:map<string, int> = {"id": 0}

class FakeDatabase {

    // Base vide.
    public static method reset(): void {
        self::clear(FAKE_CARS)
        self::clear(FAKE_MAINTENANCES)
        self::clear(FAKE_MAINTENANCE_ATTACHMENTS)
        self::clear(FAKE_CAR_PHOTOS)
        for key in FAKE_SETTINGS.keys() {
            var name:string = key
            FAKE_SETTINGS.remove(name)
        }
    }

    public static method cleanup(): void {
        self::reset()
    }

    // Voiture de test `TEST-OCUNIT-<suffix>` ; prix de vente estimé = prix d'achat.
    public static method car(suffix:string, brand:string, model:string, price:float): int {
        return self::insertCar("TEST-OCUNIT-" + suffix, brand, model, "", 0, price, "", "")
    }

    public static method maintenance(car_id:int, type:string, description:string, cost:float): void {
        self::insertMaintenance(car_id, type, description, cost, "", 0)
    }

    public static method insertCar(
        reference:string,
        brand:string,
        model:string,
        origin:string,
        year:int,
        price:float,
        acquisition_date:string,
        sale_date:string,
        mileage:int = 0,
        inspection_date:string = "",
        last_inspection_date:string = "",
        is_collection:bool = false,
        distance_unit:string = "km"
    ): int {
        const id:int = self::nextId()
        var collection:int = 0
        if is_collection {
            collection = 1
        }
        FAKE_CARS.push({
            "id": id,
            "reference": reference,
            "brand": brand,
            "model": model,
            "origin": origin,
            "year": year,
            "purchase_price": price,
            "estimated_sale_price": price,
            "acquisition_date": acquisition_date,
            "sale_date": sale_date,
            "mileage": mileage,
            "inspection_date": inspection_date,
            "last_inspection_date": last_inspection_date,
            "is_collection": collection,
            "distance_unit": distance_unit,
            "created_at": DateTime::now()
        })
        return id
    }

    public static method insertMaintenance(
        car_id:int,
        type:string,
        description:string,
        cost:float,
        material_source:string,
        lifespan_days:int,
        mileage:int = 0,
        performed_on:string = ""
    ): int {
        const id:int = self::nextId()
        FAKE_MAINTENANCES.push({
            "id": id,
            "car_id": car_id,
            "type": type,
            "description": description,
            "cost": cost,
            "material_source": material_source,
            "lifespan_days": lifespan_days,
            "mileage": mileage,
            "performed_on": performed_on,
            "attachment": "",
            "attachment_name": "",
            "created_at": DateTime::now()
        })
        return id
    }

    // Lignes de voitures, la plus récente d'abord (`ORDER BY created_at DESC`).
    public static method cars(): array<map<string, mixed>> {
        return self::newestFirst(FAKE_CARS)
    }

    // Entretiens d'une voiture (`0` : tous), le plus récent d'abord.
    public static method maintenances(car_id:int): array<map<string, mixed>> {
        var rows:array<map<string, mixed>> = []
        for row in self::newestFirst(FAKE_MAINTENANCES) {
            var owner:int = row["car_id"]
            if car_id equal 0 or owner equal car_id {
                rows.push(row)
            }
        }
        return rows
    }

    // Ligne de la voiture `id`, vide si elle n'existe pas (comme `queryOne`).
    public static method carRow(id:int): map<string, mixed> {
        for row in FAKE_CARS {
            var row_id:int = row["id"]
            if row_id equal id {
                return row
            }
        }
        return {}
    }

    // Somme des entretiens d'un type pour une voiture.
    public static method total(car_id:int, type:string): float {
        var sum:float = 0.0
        for row in self::maintenances(car_id) {
            var row_type:string = row["type"]
            var cost:float = row["cost"]
            if row_type equal type {
                sum += cost
            }
        }
        return sum
    }

    // Champs modifiables d'une voiture (CarContract::update).
    public static method updateCar(
        id:int,
        reference:string,
        brand:string,
        model:string,
        origin:string,
        year:int,
        price:float,
        acquisition_date:string,
        sale_date:string,
        mileage:int,
        inspection_date:string,
        last_inspection_date:string = "",
        is_collection:bool = false,
        distance_unit:string = "km"
    ): void {
        const row:map<string, mixed> = self::carRow(id)
        if row.size() equal 0 {
            return
        }
        row["reference"] = reference
        row["brand"] = brand
        row["model"] = model
        row["origin"] = origin
        row["year"] = year
        row["purchase_price"] = price
        row["acquisition_date"] = acquisition_date
        row["sale_date"] = sale_date
        row["mileage"] = mileage
        row["inspection_date"] = inspection_date
        row["last_inspection_date"] = last_inspection_date
        var collection:int = 0
        if is_collection {
            collection = 1
        }
        row["is_collection"] = collection
        row["distance_unit"] = distance_unit
    }

    public static method setMileage(id:int, mileage:int): void {
        const row:map<string, mixed> = self::carRow(id)
        if row.size() greater 0 {
            row["mileage"] = mileage
        }
    }

    public static method setLastInspectionDate(id:int, date:string): void {
        const row:map<string, mixed> = self::carRow(id)
        if row.size() greater 0 {
            row["last_inspection_date"] = date
        }
    }

    // Dernier relevé : jour de l'entretien le plus récent (sinon celui de
    // l'enregistrement), puis dernier enregistré — comme la requête SQL.
    public static method latestReading(car_id:int): map<string, mixed> {
        var best:map<string, mixed> = {}
        var best_day:int = 0
        for row in FAKE_MAINTENANCES {
            var owner:int = row["car_id"]
            var mileage:int = row["mileage"]
            if owner equal car_id and mileage greater 0 {
                var performed:string = row["performed_on"]
                var day:int = row["created_at"]
                if not performed.empty() {
                    day = DateTime::parse(performed + "T00:00:00")
                } else {
                    day = day - day % 86400
                }
                // Lignes dans l'ordre d'enregistrement : à jour égal, la dernière gagne.
                if best.size() equal 0 or day greater or equal best_day {
                    best = row
                    best_day = day
                }
            }
        }
        return best
    }

    // Ligne de l'entretien `id`, vide s'il n'existe pas.
    public static method maintenanceRow(id:int): map<string, mixed> {
        for row in FAKE_MAINTENANCES {
            var row_id:int = row["id"]
            if row_id equal id {
                return row
            }
        }
        return {}
    }

    public static method updateMaintenance(
        id:int,
        type:string,
        description:string,
        cost:float,
        material_source:string,
        lifespan_days:int,
        mileage:int,
        performed_on:string
    ): void {
        const row:map<string, mixed> = self::maintenanceRow(id)
        if row.size() equal 0 {
            return
        }
        row["type"] = type
        row["description"] = description
        row["cost"] = cost
        row["material_source"] = material_source
        row["lifespan_days"] = lifespan_days
        row["mileage"] = mileage
        row["performed_on"] = performed_on
    }

    public static method deleteMaintenance(id:int): void {
        self::removeWhere(FAKE_MAINTENANCES, "id", id)
        self::removeWhere(FAKE_MAINTENANCE_ATTACHMENTS, "maintenance_id", id)
    }

    // Table `settings` (clé → valeur).
    public static method settings(): map<string, string> {
        return FAKE_SETTINGS
    }

    public static method setSetting(key:string, value:string): void {
        FAKE_SETTINGS[key] = value
    }

    public static method setEstimatedPrice(id:int, price:float): void {
        const row:map<string, mixed> = self::carRow(id)
        if row.size() greater 0 {
            row["estimated_sale_price"] = price
        }
    }

    // La voiture et ses entretiens.
    public static method deleteCar(id:int): void {
        self::removeWhere(FAKE_MAINTENANCES, "car_id", id)
        self::removeWhere(FAKE_CAR_PHOTOS, "car_id", id)
        self::removeWhere(FAKE_CARS, "id", id)
    }

    public static method addPhoto(car_id:int, path:string): int {
        const id:int = self::nextId()
        FAKE_CAR_PHOTOS.push({"id": id, "car_id": car_id, "path": path, "main": false})
        return id
    }

    public static method setPhotoPath(id:int, path:string): void {
        for row in FAKE_CAR_PHOTOS {
            var photo_id:int = row["id"]
            if photo_id equal id {
                row["path"] = path
            }
        }
    }

    public static method photos(car_id:int): array<string> {
        var paths:array<string> = []
        for row in FAKE_CAR_PHOTOS {
            var owner:int = row["car_id"]
            if owner equal car_id {
                var path:string = row["path"]
                paths.push(path)
            }
        }
        return paths
    }

    // Photos d'une voiture (lignes), la principale d'abord, chemin renseigné.
    public static method photoRows(car_id:int): array<map<string, mixed>> {
        var main:array<map<string, mixed>> = []
        var others:array<map<string, mixed>> = []
        for row in FAKE_CAR_PHOTOS {
            var owner:int = row["car_id"]
            var path:string = row["path"]
            var is_main:bool = row["main"]
            if owner equal car_id and not path.empty() {
                if is_main {
                    main.push(row)
                } else {
                    others.push(row)
                }
            }
        }
        for row in others {
            main.push(row)
        }
        return main
    }

    // Faux si la photo n'est pas à la voiture.
    public static method setMainPhoto(car_id:int, photo_id:int): bool {
        var found:bool = false
        for row in FAKE_CAR_PHOTOS {
            var owner:int = row["car_id"]
            var id:int = row["id"]
            if owner equal car_id and id equal photo_id {
                found = true
            }
        }
        if not found {
            return false
        }
        for row in FAKE_CAR_PHOTOS {
            var owner:int = row["car_id"]
            var id:int = row["id"]
            if owner equal car_id {
                row["main"] = id equal photo_id
            }
        }
        return true
    }

    public static method deletePhoto(car_id:int, photo_id:int): bool {
        var selected:map<string, mixed> = {}
        for row in FAKE_CAR_PHOTOS {
            if row["car_id"] equal car_id and row["id"] equal photo_id {
                selected = row
            }
        }
        if selected.size() equal 0 {
            return false
        }
        const was_main:bool = selected["main"]
        self::removeWhere(FAKE_CAR_PHOTOS, "id", photo_id)
        if was_main {
            for row in FAKE_CAR_PHOTOS {
                if row["car_id"] equal car_id {
                    row["main"] = false
                }
            }
            var first:int = 0
            for row in FAKE_CAR_PHOTOS {
                if row["car_id"] equal car_id and (first equal 0 or row["id"] smaller first) {
                    first = row["id"]
                }
            }
            for row in FAKE_CAR_PHOTOS {
                if row["id"] equal first {
                    row["main"] = true
                }
            }
        }
        return true
    }

    public static method setAttachment(id:int, path:string, name:string): void {
        const row:map<string, mixed> = self::maintenanceRow(id)
        if row.size() greater 0 {
            row["attachment"] = path
            row["attachment_name"] = name
        }
    }

    public static method attachments(maintenance_id:int): array<map<string, mixed>> {
        var items:array<map<string, mixed>> = []
        for row in FAKE_MAINTENANCE_ATTACHMENTS {
            if row["maintenance_id"] equal maintenance_id {
                items.push(row)
            }
        }
        return items
    }

    public static method addAttachment(maintenance_id:int, path:string, name:string): int {
        const id:int = self::nextId()
        FAKE_MAINTENANCE_ATTACHMENTS.push({
            "id": id, "maintenance_id": maintenance_id, "path": path, "name": name
        })
        self::setAttachment(maintenance_id, path, name)
        return id
    }

    public static method deleteAttachment(maintenance_id:int, attachment_id:int): bool {
        var found:bool = false
        for row in FAKE_MAINTENANCE_ATTACHMENTS {
            if row["maintenance_id"] equal maintenance_id and row["id"] equal attachment_id {
                found = true
            }
        }
        if not found {
            return false
        }
        self::removeWhere(FAKE_MAINTENANCE_ATTACHMENTS, "id", attachment_id)
        var remaining:array<map<string, mixed>> = self::attachments(maintenance_id)
        if remaining.len() equal 0 {
            self::setAttachment(maintenance_id, "", "")
        } else {
            const last_index:int = remaining.len() - 1
            var latest:map<string, mixed> = remaining[last_index]
            self::setAttachment(maintenance_id, latest["path"], latest["name"])
        }
        return true
    }

    public static method clearAttachments(maintenance_id:int): void {
        self::removeWhere(FAKE_MAINTENANCE_ATTACHMENTS, "maintenance_id", maintenance_id)
        self::setAttachment(maintenance_id, "", "")
    }

    public static method deletePhotos(car_id:int): void {
        self::removeWhere(FAKE_CAR_PHOTOS, "car_id", car_id)
    }

    public static method estimatedPrice(car_id:int): float {
        var price:float = self::carRow(car_id)["estimated_sale_price"]
        return price
    }

    public static method carExists(car_id:int): bool {
        return self::carRow(car_id).size() greater 0
    }

    public static method maintenanceCount(car_id:int): int {
        return self::maintenances(car_id).len()
    }

    private static method nextId(): int {
        FAKE_SEQUENCE["id"] = FAKE_SEQUENCE["id"] + 1
        return FAKE_SEQUENCE["id"]
    }

    private static method newestFirst(rows:array<map<string, mixed>>): array<map<string, mixed>> {
        var ordered:array<map<string, mixed>> = []
        var i:int = rows.len() - 1
        while i greater or equal 0 {
            ordered.push(rows[i])
            i -= 1
        }
        return ordered
    }

    private static method removeWhere(rows:array<map<string, mixed>>, key:string, id:int): void {
        var kept:array<map<string, mixed>> = []
        for row in rows {
            var value:int = row[key]
            if value not equal id {
                kept.push(row)
            }
        }
        self::clear(rows)
        for row in kept {
            rows.push(row)
        }
    }

    private static method clear(rows:array<map<string, mixed>>): void {
        while rows.len() greater 0 {
            rows.pop()
        }
    }
}
