// MaintenanceContract en mémoire (tests.support.fake.FakeDatabase) —
// remplace context.car.infra.db.MaintenanceRepository dans un test qui
// déclare `wiring tests.support.fake.FakeMaintenanceRepository`.

import context.car.domain.entity.MaintenanceEntity
import context.car.domain.contract.MaintenanceContract
import tests.support.fake.FakeDatabase

class FakeMaintenanceRepository implements MaintenanceContract {

    private static method fromRow(row:map<string, mixed>): MaintenanceEntity {
        var id:int = row["id"]
        var car_id:int = row["car_id"]
        var type:string = row["type"]
        var description:string = row["description"]
        var cost:float = row["cost"]
        var material_source:string = row["material_source"]
        var lifespan_days:int = row["lifespan_days"]
        var created_at:int = row["created_at"]
        return use MaintenanceEntity(
            id, car_id, type, description, cost, material_source, lifespan_days, created_at
        )
    }

    public static method find(id:int): MaintenanceEntity|null {
        const row:map<string, mixed> = FakeDatabase::maintenanceRow(id)
        if row.size() equal 0 {
            return null
        }
        return self::fromRow(row)
    }

    public static method update(
        id:int,
        type:string,
        description:string,
        cost:float,
        material_source:string,
        lifespan_days:int
    ): void {
        FakeDatabase::updateMaintenance(id, type, description, cost, material_source, lifespan_days)
    }

    public static method delete(id:int): void {
        FakeDatabase::deleteMaintenance(id)
    }

    public static method create(
        car_id:int,
        type:string,
        description:string,
        cost:float,
        material_source:string,
        lifespan_days:int
    ): int {
        return FakeDatabase::insertMaintenance(
            car_id, type, description, cost, material_source, lifespan_days
        )
    }

    public static async method forCar(car_id:int): array<MaintenanceEntity> {
        var items:array<MaintenanceEntity> = []
        for row in FakeDatabase::maintenances(car_id) {
            items.push(self::fromRow(row))
        }
        return items
    }

    public static async method maintenanceTotal(car_id:int): float {
        return FakeDatabase::total(car_id, "maintenance")
    }

    public static async method improvementTotal(car_id:int): float {
        return FakeDatabase::total(car_id, "improvement")
    }
}
