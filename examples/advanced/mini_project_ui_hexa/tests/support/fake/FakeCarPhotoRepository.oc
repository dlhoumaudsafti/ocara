// CarPhotoContract en mémoire (tests.support.fake.FakeDatabase).

import context.car.domain.entity.CarPhotoEntity
import context.car.domain.contract.CarPhotoContract
import tests.support.fake.FakeDatabase

class FakeCarPhotoRepository implements CarPhotoContract {
    public static method reserve(car_id:int): int {
        return FakeDatabase::addPhoto(car_id, "")
    }

    public static method setPath(id:int, path:string): void {
        FakeDatabase::setPhotoPath(id, path)
    }

    public static method forCar(car_id:int): array<CarPhotoEntity> {
        var photos:array<CarPhotoEntity> = []
        for row in FakeDatabase::photoRows(car_id) {
            var id:int = row["id"]
            var path:string = row["path"]
            var main:bool = row["main"]
            photos.push(use CarPhotoEntity(id, path, main))
        }
        return photos
    }

    public static method setMain(car_id:int, photo_id:int): bool {
        return FakeDatabase::setMainPhoto(car_id, photo_id)
    }

    public static method deletePhoto(car_id:int, photo_id:int): bool {
        return FakeDatabase::deletePhoto(car_id, photo_id)
    }

    public static method deleteForCar(car_id:int): void {
        FakeDatabase::deletePhotos(car_id)
    }
}
