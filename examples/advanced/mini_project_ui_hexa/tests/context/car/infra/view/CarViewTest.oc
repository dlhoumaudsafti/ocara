import ocara.UnitTest
import ocara.DateTime
import context.car.domain.entity.CarEntity
import context.car.domain.entity.MaintenanceEntity
import context.car.domain.entity.CarPhotoEntity
import context.car.app.dto.CarDetailsDTO
import context.car.infra.view.CarView
import context.shared.infra.settings.Preferences

// État de l'écran `car` : la fiche de templates/car/car_detail.html de
// mini_project_hexa, sous forme de propriétés de nœuds.
class CarViewTest extends UnitTest {

    public method presentTest(): int {
        Preferences::reset()
        const car:CarEntity = use CarEntity(
            7, "REF-VIEW", "Peugeot", "308", "FR", 2015, 12000.5, 12500.5, "2024-01-01", ""
        )
        var maintenances:array<MaintenanceEntity> = []
        maintenances.push(use MaintenanceEntity(1, 7, "maintenance", "Vidange moteur", 80.0, "Garage", 0, 1790251200))
        maintenances.push(use MaintenanceEntity(2, 7, "improvement", "Peinture", 500.0, "", 0, 1790251200))
        const details:CarDetailsDTO = use CarDetailsDTO(car, maintenances, [use CarPhotoEntity(3, "uploads/photo.jpg", true)], 80.0, 500.0)

        const state:map<string, map<string, mixed>> = CarView::present(details)
        self::assertEquals("7", state["car_id"]["value"])
        self::assertEquals(
            "Peugeot 308 · ${country_FR} · 2015 · ${label_acquisition} : 2024-01-01 · ${label_sale} : ${not_set}",
            state["car_summary"]["value"]
        )
        self::assertEquals("12 000,50 €", state["car_purchase.value"]["value"])
        self::assertEquals("12 500,50 €", state["car_estimated.value"]["value"])
        self::assertEquals("80,00 €", state["car_maintenance_total.value"]["value"])
        self::assertEquals("500,00 €", state["car_improvement_total.value"]["value"])
        self::assertEquals(false, state["history_empty"]["visible"])
        self::assertEquals(false, state["photos_empty"]["visible"])

        var rows:array<map<string, mixed>> = state["maintenances"]["items"]
        self::assertEquals(2, rows.len())
        // `id` : pour modifier ou supprimer l'entretien depuis l'historique.
        self::assertEquals(1, rows[0]["id"])
        self::assertEquals("${badge_maintenance}", rows[0]["badge"])
        self::assertEquals("Vidange moteur", rows[0]["description"])
        self::assertEquals("${source_label} : Garage", rows[0]["source"])
        self::assertEquals(true, rows[0]["has_source"])
        self::assertEquals("24/09/2026", rows[0]["date"])
        self::assertEquals("${badge_improvement}", rows[1]["badge"])
        self::assertEquals(false, rows[1]["has_source"])
        self::assertEquals(false, rows[1]["has_warning"])

        var photos:array<map<string, mixed>> = state["photos"]["items"]
        self::assertEquals("uploads/photo.jpg", photos[0]["path"])
        self::assertEquals(3, photos[0]["id"])
        self::assertEquals("#FFC107", photos[0]["star_color"])
        self::assertEquals("uploads/photo.jpg", state["car_main_photo"]["src"])
        self::assertEquals(true, state["car_main_photo"]["visible"])
        return 0
    }

    public method presentWithoutDataTest(): int {
        const car:CarEntity = use CarEntity(8, "REF-EMPTY", "Renault", "Clio", "", 0, 8000.0, 8000.0, "", "")
        const details:CarDetailsDTO = use CarDetailsDTO(car, [], [], 0.0, 0.0)
        const state:map<string, map<string, mixed>> = CarView::present(details)
        self::assertEquals(true, state["history_empty"]["visible"])
        self::assertEquals(true, state["photos_empty"]["visible"])
        self::assertEquals(false, state["car_main_photo"]["visible"])
        // Ni pays ni année : absents du résumé.
        self::assertEquals(
            "Renault Clio · ${label_acquisition} : ${not_set} · ${label_sale} : ${not_set}",
            state["car_summary"]["value"]
        )
        return 0
    }

    // Compteur et contrôle technique dans le résumé ; relevé et date de
    // l'intervention dans l'historique.
    public method mileageAndInspectionTest(): int {
        Preferences::reset()
        const car:CarEntity = use CarEntity(
            11, "REF-KM", "Renault", "Clio", "FR", 2016, 9000.0, 9000.0, "", "", 84500, "2030-04-15"
        )
        var maintenances:array<MaintenanceEntity> = []
        maintenances.push(use MaintenanceEntity(5, 11, "maintenance", "Vidange", 80.0, "", 0, 1790251200, 84500, "2026-02-03"))
        const state:map<string, map<string, mixed>> = CarView::present(use CarDetailsDTO(car, maintenances, [], 80.0, 0.0))
        self::assertEquals(
            "Renault Clio · ${country_FR} · 2016 · 84 500 km · ${label_acquisition} : ${not_set} · ${label_sale} : ${not_set} · ${label_inspection} : 15/04/2030",
            state["car_summary"]["value"]
        )
        self::assertEquals(false, state["car_inspection"]["visible"])
        var rows:array<map<string, mixed>> = state["maintenances"]["items"]
        self::assertEquals("03/02/2026", rows[0]["date"])
        self::assertEquals("${reading_label} : 84 500 km", rows[0]["mileage"])
        self::assertEquals(true, rows[0]["has_mileage"])
        return 0
    }

    // Relevé : badge propre, ni coût ni facture ; facture d'un entretien.
    public method readingAndAttachmentRowsTest(): int {
        Preferences::reset()
        const car:CarEntity = use CarEntity(12, "REF-R", "Fiat", "Panda", "IT", 2012, 5000.0, 5000.0, "", "")
        var maintenances:array<MaintenanceEntity> = []
        maintenances.push(use MaintenanceEntity(6, 12, "reading", "", 0.0, "", 0, 1790251200, 70000, "2026-03-01"))
        maintenances.push(use MaintenanceEntity(7, 12, "maintenance", "Vidange", 80.0, "", 0, 1790251200, 0, "2026-02-01", "uploads/m-7.pdf", "facture.pdf"))
        var rows:array<map<string, mixed>> = CarView::present(use CarDetailsDTO(car, maintenances, [], 80.0, 0.0))["maintenances"]["items"]
        self::assertEquals("${badge_reading}", rows[0]["badge"])
        self::assertEquals(false, rows[0]["has_cost"])
        self::assertEquals(false, rows[0]["can_attach"])
        self::assertEquals(true, rows[1]["can_attach"])
        self::assertEquals(true, rows[1]["has_attachment"])
        self::assertEquals("facture.pdf", rows[1]["attachment_name"])
        self::assertEquals("uploads/m-7.pdf", rows[1]["attachment"])
        return 0
    }

    // Contrôle technique : alerte orange à moins de 60 jours, rouge dépassé.
    public method inspectionAlertTest(): int {
        Preferences::apply("fr", "EUR", "UTC")
        const now:int = DateTime::parse("2026-10-31T10:00:00")
        self::assertEquals(false, CarView::inspection("", now)["visible"])
        self::assertEquals(false, CarView::inspection("2027-06-01", now)["visible"])
        const soon:map<string, mixed> = CarView::inspection("2026-12-15", now)
        self::assertEquals(true, soon["visible"])
        self::assertEquals("${inspection_due} 15/12/2026", soon["value"])
        self::assertEquals("#e65100", soon["background"])
        const late:map<string, mixed> = CarView::inspection("2026-10-30", now)
        self::assertEquals("${inspection_overdue} 30/10/2026", late["value"])
        self::assertEquals("#c62828", late["background"])
        Preferences::reset()
        return 0
    }

    // Remplacement dû dans moins de 90 jours : alerte orange ; dépassé : rouge.
    public method replacementWarningTest(): int {
        const car:CarEntity = use CarEntity(9, "REF-WARN", "Peugeot", "208", "FR", 2019, 9000.0, 9000.0, "", "")
        const now:int = DateTime::now()
        var maintenances:array<MaintenanceEntity> = []
        maintenances.push(use MaintenanceEntity(1, 9, "maintenance", "Pneus", 300.0, "", 30, now))
        maintenances.push(use MaintenanceEntity(2, 9, "maintenance", "Vidange", 80.0, "", 10, now - 20 * 86400))
        maintenances.push(use MaintenanceEntity(3, 9, "maintenance", "Courroie", 400.0, "", 400, now))
        const details:CarDetailsDTO = use CarDetailsDTO(car, maintenances, [], 780.0, 0.0)
        var rows:array<map<string, mixed>> = CarView::present(details)["maintenances"]["items"]
        self::assertEquals(true, rows[0]["has_warning"])
        self::assertEquals("#ff3700", rows[0]["warning_color"])
        self::assertEquals("#ff0000", rows[1]["warning_color"])
        self::assertEquals(false, rows[2]["has_warning"])
        return 0
    }
}
