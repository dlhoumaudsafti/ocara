import ocara.UnitTest
import context.car.infra.view.helpers.Format

class FormatTest extends UnitTest {

    // Toujours 2 décimales, séparateur décimal "," et symbole euro.
    public method priceTest(): int {
        self::assertEquals("5800,50 €", Format::price(5800.5))
        self::assertEquals("1234,00 €", Format::price(1234.0))
        self::assertEquals("0,05 €", Format::price(0.05))
        self::assertEquals("0,00 €", Format::price(0.0))
        return 0
    }

    // Arrondi au centime.
    public method priceRoundingTest(): int {
        self::assertEquals("10,13 €", Format::price(10.129))
        self::assertEquals("10,12 €", Format::price(10.121))
        return 0
    }

    // 24/09/2026 à midi UTC : même jour quel que soit le fuseau courant.
    public method dateTest(): int {
        self::assertEquals("24/09/2026", Format::date(1790251200))
        return 0
    }
}
