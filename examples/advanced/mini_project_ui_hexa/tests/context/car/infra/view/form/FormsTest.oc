import ocara.UnitTest
import context.car.domain.entity.CarEntity
import context.car.domain.entity.MaintenanceEntity
import context.car.infra.view.form.CarForm
import context.car.infra.view.form.MaintenanceForm
import context.settings.domain.entity.SettingsEntity
import context.settings.infra.view.SettingsForm
import context.shared.infra.settings.Preferences

// Formulaires liés à l'interface : remplis depuis le domaine, vidés.
class FormsTest extends UnitTest {

    public method carFormTest(): int {
        const form:CarForm = use CarForm()
        form.load(use CarEntity(1, "AB-123", "Peugeot", "308", "FR", 2015, 8500.5, 9000.0, "2024-01-01", ""))
        self::assertEquals("AB-123", form.reference)
        self::assertEquals("FR", form.origin)
        self::assertEquals("2015", form.year)
        self::assertEquals("8500.5", form.purchase_price)
        self::assertEquals("2024-01-01", form.acquisition_date)
        // Année absente : champ vide (pas « 0 »).
        form.load(use CarEntity(2, "CD-456", "Fiat", "500", "", 0, 5000.0, 5000.0, "", ""))
        self::assertEquals("", form.year)
        // Compteur dans l'unité des paramètres ; contrôle technique tel quel.
        Preferences::apply("fr", "EUR", "UTC", "mi", "auto")
        form.load(use CarEntity(3, "EF-789", "Mini", "Cooper", "GB", 2010, 7000.0, 7000.0, "", "", 160934, "2027-03-01"))
        self::assertEquals("100000", form.mileage)
        self::assertEquals("2027-03-01", form.inspection_date)
        Preferences::reset()
        form.clear()
        self::assertEquals("", form.reference)
        self::assertEquals("", form.mileage)
        self::assertEquals("", form.purchase_price)
        return 0
    }

    public method maintenanceFormTest(): int {
        const form:MaintenanceForm = use MaintenanceForm()
        self::assertTrue(form.adding)
        self::assertFalse(form.editing)
        form.load(use MaintenanceEntity(9, 1, "improvement", "Peinture", 500.0, "Atelier", 0, 0))
        self::assertEquals(9, form.id)
        self::assertEquals("improvement", form.type)
        self::assertEquals("500.0", form.cost)
        self::assertEquals("", form.lifespan_days)
        self::assertEquals("", form.mileage)
        self::assertFalse(form.adding)
        self::assertTrue(form.editing)
        form.load(use MaintenanceEntity(10, 1, "maintenance", "Vidange", 80.0, "", 0, 0, 45000, "2026-05-02"))
        self::assertEquals("45000", form.mileage)
        self::assertEquals("2026-05-02", form.performed_on)
        form.load(use MaintenanceEntity(11, 1, "reading", "", 0.0, "", 0, 0, 50000, ""))
        self::assertTrue(form.is_reading)
        self::assertFalse(form.needs_cost)
        form.reset()
        self::assertFalse(form.is_reading)
        self::assertTrue(form.needs_cost)
        self::assertEquals("", form.performed_on)
        self::assertEquals(0, form.id)
        self::assertEquals("maintenance", form.type)
        self::assertTrue(form.adding)
        return 0
    }

    public method settingsFormTest(): int {
        const form:SettingsForm = use SettingsForm()
        form.load(use SettingsEntity("en", "CAD", "America/Chicago", "mi", "dark"))
        self::assertEquals("en", form.language)
        self::assertEquals("CAD", form.currency)
        self::assertEquals("America/Chicago", form.timezone)
        self::assertEquals("mi", form.distance_unit)
        self::assertEquals("dark", form.theme)
        return 0
    }
}
