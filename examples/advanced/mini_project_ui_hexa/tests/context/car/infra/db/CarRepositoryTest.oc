import ocara.UnitTest
import context.car.domain.entity.CarEntity
import context.car.infra.db.CarRepository
import tests.support.Fixture

class CarRepositoryTest extends UnitTest {

    public method findTest(): int {
        Fixture::reset()
        const id:int = Fixture::car("FIND", "Peugeot", "308", 12000.5)
        const car:CarEntity|null = CarRepository::find(id)
        self::assertNotNull(car)
        self::assertEquals(id, car.id)
        self::assertEquals("TEST-OCUNIT-FIND", car.reference)
        self::assertEquals("Peugeot", car.brand)
        self::assertEquals("308", car.model)
        self::assertEquals(12000.5, car.purchase_price)
        self::assertEquals(12000.5, car.estimated_price)
        Fixture::cleanup()
        return 0
    }

    public method findUnknownTest(): int {
        Fixture::reset()
        self::assertNull(CarRepository::find(-1))
        return 0
    }

    // Le prix de vente estimé démarre égal au prix d'achat.
    public method createTest(): int {
        Fixture::reset()
        const id:int = CarRepository::create(
            "TEST-OCUNIT-NEW", "Renault", "Clio", "FR", 2019, 8000.25, "2024-02-01", "2025-03-01"
        )
        self::assertTrue(id greater 0)
        const car:CarEntity|null = CarRepository::find(id)
        self::assertNotNull(car)
        self::assertEquals("Renault", car.brand)
        self::assertEquals("FR", car.origin)
        self::assertEquals(2019, car.year)
        self::assertEquals(8000.25, car.purchase_price)
        self::assertEquals(8000.25, car.estimated_price)
        self::assertEquals("2024-02-01", car.acquisition_date)
        self::assertEquals("2025-03-01", car.sale_date)
        Fixture::cleanup()
        return 0
    }

    // Champs de la fiche enregistrés ; le prix de vente estimé n'est pas touché.
    public method updateTest(): int {
        Fixture::reset()
        const id:int = Fixture::car("UPD", "Citroen", "C3", 7000.0)
        CarRepository::updateEstimatedPrice(id, 7500.0)
        CarRepository::update(use CarEntity(
            id, "TEST-OCUNIT-UPD2", "Citroën", "C3 Aircross", "FR", 2018, 7200.0, 0.0, "2023-05-01", "2026-01-15"
        ))
        const car:CarEntity|null = CarRepository::find(id)
        self::assertNotNull(car)
        self::assertEquals("TEST-OCUNIT-UPD2", car.reference)
        self::assertEquals("Citroën", car.brand)
        self::assertEquals("C3 Aircross", car.model)
        self::assertEquals("FR", car.origin)
        self::assertEquals(2018, car.year)
        self::assertEquals(7200.0, car.purchase_price)
        self::assertEquals(7500.0, car.estimated_price)
        self::assertEquals("2023-05-01", car.acquisition_date)
        self::assertEquals("2026-01-15", car.sale_date)
        Fixture::cleanup()
        return 0
    }

    public method updateEstimatedPriceTest(): int {
        Fixture::reset()
        const id:int = Fixture::car("PRICE", "Citroen", "C3", 7000.0)
        CarRepository::updateEstimatedPrice(id, 7800.0)
        self::assertEquals(7800.0, Fixture::estimatedPrice(id))
        Fixture::cleanup()
        return 0
    }

    public method deleteTest(): int {
        Fixture::reset()
        const id:int = Fixture::car("DEL", "Fiat", "500", 5000.0)
        Fixture::maintenance(id, "maintenance", "Vidange", 80.0)
        CarRepository::delete(id)
        self::assertFalse(Fixture::carExists(id))
        // Les entretiens de la voiture sont supprimés avec elle.
        self::assertEquals(0, Fixture::maintenanceCount(id))
        return 0
    }

    // fromRow (privée) : chaque colonne arrive dans le bon champ, prix de
    // vente estimé lu dans `estimated_sale_price`.
    public method fromRowTest(): int {
        Fixture::reset()
        const id:int = Fixture::car("ROW", "Dacia", "Sandero", 6000.0)
        CarRepository::updateEstimatedPrice(id, 6400.5)
        const car:CarEntity|null = CarRepository::find(id)
        self::assertNotNull(car)
        self::assertEquals(id, car.id)
        self::assertEquals("TEST-OCUNIT-ROW", car.reference)
        self::assertEquals("Dacia", car.brand)
        self::assertEquals("Sandero", car.model)
        self::assertEquals(6000.0, car.purchase_price)
        self::assertEquals(6400.5, car.estimated_price)
        Fixture::cleanup()
        return 0
    }
}
