import ocara.UnitTest
import ocara.UI
import context.shared.infra.i18n.Language
import context.shared.infra.settings.Preferences
import ocara.File
import context.car.infra.controllers.CarController
import context.car.infra.view.form.CarForm
import tests.support.fake.FakeDatabase

// Actions de la fiche, de la création et de la galerie (configs/actions/
// CarActions.oc) sur une interface non affichée : l'état posé se relit par
// `ui.get`. Les formulaires sont des CarForm remplis comme par la saisie.
class CarControllerTest extends UnitTest {
    wiring tests.support.fake.FakeCarRepository
    wiring tests.support.fake.FakeMaintenanceRepository
    wiring tests.support.fake.FakeCarPhotoRepository

    private method ui(): UI {
        return use UI("../../../../../ui/carfolio.oc.ui", Language::vars("fr"))
    }

    private method form(reference:string, price:string): CarForm {
        const form:CarForm = use CarForm()
        form.reference = reference
        form.brand = "Peugeot"
        form.model = "308"
        form.origin = "FR"
        form.year = "2015"
        form.purchase_price = price
        form.acquisition_date = "2025-01-02"
        return form
    }

    public method createTest(): int {
        FakeDatabase::reset()
        const ui:UI = self.ui()
        const form:CarForm = self.form(" TEST-OCUNIT-UI ", "8500")
        self::assertEquals("", CarController::create(ui, form))
        var id:string = ui.get("car_id", "value")
        self::assertTrue(FakeDatabase::carExists(id.toInt()))
        const row:map<string, mixed> = FakeDatabase::carRow(id.toInt())
        self::assertEquals("TEST-OCUNIT-UI", row["reference"])
        self::assertEquals("FR", row["origin"])
        self::assertEquals(2015, row["year"])
        self::assertEquals(8500.0, row["purchase_price"])
        self::assertEquals("2025-01-02", row["acquisition_date"])
        // Formulaire vidé, panneau d'ajout fermé.
        self::assertEquals("", form.reference)
        self::assertEquals(false, ui.get("new_car_sheet", "open"))
        FakeDatabase::cleanup()
        return 0
    }

    public method createInvalidTest(): int {
        FakeDatabase::reset()
        const ui:UI = self.ui()
        self::assertEquals("missing_fields", CarController::create(ui, self.form("", "8500")))
        self::assertEquals("invalid_price", CarController::create(ui, self.form("TEST-OCUNIT-X", "abc")))
        self::assertEquals("invalid_price", CarController::create(ui, self.form("TEST-OCUNIT-X", "-5")))
        const old:CarForm = self.form("TEST-OCUNIT-X", "8500")
        old.year = "1800"
        self::assertEquals("invalid_year", CarController::create(ui, old))
        old.year = "vingt"
        self::assertEquals("invalid_year", CarController::create(ui, old))
        old.year = ""
        old.origin = "XX"
        self::assertEquals("invalid_origin", CarController::create(ui, old))
        self::assertEquals(0, FakeDatabase::cars().len())
        FakeDatabase::cleanup()
        return 0
    }

    // Compteur et contrôle technique : entier positif, date valide ; l'unité
    // choisie sur le véhicule détermine la conversion persistée en kilomètres.
    public method mileageTest(): int {
        FakeDatabase::reset()
        const ui:UI = self.ui()
        const form:CarForm = self.form("TEST-OCUNIT-KM", "8500")
        form.mileage = "-5"
        self::assertEquals("invalid_mileage", CarController::create(ui, form))
        form.mileage = "beaucoup"
        self::assertEquals("invalid_mileage", CarController::create(ui, form))
        Preferences::apply("fr", "EUR", "UTC", "mi")
        form.changeUnit("mi")
        form.mileage = "120 000"
        form.inspection_date = "2027-02-31"
        self::assertEquals("invalid_date", CarController::create(ui, form))
        form.inspection_date = "2027-03-01"
        self::assertEquals("", CarController::create(ui, form))
        var id:string = ui.get("car_id", "value")
        const row:map<string, mixed> = FakeDatabase::carRow(id.toInt())
        self::assertEquals(193121, row["mileage"])
        self::assertEquals("2027-03-01", row["inspection_date"])
        Preferences::reset()
        FakeDatabase::cleanup()
        return 0
    }

    // Compteur inchangé à l'écran (miles) : la valeur en km ne dérive pas.
    public method mileageKeptTest(): int {
        FakeDatabase::reset()
        Preferences::apply("fr", "EUR", "UTC", "mi")
        const id:int = FakeDatabase::insertCar("TEST-OCUNIT-KEEP", "Mini", "Cooper", "GB", 2010, 7000.0, "", "", 100001, "")
        const form:CarForm = use CarForm()
        CarController::display(self.ui(), id, form)
        form.model = "Cooper S"
        self::assertEquals("", CarController::update(id, form))
        self::assertEquals(100001, FakeDatabase::carRow(id)["mileage"])
        self::assertEquals("Cooper S", FakeDatabase::carRow(id)["model"])
        Preferences::reset()
        FakeDatabase::cleanup()
        return 0
    }

    public method countTest(): int {
        self::assertEquals(0, CarController::count(""))
        self::assertEquals(12500, CarController::count("12 500"))
        self::assertEquals(-1, CarController::count("-3"))
        self::assertEquals(-1, CarController::count("1,5"))
        return 0
    }

    // Prix saisi avec une virgule décimale.
    public method numberTest(): int {
        self::assertEquals(8500.5, CarController::number(" 8500,5 "))
        self::assertEquals(0.0, CarController::number("abc"))
        self::assertEquals(0, CarController::year(""))
        self::assertEquals(2015, CarController::year(" 2015 "))
        self::assertEquals(-1, CarController::year("deux mille"))
        return 0
    }

    public method displayTest(): int {
        FakeDatabase::reset()
        Preferences::reset()
        const ui:UI = self.ui()
        const id:int = FakeDatabase::insertCar("TEST-OCUNIT-SHOW", "Renault", "Clio", "FR", 2012, 10000.0, "", "")
        FakeDatabase::maintenance(id, "improvement", "Peinture", 500.0)
        const form:CarForm = use CarForm()
        self::assertTrue(CarController::display(ui, id, form))
        self::assertEquals(id.toStr(), ui.get("car_id", "value"))
        // Le formulaire lié reçoit la voiture.
        self::assertEquals("TEST-OCUNIT-SHOW", form.reference)
        self::assertEquals("FR", form.origin)
        self::assertEquals("2012", form.year)
        self::assertEquals("10000.0", form.purchase_price)
        self::assertEquals("10 000,00 €", ui.get("car_purchase.value", "value"))
        self::assertEquals("500,00 €", ui.get("car_improvement_total.value", "value"))
        var rows:array<map<string, mixed>> = ui.get("maintenances", "items")
        self::assertEquals("Peinture", rows[0]["description"])
        self::assertFalse(CarController::display(ui, 999999, form))
        FakeDatabase::cleanup()
        return 0
    }

    // Fiche modifiée sur place : enregistrée, prix estimé recalculé si le
    // prix d'achat change ; formulaire invalide : rien d'enregistré.
    public method updateTest(): int {
        FakeDatabase::reset()
        const id:int = FakeDatabase::car("EDIT", "Renault", "Clio", 10000.0)
        FakeDatabase::maintenance(id, "improvement", "Peinture", 500.0)
        const form:CarForm = self.form("TEST-OCUNIT-EDIT2", "11000")
        self::assertEquals("", CarController::update(id, form))
        const row:map<string, mixed> = FakeDatabase::carRow(id)
        self::assertEquals("TEST-OCUNIT-EDIT2", row["reference"])
        self::assertEquals("Peugeot", row["brand"])
        self::assertEquals("FR", row["origin"])
        self::assertEquals(2015, row["year"])
        self::assertEquals(11000.0, row["purchase_price"])
        self::assertEquals(11500.0, FakeDatabase::estimatedPrice(id))
        form.purchase_price = "0"
        self::assertEquals("invalid_price", CarController::update(id, form))
        self::assertEquals(11000.0, FakeDatabase::carRow(id)["purchase_price"])
        self::assertEquals("not_found", CarController::update(999999, form))
        FakeDatabase::cleanup()
        return 0
    }

    // Action save_car (CarController::commit) : message d'erreur sur la fiche, ou « Enregistré ».
    public method saveTest(): int {
        FakeDatabase::reset()
        const ui:UI = self.ui()
        const id:int = FakeDatabase::car("SAVE", "Renault", "Clio", 10000.0)
        const form:CarForm = use CarForm()
        CarController::display(ui, id, form)
        form.model = "Clio IV"
        CarController::commit(ui, form)
        self::assertEquals("Clio IV", FakeDatabase::carRow(id)["model"])
        self::assertEquals(true, ui.get("car_saved", "visible"))
        self::assertEquals(false, ui.get("car_error", "visible"))
        form.brand = " "
        CarController::commit(ui, form)
        self::assertEquals("Renault", FakeDatabase::carRow(id)["brand"])
        self::assertEquals(true, ui.get("car_error", "visible"))
        FakeDatabase::cleanup()
        return 0
    }

    public method removeTest(): int {
        FakeDatabase::reset()
        const id:int = FakeDatabase::car("DEL", "Peugeot", "208", 9000.0)
        FakeDatabase::addPhoto(id, "uploads/x.jpg")
        CarController::remove(id)
        self::assertFalse(FakeDatabase::carExists(id))
        self::assertEquals(0, FakeDatabase::photos(id).len())
        FakeDatabase::cleanup()
        return 0
    }

    // Même contrôle que le site : signature du format, taille.
    public method storePhotoTest(): int {
        FakeDatabase::reset()
        const id:int = FakeDatabase::car("PHOTO", "Peugeot", "208", 9000.0)
        File::writeBytes("/tmp/ocara-ui-test.png", [137, 80, 78, 71, 13, 10, 26, 10, 0, 0])
        File::writeBytes("/tmp/ocara-ui-test-fake.png", [1, 2, 3, 4, 5, 6, 7, 8])
        File::writeBytes("/tmp/ocara-ui-test.txt", [137, 80, 78, 71, 13, 10, 26, 10])
        self::assertTrue(CarController::storePhoto(id, "/tmp/ocara-ui-test.png"))
        self::assertFalse(CarController::storePhoto(id, "/tmp/ocara-ui-test-fake.png"))
        self::assertFalse(CarController::storePhoto(id, "/tmp/ocara-ui-test.txt"))
        self::assertFalse(CarController::storePhoto(999999, "/tmp/ocara-ui-test.png"))
        const photos:array<string> = FakeDatabase::photos(id)
        self::assertEquals(1, photos.len())
        self::assertTrue(File::exists("./" + photos[0]))
        File::remove("./" + photos[0])
        FakeDatabase::cleanup()
        return 0
    }
}
