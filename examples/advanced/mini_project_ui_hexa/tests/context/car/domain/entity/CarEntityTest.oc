import ocara.UnitTest
import context.car.domain.entity.CarEntity

class CarEntityTest extends UnitTest {

    public method initTest(): int {
        const car:CarEntity = use CarEntity(7, "REF-1", "Peugeot", "308", "FR", 2015, 12000.5, 14000.75, "2024-01-01", "")
        self::assertEquals(7, car.id)
        self::assertEquals("REF-1", car.reference)
        self::assertEquals("Peugeot", car.brand)
        self::assertEquals("308", car.model)
        self::assertEquals("FR", car.origin)
        self::assertEquals(2015, car.year)
        self::assertEquals(12000.5, car.purchase_price)
        self::assertEquals(14000.75, car.estimated_price)
        self::assertEquals("2024-01-01", car.acquisition_date)
        self::assertEquals("", car.sale_date)
        return 0
    }

    // Une voiture pas encore enregistrée n'a pas d'identifiant.
    public method initWithoutIdTest(): int {
        const car:CarEntity = use CarEntity(null, "REF-2", "Renault", "Clio", "", 0, 8000.0, 8000.0, "", "")
        self::assertNull(car.id)
        return 0
    }

    // Année absente (0), ou de 1886 à l'an prochain.
    public method validYearTest(): int {
        self::assertTrue(CarEntity::validYear(0, 2026))
        self::assertTrue(CarEntity::validYear(1886, 2026))
        self::assertTrue(CarEntity::validYear(2027, 2026))
        self::assertFalse(CarEntity::validYear(2028, 2026))
        self::assertFalse(CarEntity::validYear(1885, 2026))
        return 0
    }

    public method originsTest(): int {
        self::assertTrue(CarEntity::origins().contains("FR"))
        self::assertTrue(CarEntity::origins().contains("JP"))
        self::assertFalse(CarEntity::origins().contains("XX"))
        return 0
    }
}
