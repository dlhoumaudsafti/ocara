import ocara.UnitTest
import ocara.SQLite
import context.shared.infra.db.Database

class DatabaseTest extends UnitTest {

    public method pathTest(): int {
        self::assertEquals("./app.db", Database::path())
        return 0
    }

    public method connectTest(): int {
        const db:SQLite = Database::connect()
        const row:map<string, mixed> = db.queryOne("SELECT 1 AS one")
        db.close()
        var one:int = row["one"]
        self::assertEquals(1, one)
        return 0
    }

    // Idempotente : deux migrations successives laissent les deux tables.
    public method migrateTest(): int {
        Database::migrate()
        Database::migrate()
        const db:SQLite = Database::connect()
        const rows:array<map<string, mixed>> = db.query(
            "SELECT name FROM sqlite_master"
            + " WHERE type = 'table' AND name IN ('cars', 'maintenances', 'car_photos') ORDER BY name"
        )
        db.close()
        self::assertEquals(3, rows.len())
        var first:string = rows[0]["name"]
        var second:string = rows[1]["name"]
        self::assertEquals("car_photos", first)
        self::assertEquals("cars", second)
        var third:string = rows[2]["name"]
        self::assertEquals("maintenances", third)
        return 0
    }

    public method migrateSchemaTest(): int {
        const db:SQLite = SQLite::open(":memory:")
        Database::migrateSchema(db)
        const rows:array<map<string, mixed>> = db.query("PRAGMA table_info(maintenances)")
        db.close()

        var has_material_source:bool = false
        var has_lifespan_days:bool = false
        for row in rows {
            var column:string = row["name"]
            if column equal "material_source" {
                has_material_source = true
            }
            if column equal "lifespan_days" {
                has_lifespan_days = true
            }
        }
        self::assertTrue(has_material_source)
        self::assertTrue(has_lifespan_days)
        return 0
    }

    // Base créée avant Carfolio : `origin`, `year` et la table `settings`
    // sont ajoutés, les voitures gardées.
    public method migrateOldSchemaTest(): int {
        const db:SQLite = SQLite::open(":memory:")
        db.execute(`CREATE TABLE cars (
            id INTEGER PRIMARY KEY AUTOINCREMENT, reference TEXT NOT NULL, brand TEXT NOT NULL,
            model TEXT NOT NULL, purchase_price REAL NOT NULL, estimated_sale_price REAL NOT NULL,
            created_at INTEGER NOT NULL)`)
        db.execute("INSERT INTO cars (reference, brand, model, purchase_price, estimated_sale_price, created_at) VALUES ('OLD', 'Fiat', '500', 1.0, 1.0, 0)")
        Database::migrateSchema(db)
        const car:map<string, mixed> = db.queryOne("SELECT origin, year, sale_date, mileage, inspection_date, last_inspection_date, is_collection, distance_unit FROM cars WHERE reference = 'OLD'")
        const columns:array<map<string, mixed>> = db.query("SELECT name FROM pragma_table_info('maintenances') WHERE name IN ('mileage', 'performed_on', 'attachment', 'attachment_name')")
        const photo_columns:array<map<string, mixed>> = db.query("SELECT name FROM pragma_table_info('car_photos') WHERE name = 'main'")
        const settings:map<string, mixed> = db.queryOne("SELECT COUNT(*) AS n FROM sqlite_master WHERE name = 'settings'")
        db.close()
        self::assertEquals("", car["origin"])
        self::assertEquals(0, car["year"])
        self::assertEquals("", car["sale_date"])
        self::assertEquals(0, car["mileage"])
        self::assertEquals("", car["inspection_date"])
        self::assertEquals("", car["last_inspection_date"])
        self::assertEquals(0, car["is_collection"])
        self::assertEquals("km", car["distance_unit"])
        self::assertEquals(4, columns.len())
        self::assertEquals(1, photo_columns.len())
        self::assertEquals(1, settings["n"])
        return 0
    }

    public method migrateLegacyAttachmentTest(): int {
        const db:SQLite = SQLite::open(":memory:")
        db.execute(`CREATE TABLE cars (
            id INTEGER PRIMARY KEY AUTOINCREMENT, reference TEXT NOT NULL, brand TEXT NOT NULL,
            model TEXT NOT NULL, purchase_price REAL NOT NULL, estimated_sale_price REAL NOT NULL,
            created_at INTEGER NOT NULL)`)
        db.execute("INSERT INTO cars (reference, brand, model, purchase_price, estimated_sale_price, created_at) VALUES ('ATTACH-OLD', 'Fiat', '500', 1.0, 1.0, 0)")
        db.execute(`CREATE TABLE maintenances (
            id INTEGER PRIMARY KEY, car_id INTEGER NOT NULL, type TEXT NOT NULL, description TEXT NOT NULL,
            cost REAL NOT NULL, created_at INTEGER NOT NULL, material_source TEXT NOT NULL DEFAULT '',
            lifespan_days INTEGER NOT NULL DEFAULT 0, mileage INTEGER NOT NULL DEFAULT 0,
            performed_on TEXT NOT NULL DEFAULT '', attachment TEXT NOT NULL DEFAULT '',
            attachment_name TEXT NOT NULL DEFAULT '')`)
        db.execute("INSERT INTO maintenances (id, car_id, type, description, cost, created_at, attachment, attachment_name) VALUES (9, 1, 'technical_inspection', '', 0, 0, 'uploads/report.pdf', 'report.pdf')")
        Database::migrateSchema(db)
        Database::migrateSchema(db)
        const row:map<string, mixed> = db.queryOne(
            "SELECT maintenance_id, path, name FROM maintenance_attachments WHERE maintenance_id = 9"
        )
        const count:map<string, mixed> = db.queryOne(
            "SELECT COUNT(*) AS n FROM maintenance_attachments WHERE maintenance_id = 9"
        )
        db.close()
        self::assertEquals(9, row["maintenance_id"])
        self::assertEquals("uploads/report.pdf", row["path"])
        self::assertEquals("report.pdf", row["name"])
        self::assertEquals(1, count["n"])
        return 0
    }
}
