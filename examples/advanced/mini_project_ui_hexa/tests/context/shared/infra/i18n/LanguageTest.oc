import ocara.UnitTest
import context.shared.infra.i18n.Language

class LanguageTest extends UnitTest {

    public method getTest(): int {
        const en:map<string, string> = Language::get("home", "en")
        const fr:map<string, string> = Language::get("home", "fr")
        self::assertTrue(en.has("home"))
        self::assertTrue(fr.has("home"))
        return 0
    }

    public method getDefaultLanguageTest(): int {
        const lang:map<string, string> = Language::get("home")
        self::assertTrue(lang.has("home"))
        return 0
    }

    // Textes de l'interface : mêmes clés en français et en anglais.
    public method varsTest(): int {
        const fr:map<string, mixed> = Language::vars("fr")
        const en:map<string, mixed> = Language::vars("en")
        self::assertEquals("Flotte de véhicules", fr["home_title"])
        self::assertEquals("Vehicle fleet", en["home_title"])
        self::assertEquals(fr.size(), en.size())
        for key in fr.keys() {
            self::assertTrue(en.has(key))
        }
        self::assertEquals(0, Language::vars("xx").size())
        return 0
    }
}
