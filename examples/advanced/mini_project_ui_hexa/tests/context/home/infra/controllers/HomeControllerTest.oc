import ocara.UnitTest
import ocara.UI
import context.shared.infra.i18n.Language
import context.home.infra.controllers.HomeController
import tests.support.fake.FakeDatabase

// Tableau de bord affiché à l'écran `home` (onShow : show_home).
class HomeControllerTest extends UnitTest {
    wiring tests.support.fake.FakeCarSummaryRepository

    public method refreshTest(): int {
        FakeDatabase::reset()
        const ui:UI = use UI("../../../../../ui/garage.oc.ui", Language::vars("fr"))
        FakeDatabase::car("HOME", "Peugeot", "308", 10000.0)
        HomeController::refresh(ui)
        self::assertEquals("1", ui.get("stat_count.value", "value"))
        self::assertEquals("10000,00 €", ui.get("stat_purchase.value", "value"))
        self::assertEquals(false, ui.get("cars_empty", "visible"))
        var cars:array<map<string, mixed>> = ui.get("cars", "items")
        self::assertEquals("TEST-OCUNIT-HOME", cars[0]["reference"])
        FakeDatabase::cleanup()
        return 0
    }
}
