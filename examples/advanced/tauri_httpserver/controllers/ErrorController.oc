import ocara.HTML
import ocara.HTTPServer
import ocara.HTTPServerRequest

// ─────────────────────────────────────────────────────────────────────────────

class ErrorController {

    public static method handle404(req:HTTPServerRequest): int {
        const path:string = req.path()
        scoped html:string = HTML::renderFile('templates/404.html')

        req.respond(404, html)
        return 0
    }

}
