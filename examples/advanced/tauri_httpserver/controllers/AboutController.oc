// examples/advanced/tauri_httpserver/controllers/AboutController.oc
// Contrôleur de la page "À propos".
//
// Contenu statique — mis en cache avec renderCached après le premier rendu.

import ocara.HTML
import ocara.HTTPServer
import ocara.HTTPServerRequest

class AboutController {

    public static method handle(req:HTTPServerRequest): int {
        scoped html:string = HTML::renderFileCached('templates/about.html', "page_about")

        req.respond(200, html)
        return 0
    }
}
