// examples/advanced/tauri_httpserver/controllers/ContactController.oc
// Contrôleur de la page "Contact".
//
// Contenu statique — mis en cache avec renderCached après le premier rendu.

import ocara.HTML
import ocara.HTTPServer
import ocara.HTTPServerRequest

class ContactController {

    public static method handle(req:HTTPServerRequest): int {
        scoped html:string = HTML::renderFileCached('templates/contact.html', "page_contact")

        req.respond(200, html)
        return 0
    }
}
