// examples/ocara_app/main.oc
// Point d'entrée de l'app desktop : le serveur HTTP du site tourne en arrière-plan
// (sur un thread dédié) et la fenêtre Tauri affiche directement son URL —
// donc une vraie page servie par Ocara, pas un fichier HTML statique local.
//
// Architecture :
//   components.oc                    — définition des composants HTMLComponent
//   controllers/HomeController.oc    — page d'accueil (async/resolve + render)
//   controllers/AboutController.oc   — page à propos (renderCached)
//   controllers/ContactController.oc — page contact (renderCached)
//   controllers/IPCController.oc     — méthodes exposées au JS via ui.handlers()
//   configs/Database.oc              — compteur de visites persistant (SQLite)
//
// La fenêtre enregistre aussi deux commandes IPC (ui.handlers(), voir plus bas)
// que le JS de la page d'accueil appelle directement — un vrai appel Ocara
// déclenché depuis un bouton HTML, pas une requête HTTP (voir la carte
// "Appel Ocara en direct" dans controllers/HomeController.oc).
//
// Avant d'ouvrir la fenêtre, on attend que le serveur réponde réellement à
// GET /health (au lieu d'un Thread::sleep à durée fixe, qui n'offre aucune
// garantie) — voir la boucle dans main{} ci-dessous et controllers/
// APIController.oc pour la route.
//
// Lancer :
//   ./target/release/ocara examples/ocara_app/main.oc -o /tmp/ocara_app
//   /tmp/ocara_app
namespace .

import ocara.IO
import ocara.Thread
import ocara.Tauri
import ocara.HTTPRequest
import configs.Components
import configs.Server
import configs.Database
import controllers.IPCController


init {
    IO::writeln("Initialisation de l'app...")
    use Components()
    Database::migrate()
    const server:Server = use Server()
    server.routes()
}

main {
    // Le serveur tourne sur son propre thread : Tauri::run() doit rester sur
    // le thread principal (contrainte du crate tauri), donc le serveur ne peut
    // pas être lancé ici en bloquant comme dans ocara_site/main.oc.
    //
    // Pas de try/on ici autour de server.start() (contournement volontaire) :
    // un try/on à l'intérieur d'un nameless qui capture une variable externe
    // (server) déclenche un bug distinct du compilateur, plus profond (mécanisme
    // setjmp/longjmp), toujours en cours d'investigation. Server::start() a déjà
    // son propre try/on interne (voir configs/Server.oc) qui capture les erreurs
    // de démarrage HTTPServerException.
    const serverThread:Thread = use Thread()
    serverThread.run(nameless(): void {
        server.start()
    })

    // Attendre que le serveur réponde réellement (GET /health) avant d'ouvrir la
    // fenêtre — plus fiable qu'un délai fixe, qui échouerait sous charge ou sur
    // une machine lente et gâcherait du temps inutilement sur une machine rapide.
    IO::writeln("Attente du serveur (GET /health)...")
    var serverReady:bool = false
    var attempts:int = 0
    while not serverReady {
        scoped res:int = HTTPRequest::get("http://localhost:8080/health")
        if HTTPRequest::ok(res) {
            serverReady = true
        } else {
            attempts = attempts + 1
            if attempts greater 100 {
                IO::writeln("Le serveur ne répond toujours pas après 5s")
                result 5
            } else {
                Thread::sleep(50)
            }
        }
    }
    IO::writeln("Serveur prêt.")

    IO::writeln("Ouverture de la fenêtre vers http://localhost:8080 ...")
    var ui:Tauri = use Tauri({
        "title": "Ocara App",
        "width": 1000,
        "height": 700,
        "url": "http://localhost:8080"
    })

    // Pont IPC JS -> Ocara : le bouton de la page d'accueil appelle ces deux
    // commandes directement (window.ocara.invoke(...) côté JS) — voir
    // controllers/IPCController.oc pour le code réellement exécuté.
    ui.handlers({
        "greet":      IPCController::greet,
        "serverTime": IPCController::serverTime
    })

    ui.run()

    IO::writeln("Fenêtre fermée.")
}

error {
    IO::writeln(`Error block executed with ERROR=${ERROR} SUCCESS=${SUCCESS}`)
}

success {
    IO::writeln(`Success block executed with ERROR=${ERROR} SUCCESS=${SUCCESS}`)
}