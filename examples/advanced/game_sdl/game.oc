// examples/advanced/game_sdl/game.oc
// Petit jeu de plateforme "side-scroll" en 2D, entierement dessine avec
// ocara.SDL (voir docs/builtins/SDL.md) — pas de moteur de jeu, juste des
// textures et une boucle de rendu.
//
// Structure : Player.oc (personnage) et Level.oc (decor) portent chacun
// leur propre etat/logique ; ce fichier ne fait que les assembler dans la
// boucle de rendu. Voir assets/README.md pour l'origine des textures.
//
// Contrôles :
//   Flèche droite / gauche   → marcher
//   Maintenir Ctrl + flèche  → courir
//   Flèche haut / bas        → se décaler en profondeur (en marchant/courant)
//   Échap ou fermer la fenêtre → quitter
//
// À lancer DEPUIS LA RACINE DU REPO (comme examples/builtins/sdl.oc — les
// textures sont chargées via des chemins relatifs à la racine) :
//   ./target/release/ocara examples/advanced/game_sdl/game.oc -o /tmp/game_sdl
//   /tmp/game_sdl

namespace .

architecture permissive

import ocara.IO
import ocara.SDL
import Player
import Level
import ocara.SDLException
import ocara.Exception

const TITLE:string = "Ocara Side-Scroller"
const WIDTH_DIMENSION:int = 960
const HEIGHT_DIMENSION:int = 540

init {
    IO::writeln("Initialisation du jeu SDL...")
}

main {
    try {
        var win:SDL = use SDL({
            "title": TITLE,
            "width": WIDTH_DIMENSION,
            "height": HEIGHT_DIMENSION
        })
        // le personnage reste centré à l'écran ; c'est le décor qui défile sous ses pas
        const char_screen_x:int = WIDTH_DIMENSION / 2
        var level:Level         = use Level(win)
        var player:Player       = use Player(win)
        var left_held:bool      = false
        var right_held:bool     = false
        var up_held:bool        = false
        var down_held:bool      = false
        var run_held:bool       = false
        var running:bool        = true

        // Rendu (arrière-plan → premier plan)
        win.setDrawColor(r:15, g:8, b:12, a:255)
        while running {
            // capture Clavier
            scoped ev:map<string, string> = win.pollEvent()
            while ev.type not equal "none" {
                if ev.type equal "quit" { running = false }
                else {
                    if ev.type equal "keydown" {
                        if ev.key equal "Escape" { running = false }
                        if ev.key equal "Left" { left_held = true }
                        elseif ev.key equal "Right" { right_held = true }
                        elseif ev.key equal "Up" { up_held = true }
                        elseif ev.key equal "Down" { down_held = true }
                        consumed is_run_key:bool = (
                            ev.key equal "Left Ctrl" or
                            ev.key equal "Right Ctrl"
                        )
                        if is_run_key { run_held = true }
                    }
                    if ev.type equal "keyup" {
                        if ev.key equal "Left" { left_held = false }
                        elseif ev.key equal "Right" { right_held = false }
                        elseif ev.key equal "Up" { up_held = false }
                        elseif ev.key equal "Down" { down_held = false }
                        consumed is_run_key:bool = (
                            ev.key equal "Left Ctrl" or
                            ev.key equal "Right Ctrl"
                        )
                        if is_run_key { run_held = false }
                    }
                }
                ev = win.pollEvent()
            }
            win.clear()
            level.draw(win, player.world_x)
            player.update(left_held, right_held, up_held, down_held, run_held)
            player.draw(win, char_screen_x)
            win.present()
            SDL::delay(ms:16) // ~60 fps
        }
        win.close()
    } on e is SDLException {
        result e.code
    }
}

error {
    IO::writeln(`SDL indisponible ici (pas d'affichage ? machine headless ?) — code ${ERROR}`)
}

exit {
    IO::writeln("Fin du jeu SDL.")
}
