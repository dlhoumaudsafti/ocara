namespace .

architecture permissive

// Le personnage : anime (marche/course), sens de deplacement, dessin.
//
// Toutes les frames viennent de LA MEME texture (assets/sprite.png,
// chargee une seule fois dans init) — pas de fichier par frame : chaque
// frame est un simple sous-rectangle (x, y, w, h) dessine via
// `SDL.drawTextureRegion` (voir docs/builtins/SDL.md). Le sens "gauche" ne
// duplique pas non plus les images : `flipH` retourne la meme frame au
// rendu (dernier argument de drawTextureRegion).
//
// Les rectangles sont mesures une fois pour toutes sur la planche source
// (colonnes non parfaitement regulieres — poses de course qui debordent
// legerement d'une case sur l'autre, voir assets/README.md) ; il en resulte
// qu'un pied/une main d'une pose voisine peut deborder de quelques pixels
// sur une frame ou deux — limite assumee de ce decoupage "a la volee" plutot
// que d'une planche dessinee au depart en cases parfaitement isolees.

import ocara.SDL

class Player {
    public const WALK_SPEED:int   = 4
    public const RUN_SPEED:int    = 8
    public const ANIM_HOLD:int    = 10   // frames moteur avant l'image suivante
    public const FRAME_COUNT:int  = 6
    public const GROUND_Y:int     = 760
    public const GROUND_Y_MIN:int = 725
    public const GROUND_Y_MAX:int = 800
    public property world_x:int   = 0  // position dans le monde (0 = depart, jamais negatif)

    private const HEIGHT:int      = 384
    private const WIDTH:int       = 229
    private property sprite_sheet_id:int
    private property walk_frames:array<array<int>> = [
        [0,               0, Player::WIDTH, Player::HEIGHT],
        [Player::WIDTH,   0, Player::WIDTH, Player::HEIGHT],
        [Player::WIDTH*2, 0, Player::WIDTH, Player::HEIGHT],
        [Player::WIDTH*3, 0, Player::WIDTH, Player::HEIGHT],
        [Player::WIDTH*4, 0, Player::WIDTH, Player::HEIGHT],
        [Player::WIDTH*5, 0, Player::WIDTH, Player::HEIGHT]
    ]
    // Course : 3e colonne = bord droit (et non largeur) — srcW/w grandissent
    // d'une frame a l'autre, d'ou l'effet d'etirement voulu en course.
    private property run_frames:array<array<int>> = [
        [0,               Player::HEIGHT, Player::WIDTH,   Player::HEIGHT],
        [Player::WIDTH,   Player::HEIGHT, Player::WIDTH*2, Player::HEIGHT],
        [Player::WIDTH*2, Player::HEIGHT, Player::WIDTH*3, Player::HEIGHT],
        [Player::WIDTH*3, Player::HEIGHT, Player::WIDTH*4, Player::HEIGHT],
        [Player::WIDTH*4, Player::HEIGHT, Player::WIDTH*5, Player::HEIGHT],
        [Player::WIDTH*5, Player::HEIGHT, Player::WIDTH*6, Player::HEIGHT]
    ]
    private property facing_right:bool = true
    private property running:bool      = false
    private property moving:bool       = false
    private property anim_frame:int    = 0
    private property anim_timer:int    = 0
    private property ground_y:int      = Player::GROUND_Y // ligne des pieds (profondeur sur la route)

    init(win:SDL) {
        self.sprite_sheet_id = win.loadTexture("assets/sprite.png")
    }

    // Avance l'etat du personnage d'une frame moteur selon les touches tenues.
    // Haut/bas ne deplacent le personnage en profondeur (axe y) que s'il
    // marche ou court deja horizontalement.
    public method update(left_held:bool, right_held:bool, up_held:bool, down_held:bool, run_held:bool): void {
        self.running  = run_held
        var speed:int = Player::WALK_SPEED
        if run_held {
            speed = Player::RUN_SPEED
        }

        self.moving = false
        if left_held and not right_held {
            self.moving       = true
            self.facing_right = false
            self.world_x     -= speed
            if self.world_x smaller 0 {
                self.world_x = 0
            }
        }
        if right_held and not left_held {
            self.moving       = true
            self.facing_right = true
            self.world_x     += speed
        }

        if self.moving {
            if up_held and not down_held {
                self.ground_y -= speed
                if self.ground_y smaller Player::GROUND_Y_MIN {
                    self.ground_y = Player::GROUND_Y_MIN
                }
            }
            if down_held and not up_held {
                self.ground_y += speed
                if self.ground_y greater Player::GROUND_Y_MAX {
                    self.ground_y = Player::GROUND_Y_MAX
                }
            }
        }

        if self.moving {
            self.anim_timer++
            if self.anim_timer greater or equal Player::ANIM_HOLD {
                self.anim_timer = 0
                self.anim_frame++
                if self.anim_frame greater or equal Player::FRAME_COUNT {
                    self.anim_frame = 0
                }
            }
        } else {
            self.anim_frame = 0
            self.anim_timer = 0
        }
    }

    // Dessine le personnage centre en (screenX), pieds sur groundY — la
    // largeur/hauteur variant d'une frame a l'autre, l'ancrage bas-centre
    // evite tout decalage visible d'une image a l'autre.
    public method draw(win:SDL, screenX:int): void {
        var rect:array<int> = self.walk_frames[self.anim_frame]
        if self.running {
            rect = self.run_frames[self.anim_frame]
        }
        var w:int = rect[2]/5
        var h:int = rect[3]/5
        win.drawTextureRegion(
            textureId: self.sprite_sheet_id,
            srcX:      rect[0],
            srcY:      rect[1],
            srcW:      rect[2],
            srcH:      rect[3],
            x:         screenX - w / 2,
            y:         self.ground_y - rect[3],
            w:         w,
            h:         h,
            flipH:     not self.facing_right
        )
    }
}
