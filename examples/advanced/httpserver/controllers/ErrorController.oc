import ocara.HTML
import ocara.HTTPServer
import ocara.HTTPServerRequest

// ─────────────────────────────────────────────────────────────────────────────

class ErrorController {

    public static method handle404(req:HTTPServerRequest): int {
        const path:string = req.path()
        scoped html:string = HTML::render(`<layout title="Page non trouvée" active="error">
  <card title="Erreur 404">
    <p>La page ${path} que vous recherchez n'existe pas.</p>
  </card>
</layout>`)

        req.respond(404, html)
        return 0
    }

}
