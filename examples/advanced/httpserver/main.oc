// examples/advanced/httpserver/main.oc
// Point d'entrée du mini projet.
//
// Enregistre les composants, configure les routes, démarre le serveur.
//
// Architecture :
//   components.oc                    — définition des composants HTMLComponent
//   controllers/HomeController.oc    — page d'accueil (async/resolve + render)
//   controllers/AboutController.oc   — page à propos (renderCached)
//   controllers/ContactController.oc — page contact (renderCached)
//
// Lancer :
//   ./target/release/ocara examples/advanced/httpserver/main.oc -o /tmp/site
//   /tmp/site
//
// Tester :
//   curl http://localhost:8080/
//   curl http://localhost:8080/about
//   curl http://localhost:8080/contact
namespace .

import ocara.IO
import configs.Components 
import configs.Server


init {
    IO::writeln("Initialisation du site...")
    use Components()
    const server:Server = use Server()
    server.routes()
}

main {
    IO::writeln("Site demarre sur http://localhost:8080")
    IO::writeln("  /          -> home (async stats)")
    IO::writeln("  /about     -> a propos (renderCached)")
    IO::writeln("  /contact   -> contact (renderCached)")
    try {
        server.start()
    } on e {
        IO::writeln(`Error ${e.source} ${e.code} : ${e.message}`)
        result e.code
    }
    IO::writeln("Server stopped.")
}

error {
    IO::writeln(`Error block executed with ERROR=${ERROR} SUCCESS=${SUCCESS}`)
}

success {
    IO::writeln(`Success block executed with ERROR=${ERROR} SUCCESS=${SUCCESS}`)
}