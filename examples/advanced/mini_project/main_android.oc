namespace .
// examples/advanced/mini_project/main_android.oc
// Variante Android de main.oc : même application (mêmes configs/controllers/
// models/services/templates), mais SANS ocara.Tauri (aucun équivalent
// Android, voir docs/roadmap.d/packaging-android-gui-native.md) — le serveur
// HTTP est affiché via une WebView Android système au lieu d'une fenêtre
// Tauri, voir packaging/android/ et
// docs/roadmap.d/packaging-android-webview-hybrid.md.
//
// Différence clé avec main.oc : ici, `main` ne lance PAS le serveur sur un
// thread séparé lui-même — le pont JNI (runtime_android_jni) appelle déjà
// cette fonction `main` sur un thread dédié, distinct du thread UI Android.
// `server.start()` peut donc bloquer directement (il tourne déjà hors du
// thread UI), sans le sous-thread + sondage HTTP nécessaires côté desktop
// pour ne pas geler la fenêtre Tauri en l'ouvrant trop tôt.

import ocara.IO
import configs.Components
import configs.Server
import configs.Database

init {
    IO::writeln("Initialisation de Garage Ocara (Android)...")
    use Components()
    Database::migrate()
    const server:Server = use Server()
    server.routes()
}

main {
    server.start()
}

error {
    match ERROR {
        default => IO::writeln(`Erreur inconnue : ${ERROR}`)
    }
}

exit {
    IO::writeln("Serveur arrêté.")
}
