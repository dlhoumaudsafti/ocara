// examples/ocara_app_advanced/services/PricingService.oc
// Règle métier : le prix de vente estimé d'une voiture est toujours
// recalculé entièrement (prix d'achat + somme des entretiens d'amélioration)
// plutôt qu'incrémenté à chaque ajout — robuste si un entretien est un jour
// modifié ou supprimé, pas seulement ajouté.

import models.Car
import models.Maintenance

class PricingService {

    public static method recalculateEstimatedPrice(carId:int): float {
        const car:map<string, mixed> = Car::find(carId)
        var purchasePrice:float  = car["purchase_price"]
        var improvements:float   = Maintenance::improvementTotal(carId)
        var newEstimated:float   = purchasePrice + improvements

        Car::updateEstimatedPrice(carId, newEstimated)
        return newEstimated
    }
}
