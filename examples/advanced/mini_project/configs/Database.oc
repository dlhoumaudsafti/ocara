namespace configs
// examples/advanced/mini_projet/configs/Database.oc
// Accès SQLite bas niveau : ouverture de connexion + migration du schéma.
//
// Comme dans examples/advanced/tauri_httpserver/configs/Database.oc : pas de propriété
// static en Ocara, donc chaque appel ouvre/ferme sa propre connexion vers le
// même fichier ("./app.db") plutôt que de garder un handle partagé en mémoire.

import ocara.SQLite
import ocara.System

class Database {

    public static method path(): string {
        if System::OS equal "android" {
            // Bac à sable de l'app (couplé au nom de package de
            // packaging/android/, com.ocara.demo — voir sa doc). PAS de
            // sous-dossier "files/" : contrairement à Context.getFilesDir()
            // côté Java, qui le crée à la demande, ce chemin est ouvert
            // directement par SQLite (Rust/C) sans jamais passer par cette
            // API Android — le sous-dossier n'existe donc jamais tant
            // qu'aucun code Java ne l'a créé. Vérifié par reproduction sur
            // un émulateur réel (`adb shell run-as com.ocara.demo ls -la
            // /data/user/0/com.ocara.demo/` : seuls cache/ et code_cache/
            // existent) — SQLite ne crée que le FICHIER final, jamais ses
            // dossiers parents manquants.
            return "/data/user/0/com.ocara.demo/app.db"
        }
        return "./app.db"
    }

    public static method connect(): SQLite {
        return SQLite::open(self::path())
    }

    public static method migrate(): void {
        const db:SQLite = self::connect()
        db.execute("CREATE TABLE IF NOT EXISTS cars (id INTEGER PRIMARY KEY AUTOINCREMENT, reference TEXT NOT NULL, brand TEXT NOT NULL, model TEXT NOT NULL, purchase_price REAL NOT NULL, estimated_sale_price REAL NOT NULL, created_at INTEGER NOT NULL)")
        db.execute("CREATE TABLE IF NOT EXISTS maintenances (id INTEGER PRIMARY KEY AUTOINCREMENT, car_id INTEGER NOT NULL, type TEXT NOT NULL, description TEXT NOT NULL, cost REAL NOT NULL, created_at INTEGER NOT NULL)")
        db.close()
    }
}
