namespace .
// examples/advanced/mini_projet/main.oc
// Point d'entrée : le serveur HTTP tourne sur un thread dédié et la fenêtre
// Tauri affiche directement son URL (http://localhost:8081) — une vraie
// page servie par Ocara/SQLite, pas un fichier HTML statique local. Même
// patron que examples/advanced/tauri_httpserver/main.oc.

import ocara.IO
import ocara.System
import ocara.Thread
import ocara.Tauri
import ocara.HTTPRequest
import ocara.HTTPResponse
import configs.Components
import configs.Server
import configs.Database

runtime core.init is init
runtime core.main is main
runtime core.error is error
runtime core.exit is exit
