// ─────────────────────────────────────────────────────────────────────────────
// Exemple 23 — Appels inter-statiques avec self::
//
// Illustre :
//   - Méthodes statiques qui s'appellent entre elles via self::
//   - self:: = raccourci pour ClassName:: depuis l'intérieur d'une classe
//   - Réutilisation de logique sans instanciation
// ─────────────────────────────────────────────────────────────────────────────
architecture permissive

import ocara.IO
import ocara.String

class Validator {

    public static method isPositive(n:int): bool {
        return n greater 0
    }

    public static method isInRange(n:int, low:int, high:int): bool {
        return n greater or equal low and n smaller or equal high
    }

    // Appelle d'autres méthodes statiques de la même classe via self::
    public static method isValidAge(age:int): bool {
        return self::isPositive(age) and self::isInRange(age, 1, 150)
    }

    public static method isValidScore(score:int): bool {
        return self::isInRange(score, 0, 100)
    }
}


class Temperature {

    public const ABSOLUTE_ZERO:int = -273

    // Conversion Celsius → Fahrenheit
    public static method toFahrenheit(c:int): int {
        return c * 9 / 5 + 32
    }

    // Conversion Fahrenheit → Celsius
    public static method toCelsius(f:int): int {
        return (f - 32) * 5 / 9
    }

    // Vérifie qu'une température est physiquement possible
    public static method isValid(c:int): bool {
        return c greater or equal Temperature::ABSOLUTE_ZERO
    }

    // Normalise : si en-dessous du zéro absolu, renvoie le zéro absolu
    public static method clamp(c:int): int {
        if self::isValid(c) {
            return c
        }
        return Temperature::ABSOLUTE_ZERO
    }
}


class StringCheck {

    public static method hasContent(s:string): bool {
        return s not equal ""
    }

    public static method startsWithUpper(s:string): bool {
        return s equal String::capitalize(s) and self::hasContent(s)
    }

    public static method isValidName(s:string): bool {
        return self::hasContent(s) and self::startsWithUpper(s)
    }
}


function main(): int {

    // ── Validator ────────────────────────────────────────────────────────────
    IO::writeln(Validator::isPositive(5))          // true
    IO::writeln(Validator::isPositive(-3))         // false
    IO::writeln(Validator::isValidAge(25))        // true
    IO::writeln(Validator::isValidAge(0))         // false
    IO::writeln(Validator::isValidAge(200))       // false
    IO::writeln(Validator::isValidScore(85))      // true
    IO::writeln(Validator::isValidScore(101))     // false

    // ── Temperature ──────────────────────────────────────────────────────────
    IO::writeln(Temperature::toFahrenheit(100))    // 212
    IO::writeln(Temperature::toFahrenheit(0))      // 32
    IO::writeln(Temperature::toCelsius(212))       // 100
    IO::writeln(Temperature::isValid(-273))        // true
    IO::writeln(Temperature::isValid(-300))        // false
    IO::writeln(Temperature::clamp(-300))           // -273
    IO::writeln(Temperature::clamp(20))             // 20

    // ── StringCheck ──────────────────────────────────────────────────────────
    IO::writeln(StringCheck::hasContent("hello"))  // true
    IO::writeln(StringCheck::hasContent(""))       // false
    IO::writeln(StringCheck::isValidName("Alice"))// true
    IO::writeln(StringCheck::isValidName("alice"))// false
    IO::writeln(StringCheck::isValidName(""))     // false

    return 0
}
