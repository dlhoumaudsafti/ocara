// ─────────────────────────────────────────────────────────────────────────────
// Exemple 04 — Conditions
//
// Illustre :
//   - if / elseif / else
//   - Opérateurs de comparaison : == != < <= > >=
//   - Opérateurs logiques : and or not
// ─────────────────────────────────────────────────────────────────────────────

import ocara.IO

function note_to_mention(note:int): string {
    if note greater or equal 90 {
        return "Excellent"
    } elseif note greater or equal 75 {
        return "Bien"
    } elseif note greater or equal 60 {
        return "Passable"
    } else {
        return "Insuffisant"
    }
}

function is_adult(age:int): bool {
    return age greater or equal 18
}


function main(): int {

    // Condition simple
    var x:int = 10
    if x greater 0 {
        IO::writeln("x est positif")
    }

    // if / elseif / else
    var temperature:int = 25
    if temperature smaller 0 {
        IO::writeln("Gel")
    } elseif temperature smaller 15 {
        IO::writeln("Frais")
    } elseif temperature smaller 25 {
        IO::writeln("Agréable")
    } else {
        IO::writeln("Chaud")
    }

    // Opérateurs logiques
    var a:int = 5
    var b:int = 10
    if a greater 0 and b greater 0 {
        IO::writeln("a et b sont positifs")
    }

    if a greater 100 or b greater 5 {
        IO::writeln("au moins une condition vraie")
    }

    if not false {
        IO::writeln("négation de false vaut true")
    }

    // Appel de fonction avec condition
    IO::writeln(note_to_mention(85))      // Bien
    IO::writeln(note_to_mention(45))      // Insuffisant

    if is_adult(20) {
        IO::writeln("majeur")
    } else {
        IO::writeln("mineur")
    }

    return 0
}
