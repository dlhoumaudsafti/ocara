// ============================================================================
// Paramètres variadics — Tests exhaustifs de TOUS les types
// ============================================================================
// Démonstration complète : int, float, string, bool, null, array, map,
// Function, classes, unions, mixed

architecture permissive

import ocara.IO
import ocara.Convert
import ocara.Array

// ── Classe de test ──────────────────────────────────────────────────────────

class Animal {
    public property name:string
    init(n:string) { self.name = n }
}

// ── 1. variadic<int> ────────────────────────────────────────────────────────

function sumInt(nums:variadic<int>): int {
    var total:int = 0
    for n in nums {
        total = total + n
    }
    return total
}

// ── 2. variadic<float> ──────────────────────────────────────────────────────

function sumFloat(nums:variadic<float>): float {
    var total:float = 0.0
    for n in nums {
        total = total + n
    }
    return total
}

// ── 3. variadic<string> ─────────────────────────────────────────────────────

function concatString(parts:variadic<string>): string {
    var result:string = ""
    for p in parts {
        result = result + p
    }
    return result
}

// ── 4. variadic<bool> ───────────────────────────────────────────────────────

function allTrue(flags:variadic<bool>): bool {
    for f in flags {
        if not f {
            return false
        }
    }
    return true
}

// ── 5. variadic<int|null> (union avec null) ────────────────────────────────

function sumNullable(nums:variadic<int|null>): int {
    var total:int = 0
    for n in nums {
        if n is int {
            total = total + n
        }
    }
    return total
}

// ── 6. variadic<array<int>> (tableaux) ───────────────────────────────────────────

function flattenArrays(arrays:variadic<array<int>>): int {
    var count:int = 0
    for arr in arrays {
        count = count + Array::len(arr)
    }
    return count
}

// ── 7. variadic<map<string,int>> (maps) ─────────────────────────────────────

function countMaps(maps:variadic<map<string,int>>): int {
    var total:int = 0
    for m in maps {
        total = total + 1
    }
    return total
}

// ── 8. variadic<Function<int(int)>> (fonctions) ──────────────────────────────────────────────────

function applyFunctions(val:int, funcs:variadic<Function<int(int)>>): int {
    var result:int = val
    for f in funcs {
        result = f(result)
    }
    return result
}

function double(x:int): int { return x * 2 }
function triple(x:int): int { return x * 3 }

// ── 9. variadic<Animal> (classes/objets) ────────────────────────────────────

function listAnimals(animals:variadic<Animal>): int {
    var count:int = 0
    for a in animals {
        IO::writeln("  - " + a.name)
        count = count + 1
    }
    return count
}

// ── 10. variadic<int|string|bool|null> (union multiple) ────────────────────

function describeUnion(vals:variadic<int|string|bool|null>): void {
    IO::writeln("Union values:")
    for val in vals {
        match val {
            is null   => IO::writeln("  → null")
            is int    => IO::writeln("  → int: " + Convert::intToStr(val))
            is string => IO::writeln(`  → string: ${val}`)
            is bool   => IO::writeln("  → bool: " + Convert::boolToStr(val))
        }
    }
}

// ── 11. variadic<mixed> (type dynamique avec warning) ───────────────────────

function debugMixed(vals:variadic<mixed>): void {
    IO::writeln("Mixed values (count: " + Convert::intToStr(Array::len(vals)) + "):")
    for val in vals {
        IO::writeln("  → " + Convert::intToStr(val))  // Simplifié
    }
}

// ── 12. Paramètres fixes + variadic ─────────────────────────────────────────

function prefixConcat(prefix:string, parts:variadic<string>): string {
    var result:string = prefix
    for p in parts {
        result = result + " " + p
    }
    return result
}

// ── 13. variadic avec 0 argument ────────────────────────────────────────────

function defaultSum(nums:variadic<int>): int {
    if Array::len(nums) equal 0 {
        return -1
    }
    return sumInt(nums)
}

// ── Main ────────────────────────────────────────────────────────────────────

function main(): int {
    IO::writeln("=== Tests exhaustifs de paramètres variadics ===")
    IO::writeln("")

    // Test 1: variadic<int>
    IO::writeln("1. variadic<int>:")
    IO::writeln("   sumInt(1, 2, 3, 4, 5) = " + Convert::intToStr(sumInt(1, 2, 3, 4, 5)))
    IO::writeln("   sumInt() = " + Convert::intToStr(sumInt()))
    IO::writeln("   sumInt(42) = " + Convert::intToStr(sumInt(42)))
    IO::writeln("")

    // Test 2: variadic<float>
    IO::writeln("2. variadic<float>:")
    IO::writeln("   sumFloat(1.5, 2.5, 3.0) = " + Convert::floatToStr(sumFloat(1.5, 2.5, 3.0)))
    IO::writeln("   sumFloat() = " + Convert::floatToStr(sumFloat()))
    IO::writeln("")

    // Test 3: variadic<string>
    IO::writeln("3. variadic<string>:")
    IO::writeln("   concatString(\"Hello\", \" \", \"World\") = " + concatString("Hello", " ", "World"))
    IO::writeln("   concatString() = \"" + concatString() + "\"")
    IO::writeln("")

    // Test 4: variadic<bool>
    IO::writeln("4. variadic<bool>:")
    IO::writeln("   allTrue(true, true, true) = " + Convert::boolToStr(allTrue(true, true, true)))
    IO::writeln("   allTrue(true, false, true) = " + Convert::boolToStr(allTrue(true, false, true)))
    IO::writeln("   allTrue() = " + Convert::boolToStr(allTrue()))
    IO::writeln("")

    // Test 5: variadic<int|null>
    IO::writeln("5. variadic<int|null> (union avec null):")
    IO::writeln("   sumNullable(1, null, 3, null, 5) = " + Convert::intToStr(sumNullable(1, null, 3, null, 5)))
    IO::writeln("")

    // Test 6: variadic<array<int>>
    IO::writeln("6. variadic<array<int>> (tableaux):")
    var arr1:array<int> = [1, 2, 3]
    var arr2:array<int> = [4, 5]
    var arr3:array<int> = [6, 7, 8, 9]
    IO::writeln("   flattenArrays([1,2,3], [4,5], [6,7,8,9]) = " + Convert::intToStr(flattenArrays(arr1, arr2, arr3)))
    IO::writeln("")

    // Test 7: variadic<map<string,int>>
    IO::writeln("7. variadic<map<string,int>> (maps):")
    var map1:map<string,int> = {"a": 1, "b": 2}
    var map2:map<string,int> = {"c": 3}
    IO::writeln("   countMaps(map1, map2) = " + Convert::intToStr(countMaps(map1, map2)))
    IO::writeln("")

    // Test 8: variadic<Function<int(int)>>
    IO::writeln("8. variadic<Function<int(int)>> (fonctions):")
    IO::writeln("   applyFunctions(5, double, triple) = " + Convert::intToStr(applyFunctions(5, double, triple)))
    IO::writeln("")

    // Test 9: variadic<Animal> (classes)
    IO::writeln("9. variadic<Animal> (objets):")
    var cat:Animal = use Animal("Chat")
    var dog:Animal = use Animal("Chien")
    var bird:Animal = use Animal("Oiseau")
    var count:int = listAnimals(cat, dog, bird)
    IO::writeln("   Total: " + Convert::intToStr(count) + " animaux")
    IO::writeln("")

    // Test 10: variadic<int|string|bool|null> (union multiple)
    IO::writeln("10. variadic<int|string|bool|null>:")
    describeUnion(42, "hello", true, null, 100, "world", false)
    IO::writeln("")

    // Test 11: variadic<mixed> (warning attendu)
    IO::writeln("11. variadic<mixed> (avec warning à la compilation):")
    debugMixed(1, 2, 3)
    IO::writeln("")

    // Test 12: Paramètres fixes + variadic
    IO::writeln("12. Paramètres fixes + variadic:")
    IO::writeln("   prefixConcat(\"Prefix:\", \"a\", \"b\", \"c\") = " + prefixConcat("Prefix:", "a", "b", "c"))
    IO::writeln("   prefixConcat(\"Prefix:\") = " + prefixConcat("Prefix:"))
    IO::writeln("")

    // Test 13: Appel avec 0 argument
    IO::writeln("13. Gestion de 0 argument:")
    IO::writeln("   defaultSum() = " + Convert::intToStr(defaultSum()))
    IO::writeln("   defaultSum(10, 20) = " + Convert::intToStr(defaultSum(10, 20)))
    IO::writeln("")

    IO::writeln("✓ Tous les types testés avec succès !")
    return 0
}
