import ocara.IO

function main(): int {
    IO::writeln("── 19. break / continue ─────────────────────")

    // break dans while
    var i:int = 0
    while i smaller 10 {
        if i equal 5 {
            break
        }
        IO::writeln("while : " + i)
        i = i + 1
    }
    IO::writeln("après break : i=" + i)

    // continue dans while
    var j:int = 0
    while j smaller 8 {
        j = j + 1
        if j % 2 equal 0 {
            continue
        }
        IO::writeln("impair : " + j)
    }

    // break dans for..range
    for k in 0..10 {
        if k equal 4 {
            break
        }
        IO::writeln("range : " + k)
    }

    // continue dans for..range
    for n in 0..6 {
        if n equal 2 or n equal 4 {
            continue
        }
        IO::writeln("skip 2,4 : " + n)
    }

    // break dans for..in (tableau)
    var nums:array<int> = [10, 20, 30, 40, 50]
    for v in nums {
        if v equal 30 {
            break
        }
        IO::writeln("arr : " + v)
    }

    return 0
}
