// ─────────────────────────────────────────────────────────────────────────────
// examples/builtins/httpserver.oc
//
// Démonstration de ocara.HTTPServer
//
// Pour tester :
//   ./target/release/ocara examples/builtins/httpserver.oc -o /tmp/httpserver_demo
//   /tmp/httpserver_demo
// Puis dans un autre terminal :
//   curl http://localhost:8080/
//   curl "http://localhost:8080/?name=Alice"
//   curl -X POST -d "bonjour" http://localhost:8080/echo
//   curl http://localhost:8080/json
//   curl http://localhost:8080/info
//   curl http://localhost:8080/hits
// ─────────────────────────────────────────────────────────────────────────────

import ocara.HTTPServer
import ocara.IO

function main(): int {

    const server:HTTPServer = use HTTPServer()
    server.port(8080)
    server.workers(4)

    // État partagé entre handlers — sûr SANS Mutex : l'invocation des
    // handlers est sérialisée nativement par HTTPServer (voir docs/builtins/
    // HTTPServer.md, section "Notes de sécurité / concurrence", et
    // docs/roadmap.d/runtime-httpserver-race-condition.md) — deux requêtes
    // concurrentes ne peuvent jamais exécuter un handler en même temps.
    // `var`, pas `scoped` : capturé par le handler, doit survivre à tout le
    // cycle de vie du serveur.
    var hitCount:int = 0

    // ── Route GET / ──────────────────────────────────────────────────────────
    // Accueil : salue le visiteur avec le paramètre ?name=
    server.route("/", "GET", nameless(req:int): int {
        var name:string = HTTPServer::query(req, "name")
        if name equal "" {
            name = "Monde"
        }
        HTTPServer::respondHeader(req, "Content-Type", "text/plain; charset=utf-8")
        HTTPServer::respond(req, 200, `Bonjour ${name} !`)
        return 0
    })

    // ── Route POST /echo ─────────────────────────────────────────────────────
    // Renvoie le corps de la requête tel quel
    server.route("/echo", "POST", nameless(req:int): int {
        var body:string = HTTPServer::body(req)
        HTTPServer::respondHeader(req, "Content-Type", "text/plain")
        HTTPServer::respond(req, 200, body)
        return 0
    })

    // ── Route GET /json ──────────────────────────────────────────────────────
    // Retourne une réponse JSON
    server.route("/json", "GET", nameless(req:int): int {
        var path:string = HTTPServer::path(req)
        var meth:string = HTTPServer::method(req)
        HTTPServer::respondHeader(req, "Content-Type", "application/json")
        HTTPServer::respond(req, 200, `{"path":"${path}","method":"${meth}","status":"ok"}`)
        return 0
    })

    // ── Route GET /info ──────────────────────────────────────────────────────
    // Lit un en-tête de la requête
    server.route("/info", "GET", nameless(req:int): int {
        var ua:string = HTTPServer::header(req, "user-agent")
        HTTPServer::respondHeader(req, "Content-Type", "text/plain")
        HTTPServer::respond(req, 200, `User-Agent: ${ua}`)
        return 0
    })

    // ── Route GET /hits ──────────────────────────────────────────────────────
    // Compteur de visites partagé entre TOUTES les requêtes concurrentes.
    // Aucun Mutex nécessaire : HTTPServer sérialise nativement l'invocation
    // des handlers (voir plus haut) — deux requêtes simultanées sur /hits ne
    // peuvent jamais lire hitCount en même temps, aucune incrémentation ne
    // peut se perdre.
    server.route("/hits", "GET", nameless(req:int): int {
        hitCount++
        HTTPServer::respondHeader(req, "Content-Type", "text/plain; charset=utf-8")
        HTTPServer::respond(req, 200, `${hitCount}`)
        return 0
    })

    IO::writeln("HTTPServer démarré sur http://localhost:8080")
    IO::writeln("Arrêt : Ctrl+C")
    server.run()

    return 0
}
