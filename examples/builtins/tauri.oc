// examples/builtins/tauri.oc
// Démonstration de ocara.Tauri
//
// Statut (voir docs/builtins/Tauri.md pour le détail) :
//   - Fonctionnel : création de fenêtre réelle (title/width/height/url) + run(),
//     et le pont IPC JS -> Ocara ui.handler()/ui.handlers() ci-dessous.
//   - Simulé (pas encore branché à la vraie fenêtre) : listen/emit/dialog/notify
//     et les getters/setters d'état (getTitle, setWidth, isOpen, focus, ...).
//     Ils sont montrés ici pour la surface d'API, mais n'ont aucun effet visible.
//
// Test rapide (compile-check seulement, n'ouvre pas de fenêtre — pas de run()) :
//   ./target/release/ocara examples/builtins/tauri.oc --check

import ocara.IO
import ocara.DateTime
import ocara.Tauri

class Backend {
    public static method greet(name:string): string {
        return "Bonjour " + name + " ! Il est " + DateTime::fromTimestamp(DateTime::now()) + "."
    }
    public static method ping(): string {
        return "pong"
    }
}

function main(): int {

    var ui:Tauri = use Tauri({
        "title": "Ocara Desktop Demo",
        "width": 1000,
        "height": 700,
        "url": "index.html"
    })

    // ── Pont IPC JS -> Ocara (fonctionnel) ──────────────────────────────────
    // Le JS de la page peut appeler ces méthodes directement, en objet nommé
    // (window.__TAURI_INTERNALS__.invoke("greet", {name: "Ada"})) ou en tableau
    // positionnel (window.ocara.invoke("greet", ["Ada"])) — voir Tauri.md.
    ui.handler("greet", Backend::greet)
    ui.handlers({
        "ping": Backend::ping
    })

    // ── Reste de l'API (encore simulé — voir docs/builtins/Tauri.md) ───────
    ui.listen("fromJS", nameless(data:string): void {
        IO::writeln(`Message JS reçu : ${data}`)
    })

    IO::writeln(`Titre initial : ${ui.getTitle()}`)
    IO::writeln(`Fenêtre ouverte : ${ui.isOpen()}`)

    ui.setTitle("Ocara — fenêtre mise à jour")
    ui.setWidth(1200)
    ui.setHeight(760)

    IO::writeln(`Nouveau titre : ${ui.getTitle()}`)
    IO::writeln(`Dimensions : ${ui.getWidth()}x${ui.getHeight()}`)

    ui.emit("backendReady", {
        "status": "ready",
        "version": "0.1.0"
    })

    ui.notify({
        "title": "Ocara Tauri",
        "body": "Application démarrée avec succès."
    })

    var answer:string = ui.dialog({
        "type": "info",
        "title": "Bienvenue",
        "message": "L'application Tauri est prête."
    })
    IO::writeln(`Réponse dialogue : ${answer}`)

    ui.focus()
    ui.maximize()
    ui.restore()

    IO::writeln("Démonstration Tauri terminée.")
    return 0
}
