// examples/builtins/sdl.oc
// Démonstration de ocara.SDL (Paliers 1-3 — voir docs/builtins/SDL.md)
//
// Contrairement à ocara.Tauri, tout ce qui est montré ici est réellement
// branché sur SDL3 (fenêtre, dessin, événements, textures, texte, audio,
// manettes) — rien n'est simulé.
//
// Test rapide (compile-check seulement, n'ouvre pas de fenêtre) :
//   ./target/release/ocara examples/builtins/sdl.oc --check
//
// Exécution réelle (ouvre une vraie fenêtre ~3 secondes, ou jusqu'à
// fermeture manuelle) — à lancer DEPUIS LA RACINE DU REPO (le logo est
// chargé via le chemin relatif 'logo-min.png') :
//   ./target/release/ocara examples/builtins/sdl.oc -o /tmp/sdl_demo
//   /tmp/sdl_demo
// Sans serveur d'affichage (CI, machine headless), SDL::init échoue proprement
// avec une SDLException — voir le try/on ci-dessous. Logo/police/son/musique
// sont chacun dans leur propre try/on : leur absence individuelle ne fait pas
// échouer le reste de la démonstration (dessin toujours affiché sans eux).
// Ces 4 try séquentiels imbriqués dans le try englobant exercent au passage
// un ancien bug de codegen (collision de noms __try_body_N/__try_handler_N
// sur des try imbriqués successifs) corrigé dans src/ir/module.rs (compteur
// dédié `try_counter`) / src/lower/stmt.d/statements.d/exceptions.rs.

import ocara.IO
import ocara.SDL

function main(): int {
    try {
        var win:SDL = use SDL({
            "title": "Ocara SDL Demo",
            "width": 800,
            "height": 600
        })

        IO::writeln(`Fenêtre ouverte : ${win.getTitle()} (${win.getWidth()}x${win.getHeight()})`)

        // ── Palier 2 : texture (facultative — la démo continue sans elle) ──
        var textureId:int = -1
        try {
            textureId = win.loadTexture("logo-min.png")
            IO::writeln(`Logo chargé : ${win.textureWidth(textureId)}x${win.textureHeight(textureId)}`)
        } on e is SDLException {
            IO::writeln(`Logo non chargé (${e.message}) — dessin sans logo.`)
        }

        // ── Palier 2 : police (facultative aussi) ───────────────────────────
        var fontId:int = -1
        try {
            fontId = win.loadFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 28)
        } on e is SDLException {
            IO::writeln(`Police non chargée (${e.message}) — dessin sans texte.`)
        }

        // ── Palier 3 : son (facultatif) ──────────────────────────────────────
        var soundId:int = -1
        try {
            soundId = win.loadSound("/usr/share/sounds/sound-icons/prompt.wav")
            win.playSound(soundId)   // joué une fois au démarrage
        } on e is SDLException {
            IO::writeln(`Son non chargé (${e.message}).`)
        }

        // ── Palier 3 : musique (facultative) ─────────────────────────────────
        try {
            win.playMusic("/usr/share/sounds/sound-icons/prompt.wav", true)  // en boucle, en fond
            win.setMusicVolume(30)
        } on e is SDLException {
            IO::writeln(`Musique non chargée (${e.message}).`)
        }

        // ── Palier 3 : manette (si une est branchée) ────────────────────────
        var gamepadId:int = -1

        var running:bool = true
        var frame:int = 0
        var x:int = 50

        while running and frame smaller 180 {   // ~3 secondes à 60 fps, ou fermeture manuelle
            // Vider la file d'événements avant de dessiner la frame
            var ev:map<string, mixed> = win.pollEvent()
            while ev["type"] not equal "none" {
                if ev["type"] equal "quit" {
                    running = false
                }
                if ev["type"] equal "keydown" {
                    if ev["key"] equal "Escape" {
                        running = false
                    }
                }
                if ev["type"] equal "gamepadconnected" {
                    gamepadId = ev["gamepadId"]
                    IO::writeln(`Manette connectée : id ${gamepadId}`)
                }
                if ev["type"] equal "gamepaddisconnected" {
                    IO::writeln(`Manette déconnectée : id ${ev["gamepadId"]}`)
                    gamepadId = -1
                }
                ev = win.pollEvent()
            }

            // Manette : lecture directe de l'état (utile pour un mouvement
            // continu — ici juste affiché une fois par seconde pour l'exemple)
            if gamepadId greater -1 and frame equal 60 {
                IO::writeln(`Manette ${gamepadId} — bouton Sud appuyé : ${win.isButtonPressed(gamepadId, "south")}, stick gauche X : ${win.getAxis(gamepadId, "leftx")}`)
            }

            // Fond
            win.setDrawColor(20, 20, 30, 255)
            win.clear()

            // Un carré qui traverse la fenêtre
            win.setDrawColor(220, 60, 60, 255)
            win.fillRect(x, 250, 80, 80)

            // Contour + une ligne, pour montrer les autres primitives
            win.setDrawColor(60, 180, 220, 255)
            win.drawRect(20, 20, 200, 100)
            win.drawLine(0, 0, 800, 600)

            // Le logo, redimensionné, en haut à droite
            if textureId greater 0 {
                win.drawTextureScaled(textureId, 650, 20, 120, 120)
            }

            // Un peu de texte, en bas
            if fontId greater 0 {
                win.drawText(fontId, "Ocara + SDL3", 220, 500, 255, 255, 255, 255)
            }

            win.present()

            x = x + 4
            if x greater 800 {
                x = -80
            }

            frame = frame + 1
            SDL::delay(16)
        }

        win.stopMusic()

        // Libération explicite des ressources chargées (voir docs/builtins/SDL.md,
        // section "Libération") — id inconnu/déjà libéré serait un no-op silencieux
        if textureId greater 0 {
            win.unloadTexture(textureId)
        }
        if fontId greater 0 {
            win.unloadFont(fontId)
        }
        if soundId greater 0 {
            win.unloadSound(soundId)
        }

        win.close()
        IO::writeln(`Démonstration SDL terminée (${frame} frames, fenêtre ouverte : ${win.isOpen()}).`)
    } on e is SDLException {
        IO::writeln(`SDL indisponible ici (pas d'affichage ? machine headless ?) : ${e.message} (code ${e.code})`)
    }

    return 0
}
