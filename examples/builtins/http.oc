// examples/builtins/http.oc
// Démonstration de ocara.HTTPRequest / ocara.HTTPResponse

import ocara.HTTPRequest
import ocara.HTTPResponse
import ocara.IO

function main(): int {

    // ── 1. Requête GET simple (raccourci) ────────────────────────────────────
    scoped res:HTTPResponse = HTTPRequest::get("http://useragent.fr/")

    IO::writeln("=== GET /users ===")
    IO::writeln(`Status : ${res.status()}`)

    if res.ok() {
        IO::writeln(res.body())
    } else {
        IO::writeln(`Erreur HTTP : ${res.status()}`)
    }
    res.closeResponse() // libère res — ce runtime n'a pas de GC, voir docs/builtins/HTTPRequest.md

    // ── 2. Requête POST avec en-têtes et corps ───────────────────────────────
    scoped req:HTTPRequest = HTTPRequest::new("http://useragent.fr/")
    req.setMethod("POST")
    req.setHeader("Content-Type", "application/json")
    req.setHeader("Authorization", "Bearer secret-token")
    req.setBody("{\"name\": \"Alice\", \"age\": 30}")
    req.setTimeout(5000)

    scoped res2:HTTPResponse = req.send()

    IO::writeln("=== POST /users ===")
    IO::writeln(`Status : ${res2.status()}`)
    IO::writeln(`Content-Type reçu : ${res2.header("Content-Type")}`)

    if res2.ok() {
        IO::writeln(res2.body())
    } else {
        IO::writeln(`Erreur : ${res2.error()}`)
    }
    req.close()          // libère req — plus utile une fois envoyée
    res2.closeResponse()

    // ── 3. Gestion d'une erreur réseau ───────────────────────────────────────
    scoped res3:HTTPResponse = HTTPRequest::get("https://hote-inexistant.local/api")

    IO::writeln("=== Erreur réseau ===")
    if res3.isError() {
        IO::writeln(`Erreur réseau : ${res3.error()}`)
    } else {
        IO::writeln(`Status : ${res3.status()}`)
    }
    res3.closeResponse()

    // ── 4. PUT et DELETE ─────────────────────────────────────────────────────
    scoped res4:HTTPResponse = HTTPRequest::put("http://useragent.fr/", "{\"name\": \"Bob\"}")
    IO::writeln(`PUT status : ${res4.status()}`)
    res4.closeResponse()

    scoped res5:HTTPResponse = HTTPRequest::delete("http://useragent.fr/")
    IO::writeln(`DELETE status : ${res5.status()}`)
    res5.closeResponse()

    // ── 5. Lecture de tous les en-têtes ──────────────────────────────────────
    scoped res6:HTTPResponse = HTTPRequest::get("http://useragent.fr/")
    scoped hdrs:map<string, string> = res6.headers()
    IO::writeln("=== En-têtes de réponse ===")
    res6.closeResponse()

    return 0
}
