// examples/ocara_app/controllers/AboutController.oc
// Contrôleur de la page "À propos".
//
// Contenu statique — mis en cache avec renderCached après le premier rendu.

import ocara.HTML
import ocara.HTTPServer
import ocara.File

class AboutController {

    public static method handle(req:int): int {
        scoped html:string = HTML::renderCached(File::read('templates/about.html'), "page_about")

        HTTPServer::respond(req, 200, html)
        return 0
    }
}
