// examples/ocara_app/controllers/ContactController.oc
// Contrôleur de la page "Contact".
//
// Contenu statique — mis en cache avec renderCached après le premier rendu.

import ocara.HTML
import ocara.HTTPServer
import ocara.File

class ContactController {

    public static method handle(req:int): int {
        scoped html:string = HTML::renderCached(File::read('templates/contact.html'), "page_contact")

        HTTPServer::respond(req, 200, html)
        return 0
    }
}
