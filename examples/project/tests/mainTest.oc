// ─────────────────────────────────────────────────────────────────────────────
// tests/mainTest.oc — tests unitaires pour main.oc (classes Score et Student)
// ─────────────────────────────────────────────────────────────────────────────

import ocara.UnitTest
import Score from "../main"
import Student from "../main"
import Color from "../main"

class MainTest extends UnitTest {

    public method printTest(): int {
        scoped s:Score = use Score("Alice", 90)
        s.print()
        self::pass("print appelé sans erreur")
        return 0
    }

    public method compareTest(): int {
        scoped s:Score = use Score("Alice", 80)
        self::assertEquals(1,  s.compare(70))
        self::assertEquals(-1, s.compare(90))
        self::assertEquals(0,  s.compare(80))
        return 0
    }

    public method addBonusTest(): int {
        scoped s:Score = use Score("Bob", 70)
        self::assertEquals(70, s.get_value())
        s.add_bonus(10)
        self::assertEquals(70, s.get_value())
        self::pass("add_bonus appliqué sans erreur")
        return 0
    }

    public method isPassingTest(): int {
        scoped passing:Score = use Score("Alice", 80)
        scoped failing:Score = use Score("Bob", 50)
        scoped limit:Score   = use Score("Carol", 60)
        self::assertTrue(passing.is_passing())
        self::assertFalse(failing.is_passing())
        self::assertTrue(limit.is_passing())
        return 0
    }

    public method getValueTest(): int {
        scoped s:Score = use Score("Alice", 75)
        self::assertEquals(75, s.get_value())
        return 0
    }

    public method getNameTest(): int {
        scoped s:Score = use Score("Charlie", 90)
        self::assertNotNull(s.get_name())
        self::pass("get_name retourne une valeur non nulle")
        return 0
    }

    public method enrollTest(): int {
        scoped st:Student = use Student("Dave", "S001")
        self::assertEquals(0, st.get_value())
        st.enroll("Math", 15)
        self::assertEquals(15, st.get_value())
        st.enroll("Info", 18)
        self::assertEquals(33, st.get_value())
        return 0
    }

    public method getIdTest(): int {
        scoped st:Student = use Student("Eve", "S042")
        self::assertNotNull(st.get_id())
        self::pass("get_id retourne une valeur non nulle")
        return 0
    }

    public method mixTest(): int {
        self::assertNotNull(Color::mix(Color::RED, Color::BLUE))
        self::pass("mix appelé sans erreur")
        return 0
    }

    public method isPrimaryTest(): int {
        self::assertTrue(Color::is_primary(Color::RED))
        self::assertTrue(Color::is_primary(Color::GREEN))
        self::assertTrue(Color::is_primary(Color::BLUE))
        self::assertFalse(Color::is_primary("violet"))
        return 0
    }

    public method describeTest(): int {
        self::assertNotNull(Color::describe(Color::RED))
        self::assertNotNull(Color::describe("inconnu"))
        self::pass("describe appelé sans erreur")
        return 0
    }
}
