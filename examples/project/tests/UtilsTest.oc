// ─────────────────────────────────────────────────────────────────────────────
// tests/UtilsTest.oc — tests unitaires pour classes/Utils.oc
// ─────────────────────────────────────────────────────────────────────────────

import ocara.UnitTest
import classes.Utils

class UtilsTest extends UnitTest {

    public method absTest(): int {
        scoped u:Utils = use Utils()
        self::assertEquals(42, u.abs(-42))
        self::assertEquals(7,  u.abs(7))
        self::assertEquals(0,  u.abs(0))
        return 0
    }

    public method powTest(): int {
        scoped u:Utils = use Utils()
        self::assertEquals(1,    u.pow(5, 0))
        self::assertEquals(8,    u.pow(2, 3))
        self::assertEquals(1024, u.pow(2, 10))
        self::assertEquals(81,   u.pow(3, 4))
        return 0
    }

    public method sumRangeTest(): int {
        scoped u:Utils = use Utils()
        self::assertEquals(0,  u.sum_range(0, 0))
        self::assertEquals(10, u.sum_range(0, 5))
        self::assertEquals(9,  u.sum_range(2, 5))
        return 0
    }
}
