// ─────────────────────────────────────────────────────────────────────────────
// tests/ServicesTest.oc — tests unitaires pour classes/Services.oc
// ─────────────────────────────────────────────────────────────────────────────

import ocara.UnitTest
import classes.Services

class ServicesTest extends UnitTest {

    public method countTasksTest(): int {
        scoped s:Services = use Services()
        self::assertEquals(0, s.count_tasks())
        s.add("tâche 1")
        self::assertEquals(1, s.count_tasks())
        s.add("tâche 2")
        self::assertEquals(2, s.count_tasks())
        return 0
    }

    public method addTest(): int {
        scoped s:Services = use Services()
        self::assertEquals(0, s.count_tasks())
        s.add("tâche A")
        s.add("tâche B")
        s.add("tâche C")
        self::assertEquals(3, s.count_tasks())
        return 0
    }

    public method tagTest(): int {
        scoped s:Services = use Services()
        // tag() ne plante pas et met à jour les compteurs internes
        s.tag("urgent")
        s.tag("urgent")
        s.tag("normal")
        self::pass("tag appelé sans erreur")
        return 0
    }

    public method processRangeTest(): int {
        scoped s:Services = use Services()
        // process_range() affiche uniquement, on vérifie qu'il ne plante pas
        s.process_range(1, 3)
        self::pass("process_range appelé sans erreur")
        return 0
    }

    public method showSummaryTest(): int {
        scoped s:Services = use Services()
        s.add("tâche X")
        s.show_summary()
        self::assertEquals(1, s.count_tasks())
        return 0
    }
}
