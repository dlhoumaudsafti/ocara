// ─────────────────────────────────────────────────────────────────────────────
// Exemple 07 — Boucles
//
// Illustre :
//   - while : boucle conditionnelle
//   - for i in range : itération sur une plage d'entiers
//   - for i in array : itération sur un tableau
//   - for key has val in map : itération clé/valeur
//   - Plages : start to end (fin incluse), start until end (fin exclue)
// ─────────────────────────────────────────────────────────────────────────────

architecture permissive

import ocara.IO

function main(): int {

    // ── while ──────────────────────────────────────────────────────────────
    var i:int = 0
    while i smaller 5 {
        IO::writeln(i)
        i = i + 1
    }
    // 0 1 2 3 4

    // ── for in range ────────────────────────────────────────────────────────
    // `to` : borne de fin incluse
    for j in 1 to 5 {
        IO::writeln(j)
    }
    // 1 2 3 4 5

    // `until` : borne de fin exclue (pratique pour un indice : 0 until n)
    for j in 0 until 3 {
        IO::writeln(j)
    }
    // 0 1 2

    // ── Calcul de somme avec for ─────────────────────────────────────────────
    var sum:int = 0
    for k in 1 to 10 {
        sum = sum + k
    }
    IO::writeln(sum)              // 55  (1+2+…10)

    // ── for sur un tableau ───────────────────────────────────────────────────
    var fruits:array<string> = ["pomme", "banane", "cerise"]
    for fruit in fruits {
        IO::writeln(fruit)
    }
    // pomme  banane  cerise

    // ── for clé/valeur sur une map ───────────────────────────────────────────
    var scores:map<string, int> = {
        "Alice": 95,
        "Bob":   82,
        "Carol": 78
    }
    for nom has points in scores {
        IO::writeln(nom)
        IO::writeln(points)
    }

    // ── Boucle de compte à rebours ───────────────────────────────────────────
    var countdown:int = 5
    while countdown greater 0 {
        IO::writeln(countdown)
        countdown = countdown - 1
    }
    IO::writeln("Go!")

    return 0
}
