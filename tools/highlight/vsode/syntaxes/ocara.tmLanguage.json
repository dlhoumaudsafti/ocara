{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ocara",
  "scopeName": "source.ocara",
  "fileTypes": ["oc"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#when-clause" },
    { "include": "#architecture-decl" },
    { "include": "#namespace" },
    { "include": "#import" },
    { "include": "#runtime-import" },
    { "include": "#runtime-block" },
    { "include": "#string-sql-double" },
    { "include": "#string-sql-single" },
    { "include": "#string-sql-template" },
    { "include": "#string-template" },
    { "include": "#string-double" },
    { "include": "#string-single" },
    { "include": "#named-argument" },
    { "include": "#generic-declaration" },
    { "include": "#class-declaration" },
    { "include": "#interface-module-enum-declaration" },
    { "include": "#function-declaration" },
    { "include": "#method-declaration" },
    { "include": "#method-call" },
    { "include": "#function-call" },
    { "include": "#self-static-access" },
    { "include": "#parent-static-access" },
    { "include": "#static-access" },
    { "include": "#generic-instantiation" },
    { "include": "#class-instantiation" },
    { "include": "#wiring-declaration" },
    { "include": "#storage-modifier" },
    { "include": "#keyword-control" },
    { "include": "#keyword-declaration" },
    { "include": "#keyword-other" },
    { "include": "#type-primitive" },
    { "include": "#constant-language" },
    { "include": "#number" },
    { "include": "#class-name" },
    { "include": "#operator" },
    { "include": "#punctuation" }
  ],
  "repository": {

    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ocara",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ocara",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.ocara" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.ocara" }
          }
        }
      ]
    },

    "architecture-decl": {
      "comment": "architecture hexagonal|permissive (docs/EBNF.md §33) : couleur des instructions bas niveau, comme when ; propriétés du bloc et couches colorées par le serveur de langage",
      "match": "^\\s*(architecture)\\s+(hexagonal|permissive)\\b",
      "captures": {
        "1": { "name": "keyword.control.directive.when.ocara" },
        "2": { "name": "keyword.control.directive.when.ocara" }
      }
    },

    "when-clause": {
      "comment": "Clause `when` (déclaration conditionnelle, docs/EBNF.md §32) : mot-clé et opérateurs dans une même couleur dédiée (configurationDefaults)",
      "name": "meta.condition.when.ocara",
      "begin": "^\\s*(when)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.directive.when.ocara" }
      },
      "end": "(?=//)|$",
      "patterns": [
        { "match": "\\b(default|is|not|greater|smaller|or|equal|and)\\b", "name": "keyword.control.directive.when.ocara" },
        { "include": "#static-access" },
        { "include": "#string-single" },
        { "include": "#string-double" },
        { "include": "#number" },
        { "include": "#punctuation" }
      ]
    },

    "runtime-import": {
      "comment": "runtime start.Init as init — runtime block import",
      "match": "^\\s*(runtime)\\s+([\\w]+(?:\\.[\\w]+)*)\\s+(as)\\s+(init|main|error|success|exit)\\s*(?=//|$)",
      "captures": {
        "1": { "name": "keyword.control.runtime.ocara" },
        "2": { "name": "entity.name.namespace.ocara" },
        "3": { "name": "keyword.control.as.ocara" },
        "4": { "name": "keyword.declaration.runtime.block.ocara" }
      }
    },

    "runtime-block": {
      "comment": "init { ... } — runtime lifecycle blocks",
      "begin": "\\b(init|main|error|success|exit)\\s*\\{",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.runtime.block.ocara" }
      },
      "patterns": [
        { "include": "$self" }
      ]
    },

    "namespace": {
      "patterns": [
        {
          "comment": "namespace . — root namespace",
          "match": "^(namespace)\\s+(\\.)\\s*$",
          "captures": {
            "1": { "name": "keyword.other.namespace.ocara" },
            "2": { "name": "punctuation.separator.namespace.root.ocara" }
          }
        },
        {
          "comment": "namespace identifier — named namespace",
          "match": "^(namespace)\\s+([\\w]+)\\s*$",
          "captures": {
            "1": { "name": "keyword.other.namespace.ocara" },
            "2": { "name": "entity.name.namespace.ocara" }
          }
        }
      ]
    },

    "import": {
      "patterns": [
        {
          "comment": "import * from \"file\" — wildcard import",
          "match": "^\\s*(import)\\s+(\\*)\\s+(from)\\s+(\"[^\"]+\")(?:\\s+(as)\\s+([A-Za-z_][\\w]*))?\\s*(?=//|$)",
          "captures": {
            "1": { "name": "keyword.control.import.ocara" },
            "2": { "name": "constant.language.import-all.ocara" },
            "3": { "name": "keyword.control.from.ocara" },
            "4": { "name": "string.quoted.double.ocara" },
            "5": { "name": "keyword.control.as.ocara" },
            "6": { "name": "entity.name.type.alias.ocara" }
          }
        },
        {
          "comment": "import Circle from \"file\" [as Alias] — selective import",
          "match": "^\\s*(import)\\s+([A-Z][\\w]*)\\s+(from)\\s+(\"[^\"]+\")(?:\\s+(as)\\s+([A-Za-z_][\\w]*))?\\s*(?=//|$)",
          "captures": {
            "1": { "name": "keyword.control.import.ocara" },
            "2": { "name": "entity.name.type.ocara" },
            "3": { "name": "keyword.control.from.ocara" },
            "4": { "name": "string.quoted.double.ocara" },
            "5": { "name": "keyword.control.as.ocara" },
            "6": { "name": "entity.name.type.alias.ocara" }
          }
        },
        {
          "comment": "import churn from \"file\" [as alias] — import sélectif d'une fonction",
          "match": "^\\s*(import)\\s+([a-z_][\\w]*)\\s+(from)\\s+(\"[^\"]+\")(?:\\s+(as)\\s+([a-z_][\\w]*))?\\s*(?=//|$)",
          "captures": {
            "1": { "name": "keyword.control.import.ocara" },
            "2": { "name": "entity.name.function.ocara" },
            "3": { "name": "keyword.control.from.ocara" },
            "4": { "name": "string.quoted.double.ocara" },
            "5": { "name": "keyword.control.as.ocara" },
            "6": { "name": "entity.name.function.ocara" }
          }
        },
        {
          "comment": "import ocara.Builtin — namespace builtin en couleur distincte",
          "match": "^\\s*(import)\\s+(ocara)(\\.)([\\w]+)(?:\\s+(as)\\s+([A-Za-z_][\\w]*))?\\s*(?=//|$)",
          "captures": {
            "1": { "name": "keyword.control.import.ocara" },
            "2": { "name": "support.class.builtin.namespace.ocara" },
            "3": { "name": "punctuation.separator.dot.ocara" },
            "4": { "name": "support.class.builtin.ocara" },
            "5": { "name": "keyword.control.as.ocara" },
            "6": { "name": "entity.name.type.alias.ocara" }
          }
        },
        {
          "comment": "import path.to.Module [as Alias]",
          "match": "^\\s*(import)\\s+([\\w]+(?:\\.[\\w]+)*)(?:\\s+(as)\\s+([A-Za-z_][\\w]*))?\\s*(?=//|$)",
          "captures": {
            "1": { "name": "keyword.control.import.ocara" },
            "2": { "name": "entity.name.namespace.ocara" },
            "3": { "name": "keyword.control.as.ocara" },
            "4": { "name": "entity.name.type.alias.ocara" }
          }
        }
      ]
    },

    "string-template": {
      "name": "string.template.ocara",
      "begin": "`",
      "end": "`",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.template.begin.ocara" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.template.end.ocara" }
      },
      "comment": "Échappements avant l'interpolation : \\` ne ferme pas le gabarit, \\${x} n'est pas interpolé. HTML : sous-ensemble maison (balises, attributs, commentaires, entités) dont chaque région s'arrête au ` fermant — text.html.basic avalait le reste du fichier sur <!-- ${x} ou un attribut non fermé.",
      "patterns": [
        { "include": "#string-escape" },
        { "include": "#template-expression" },
        { "include": "#template-html" }
      ]
    },

    "string-sql-double": {
      "comment": "Chaîne \"…\" reconnue comme SQL : premier argument de execute/query/queryOne/prepare, précédée de /* sql */, ou commençant par un mot-clé SQL en majuscules suivi d'un autre mot. Toute région interne s'arrête au \" fermant.",
      "name": "string.quoted.double.ocara meta.embedded.sql",
      "begin": "(?<=\\.execute\\(|\\.query\\(|\\.queryOne\\(|\\.prepare\\(|/\\*sql\\*/|/\\* sql \\*/|/\\*SQL\\*/|/\\* SQL \\*/)\\s*(\")|(\")(?=\\s*(?:SELECT|INSERT|UPDATE|DELETE|REPLACE|CREATE|DROP|ALTER|WITH|PRAGMA|BEGIN|COMMIT|ROLLBACK|VACUUM|TRUNCATE|EXPLAIN|ANALYZE|ATTACH|DETACH|SAVEPOINT|RELEASE)\\s+[^\\s\"])",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.ocara"
        },
        "2": {
          "name": "punctuation.definition.string.begin.ocara"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.ocara"
        }
      },
      "patterns": [
        {
          "include": "#string-escape"
        },
        {
          "name": "comment.block.sql",
          "begin": "/\\*",
          "end": "\\*/|(?=\")",
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "name": "comment.line.double-dash.sql",
          "begin": "--",
          "end": "$|(?=\")",
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "name": "string.quoted.single.sql",
          "begin": "'",
          "end": "'|(?=\")",
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "include": "#sql-tokens"
        }
      ]
    },

    "string-sql-single": {
      "comment": "Chaîne '…' reconnue comme SQL : premier argument de execute/query/queryOne/prepare, précédée de /* sql */, ou commençant par un mot-clé SQL en majuscules suivi d'un autre mot. Toute région interne s'arrête au ' fermant.",
      "name": "string.quoted.single.ocara meta.embedded.sql",
      "begin": "(?<=\\.execute\\(|\\.query\\(|\\.queryOne\\(|\\.prepare\\(|/\\*sql\\*/|/\\* sql \\*/|/\\*SQL\\*/|/\\* SQL \\*/)\\s*(')|(')(?=\\s*(?:SELECT|INSERT|UPDATE|DELETE|REPLACE|CREATE|DROP|ALTER|WITH|PRAGMA|BEGIN|COMMIT|ROLLBACK|VACUUM|TRUNCATE|EXPLAIN|ANALYZE|ATTACH|DETACH|SAVEPOINT|RELEASE)\\s+[^\\s'])",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.ocara"
        },
        "2": {
          "name": "punctuation.definition.string.begin.ocara"
        }
      },
      "end": "'",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.ocara"
        }
      },
      "patterns": [
        {
          "include": "#string-escape"
        },
        {
          "name": "comment.block.sql",
          "begin": "/\\*",
          "end": "\\*/|(?=')",
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "name": "comment.line.double-dash.sql",
          "begin": "--",
          "end": "$|(?=')",
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "name": "string.quoted.double.sql",
          "begin": "\"",
          "end": "\"|(?=')",
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "include": "#sql-tokens"
        }
      ]
    },

    "string-sql-template": {
      "comment": "Chaîne `…` reconnue comme SQL : premier argument de execute/query/queryOne/prepare, précédée de /* sql */, ou commençant par un mot-clé SQL en majuscules suivi d'un autre mot. Toute région interne s'arrête au ` fermant.",
      "name": "string.template.ocara meta.embedded.sql",
      "begin": "(?<=\\.execute\\(|\\.query\\(|\\.queryOne\\(|\\.prepare\\(|/\\*sql\\*/|/\\* sql \\*/|/\\*SQL\\*/|/\\* SQL \\*/)\\s*(`)|(`)(?=\\s*(?:SELECT|INSERT|UPDATE|DELETE|REPLACE|CREATE|DROP|ALTER|WITH|PRAGMA|BEGIN|COMMIT|ROLLBACK|VACUUM|TRUNCATE|EXPLAIN|ANALYZE|ATTACH|DETACH|SAVEPOINT|RELEASE)\\s+[^\\s`])",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.template.begin.ocara"
        },
        "2": {
          "name": "punctuation.definition.string.template.begin.ocara"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.end.ocara"
        }
      },
      "patterns": [
        {
          "include": "#string-escape"
        },
        {
          "include": "#template-expression"
        },
        {
          "name": "comment.block.sql",
          "begin": "/\\*",
          "end": "\\*/|(?=`)",
          "patterns": [
            {
              "include": "#string-escape"
            },
            {
              "include": "#template-expression"
            }
          ]
        },
        {
          "name": "comment.line.double-dash.sql",
          "begin": "--",
          "end": "$|(?=`)",
          "patterns": [
            {
              "include": "#string-escape"
            },
            {
              "include": "#template-expression"
            }
          ]
        },
        {
          "name": "string.quoted.single.sql",
          "begin": "'",
          "end": "'|(?=`)",
          "patterns": [
            {
              "include": "#string-escape"
            },
            {
              "include": "#template-expression"
            }
          ]
        },
        {
          "name": "string.quoted.double.sql",
          "begin": "\"",
          "end": "\"|(?=`)",
          "patterns": [
            {
              "include": "#string-escape"
            },
            {
              "include": "#template-expression"
            }
          ]
        },
        {
          "include": "#sql-tokens"
        }
      ]
    },

    "sql-tokens": {
      "comment": "Mots SQL d'une chaîne reconnue comme SQL : aucun ne contient de délimiteur, ils ne peuvent pas déborder de la chaîne.",
      "patterns": [
        {
          "name": "variable.parameter.sql",
          "match": "(?<![:\\w]):[A-Za-z_]\\w*"
        },
        {
          "name": "constant.numeric.sql",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        },
        {
          "name": "constant.language.sql",
          "match": "(?i)\\b(?:NULL|TRUE|FALSE|CURRENT_TIMESTAMP|CURRENT_DATE|CURRENT_TIME)\\b"
        },
        {
          "name": "support.function.sql",
          "match": "(?i)\\b(?:COUNT|SUM|AVG|MIN|MAX|TOTAL|GROUP_CONCAT|COALESCE|IFNULL|NULLIF|IIF|LENGTH|LOWER|UPPER|TRIM|LTRIM|RTRIM|SUBSTR|SUBSTRING|INSTR|REPLACE|ROUND|ABS|RANDOM|CAST|NOW|STRFTIME|DATE|DATETIME|JULIANDAY|LAST_INSERT_ROWID|LAST_INSERT_ID|CONCAT|JSON_EXTRACT|JSON_OBJECT|JSON_ARRAY|PRINTF|FORMAT|TYPEOF|HEX|QUOTE)(?=\\s*\\()"
        },
        {
          "name": "storage.type.sql",
          "match": "(?i)\\b(?:INTEGER|INT|BIGINT|SMALLINT|TINYINT|MEDIUMINT|REAL|DOUBLE|FLOAT|DECIMAL|NUMERIC|TEXT|LONGTEXT|MEDIUMTEXT|VARCHAR|CHAR|NCHAR|NVARCHAR|CLOB|BLOB|BOOLEAN|BOOL|DATE|DATETIME|TIME|TIMESTAMP|JSON|ENUM)\\b"
        },
        {
          "name": "keyword.other.sql",
          "match": "(?i)\\b(?:SELECT|FROM|WHERE|AND|OR|NOT|IN|IS|LIKE|GLOB|BETWEEN|EXISTS|INSERT|INTO|VALUES|UPDATE|SET|DELETE|CREATE|TABLE|INDEX|VIEW|TRIGGER|UNIQUE|PRIMARY|KEY|FOREIGN|REFERENCES|CONSTRAINT|DEFAULT|CHECK|AUTOINCREMENT|AUTO_INCREMENT|DROP|ALTER|ADD|COLUMN|RENAME|TO|IF|JOIN|INNER|LEFT|RIGHT|FULL|OUTER|CROSS|NATURAL|ON|USING|AS|DISTINCT|ALL|GROUP|BY|ORDER|ASC|DESC|HAVING|LIMIT|OFFSET|UNION|INTERSECT|EXCEPT|CASE|WHEN|THEN|ELSE|END|WITH|RECURSIVE|REPLACE|RETURNING|CONFLICT|DO|NOTHING|BEGIN|COMMIT|ROLLBACK|TRANSACTION|SAVEPOINT|RELEASE|PRAGMA|VACUUM|EXPLAIN|ANALYZE|ATTACH|DETACH|DATABASE|SCHEMA|TRUNCATE|CASCADE|COLLATE|ESCAPE|TEMP|TEMPORARY|WITHOUT|ROWID|ENGINE|CHARSET)\\b"
        },
        {
          "name": "keyword.operator.sql",
          "match": "<>|!=|<=|>=|\\|\\||[=<>*+%/-]"
        }
      ]
    },

    "template-html": {
      "patterns": [
        {
          "name": "comment.block.html",
          "begin": "<!--",
          "end": "-->|(?=`)",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.html" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.html" } },
          "patterns": [
            { "include": "#string-escape" },
            { "include": "#template-expression" }
          ]
        },
        {
          "name": "meta.tag.html",
          "begin": "(</?)([A-Za-z][\\w:-]*)",
          "end": "(/?>)|(?=`)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.html" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.tag.end.html" } },
          "patterns": [
            { "include": "#string-escape" },
            { "include": "#template-expression" },
            { "include": "#template-html-attribute-value" },
            { "match": "[^\\s=\"'<>/`$]+", "name": "entity.other.attribute-name.html" },
            { "match": "=", "name": "punctuation.separator.key-value.html" }
          ]
        },
        {
          "name": "constant.character.entity.html",
          "match": "&(?:[A-Za-z][A-Za-z0-9]*|#\\d+|#x[0-9A-Fa-f]+);"
        }
      ]
    },

    "template-html-attribute-value": {
      "patterns": [
        {
          "name": "string.quoted.double.html",
          "begin": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.html" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.html" } },
          "end": "\"|(?=`)",
          "patterns": [
            { "include": "#string-escape" },
            { "include": "#template-expression" }
          ]
        },
        {
          "name": "string.quoted.single.html",
          "begin": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.html" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.html" } },
          "end": "'|(?=`)",
          "patterns": [
            { "include": "#string-escape" },
            { "include": "#template-expression" }
          ]
        }
      ]
    },

    "template-expression": {
      "name": "meta.template.expression.ocara",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.ocara" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.ocara" }
      },
      "contentName": "source.ocara.embedded",
      "patterns": [
        { "include": "$self" }
      ]
    },

    "string-double": {
      "name": "string.quoted.double.ocara",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.ocara" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.ocara" }
      },
      "patterns": [
        { "include": "#string-escape" }
      ]
    },

    "string-single": {
      "name": "string.quoted.single.ocara",
      "begin": "'",
      "end": "'",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.ocara" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.ocara" }
      },
      "patterns": [
        { "include": "#string-escape" }
      ]
    },

    "string-escape": {
      "name": "constant.character.escape.ocara",
      "match": "\\\\[ntr\"'\\\\0`$]"
    },

    "named-argument": {
      "comment": "f(name: expr) — argument nommé (docs/roadmap.d/langage-named-arguments.md). Après '(' / ',' ou en début de ligne (appel multi-lignes) ; exclu quand le ':' est suivi d'un type (paramètre déclaré 'nom:Type').",
      "match": "(?:(?<=[(,])|^)\\s*([a-zA-Z_][\\w]*)\\s*(:)(?!:)(?!\\s*(?:int|float|string|bool|mixed|void|array|map|variadic|Function|Resolvable|message)\\b)(?!\\s*[A-Z][\\w]*\\s*(?:[,)=|<{]|$))",
      "captures": {
        "1": { "name": "variable.parameter.named-argument.ocara" },
        "2": { "name": "punctuation.separator.named-argument.ocara" }
      }
    },

    "generic-declaration": {
      "comment": "generic List<T> or generic Cache<K, V = string>",
      "match": "\\b(generic)\\s+([A-Z][\\w]*)\\s*<([^>]+)>",
      "captures": {
        "1": { "name": "keyword.declaration.generic.ocara" },
        "2": { "name": "entity.name.class.generic.ocara" },
        "3": { "name": "entity.name.type.parameter.ocara" }
      }
    },

    "class-declaration": {
      "match": "\\b(class|struct)\\s+([A-Z][\\w]*)\\b",
      "captures": {
        "1": { "name": "keyword.declaration.class.ocara" },
        "2": { "name": "entity.name.class.ocara" }
      }
    },

    "interface-module-enum-declaration": {
      "match": "\\b(interface|module|enum)\\s+([A-Z][\\w]*)\\b",
      "captures": {
        "1": { "name": "keyword.declaration.ocara" },
        "2": { "name": "entity.name.class.ocara" }
      }
    },

    "function-declaration": {
      "match": "\\b(?:(async)\\s+)?(function)\\s+([a-z_][\\w]*)\\b",
      "captures": {
        "1": { "name": "storage.modifier.async.ocara" },
        "2": { "name": "keyword.declaration.function.ocara" },
        "3": { "name": "entity.name.function.ocara" }
      }
    },

    "method-declaration": {
      "comment": "public static async method methodName",
      "match": "\\b(?:(async)\\s+)?(method)\\s+([a-z_][\\w]*)\\b",
      "captures": {
        "1": { "name": "storage.modifier.async.ocara" },
        "2": { "name": "keyword.declaration.function.ocara" },
        "3": { "name": "entity.name.function.method.ocara" }
      }
    },

    "method-call": {
      "comment": "obj.method( — appel de méthode sur instance",
      "match": "(?<![:])\\.([a-zA-Z_][\\w]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.method.ocara" }
      }
    },

    "function-call": {
      "comment": "free function call: name( — sauf mot-clé suivi de ( (if (, while (, return (, not (…)",
      "match": "\\b(?!(?:if|elseif|else|then|switch|match|while|for|in|return|result|break|continue|default|try|on|raise|emit|and|or|not|equal|smaller|greater|is|var|const|use)\\b)([a-z_][\\w]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.ocara" }
      }
    },

    "self-static-access": {
      "comment": "self::methodName — accès statique depuis l'intérieur d'une classe",
      "match": "\\b(self)(::)([\\w]+)\\b",
      "captures": {
        "1": { "name": "variable.language.self.ocara" },
        "2": { "name": "punctuation.accessor.double-colon.ocara" },
        "3": { "name": "entity.name.function.static.ocara" }
      }
    },

    "parent-static-access": {
      "comment": "parent::methodName — accès statique depuis l'intérieur d'une classe parente",
      "match": "\\b(parent)(::)([\\w]+)\\b",
      "captures": {
        "1": { "name": "variable.language.parent.ocara" },
        "2": { "name": "punctuation.accessor.double-colon.ocara" },
        "3": { "name": "entity.name.function.static.ocara" }
      }
    },

    "static-access": {
      "comment": "ClassName::member ou ClassName::CONST",
      "match": "\\b([A-Z][\\w]*)(::)([\\w]+)\\b",
      "captures": {
        "1": { "name": "entity.name.class.ocara" },
        "2": { "name": "punctuation.accessor.double-colon.ocara" },
        "3": { "name": "entity.name.function.static.ocara" }
      }
    },

    "generic-instantiation": {
      "comment": "use List<int>() or use Cache<string, User>()",
      "match": "\\b(use)\\s+([A-Z][\\w]*)\\s*<([^>]+)>\\s*\\(",
      "captures": {
        "1": { "name": "keyword.operator.new.ocara" },
        "2": { "name": "entity.name.class.generic.ocara" },
        "3": { "name": "entity.name.type.parameter.ocara" }
      }
    },

    "class-instantiation": {
      "comment": "use ClassName(",
      "match": "\\b(use)\\s+([A-Z][\\w]*)\\b",
      "captures": {
        "1": { "name": "keyword.operator.new.ocara" },
        "2": { "name": "entity.name.class.ocara" }
      }
    },

    "wiring-declaration": {
      "comment": "wiring path.to.ClassName — dans une interface (EBNF §17.1) ou une classe de test (§17.2)",
      "match": "\\b(wiring)\\s+([A-Za-z_][\\w.]*)\\b",
      "captures": {
        "1": { "name": "keyword.other.ocara" },
        "2": { "name": "entity.name.class.ocara" }
      }
    },

    "storage-modifier": {
      "name": "storage.modifier.ocara",
      "match": "\\b(public|private|protected|static|async)\\b"
    },

    "keyword-control": {
      "patterns": [
        {
          "comment": "Plages `a to b` (fin incluse) / `a until b` (fin exclue) : mots-clés seulement entre deux bornes",
          "match": "(?<=[\\w)\\]])\\s+(to|until)(?=\\s+[\\w(\\-])",
          "captures": { "1": { "name": "keyword.control.range.ocara" } }
        },
        {
          "comment": "`has` n'est un mot-clé que dans `for k has v in m` (identifiant ailleurs : m.has(k)).",
          "match": "\\b(for)\\s+([a-zA-Z_][\\w]*)\\s+(has)\\b",
          "captures": {
            "1": { "name": "keyword.control.ocara" },
            "3": { "name": "keyword.control.ocara" }
          }
        },
        {
          "name": "keyword.control.ocara",
          "match": "\\b(if|elseif|else|then|switch|match|while|for|in|return|result|break|continue|default|try|on|raise|emit)\\b"
        }
      ]
    },

    "keyword-declaration": {
      "name": "keyword.declaration.ocara",
      "match": "\\b(var|scoped|consumed|const|init|property|generic|runtime|main|error|success|exit)\\b"
    },

    "keyword-other": {
      "name": "keyword.other.ocara",
      "match": "\\b(as|from|use|nameless|resolve|extends|implements|modules|wiring|self|parent|namespace)\\b"
    },

    "type-primitive": {
      "name": "support.type.primitive.ocara",
      "match": "\\b(int|float|string|bool|mixed|void|map|array|message|Resolvable|Function|variadic|null)\\b"
    },

    "constant-language": {
      "patterns": [
        {
          "name": "constant.language.boolean.true.ocara",
          "match": "\\btrue\\b"
        },
        {
          "name": "constant.language.boolean.false.ocara",
          "match": "\\bfalse\\b"
        }
      ]
    },

    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.ocara",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.ocara",
          "match": "\\b\\d+\\b"
        }
      ]
    },

    "class-name": {
      "comment": "Toute référence PascalCase (type, classe importée, etc.)",
      "name": "entity.name.type.ocara",
      "match": "\\b[A-Z][\\w]*\\b"
    },

    "operator": {
      "patterns": [
        {
          "comment": "Comparaisons littérales",
          "name": "keyword.control.ocara",
          "match": "\\b(and|or|not|equal|smaller|greater|is)\\b"
        },
        {
          "name": "keyword.control.ocara",
          "match": "\\.\\."
        },
        {
          "comment": "< et > restent des tokens valides pour les génériques (List<T>, Function<int(int)>), jamais pour une comparaison.",
          "name": "keyword.control.ocara",
          "match": "(?<![=!<>])[<>](?![=])"
        },
        {
          "name": "keyword.control.ocara",
          "match": "(?<![=!<>])=(?!=)"
        },
        {
          "name": "keyword.control.ocara",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.control.ocara",
          "match": "\\|"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.accessor.dot.ocara",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.comma.ocara",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.ocara",
          "match": ":"
        }
      ]
    }
  }
}
