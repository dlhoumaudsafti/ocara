        },
        {
          "id": "ocara.benchmark",
          "name": "Benchmark",
          "contextualTitle": "Benchmark - Ocara"
        },
        {
          "id": "ocara.coverage",
          "name": "Coverage",
          "contextualTitle": "Coverage - Ocara"
        },
        {
          "id": "ocara.linter",
          "name": "Linter",
