          "contextualTitle": "Configuration - Ocara"
        },
        {
          "id": "ocara.workflow",
          "name": "Workflow",
          "contextualTitle": "Workflow - Ocara"
        },
        {
          "type": "webview",
          "id": "ocara.graph",
          "name": "Graphe d'appels",
