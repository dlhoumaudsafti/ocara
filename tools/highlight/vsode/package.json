{
  "name": "ocara-language",
  "displayName": "Ocara Language Support",
  "description": "Syntax highlighting, completion, Go-to-Definition, ocaracs linting and compile/dump commands for Ocara (.oc) files",
  "version": "1.0.0",
  "publisher": "david-lhoumaud",
  "license": "MIT",
  "icon": "logo-min.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:ocara",
    "onView:ocara.controls",
    "onView:ocara.workflow",
    "onView:ocara.graph",
    "onView:ocara.benchmark",
    "onView:ocara.coverage",
    "onView:ocara.linter",
    "onView:ocara.architecture",
    "onCustomEditor:ocara.uiDesigner"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ocara",
        "aliases": [
          "Ocara",
          "ocara"
        ],
        "extensions": [
          ".oc"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "yaml",
        "extensions": [
          ".oc.ui"
        ]
      }
    ],
    "grammars": [
      {
        "language": "ocara",
        "scopeName": "source.ocara",
        "path": "./syntaxes/ocara.tmLanguage.json",
        "embeddedLanguages": {
          "text.html.basic": "html",
          "source.ocara.embedded": "ocara"
        }
      }
    ],
    "configuration": {
      "title": "Ocara",
      "properties": {
        "ocara.compilerPath": {
          "type": "string",
          "default": "ocara",
          "markdownDescription": "Chemin du compilateur `ocara` ou commande pour le lancer (arguments et guillemets acceptés, variables `${workspaceFolder}` et `${fileDirname}`). Laissé à `ocara` et absent du PATH : `<workspace>/target/release/ocara` s'il existe."
        },
        "ocara.ocaracsPath": {
          "type": "string",
          "default": "ocaracs",
          "markdownDescription": "Chemin de l'analyseur de style `ocaracs` ou commande pour le lancer (mêmes règles que `ocara.compilerPath`)."
        },
        "ocara.ocaraunitPath": {
          "type": "string",
          "default": "ocaraunit",
          "markdownDescription": "Chemin du runner de tests `ocaraunit` ou commande pour le lancer (mêmes règles que `ocara.compilerPath`)."
        },
        "ocara.lint.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Analyse `ocaracs` automatique à l'affichage, l'ouverture et l'enregistrement d'un fichier `.oc` (règles : `.ocaracs` le plus proche du script, sinon valeurs par défaut d'ocaracs)."
        },
        "ocara.lint.scope": {
          "type": "string",
          "enum": [
            "workspace",
            "folder",
            "script"
          ],
          "default": "workspace",
          "enumDescriptions": [
            "Projets de l'espace de travail.",
            "Dossier du script affiché, sous-dossiers compris.",
            "Script affiché seul (ses avertissements uniquement)."
          ],
          "markdownDescription": "Périmètre de l'encart **Linter** et de son voyant : `workspace` (projets de l'espace de travail), `folder` (dossier du script affiché, sous-dossiers compris) ou `script` (script affiché seul). Lancement : bouton ▶, et automatiquement selon `ocara.lint.auto`. N'affecte pas l'analyse `ocaracs` du fichier affiché (surlignage jaune, `ocara.lint.enable`)."
        },
        "ocara.lint.auto": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Mode automatique de l'encart **Linter** (bouton de l'en-tête) : en `workspace`, à l'ouverture et à chaque enregistrement d'un `.oc` ; en `folder`, à l'enregistrement d'un `.oc` du dossier et quand le script affiché change de dossier ; en `script`, à l'enregistrement du script et quand le script affiché change."
        },
        "ocara.lint.projects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Dossiers analysés par l'encart **Linter** en périmètre `workspace` (relatifs à l'espace de travail, ex. `examples/advanced/mini_project_hexa`). Vide : racines des projets testés (dossier `tests` contenant des `*Test.oc`), sinon dossiers de l'espace de travail."
        },
        "ocara.lint.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Dossiers ou fichiers ignorés par l'encart **Linter** (ex. `core`, `main.oc`, `tests/support`), comparés par segments de chemin depuis la racine analysée et l'espace de travail : listés en gris, leurs avertissements ne comptent pas."
        },
        "ocara.coverage.scope": {
          "type": "string",
          "enum": [
            "workspace",
            "folder",
            "script"
          ],
          "default": "workspace",
          "enumDescriptions": [
            "Tous les projets testés de l'espace de travail.",
            "Dossier du script affiché : tests du projet qui le contient, couverture limitée au dossier.",
            "Script affiché : tests de son projet, couverture limitée au script ; un *Test.oc ne lance que lui-même."
          ],
          "markdownDescription": "Périmètre de l'encart **Coverage** et de son voyant : `workspace` (tous les projets testés), `folder` (dossier du script affiché : tests du projet qui le contient, couverture limitée au dossier ; un dossier de tests ne lance que ses tests) ou `script` (script affiché : tests de son projet, couverture limitée au script ; un `*Test.oc` ne lance que lui-même). Lancement : bouton ▶, et automatiquement selon `ocara.coverage.auto`."
        },
        "ocara.coverage.auto": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Mode automatique de l'encart **Coverage** (bouton de l'en-tête) : en `workspace`, à l'ouverture et à chaque enregistrement d'un `.oc` ; en `folder`, à l'enregistrement d'un `.oc` du dossier et quand le script affiché change de dossier ; en `script`, à l'enregistrement du script et quand le script affiché change."
        },
        "ocara.coverage.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Dossiers ou fichiers exclus de la couverture (ex. `core`, `main.oc`, `context/car/infra/db`) et de la recherche des projets testés, listés en gris dans l'encart Coverage. Comparés par segments de chemin, relativement à la racine de chaque projet (et de l'espace de travail pour la recherche des projets) : `core` exclut `core/…` et `a/core/…`."
        },
        "ocara.coverage.projects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Dossiers de tests à lancer (relatifs à l'espace de travail, ex. `examples/advanced/mini_project_hexa/tests`). Vide : tout dossier `tests` contenant des `*Test.oc`, la racine du projet étant son parent."
        },
        "ocara.coverage.threshold": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "maximum": 100,
          "markdownDescription": "Couverture par ligne (en %) à partir de laquelle le voyant Coverage passe au vert (tous les tests doivent aussi passer)."
        },
        "ocara.architecture.scope": {
          "type": "string",
          "enum": [
            "workspace",
            "folder",
            "script"
          ],
          "default": "workspace",
          "enumDescriptions": [
            "Projets de l'espace de travail (dossier de chaque main.oc, ou ocara.architecture.projects).",
            "Projet(s) du dossier du script affiché, scripts du dossier seulement.",
            "Projet du script affiché, ce script seulement."
          ],
          "markdownDescription": "Périmètre de l'encart **Architecture** et de son voyant : rapport du compilateur (`ocara main.oc --architecture-report`, docs/EBNF.md §33) pour les projets de l'espace de travail (`workspace` : dossier de chaque `main.oc`, ou `ocara.architecture.projects`), le projet du dossier du script affiché (`folder`, scripts du dossier seulement) ou du script affiché (`script`). Tests, blocs runtime et `ocara.architecture.exclude` ignorés (listés en gris). Lancement : bouton ▶, et automatiquement selon `ocara.architecture.auto`."
        },
        "ocara.architecture.auto": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Mode automatique de l'encart **Architecture** (bouton de l'en-tête), mêmes déclencheurs que `ocara.lint.auto`."
        },
        "ocara.architecture.projects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Dossiers de projet analysés par l'encart **Architecture** en périmètre `workspace` (relatifs à l'espace de travail, ex. `examples/advanced/mini_project_hexa`) ; chacun doit contenir son `main.oc`. Vide : dossier de chaque `main.oc` de l'espace de travail."
        },
        "ocara.architecture.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Dossiers ou fichiers ignorés par l'encart **Architecture** (ex. `configs`, `probe_main.oc`), comparés par segments de chemin depuis l'espace de travail : listés en gris, non vérifiés. Les tests et les blocs runtime le sont toujours."
        },
        "ocara.autoImport.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ajoute les imports manquants à l'enregistrement d'un fichier `.oc` : `import ocara.X` pour un builtin, sinon le fichier du projet qui déclare le type, cherché dans le dossier du script, ses sous-dossiers, puis les dossiers parents jusqu'à la racine du projet. Le correctif rapide (Ctrl+.) reste disponible quand ce réglage est désactivé."
        },
        "ocara.os": {
          "type": "string",
          "enum": [
            "system",
            "linux",
            "windows",
            "macos",
            "android",
            "other"
          ],
          "enumDescriptions": [
            "Système de la machine (défaut)",
            "Linux",
            "Windows",
            "macOS",
            "Android",
            "Valeur personnalisée : réglage « ocara.osOther »"
          ],
          "default": "system",
          "markdownDescription": "Valeur de `System::OS` pour l'éditeur : variante `when` retenue, variantes écartées estompées et diagnostics de cette configuration. Ne change pas la cible des commandes de compilation (machine hôte)."
        },
        "ocara.osOther": {
          "type": "string",
          "default": "",
          "markdownDescription": "Valeur personnalisée de `System::OS` quand `ocara.os` vaut `other`."
        },
        "ocara.arch": {
          "type": "string",
          "enum": [
            "system",
            "x86_64",
            "aarch64",
            "arm",
            "other"
          ],
          "enumDescriptions": [
            "Architecture de la machine (défaut)",
            "Intel / AMD 64 bits",
            "ARM 64 bits",
            "ARM 32 bits",
            "Valeur personnalisée : réglage « ocara.archOther »"
          ],
          "default": "system",
          "markdownDescription": "Valeur de `System::ARCH` pour l'éditeur (mêmes effets que `ocara.os`)."
        },
        "ocara.archOther": {
          "type": "string",
          "default": "",
          "markdownDescription": "Valeur personnalisée de `System::ARCH` quand `ocara.arch` vaut `other`."
        },
        "ocara.build": {
          "type": "string",
          "enum": [
            "debug",
            "release"
          ],
          "enumDescriptions": [
            "Mode debug (défaut)",
            "Mode release (`--release`)"
          ],
          "default": "debug",
          "markdownDescription": "Valeur de `System::BUILD` pour l'éditeur (mêmes effets que `ocara.os`). Les commandes de compilation gardent leur propre mode (Debug/Release)."
        },
        "ocara.benchmark.runs": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "markdownDescription": "Nombre d'exécutions de « Mesurer temps et mémoire » (temps moyen, min, max ; pic mémoire le plus haut)."
        },
        "ocara.benchmark.timeout": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "markdownDescription": "Délai maximal d'une exécution mesurée, en secondes (un serveur qui ne s'arrête pas est interrompu)."
        },
        "ocara.benchmark.leakSizes": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "default": [
            20000,
            200000
          ],
          "minItems": 2,
          "maxItems": 2,
          "markdownDescription": "Valeurs du marqueur `__N__` pour la détection de fuite : le pic mémoire est comparé entre les deux (voir docs/benchmarking.md)."
        },
        "ocara.startupScript": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Script de démarrage du projet, relatif au dossier de l'espace de travail (ex. `main.oc`) : « Compiler et lancer » le compile et le lance quel que soit le script affiché. Vide : le script cliqué ou affiché (comportement par défaut). Commande **Ocara : Choisir le script de démarrage**."
        }
      }
    },
    "commands": [
      {
        "command": "ocara.compile",
        "title": "Compiler (Debug)",
        "category": "Ocara"
      },
      {
        "command": "ocara.compileRelease",
        "title": "Compiler (Release)",
        "category": "Ocara"
      },
      {
        "command": "ocara.compileAndRun",
        "title": "Compiler et lancer (Debug)",
        "category": "Ocara"
      },
      {
        "command": "ocara.compileAndRunRelease",
        "title": "Compiler et lancer (Release)",
        "category": "Ocara"
      },
      {
        "command": "ocara.dump",
        "title": "Afficher le dump",
        "category": "Ocara"
      },
      {
        "command": "ocara.fixStyle",
        "title": "Fixer la mise en forme",
        "category": "Ocara"
      },
      {
        "command": "ocara.openDoc",
        "title": "Ouvrir la documentation Ocara",
        "category": "Ocara"
      },
      {
        "command": "ocara.workflow.refresh",
        "title": "Rafraîchir",
        "category": "Ocara",
        "icon": "$(refresh)"
      },
      {
        "command": "ocara.bench.run",
        "title": "Mesurer temps et mémoire",
        "category": "Ocara",
        "icon": "$(dashboard)"
      },
      {
        "command": "ocara.bench.leak",
        "title": "Détecter les fuites",
        "category": "Ocara",
        "icon": "$(debug-alt)"
      },
      {
        "command": "ocara.bench.profile",
        "title": "Profiler par fonction",
        "category": "Ocara",
        "icon": "$(flame)"
      },
      {
        "command": "ocara.bench.clear",
        "title": "Effacer l'historique de benchmark",
        "category": "Ocara",
        "icon": "$(clear-all)"
      },
      {
        "command": "ocara.nav.back",
        "title": "Script précédent",
        "category": "Ocara",
        "icon": "$(arrow-left)",
        "enablement": "ocara.nav.canBack"
      },
      {
        "command": "ocara.nav.forward",
        "title": "Script suivant",
        "category": "Ocara",
        "icon": "$(arrow-right)",
        "enablement": "ocara.nav.canForward"
      },
      {
        "command": "ocara.nav.clear",
        "title": "Fermer l'historique de navigation",
        "category": "Ocara",
        "icon": "$(close)"
      },
      {
        "command": "ocara.nav.open",
        "title": "Ouvrir (historique de navigation)",
        "category": "Ocara"
      },
      {
        "command": "ocara.nav.go",
        "title": "Aller à une entrée de l'historique",
        "category": "Ocara"
      },
      {
        "command": "ocara.bench.leakGrowth",
        "title": "Fuite par croissance (__N__)",
        "category": "Ocara",
        "icon": "$(graph-line)"
      },
      {
        "command": "ocara.restartLanguageServer",
        "title": "Redémarrer le serveur de langage",
        "category": "Ocara"
      },
      {
        "command": "ocara.coverage.run",
        "title": "Lancer les tests et la couverture",
        "category": "Ocara",
        "icon": "$(play)"
      },
      {
        "command": "ocara.coverage.goto",
        "title": "Aller au code non couvert",
        "category": "Ocara"
      },
      {
        "command": "ocara.coverage.output",
        "title": "Afficher la sortie des tests",
        "category": "Ocara"
      },
      {
        "command": "ocara.linter.run",
        "title": "Analyser le style (ocaracs)",
        "category": "Ocara",
        "icon": "$(play)"
      },
      {
        "command": "ocara.linter.goto",
        "title": "Aller à l'avertissement",
        "category": "Ocara"
      },
      {
        "command": "ocara.architecture.run",
        "title": "Vérifier l'architecture",
        "category": "Ocara",
        "icon": "$(play)"
      },
      {
        "command": "ocara.architecture.goto",
        "title": "Aller à l'erreur d'architecture",
        "category": "Ocara"
      },
      {
        "command": "ocara.coverage.autoOff",
        "title": "Mode automatique activé (Coverage) — désactiver",
        "category": "Ocara",
        "icon": "$(sync)"
      },
      {
        "command": "ocara.coverage.autoOn",
        "title": "Mode automatique désactivé (Coverage) — activer",
        "category": "Ocara",
        "icon": "$(sync-ignored)"
      },
      {
        "command": "ocara.linter.autoOff",
        "title": "Mode automatique activé (Linter) — désactiver",
        "category": "Ocara",
        "icon": "$(sync)"
      },
      {
        "command": "ocara.linter.autoOn",
        "title": "Mode automatique désactivé (Linter) — activer",
        "category": "Ocara",
        "icon": "$(sync-ignored)"
      },
      {
        "command": "ocara.architecture.autoOff",
        "title": "Mode automatique activé (Architecture) — désactiver",
        "category": "Ocara",
        "icon": "$(sync)"
      },
      {
        "command": "ocara.architecture.autoOn",
        "title": "Mode automatique désactivé (Architecture) — activer",
        "category": "Ocara",
        "icon": "$(sync-ignored)"
      },
      {
        "command": "ocara.ui.openDesigner",
        "title": "Ouvrir le designer",
        "category": "Ocara UI",
        "icon": "$(layout)"
      },
      {
        "command": "ocara.ui.openDesignerToSide",
        "title": "Ouvrir le designer à côté",
        "category": "Ocara UI",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "ocara.ui.openSource",
        "title": "Afficher le source",
        "category": "Ocara UI",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ocara.chooseStartupScript",
        "title": "Choisir le script de démarrage",
        "category": "Ocara"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ocara.compile",
          "when": "resourceExtname == .oc",
          "group": "ocara@1"
        },
        {
          "command": "ocara.compileRelease",
          "when": "resourceExtname == .oc",
          "group": "ocara@2"
        },
        {
          "command": "ocara.compileAndRun",
          "when": "resourceExtname == .oc",
          "group": "ocara@3"
        },
        {
          "command": "ocara.compileAndRunRelease",
          "when": "resourceExtname == .oc",
          "group": "ocara@4"
        },
        {
          "command": "ocara.dump",
          "when": "resourceExtname == .oc",
          "group": "ocara@5"
        },
        {
          "command": "ocara.fixStyle",
          "when": "resourceExtname == .oc",
          "group": "ocara@6"
        }
      ],
      "explorer/context": [
        {
          "command": "ocara.compile",
          "when": "resourceExtname == .oc",
          "group": "ocara@1"
        },
        {
          "command": "ocara.compileRelease",
          "when": "resourceExtname == .oc",
          "group": "ocara@2"
        },
        {
          "command": "ocara.compileAndRun",
          "when": "resourceExtname == .oc",
          "group": "ocara@3"
        },
        {
          "command": "ocara.compileAndRunRelease",
          "when": "resourceExtname == .oc",
          "group": "ocara@4"
        },
        {
          "command": "ocara.dump",
          "when": "resourceExtname == .oc",
          "group": "ocara@5"
        },
        {
          "command": "ocara.fixStyle",
          "when": "resourceExtname == .oc || explorerResourceIsFolder",
          "group": "ocara@6"
        },
        {
          "command": "ocara.ui.openDesigner",
          "when": "resourceFilename =~ /\\.oc\\.ui$/",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "ocara.compile",
          "when": "editorLangId == ocara"
        },
        {
          "command": "ocara.compileRelease",
          "when": "editorLangId == ocara"
        },
        {
          "command": "ocara.compileAndRun",
          "when": "editorLangId == ocara"
        },
        {
          "command": "ocara.compileAndRunRelease",
          "when": "editorLangId == ocara"
        },
        {
          "command": "ocara.dump",
          "when": "editorLangId == ocara"
        },
        {
          "command": "ocara.fixStyle",
          "when": "editorLangId == ocara"
        },
        {
          "command": "ocara.openDoc",
          "when": "false"
        },
        {
          "command": "ocara.workflow.refresh",
          "when": "false"
        },
        {
          "command": "ocara.nav.open",
          "when": "false"
        },
        {
          "command": "ocara.nav.go",
          "when": "false"
        },
        {
          "command": "ocara.nav.back",
          "when": "ocara.nav.active"
        },
        {
          "command": "ocara.nav.forward",
          "when": "ocara.nav.active"
        },
        {
          "command": "ocara.nav.clear",
          "when": "ocara.nav.active"
        },
        {
          "command": "ocara.coverage.goto",
          "when": "false"
        },
        {
          "command": "ocara.coverage.output",
          "when": "false"
        },
        {
          "command": "ocara.linter.goto",
          "when": "false"
        },
        {
          "command": "ocara.architecture.goto",
          "when": "false"
        },
        {
          "command": "ocara.coverage.autoOff",
          "when": "false"
        },
        {
          "command": "ocara.coverage.autoOn",
          "when": "false"
        },
        {
          "command": "ocara.linter.autoOff",
          "when": "false"
        },
        {
          "command": "ocara.linter.autoOn",
          "when": "false"
        },
        {
          "command": "ocara.architecture.autoOff",
          "when": "false"
        },
        {
          "command": "ocara.architecture.autoOn",
          "when": "false"
        },
        {
          "command": "ocara.ui.openDesigner",
          "when": "resourceFilename =~ /\\.oc\\.ui$/"
        },
        {
          "command": "ocara.ui.openDesignerToSide",
          "when": "resourceFilename =~ /\\.oc\\.ui$/"
        },
        {
          "command": "ocara.ui.openSource",
          "when": "activeCustomEditorId == ocara.uiDesigner"
        }
      ],
      "view/title": [
        {
          "command": "ocara.workflow.refresh",
          "when": "view == ocara.workflow",
          "group": "navigation"
        },
        {
          "command": "ocara.bench.run",
          "when": "view == ocara.benchmark",
          "group": "navigation@1"
        },
        {
          "command": "ocara.bench.leak",
          "when": "view == ocara.benchmark",
          "group": "navigation@2"
        },
        {
          "command": "ocara.bench.profile",
          "when": "view == ocara.benchmark",
          "group": "navigation@4"
        },
        {
          "command": "ocara.bench.leakGrowth",
          "when": "view == ocara.benchmark",
          "group": "navigation@3"
        },
        {
          "command": "ocara.bench.clear",
          "when": "view == ocara.benchmark",
          "group": "navigation@5"
        },
        {
          "command": "ocara.coverage.run",
          "when": "view == ocara.coverage",
          "group": "navigation@1"
        },
        {
          "command": "ocara.linter.run",
          "when": "view == ocara.linter",
          "group": "navigation@1"
        },
        {
          "command": "ocara.architecture.run",
          "when": "view == ocara.architecture",
          "group": "navigation@1"
        },
        {
          "command": "ocara.coverage.autoOff",
          "when": "view == ocara.coverage && ocara.coverage.auto",
          "group": "navigation@0"
        },
        {
          "command": "ocara.coverage.autoOn",
          "when": "view == ocara.coverage && !ocara.coverage.auto",
          "group": "navigation@0"
        },
        {
          "command": "ocara.linter.autoOff",
          "when": "view == ocara.linter && ocara.linter.auto",
          "group": "navigation@0"
        },
        {
          "command": "ocara.linter.autoOn",
          "when": "view == ocara.linter && !ocara.linter.auto",
          "group": "navigation@0"
        },
        {
          "command": "ocara.architecture.autoOff",
          "when": "view == ocara.architecture && ocara.architecture.auto",
          "group": "navigation@0"
        },
        {
          "command": "ocara.architecture.autoOn",
          "when": "view == ocara.architecture && !ocara.architecture.auto",
          "group": "navigation@0"
        }
      ],
      "editor/title": [
        {
          "command": "ocara.nav.back",
          "when": "ocara.nav.active",
          "group": "navigation@-3"
        },
        {
          "command": "ocara.nav.forward",
          "when": "ocara.nav.active",
          "group": "navigation@-2"
        },
        {
          "command": "ocara.ui.openDesigner",
          "alt": "ocara.ui.openDesignerToSide",
          "when": "resourceFilename =~ /\\.oc\\.ui$/ && activeCustomEditorId != ocara.uiDesigner",
          "group": "navigation"
        },
        {
          "command": "ocara.ui.openSource",
          "when": "activeCustomEditorId == ocara.uiDesigner",
          "group": "navigation"
        }
      ]
    },
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "keyword.control.directive.when.ocara",
            "settings": {
              "foreground": "#FFCC00",
              "fontStyle": "bold"
            }
          }
        ],
        "[*Light*]": {
          "textMateRules": [
            {
              "scope": "keyword.control.directive.when.ocara",
              "settings": {
                "foreground": "#A86500",
                "fontStyle": "bold"
              }
            }
          ]
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "ocaraWhen",
        "superType": "keyword",
        "description": "Clause `when` et ses opérateurs"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "ocara",
        "scopes": {
          "ocaraWhen": [
            "keyword.control.directive.when.ocara"
          ]
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
