          "contextualTitle": "Architecture - Ocara"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ocara.workflow",
        "contents": "Ouvrez un script Ocara (.oc) : ses imports, sa structure, ses appels et ses variantes `when` s'affichent ici."
      },
      {
        "view": "ocara.benchmark",
        "contents": "Ouvrez un script Ocara (.oc) pour mesurer son temps d'exécution, son pic mémoire, détecter une fuite ou le profiler par fonction."
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": "*.oc.ui",
        "url": "./schemas/oc-ui.schema.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "ocara.uiDesigner",
        "displayName": "Designer Ocara UI",
        "selector": [
          {
            "filenamePattern": "*.oc.ui"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node scripts/copy-docs.js && node scripts/copy-ui.js && tsc -p ./",
    "watch": "node scripts/copy-docs.js && node scripts/copy-ui.js && tsc -watch -p ./",
    "package": "vsce package",
    "test:grammar": "node scripts/test-grammar.js"
  },
