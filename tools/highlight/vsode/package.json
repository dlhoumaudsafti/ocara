{
  "name": "ocara-language",
  "displayName": "Ocara Language Support",
  "description": "Syntax highlighting, completion, Go-to-Definition, ocaracs linting and compile/dump commands for Ocara (.oc) files",
  "version": "1.0.0",
  "publisher": "david-lhoumaud",
  "license": "MIT",
  "icon": "logo-min.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:ocara",
    "onView:ocara.controls",
    "onView:ocara.workflow",
    "onView:ocara.graph",
    "onView:ocara.benchmark"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ocara",
        "aliases": [
          "Ocara",
          "ocara"
        ],
        "extensions": [
          ".oc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ocara",
        "scopeName": "source.ocara",
        "path": "./syntaxes/ocara.tmLanguage.json",
        "embeddedLanguages": {
          "text.html.basic": "html",
          "source.ocara.embedded": "ocara"
        }
      }
    ],
    "configuration": {
      "title": "Ocara",
      "properties": {
        "ocara.compilerPath": {
          "type": "string",
          "default": "ocara",
          "markdownDescription": "Chemin du compilateur `ocara` ou commande pour le lancer (arguments et guillemets acceptés, variables `${workspaceFolder}` et `${fileDirname}`). Laissé à `ocara` et absent du PATH : `<workspace>/target/release/ocara` s'il existe."
        },
        "ocara.ocaracsPath": {
          "type": "string",
          "default": "ocaracs",
          "markdownDescription": "Chemin de l'analyseur de style `ocaracs` ou commande pour le lancer (mêmes règles que `ocara.compilerPath`)."
        },
        "ocara.lint.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Analyse `ocaracs` automatique à l'affichage, l'ouverture et l'enregistrement d'un fichier `.oc` (règles : `.ocaracs` le plus proche du script, sinon valeurs par défaut d'ocaracs)."
        },
        "ocara.autoImport.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ajoute les imports manquants à l'enregistrement d'un fichier `.oc` : `import ocara.X` pour un builtin, sinon le fichier du projet qui déclare le type, cherché dans le dossier du script, ses sous-dossiers, puis les dossiers parents jusqu'à la racine du projet. Le correctif rapide (Ctrl+.) reste disponible quand ce réglage est désactivé."
        },
        "ocara.os": {
          "type": "string",
          "enum": [
            "system",
            "linux",
            "windows",
            "macos",
            "android",
            "other"
          ],
          "enumDescriptions": [
            "Système de la machine (défaut)",
            "Linux",
            "Windows",
            "macOS",
            "Android",
            "Valeur personnalisée : réglage « ocara.osOther »"
          ],
          "default": "system",
          "markdownDescription": "Valeur de `System::OS` pour l'éditeur : variante `when` retenue, variantes écartées estompées et diagnostics de cette configuration. Ne change pas la cible des commandes de compilation (machine hôte)."
        },
        "ocara.osOther": {
          "type": "string",
          "default": "",
          "markdownDescription": "Valeur personnalisée de `System::OS` quand `ocara.os` vaut `other`."
        },
        "ocara.arch": {
          "type": "string",
          "enum": [
            "system",
            "x86_64",
            "aarch64",
            "arm",
            "other"
          ],
          "enumDescriptions": [
            "Architecture de la machine (défaut)",
            "Intel / AMD 64 bits",
            "ARM 64 bits",
            "ARM 32 bits",
            "Valeur personnalisée : réglage « ocara.archOther »"
          ],
          "default": "system",
          "markdownDescription": "Valeur de `System::ARCH` pour l'éditeur (mêmes effets que `ocara.os`)."
        },
        "ocara.archOther": {
          "type": "string",
          "default": "",
          "markdownDescription": "Valeur personnalisée de `System::ARCH` quand `ocara.arch` vaut `other`."
        },
        "ocara.build": {
          "type": "string",
          "enum": [
            "debug",
            "release"
          ],
          "enumDescriptions": [
            "Mode debug (défaut)",
            "Mode release (`--release`)"
          ],
          "default": "debug",
          "markdownDescription": "Valeur de `System::BUILD` pour l'éditeur (mêmes effets que `ocara.os`). Les commandes de compilation gardent leur propre mode (Debug/Release)."
        },
        "ocara.benchmark.runs": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "markdownDescription": "Nombre d'exécutions de « Mesurer temps et mémoire » (temps moyen, min, max ; pic mémoire le plus haut)."
        },
        "ocara.benchmark.timeout": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "markdownDescription": "Délai maximal d'une exécution mesurée, en secondes (un serveur qui ne s'arrête pas est interrompu)."
        },
        "ocara.benchmark.leakSizes": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "default": [
            20000,
            200000
          ],
          "minItems": 2,
          "maxItems": 2,
          "markdownDescription": "Valeurs du marqueur `__N__` pour la détection de fuite : le pic mémoire est comparé entre les deux (voir docs/benchmarking.md)."
        }
      }
    },
    "commands": [
      {
        "command": "ocara.compile",
        "title": "Compiler (Debug)",
        "category": "Ocara"
      },
      {
        "command": "ocara.compileRelease",
        "title": "Compiler (Release)",
        "category": "Ocara"
      },
      {
        "command": "ocara.compileAndRun",
        "title": "Compiler et lancer (Debug)",
        "category": "Ocara"
      },
      {
        "command": "ocara.compileAndRunRelease",
        "title": "Compiler et lancer (Release)",
        "category": "Ocara"
      },
      {
        "command": "ocara.dump",
        "title": "Afficher le dump",
        "category": "Ocara"
      },
      {
        "command": "ocara.fixStyle",
        "title": "Fixer la mise en forme",
        "category": "Ocara"
      },
      {
        "command": "ocara.openDoc",
        "title": "Ouvrir la documentation Ocara",
        "category": "Ocara"
      },
      {
        "command": "ocara.workflow.refresh",
        "title": "Rafraîchir",
        "category": "Ocara",
        "icon": "$(refresh)"
      },
      {
        "command": "ocara.bench.run",
        "title": "Mesurer temps et mémoire",
        "category": "Ocara",
        "icon": "$(dashboard)"
      },
      {
        "command": "ocara.bench.leak",
        "title": "Détecter une fuite (__N__)",
        "category": "Ocara",
        "icon": "$(debug-alt)"
      },
      {
        "command": "ocara.bench.profile",
        "title": "Profiler par fonction",
        "category": "Ocara",
        "icon": "$(flame)"
      },
      {
        "command": "ocara.bench.clear",
        "title": "Effacer l'historique de benchmark",
        "category": "Ocara",
        "icon": "$(clear-all)"
      },
      {
        "command": "ocara.nav.back",
        "title": "Script précédent",
        "category": "Ocara",
        "icon": "$(arrow-left)",
        "enablement": "ocara.nav.canBack"
      },
      {
        "command": "ocara.nav.forward",
        "title": "Script suivant",
        "category": "Ocara",
        "icon": "$(arrow-right)",
        "enablement": "ocara.nav.canForward"
      },
      {
        "command": "ocara.nav.clear",
        "title": "Fermer l'historique de navigation",
        "category": "Ocara",
        "icon": "$(close)"
      },
      {
        "command": "ocara.nav.open",
        "title": "Ouvrir (historique de navigation)",
        "category": "Ocara"
      },
      {
        "command": "ocara.nav.go",
        "title": "Aller à une entrée de l'historique",
        "category": "Ocara"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ocara.compile",
          "when": "resourceExtname == .oc",
          "group": "ocara@1"
        },
        {
          "command": "ocara.compileRelease",
          "when": "resourceExtname == .oc",
          "group": "ocara@2"
        },
        {
          "command": "ocara.compileAndRun",
          "when": "resourceExtname == .oc",
          "group": "ocara@3"
        },
        {
          "command": "ocara.compileAndRunRelease",
          "when": "resourceExtname == .oc",
          "group": "ocara@4"
        },
        {
          "command": "ocara.dump",
          "when": "resourceExtname == .oc",
          "group": "ocara@5"
        },
        {
          "command": "ocara.fixStyle",
          "when": "resourceExtname == .oc",
          "group": "ocara@6"
        }
      ],
      "explorer/context": [
        {
          "command": "ocara.compile",
          "when": "resourceExtname == .oc",
          "group": "ocara@1"
        },
        {
          "command": "ocara.compileRelease",
          "when": "resourceExtname == .oc",
          "group": "ocara@2"
        },
        {
          "command": "ocara.compileAndRun",
          "when": "resourceExtname == .oc",
          "group": "ocara@3"
        },
        {
          "command": "ocara.compileAndRunRelease",
          "when": "resourceExtname == .oc",
          "group": "ocara@4"
        },
        {
          "command": "ocara.dump",
          "when": "resourceExtname == .oc",
          "group": "ocara@5"
        },
        {
          "command": "ocara.fixStyle",
          "when": "resourceExtname == .oc || explorerResourceIsFolder",
          "group": "ocara@6"
        }
      ],
      "commandPalette": [
        {
          "command": "ocara.compile",
          "when": "editorLangId == ocara"
        },
        {
          "command": "ocara.compileRelease",
          "when": "editorLangId == ocara"
        },
        {
          "command": "ocara.compileAndRun",
          "when": "editorLangId == ocara"
        },
        {
          "command": "ocara.compileAndRunRelease",
          "when": "editorLangId == ocara"
        },
        {
          "command": "ocara.dump",
          "when": "editorLangId == ocara"
        },
        {
          "command": "ocara.fixStyle",
          "when": "editorLangId == ocara"
        },
        {
          "command": "ocara.openDoc",
          "when": "false"
        },
        {
          "command": "ocara.workflow.refresh",
          "when": "false"
        },
        {
          "command": "ocara.nav.open",
          "when": "false"
        },
        {
          "command": "ocara.nav.go",
          "when": "false"
        },
        {
          "command": "ocara.nav.back",
          "when": "ocara.nav.active"
        },
        {
          "command": "ocara.nav.forward",
          "when": "ocara.nav.active"
        },
        {
          "command": "ocara.nav.clear",
          "when": "ocara.nav.active"
        }
      ],
      "view/title": [
        {
          "command": "ocara.workflow.refresh",
          "when": "view == ocara.workflow",
          "group": "navigation"
        },
        {
          "command": "ocara.bench.run",
          "when": "view == ocara.benchmark",
          "group": "navigation@1"
        },
        {
          "command": "ocara.bench.leak",
          "when": "view == ocara.benchmark",
          "group": "navigation@2"
        },
        {
          "command": "ocara.bench.profile",
          "when": "view == ocara.benchmark",
          "group": "navigation@3"
        },
        {
          "command": "ocara.bench.clear",
          "when": "view == ocara.benchmark",
          "group": "navigation@4"
        }
      ],
      "editor/title": [
        {
          "command": "ocara.nav.back",
          "when": "ocara.nav.active",
          "group": "navigation@-3"
        },
        {
          "command": "ocara.nav.forward",
          "when": "ocara.nav.active",
          "group": "navigation@-2"
        }
      ]
    },
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "keyword.control.directive.when.ocara",
            "settings": {
              "foreground": "#FFCC00",
              "fontStyle": "bold"
            }
          }
        ],
        "[*Light*]": {
          "textMateRules": [
            {
              "scope": "keyword.control.directive.when.ocara",
              "settings": {
                "foreground": "#A86500",
                "fontStyle": "bold"
              }
            }
          ]
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "ocaraWhen",
        "superType": "keyword",
        "description": "Clause `when` et ses opérateurs"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "ocara",
        "scopes": {
          "ocaraWhen": [
            "keyword.control.directive.when.ocara"
          ]
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ocara",
          "title": "Ocara",
          "icon": "logo-min-white.png"
        }
      ]
    },
    "views": {
      "ocara": [
        {
          "type": "webview",
          "id": "ocara.controls",
          "name": "Configuration",
          "contextualTitle": "Ocara"
        },
        {
          "id": "ocara.workflow",
          "name": "Workflow",
          "contextualTitle": "Ocara"
        },
        {
          "type": "webview",
          "id": "ocara.graph",
          "name": "Graphe d'appels",
          "contextualTitle": "Ocara"
        },
        {
          "id": "ocara.benchmark",
          "name": "Benchmark",
          "contextualTitle": "Ocara"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ocara.workflow",
        "contents": "Ouvrez un script Ocara (.oc) : ses imports, sa structure, ses appels et ses variantes `when` s'affichent ici."
      },
      {
        "view": "ocara.benchmark",
        "contents": "Ouvrez un script Ocara (.oc) pour mesurer son temps d'exécution, son pic mémoire, détecter une fuite ou le profiler par fonction."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node scripts/copy-docs.js && tsc -p ./",
    "watch": "node scripts/copy-docs.js && tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.15.0",
    "cheerio": "^1.0.0-rc.12",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
